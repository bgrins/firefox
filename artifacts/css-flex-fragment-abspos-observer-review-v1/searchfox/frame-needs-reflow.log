    2726:           // If we get here, 'a' is abspos, so its subtree's intrinsic sizing
    2727:           // has no effect on its ancestors' intrinsic sizing. So, don't loop
    2728:           // upwards any further.
    2729:           break;
    2730:         }
    2731:       }
    2732:     }
    2733: 
    2734:     const bool frameAncestorAndDescendantISizesDirty =
    2735:         (aIntrinsicDirty == IntrinsicDirty::FrameAncestorsAndDescendants);
    2736:     const bool dirty = (aBitToAdd == NS_FRAME_IS_DIRTY);
    2737:     if (frameAncestorAndDescendantISizesDirty || dirty) {
    2738:       // Mark all descendants dirty (using an nsTArray stack rather than
    2739:       // recursion).
    2740:       // Note that ReflowInput::InitResizeFlags has some similar
    2741:       // code; see comments there for how and why it differs.
    2742:       AutoTArray<nsIFrame*, 32> stack;
    2743:       stack.AppendElement(subtreeRoot);
    2744: 
    2745:       do {
    2746:         nsIFrame* f = stack.PopLastElement();
    2747: 
    2748:         if (frameAncestorAndDescendantISizesDirty && f->IsPlaceholderFrame()) {
    2749:           // Call `GetOutOfFlowFrame` directly because we can get here from
    2750:           // frame destruction and the placeholder might be already torn down.
    2751:           if (nsIFrame* oof =
    2752:                   static_cast<nsPlaceholderFrame*>(f)->GetOutOfFlowFrame()) {
    2753:             if (!nsLayoutUtils::IsProperAncestorFrame(subtreeRoot, oof)) {
    2754:               // We have another distinct subtree we need to mark.
    2755:               subtrees.AppendElement(oof);
    2756:             }
    2757:           }
    2758:         }
    2759: 
    2760:         for (const auto& childList : f->ChildLists()) {
    2761:           for (nsIFrame* kid : childList.mList) {
    2762:             if (frameAncestorAndDescendantISizesDirty) {
    2763:               kid->MarkIntrinsicISizesDirty();
    2764:             }
    2765:             if (dirty) {
    2766:               kid->AddStateBits(NS_FRAME_IS_DIRTY);
    2767:             }
    2768:             stack.AppendElement(kid);
    2769:           }
    2770:         }
    2771:       } while (stack.Length() != 0);
    2772:     }
    2773: 
    2774:     // Skip setting dirty bits up the tree if we weren't given a bit to add.
    2775:     if (!aBitToAdd) {
