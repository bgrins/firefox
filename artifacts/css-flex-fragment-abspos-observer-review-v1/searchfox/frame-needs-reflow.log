>>> 2648: void PresShell::FrameNeedsReflow(nsIFrame* aFrame,
    2649:                                  IntrinsicDirty aIntrinsicDirty,
    2650:                                  nsFrameState aBitToAdd,
    2651:                                  ReflowRootHandling aRootHandling) {
    2652:   MOZ_ASSERT(aBitToAdd == NS_FRAME_IS_DIRTY ||
    2653:                  aBitToAdd == NS_FRAME_HAS_DIRTY_CHILDREN || !aBitToAdd,
    2654:              "Unexpected bits being added");
    2655: 
    2656:   // FIXME bug 478135
    2657:   NS_ASSERTION(
    2658:       aIntrinsicDirty != IntrinsicDirty::FrameAncestorsAndDescendants ||
    2659:           aBitToAdd != NS_FRAME_HAS_DIRTY_CHILDREN,
    2660:       "bits don't correspond to style change reason");
    2661: 
    2662:   // FIXME bug 457400
    2663:   NS_ASSERTION(!mIsReflowing, "can't mark frame dirty during reflow");
    2664: 
    2665:   // If we've not yet done the initial reflow, then don't bother
    2666:   // enqueuing a reflow command yet.
    2667:   if (!mDidInitialize) {
    2668:     return;
    2669:   }
    2670: 
    2671:   // If we're already destroying, don't bother with this either.
    2672:   if (mIsDestroying) {
    2673:     return;
    2674:   }
    2675: 
    2676:   AutoTArray<nsIFrame*, 4> subtrees;
    2677:   subtrees.AppendElement(aFrame);
    2678: 
    2679:   do {
    2680:     nsIFrame* subtreeRoot = subtrees.PopLastElement();
    2681: 
    2682:     // Grab |wasDirty| now so we can go ahead and update the bits on
    2683:     // subtreeRoot.
    2684:     bool wasDirty = subtreeRoot->IsSubtreeDirty();
    2685:     subtreeRoot->AddStateBits(aBitToAdd);
    2686: 
    2687:     // Determine whether we need to keep looking for the next ancestor
    2688:     // reflow root if subtreeRoot itself is a reflow root.
    2689:     bool targetNeedsReflowFromParent;
    2690:     switch (aRootHandling) {
    2691:       case ReflowRootHandling::PositionOrSizeChange:
    2692:         targetNeedsReflowFromParent = true;
    2693:         break;
    2694:       case ReflowRootHandling::NoPositionOrSizeChange:
    2695:         targetNeedsReflowFromParent = false;
    2696:         break;
    2697:       case ReflowRootHandling::InferFromBitToAdd:
    2698:         targetNeedsReflowFromParent = (aBitToAdd == NS_FRAME_IS_DIRTY);
    2699:         break;
    2700:     }
    2701: 
    2702:     auto FrameIsReflowRoot = [](const nsIFrame* aFrame) {
    2703:       return aFrame->HasAnyStateBits(NS_FRAME_REFLOW_ROOT |
    2704:                                      NS_FRAME_DYNAMIC_REFLOW_ROOT);
    2705:     };
    2706: 
    2707:     auto CanStopClearingAncestorIntrinsics = [&](const nsIFrame* aFrame) {
    2708:       return FrameIsReflowRoot(aFrame) && aFrame != subtreeRoot;
    2709:     };
    2710: 
    2711:     auto IsReflowBoundary = [&](const nsIFrame* aFrame) {
    2712:       return FrameIsReflowRoot(aFrame) &&
    2713:              (aFrame != subtreeRoot || !targetNeedsReflowFromParent);
    2714:     };
    2715: 
    2716:     // Mark the intrinsic widths as dirty on the frame, all of its ancestors,
    2717:     // and all of its descendants, if needed:
    2718: 
    2719:     if (aIntrinsicDirty != IntrinsicDirty::None) {
    2720:       // Mark argument and all ancestors dirty. (Unless we hit a reflow root
    2721:       // that should contain the reflow.
    2722:       for (nsIFrame* a = subtreeRoot;
    2723:            a && !CanStopClearingAncestorIntrinsics(a); a = a->GetParent()) {
    2724:         a->MarkIntrinsicISizesDirty();
