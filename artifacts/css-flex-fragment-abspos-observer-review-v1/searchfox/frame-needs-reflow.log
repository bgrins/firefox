    2784:       if (IsReflowBoundary(f) || !f->GetParent()) {
    2785:         // we've hit a reflow root or the root frame
    2786:         if (!wasDirty) {
    2787:           mDirtyRoots.Add(f);
    2788:           SetNeedLayoutFlush();
    2789:         }
    2790: #ifdef DEBUG
    2791:         else {
    2792:           VerifyHasDirtyRootAncestor(f);
    2793:         }
    2794: #endif
    2795: 
    2796:         break;
    2797:       }
    2798: 
    2799:       nsIFrame* child = f;
    2800:       f = f->GetParent();
    2801:       wasDirty = f->IsSubtreeDirty();
    2802:       f->ChildIsDirty(child);
    2803:       NS_ASSERTION(f->HasAnyStateBits(NS_FRAME_HAS_DIRTY_CHILDREN),
    2804:                    "ChildIsDirty didn't do its job");
    2805:       if (wasDirty) {
    2806:         // This frame was already marked dirty.
    2807: #ifdef DEBUG
    2808:         VerifyHasDirtyRootAncestor(f);
    2809: #endif
    2810:         break;
    2811:       }
    2812:     }
    2813:   } while (subtrees.Length() != 0);
