     122:               ymost + padding.bottom +
     123:               kidReflowInput.mStyleBorder->GetComputedBorderWidth(eSideBottom);
     124:           const float ratio = float(maxSize.height) / float(heightToFit);
     125:           MOZ_ASSERT(ratio >= 0.0 && ratio < 1.0);
     126:           mPD->mShrinkToFitRatio = std::min(mPD->mShrinkToFitRatio, ratio);
