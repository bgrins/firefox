      58:   if (aReflowInput.ComputedBSize() != NS_UNCONSTRAINEDSIZE) {
      59:     aReflowOutput.BSize(pcfWM) = aReflowInput.ComputedBSize();
      60:   }
      61:   aReflowOutput.SetOverflowAreasToDesiredBounds();
      62: 
      63:   // A PageContentFrame must always have one child: the canvas frame.
      64:   // Resize our frame allowing it only to be as big as we are
      65:   // XXX Pay attention to the page's border and padding...
      66:   if (mFrames.NotEmpty()) {
      67:     nsIFrame* const frame = mFrames.FirstChild();
      68:     const WritingMode frameWM = frame->GetWritingMode();
      69:     const LogicalSize logicalSize(frameWM, maxSize);
      70:     LogicalSize availSize = logicalSize;
      71:     if (aReflowInput.mFlags.mIsInFragmentainerMeasuringReflow) {
      72:       availSize.BSize(frameWM) = NS_UNCONSTRAINEDSIZE;
      73:     }
      74:     ReflowInput kidReflowInput(aPresContext, aReflowInput, frame, availSize);
      75:     kidReflowInput.SetComputedBSize(logicalSize.BSize(frameWM));
      76:     ReflowOutput kidReflowOutput(kidReflowInput);
      77:     ReflowChild(frame, aPresContext, kidReflowOutput, kidReflowInput, 0, 0,
      78:                 ReflowChildFlags::Default, aStatus);
      79: 
      80:     // The document element's background should cover the entire canvas, so
      81:     // take into account the combined area and any space taken up by
      82:     // absolutely positioned elements
      83:     nsMargin padding(0, 0, 0, 0);
      84: 
      85:     // XXXbz this screws up percentage padding (sets padding to zero
      86:     // in the percentage padding case)
      87:     frame->StylePadding()->GetPadding(padding);
      88: 
      89:     // This is for shrink-to-fit, and therefore we want to use the
      90:     // scrollable overflow, since the purpose of shrink to fit is to
      91:     // make the content that ought to be reachable (represented by the
      92:     // scrollable overflow) fit in the page.
      93:     //
      94:     // For pdf.js documents, the shrink-to-fit ratio also takes y-axis overflow
      95:     // into account. During a measuring reflow under an unconstrained
      96:     // block-size, that overflow spans the entire unfragmented document with all
      97:     // pages stacked. Therefore the computation produces an incorrect ratio that
      98:     // tries to fit the entire document onto a single page. Since
      99:     // mShrinkToFitRatio is only lowered (via std::min) and never reset, we skip
     100:     // computing the shrink-to-fit ratio during a measuring reflow.
