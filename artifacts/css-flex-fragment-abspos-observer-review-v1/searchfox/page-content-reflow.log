     104:       // for children sticking outside the child frame's padding edge
     105:       nscoord xmost = kidReflowOutput.ScrollableOverflow().XMost();
     106:       if (xmost > kidReflowOutput.Width()) {
     107:         const nscoord widthToFit =
     108:             xmost + padding.right +
     109:             kidReflowInput.mStyleBorder->GetComputedBorderWidth(eSideRight);
     110:         const float ratio = float(maxSize.width) / float(widthToFit);
