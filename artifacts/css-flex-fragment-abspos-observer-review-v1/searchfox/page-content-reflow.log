      41:     nsresult rv =
      42:         aPresContext->PresShell()->FrameConstructor()->ReplicateFixedFrames(
      43:             this);
      44:     if (NS_FAILED(rv)) {
      45:       return;
      46:     }
      47:   }
      48: 
      49:   // Set our size up front, since some parts of reflow depend on it
      50:   // being already set.  Note that the computed height may be
      51:   // unconstrained; that's ok.  Consumers should watch out for that.
      52:   const nsSize maxSize = aReflowInput.ComputedPhysicalSize();
