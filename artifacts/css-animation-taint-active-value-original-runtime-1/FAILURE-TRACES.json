  {
    "test": "/css/css-variables/animation-taint-alias-outer-fallback.tentative.html",
    "subtest": "Active animation taint alias: custom aliases retain values and outer sink chooses fallback",
    "trace": {
      "property": "writing-mode",
      "mode": "alias",
      "initial": {
        "sink": "horizontal-tb",
