        "cssDuration": "2s",
        "duration": 2000,
        "computedDuration": 2000,
        "progress": 0.375,
        "time": 750,
        "state": "paused",
        "effectSame": true
      },
      "samples": [
        {
          "phase": "first-read",
          "value": "horizontal-tb"
        },
        {
          "phase": "passive-frame-1",
          "value": "horizontal-tb"
        },
        {
          "phase": "passive-frame-2",
          "value": "horizontal-tb"
        },
        {
          "phase": "passive-frame-3",
          "value": "horizontal-tb"
        }
      ],
      "beforeMembership": {
        "sink": "horizontal-tb",
        "variable": "horizontal-tb",
        "alias": "horizontal-tb",
        "aliasHop": "horizontal-tb",
        "cssDuration": "2s",
        "duration": 2000,
        "computedDuration": 2000,
        "progress": 0.375,
        "time": 750,
        "state": "paused",
        "effectSame": true
      },
      "membership": {
        "count": 1,
        "sameAnimation": true,
        "sameEffect": true
      },
      "afterMembership": {
        "sink": "horizontal-tb",
        "variable": "horizontal-tb",
        "alias": "horizontal-tb",
        "aliasHop": "horizontal-tb",
        "cssDuration": "2s",
        "duration": 2000,
        "computedDuration": 2000,
        "progress": 0.375,
        "time": 750,
        "state": "paused",
        "effectSame": true
      }
    },
