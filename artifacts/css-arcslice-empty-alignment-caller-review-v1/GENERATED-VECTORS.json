{
  "text-shadow": {
    "affects": "overflow",
    "ignored_when_colors_disabled": true,
    "servo_restyle_damage": "repaint",
    "spec": "https://drafts.csswg.org/css-text-decor-3/#text-shadow-property",
    "struct": "inherited_text",
    "type": "SimpleShadow",
    "vector": {
      "animation_type": "with_zero",
      "simple_bindings": true
    }
  }
}
