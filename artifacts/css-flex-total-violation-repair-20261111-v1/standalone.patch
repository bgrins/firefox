+<!doctype html>
+<meta charset="utf-8">
+<title>Large total min-size violations freeze the constrained flex items</title>
+<link rel="help" href="https://drafts.csswg.org/css-flexbox-1/#resolve-flexible-lengths">
+<meta name="assert" content="A positive total min-size violation freezes the min-constrained items before redistributing remaining shrink space.">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<style>
+  .container {
+    display: flex;
+    width: 1000px;
+    height: 1000px;
+    align-items: flex-start;
+  }
+  .item {
+    width: 0;
+    height: 0;
+    min-width: 0;
+    min-height: 0;
+  }
+  .subject {
+    flex: 0 0.0000152587890625 1000px;
+  }
+</style>
+<body>
+<script>
+for (const direction of ["row", "row-reverse", "column", "column-reverse"]) {
+  for (const [count, minimum] of [[5, 1000], [3, 10000000], [4, 10000000], [5, 10000000], [7, 10000000], [357, 100000], [359, 100000]]) {
+    test(t => {
+      const size = direction.startsWith("row") ? "width" : "height";
+      const minSize = direction.startsWith("row") ? "minWidth" : "minHeight";
+      const container = document.createElement("div");
+      container.className = "container";
+      container.style.flexDirection = direction;
+      const subject = document.createElement("div");
+      subject.className = "item subject";
+      container.append(subject);
+      const constrained = [];
+      for (let i = 0; i < count; i++) {
+        const item = document.createElement("div");
+        item.className = "item";
+        item.style.flex = `0 1 ${minimum}px`;
+        item.style[minSize] = `${minimum}px`;
+        container.append(item);
+        constrained.push(item);
+      }
+      document.body.append(container);
+      t.add_cleanup(() => container.remove());
+
+      for (const item of constrained) {
+        assert_approx_equals(parseFloat(getComputedStyle(item)[size]), minimum, 0.05,
+          "Min-constrained item size");
+      }
+      const expected = Math.max(0, 1000 - count * minimum / 65536);
+      assert_approx_equals(subject.getBoundingClientRect()[size], expected, 0.05,
+        "Subject size after the min-constrained items freeze");
+    }, `${direction}: shrink beside ${count} items with minimum ${minimum}px`);
+  }
+}
+</script>
