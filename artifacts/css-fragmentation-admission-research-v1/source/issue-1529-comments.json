[{"url":"https://api.github.com/repos/w3c/csswg-drafts/issues/comments/308510246","html_url":"https://github.com/w3c/csswg-drafts/issues/1529#issuecomment-308510246","issue_url":"https://api.github.com/repos/w3c/csswg-drafts/issues/1529","id":308510246,"node_id":"MDEyOklzc3VlQ29tbWVudDMwODUxMDI0Ng==","user":{"login":"MatsPalmgren","id":4010828,"node_id":"MDQ6VXNlcjQwMTA4Mjg=","avatar_url":"https://avatars.githubusercontent.com/u/4010828?v=4","gravatar_id":"","url":"https://api.github.com/users/MatsPalmgren","html_url":"https://github.com/MatsPalmgren","followers_url":"https://api.github.com/users/MatsPalmgren/followers","following_url":"https://api.github.com/users/MatsPalmgren/following{/other_user}","gists_url":"https://api.github.com/users/MatsPalmgren/gists{/gist_id}","starred_url":"https://api.github.com/users/MatsPalmgren/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MatsPalmgren/subscriptions","organizations_url":"https://api.github.com/users/MatsPalmgren/orgs","repos_url":"https://api.github.com/users/MatsPalmgren/repos","events_url":"https://api.github.com/users/MatsPalmgren/events{/privacy}","received_events_url":"https://api.github.com/users/MatsPalmgren/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-06-14T17:57:47Z","updated_at":"2017-06-14T18:07:31Z","body":"> Definitely in the former fragment. It's very observable if the zero-height block has abs.pos. children.\r\n\r\n**Edit**: Hmm, on second thought, I take that back.  It might just be a quirk/bug in our implementation (Gecko).\r\n\r\n(BTW, your example markup isn't visible.)","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/w3c/csswg-drafts/issues/comments/308510246/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/w3c/csswg-drafts/issues/comments/308541075","html_url":"https://github.com/w3c/csswg-drafts/issues/1529#issuecomment-308541075","issue_url":"https://api.github.com/repos/w3c/csswg-drafts/issues/1529","id":308541075,"node_id":"MDEyOklzc3VlQ29tbWVudDMwODU0MTA3NQ==","user":{"login":"mstensho","id":13527206,"node_id":"MDQ6VXNlcjEzNTI3MjA2","avatar_url":"https://avatars.githubusercontent.com/u/13527206?v=4","gravatar_id":"","url":"https://api.github.com/users/mstensho","html_url":"https://github.com/mstensho","followers_url":"https://api.github.com/users/mstensho/followers","following_url":"https://api.github.com/users/mstensho/following{/other_user}","gists_url":"https://api.github.com/users/mstensho/gists{/gist_id}","starred_url":"https://api.github.com/users/mstensho/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mstensho/subscriptions","organizations_url":"https://api.github.com/users/mstensho/orgs","repos_url":"https://api.github.com/users/mstensho/repos","events_url":"https://api.github.com/users/mstensho/events{/privacy}","received_events_url":"https://api.github.com/users/mstensho/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-06-14T19:58:15Z","updated_at":"2017-06-14T19:58:15Z","body":"(Sorry - fixed the markup)","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/w3c/csswg-drafts/issues/comments/308541075/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/w3c/csswg-drafts/issues/comments/308831157","html_url":"https://github.com/w3c/csswg-drafts/issues/1529#issuecomment-308831157","issue_url":"https://api.github.com/repos/w3c/csswg-drafts/issues/1529","id":308831157,"node_id":"MDEyOklzc3VlQ29tbWVudDMwODgzMTE1Nw==","user":{"login":"fantasai","id":725717,"node_id":"MDQ6VXNlcjcyNTcxNw==","avatar_url":"https://avatars.githubusercontent.com/u/725717?v=4","gravatar_id":"","url":"https://api.github.com/users/fantasai","html_url":"https://github.com/fantasai","followers_url":"https://api.github.com/users/fantasai/followers","following_url":"https://api.github.com/users/fantasai/following{/other_user}","gists_url":"https://api.github.com/users/fantasai/gists{/gist_id}","starred_url":"https://api.github.com/users/fantasai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fantasai/subscriptions","organizations_url":"https://api.github.com/users/fantasai/orgs","repos_url":"https://api.github.com/users/fantasai/repos","events_url":"https://api.github.com/users/fantasai/events{/privacy}","received_events_url":"https://api.github.com/users/fantasai/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-06-15T18:38:44Z","updated_at":"2017-06-15T18:38:44Z","body":"This is technically undefined, since we don't define between which elements one is supposed to break--just where one is allowed / discouraged / forbidden from breaking. I'd imagine it'd go in the earlier fragmentainer, since that's what typically happens in other fragmenting modes like inline line breaking and flex line breaking.","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/w3c/csswg-drafts/issues/comments/308831157/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/w3c/csswg-drafts/issues/comments/310645184","html_url":"https://github.com/w3c/csswg-drafts/issues/1529#issuecomment-310645184","issue_url":"https://api.github.com/repos/w3c/csswg-drafts/issues/1529","id":310645184,"node_id":"MDEyOklzc3VlQ29tbWVudDMxMDY0NTE4NA==","user":{"login":"SelenIT","id":282754,"node_id":"MDQ6VXNlcjI4Mjc1NA==","avatar_url":"https://avatars.githubusercontent.com/u/282754?v=4","gravatar_id":"","url":"https://api.github.com/users/SelenIT","html_url":"https://github.com/SelenIT","followers_url":"https://api.github.com/users/SelenIT/followers","following_url":"https://api.github.com/users/SelenIT/following{/other_user}","gists_url":"https://api.github.com/users/SelenIT/gists{/gist_id}","starred_url":"https://api.github.com/users/SelenIT/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SelenIT/subscriptions","organizations_url":"https://api.github.com/users/SelenIT/orgs","repos_url":"https://api.github.com/users/SelenIT/repos","events_url":"https://api.github.com/users/SelenIT/events{/privacy}","received_events_url":"https://api.github.com/users/SelenIT/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-06-23T11:46:51Z","updated_at":"2017-06-23T11:46:51Z","body":"I'd prefer it going in the earlier fragmentainer, too. I expect the new fragmentainer to be created only if the former one is overflowed, and adding a zero-sized item shouldn't cause overflowing if the fragmentainer wasn't overflowed without it.","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/w3c/csswg-drafts/issues/comments/310645184/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/w3c/csswg-drafts/issues/comments/318727237","html_url":"https://github.com/w3c/csswg-drafts/issues/1529#issuecomment-318727237","issue_url":"https://api.github.com/repos/w3c/csswg-drafts/issues/1529","id":318727237,"node_id":"MDEyOklzc3VlQ29tbWVudDMxODcyNzIzNw==","user":{"login":"tabatkins","id":682840,"node_id":"MDQ6VXNlcjY4Mjg0MA==","avatar_url":"https://avatars.githubusercontent.com/u/682840?v=4","gravatar_id":"","url":"https://api.github.com/users/tabatkins","html_url":"https://github.com/tabatkins","followers_url":"https://api.github.com/users/tabatkins/followers","following_url":"https://api.github.com/users/tabatkins/following{/other_user}","gists_url":"https://api.github.com/users/tabatkins/gists{/gist_id}","starred_url":"https://api.github.com/users/tabatkins/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tabatkins/subscriptions","organizations_url":"https://api.github.com/users/tabatkins/orgs","repos_url":"https://api.github.com/users/tabatkins/repos","events_url":"https://api.github.com/users/tabatkins/events{/privacy}","received_events_url":"https://api.github.com/users/tabatkins/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2017-07-28T18:20:28Z","updated_at":"2017-07-28T18:20:28Z","body":"Yes, everywhere else we do *explicitly* define breaking, we mandate that zero-size things at a boundary live on the previous line, not the next. (See flexbox, for example.)\r\n\r\nMaking this clearer in Fragmentation would be good.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/w3c/csswg-drafts/issues/comments/318727237/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/w3c/csswg-drafts/issues/comments/414400328","html_url":"https://github.com/w3c/csswg-drafts/issues/1529#issuecomment-414400328","issue_url":"https://api.github.com/repos/w3c/csswg-drafts/issues/1529","id":414400328,"node_id":"MDEyOklzc3VlQ29tbWVudDQxNDQwMDMyOA==","user":{"login":"fantasai","id":725717,"node_id":"MDQ6VXNlcjcyNTcxNw==","avatar_url":"https://avatars.githubusercontent.com/u/725717?v=4","gravatar_id":"","url":"https://api.github.com/users/fantasai","html_url":"https://github.com/fantasai","followers_url":"https://api.github.com/users/fantasai/followers","following_url":"https://api.github.com/users/fantasai/following{/other_user}","gists_url":"https://api.github.com/users/fantasai/gists{/gist_id}","starred_url":"https://api.github.com/users/fantasai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fantasai/subscriptions","organizations_url":"https://api.github.com/users/fantasai/orgs","repos_url":"https://api.github.com/users/fantasai/repos","events_url":"https://api.github.com/users/fantasai/events{/privacy}","received_events_url":"https://api.github.com/users/fantasai/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-08-20T17:35:44Z","updated_at":"2018-08-20T17:35:44Z","body":"Agenda+ to ask the WG about mandating, specifically for zero-sized elements, that they stay with the earlier fragmentainer is a good idea.","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/w3c/csswg-drafts/issues/comments/414400328/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/w3c/csswg-drafts/issues/comments/415098496","html_url":"https://github.com/w3c/csswg-drafts/issues/1529#issuecomment-415098496","issue_url":"https://api.github.com/repos/w3c/csswg-drafts/issues/1529","id":415098496,"node_id":"MDEyOklzc3VlQ29tbWVudDQxNTA5ODQ5Ng==","user":{"login":"css-meeting-bot","id":27466577,"node_id":"MDQ6VXNlcjI3NDY2NTc3","avatar_url":"https://avatars.githubusercontent.com/u/27466577?v=4","gravatar_id":"","url":"https://api.github.com/users/css-meeting-bot","html_url":"https://github.com/css-meeting-bot","followers_url":"https://api.github.com/users/css-meeting-bot/followers","following_url":"https://api.github.com/users/css-meeting-bot/following{/other_user}","gists_url":"https://api.github.com/users/css-meeting-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/css-meeting-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/css-meeting-bot/subscriptions","organizations_url":"https://api.github.com/users/css-meeting-bot/orgs","repos_url":"https://api.github.com/users/css-meeting-bot/repos","events_url":"https://api.github.com/users/css-meeting-bot/events{/privacy}","received_events_url":"https://api.github.com/users/css-meeting-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-08-22T16:42:14Z","updated_at":"2018-08-22T16:42:14Z","body":"The Working Group just discussed `Empty fragment at fragmentainer boundary`, and agreed to the following:\n\n* `RESOLVED: Specify 0 size elements are positioned as early as possible in the fragmentation flow`\n\n<details><summary>The full IRC log of that discussion</summary>\n&lt;dael> Topic: Empty fragment at fragmentainer boundary<br>\n&lt;dael> github: https://github.com/w3c/csswg-drafts/issues/1529<br>\n&lt;dael> fantasai: About an empty fragment at a fragmentainer boundry.  If you have a 0 height block or 0 width inline etc and the previous item that fi there filled the whole line does the 0 size element stay on the page?<br>\n&lt;dael> fantasai: Specs don't say anything now about where required to break so UA can be intellengent.<br>\n&lt;dael> fantasai: For 0 size might make sense to spec explicitly<br>\n&lt;dael> fantasai: Question is do we want to spec that for fragmentation in general or just for flexbox?<br>\n&lt;dael> fantasai: flexbox is only place w e define that percisely right now.<br>\n&lt;dael> Rossen: I believe we discussedin the past. Don't remember if resolved.<br>\n&lt;fantasai> because flexbox requires consistency more than quality-of-implementation, so its breaking rules are defined<br>\n&lt;dael> Rossen: As far as I recall reason is the empty elements are exausted opportunitically as much as possible. If there are empty boxes at the end of fragment we assume they fit. Done so you can reduce subsequent fragments.<br>\n&lt;dael> Rossen: That makes sense<br>\n&lt;dael> Rossen: Other side is such elements or boxes are used for positioning or to create containing blocks or abspos items that go in and out for UI<br>\n&lt;dael> Rossen: For those cases harder to argue it's better that such items are consumed asap or pushed. Again, counter is there are avoid break-inside  and break-after properties where you can use such and control correctly<br>\n&lt;dael> Rossen: In both cases makes snese to position and consume empty boxes a s early aspossible on frag where they are encountered rather then pushing<br>\n&lt;dael> Rossen: That's how I remember previous<br>\n&lt;dael> Rossen: Curious if there are other arguments or if we can resolve on that and spec it so we don't forget again<br>\n&lt;bradk> +1<br>\n&lt;dael> Rossen: Obj to Spec 0 size elements are positioned as early as possible in the fragmentation flow?<br>\n&lt;dael> RESOLVED: Specify 0 size elements are positioned as early as possible in the fragmentation flow<br>\n</details>\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/w3c/csswg-drafts/issues/comments/415098496/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/w3c/csswg-drafts/issues/comments/415592931","html_url":"https://github.com/w3c/csswg-drafts/issues/1529#issuecomment-415592931","issue_url":"https://api.github.com/repos/w3c/csswg-drafts/issues/1529","id":415592931,"node_id":"MDEyOklzc3VlQ29tbWVudDQxNTU5MjkzMQ==","user":{"login":"fantasai","id":725717,"node_id":"MDQ6VXNlcjcyNTcxNw==","avatar_url":"https://avatars.githubusercontent.com/u/725717?v=4","gravatar_id":"","url":"https://api.github.com/users/fantasai","html_url":"https://github.com/fantasai","followers_url":"https://api.github.com/users/fantasai/followers","following_url":"https://api.github.com/users/fantasai/following{/other_user}","gists_url":"https://api.github.com/users/fantasai/gists{/gist_id}","starred_url":"https://api.github.com/users/fantasai/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/fantasai/subscriptions","organizations_url":"https://api.github.com/users/fantasai/orgs","repos_url":"https://api.github.com/users/fantasai/repos","events_url":"https://api.github.com/users/fantasai/events{/privacy}","received_events_url":"https://api.github.com/users/fantasai/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-08-23T22:36:44Z","updated_at":"2018-08-23T22:37:24Z","body":"OK, added the following:\r\n\r\n> Additionally, CSS imposes one requirement: a zero-sized box fragment, since it does not take up space, must appear on the earlier side of a fragmentation break if it is able to fit within the fragmentainer.\r\n>\r\n> Note: A zero-sized box fragment can be pushed to the next fragmentainer if it is placed immediately after content that itself overflows the fragmentainer.\r\n\r\nAgenda+ to check on the subtleties of a zero-sized fragment that's placed after an overflowing piece of content. :/ CC @mstensho ","author_association":"COLLABORATOR","pin":null,"reactions":{"url":"https://api.github.com/repos/w3c/csswg-drafts/issues/comments/415592931/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/w3c/csswg-drafts/issues/comments/415594789","html_url":"https://github.com/w3c/csswg-drafts/issues/1529#issuecomment-415594789","issue_url":"https://api.github.com/repos/w3c/csswg-drafts/issues/1529","id":415594789,"node_id":"MDEyOklzc3VlQ29tbWVudDQxNTU5NDc4OQ==","user":{"login":"tabatkins","id":682840,"node_id":"MDQ6VXNlcjY4Mjg0MA==","avatar_url":"https://avatars.githubusercontent.com/u/682840?v=4","gravatar_id":"","url":"https://api.github.com/users/tabatkins","html_url":"https://github.com/tabatkins","followers_url":"https://api.github.com/users/tabatkins/followers","following_url":"https://api.github.com/users/tabatkins/following{/other_user}","gists_url":"https://api.github.com/users/tabatkins/gists{/gist_id}","starred_url":"https://api.github.com/users/tabatkins/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/tabatkins/subscriptions","organizations_url":"https://api.github.com/users/tabatkins/orgs","repos_url":"https://api.github.com/users/tabatkins/repos","events_url":"https://api.github.com/users/tabatkins/events{/privacy}","received_events_url":"https://api.github.com/users/tabatkins/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-08-23T22:45:44Z","updated_at":"2018-08-23T22:45:44Z","body":"The most reasonable answer seems clear, and is already reflected [in Flexbox](https://drafts.csswg.org/css-flexbox/#algo-line-break): they go to the next fragmentainer.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/w3c/csswg-drafts/issues/comments/415594789/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/w3c/csswg-drafts/issues/comments/417015453","html_url":"https://github.com/w3c/csswg-drafts/issues/1529#issuecomment-417015453","issue_url":"https://api.github.com/repos/w3c/csswg-drafts/issues/1529","id":417015453,"node_id":"MDEyOklzc3VlQ29tbWVudDQxNzAxNTQ1Mw==","user":{"login":"css-meeting-bot","id":27466577,"node_id":"MDQ6VXNlcjI3NDY2NTc3","avatar_url":"https://avatars.githubusercontent.com/u/27466577?v=4","gravatar_id":"","url":"https://api.github.com/users/css-meeting-bot","html_url":"https://github.com/css-meeting-bot","followers_url":"https://api.github.com/users/css-meeting-bot/followers","following_url":"https://api.github.com/users/css-meeting-bot/following{/other_user}","gists_url":"https://api.github.com/users/css-meeting-bot/gists{/gist_id}","starred_url":"https://api.github.com/users/css-meeting-bot/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/css-meeting-bot/subscriptions","organizations_url":"https://api.github.com/users/css-meeting-bot/orgs","repos_url":"https://api.github.com/users/css-meeting-bot/repos","events_url":"https://api.github.com/users/css-meeting-bot/events{/privacy}","received_events_url":"https://api.github.com/users/css-meeting-bot/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-08-29T16:24:33Z","updated_at":"2018-08-29T16:24:33Z","body":"The CSS Working Group just discussed `Empty fragment at fragmentainer boundary`, and agreed to the following:\n\n* `RESOLVED: have 0 sized fragments pushed to next fragmentainer if content before has overflows its fragmentainer`\n\n<details><summary>The full IRC log of that discussion</summary>\n&lt;dael> Topic: Empty fragment at fragmentainer boundary<br>\n&lt;fantasai> issue about including padding in scrollable overflow area -- 12 upvootes, more than pretty much any other issue I've seen, + 18 on a comment further down the line supporting it https://github.com/w3c/csswg-drafts/issues/129<br>\n&lt;dael> github: https://github.com/w3c/csswg-drafts/issues/1529#issuecomment-415592931<br>\n&lt;dael> fantasai: I added text to spec but realized we saida  0 size fragment stays with previous page. Doesn't seem to becase if whatever came before overflows fragmentaner.<br>\n&lt;dael> fantasai: If I've got an unbreakable box that overflows and a 0 height after it moves to the next column.<br>\n&lt;dael> fantasai: Wanted to check that's what we want.<br>\n&lt;dael> fantasai: If anyone wants to look more<br>\n&lt;dael> astearns: Makes sense to me. In your note say can be pushed. Perhaps must be pushed?<br>\n&lt;dael> fantasai: Makes sense. Change from can to will<br>\n&lt;dael> astearns: Okaya<br>\n&lt;dael> ??: Should it still be pushed if not content after 0 height thing?<br>\n&lt;dbaron> s/??/bradkemper/<br>\n&lt;dael> fantasai: Yeah<br>\n&lt;dael> bradk: Create a new column with nothing in it<br>\n&lt;dael> fantasai: Might have something in it<br>\n&lt;dael> bradk: That's useful thing?<br>\n&lt;dael> fantasai: is what happens currently. If something is visible generally don't want it below fragmentainer height<br>\n&lt;dael> bradk: Alright, you've convinced me<br>\n&lt;Rossen_> Are we still preserving the model of minimizing the number of empty boxes due to 0 size fragments<br>\n&lt;dael> astearns: Other concerns?<br>\n&lt;dael> astearns: Rossen_ on IRC asks [reads]<br>\n&lt;dael> astearns: I think that's restating bradk concern...<br>\n&lt;dael> fantasai: We're not. Making sure no element starts below end of fragmentaner. Which is good because sometimes can't see below end of fragmentainer it gets clipped<br>\n&lt;astearns> Rossen_: OK with that?<br>\n&lt;fantasai> s/:/,/<br>\n&lt;dael> [waiting for Rossen_ to answer in IRC]<br>\n&lt;Rossen_> OK, that's fine. My question was - once an element is to be positined (margins are consumed) and is 0 size - it gets placed on the current fragment right?<br>\n&lt;fantasai> see also Tab's note about how this is how Flexbox works already<br>\n&lt;fantasai> If we haven't already overflowed the current fragmentainer, yes<br>\n&lt;fantasai> If we've already overflowed, no, it moves to the next one<br>\n&lt;Rossen_> OK, that makes more sence, thanks<br>\n&lt;dael> astearns: Any other questions or concerns?<br>\n&lt;dael> astearns: Objections to have 0 sized fragments pushed to next fragmentainer if content before has overflows its fragmentainer?<br>\n&lt;dael> RESOLVED: have 0 sized fragments pushed to next fragmentainer if content before has overflows its fragmentainer<br>\n</details>\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/w3c/csswg-drafts/issues/comments/417015453/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]