+pub(crate) enum SubstitutionDemand {
+    Provider(Name),
+    Attribute {
+        name: Name,
+        data: AttributeData,
+        url_data: UrlExtraData,
+    },
+    Prioritary(PrioritaryPropertyId),
+    InitialContext(Name),
+}
+
+pub(crate) enum SubstitutionError {
+    Invalid,
+    Demand(SubstitutionDemand),
+}
+
+impl From<()> for SubstitutionError {
+    fn from(_: ()) -> Self {
+        Self::Invalid
+    }
+}
