+pub(crate) fn prepare_provider<'registration>(
+    name: &Name,
+    namespace: Option<&Namespace>,
+    value: &Arc<VariableValue>,
+    stylist: &'registration Stylist,
+    context: &computed::Context,
+    attribute_tracker: &AttributeTracker,
+    readiness: &dyn SubstitutionReadiness,
+) -> Result<PreparedProvider<'registration>, SubstitutionDemand> {
+    let is_var = namespace.is_none();
+    let registration = stylist.get_custom_property_registration(name);
+    let mut attributes = AttributeTracker {
+        context: attribute_tracker.context,
+        references: attribute_tracker.references.clone(),
+    };
+    let mut state = SubstitutionState::default();
+    if is_var {
+        state.names.push(name);
+    }
+    let substitution = substitute_internal(
+        value,
+        Some(PropertyIdRef::from(name)),
+        &context.builder.substitution_functions,
+        stylist,
+        context,
+        &mut attributes,
+        &mut state,
+        Some(readiness),
+        None,
+    );
+    let poisoned = is_var && state.cyclic_names.contains(&name);
+    drop(state);
+    let substitution = match substitution {
+        Err(SubstitutionError::Demand(demand)) => return Err(demand),
+        _ if poisoned => return Err(SubstitutionDemand::Provider(name.clone())),
+        Ok(value) => Some(value),
+        Err(SubstitutionError::Invalid) => None,
+    };
+    let default = |reason| {
+        prepare_registered_default(
+            name,
+            reason,
+            ProviderCycleClassification::Acyclic,
+            registration,
+            stylist,
+            context,
+        )
+        .map(PreparedProviderInput::Default)
+    };
+    let input = match substitution {
+        None if is_var => default(RegisteredDefaultReason::Invalid)?,
+        None => PreparedProviderInput::Resolved(None),
+        Some(substitution) => {
+            let keyword = if is_var {
+                Parser::new(&substitution.css)
+                    .try_parse(CSSWideKeyword::parse)
+                    .ok()
+            } else {
+                None
+            };
+            if let Some(keyword) = keyword {
+                default(RegisteredDefaultReason::CssWide(keyword))?
+            } else if is_var && !registration.is_universal() {
+                let taint = if substitution.attr_tainted {
+                    AttrTaint::new_fully_tainted(substitution.css.len())
+                } else {
+                    AttrTaint::default()
+                };
+                match parse_registered_value(
+                    name,
+                    &substitution.css,
+                    &value.url_data,
+                    registration,
+                    taint,
+                ) {
+                    Some(value) => PreparedProviderInput::Typed(value, substitution.attr_tainted),
+                    None => default(RegisteredDefaultReason::Invalid)?,
+                }
+            } else {
+                let mut computed =
+                    ComputedRegisteredValue::universal(Arc::new(VariableValue::new_resolved(
+                        substitution.css.into_owned(),
+                        &value.url_data,
+                        substitution.first_token_type,
+                        substitution.last_token_type,
+                    )));
+                computed.attr_tainted |= substitution.attr_tainted;
+                PreparedProviderInput::Resolved(Some(computed))
+            }
+        },
+    };
+    Ok(PreparedProvider {
+        name: name.clone(),
+        namespace: namespace.cloned(),
+        registration,
+        input,
+        attributes: attributes.references,
+    })
+}
