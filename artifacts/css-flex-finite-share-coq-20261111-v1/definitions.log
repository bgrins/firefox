Generic_fmt.round_generic =
fun (beta : Zaux.radix) (fexp : Z -> Z) (rnd : R -> Z)
  (valid_rnd : Generic_fmt.Valid_rnd rnd) (x : R)
  (Hx : Generic_fmt.generic_format beta fexp x) =>
eq_ind_r
  (fun r : R =>
   Defs.F2R
     {| Defs.Fnum := rnd r; Defs.Fexp := Generic_fmt.cexp beta fexp x |} = x)
  (eq_ind_r
     (fun z : Z =>
      Defs.F2R
        {| Defs.Fnum := z; Defs.Fexp := Generic_fmt.cexp beta fexp x |} = x)
     (eq_sym Hx)
     (Generic_fmt.Zrnd_IZR rnd
        (Raux.Ztrunc (Generic_fmt.scaled_mantissa beta fexp x))))
  (Generic_fmt.scaled_mantissa_generic beta fexp x Hx)
:
Generic_fmt.round beta fexp rnd x = x
     : forall (beta : Zaux.radix) (fexp : Z -> Z) (rnd : R -> Z),
       Generic_fmt.Valid_rnd rnd ->
       forall x : R,
       Generic_fmt.generic_format beta fexp x ->
       Generic_fmt.round beta fexp rnd x = x

Arguments Generic_fmt.round_generic beta (fexp rnd)%function_scope
  {valid_rnd} x%R_scope _


