+def derive_baseline(rows, endings, targets, complete, published_cases):
+    keyed = [row for row in rows if isinstance(row.get('test'), str) and isinstance(row.get('subtest'), str)]
+    keys = [(row['test'], row['subtest']) for row in keyed]
