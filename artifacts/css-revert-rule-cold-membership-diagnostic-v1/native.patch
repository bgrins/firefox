 type NonCustomPropertyReferences = NonCustomReferenceMap<Vec<(LonghandId, Arc<UnparsedValue>)>>;
 
+enum DeclarationSources<'a> {
+    Rules(&'a StrongRuleNode, &'a StylesheetGuards<'a>),
+    Block(&'a PropertyDeclarationBlock),
+}
+
+fn block_contains(block: &PropertyDeclarationBlock, declaration: &PropertyDeclaration) -> bool {
+    block
+        .declarations()
+        .iter()
+        .any(|entry| std::ptr::eq(entry, declaration))
+}
+
+impl<'a> DeclarationSources<'a> {
+    #[cold]
+    fn containing_block(&self, declaration: &PropertyDeclaration) -> &'a PropertyDeclarationBlock {
+        match *self {
+            Self::Block(block) => {
+                assert!(block_contains(block, declaration));
+                block
+            },
+            Self::Rules(rules, guards) => {
+                let mut node = Some(rules);
+                while let Some(current) = node {
+                    if let Some(source) = current.style_source() {
+                        let guard = current
+                            .cascade_priority()
+                            .cascade_level()
+                            .origin()
+                            .guard(guards);
+                        let block = source.read(guard);
+                        if block_contains(block, declaration) {
+                            return block;
+                        }
+                    }
+                    node = current.parent();
+                }
+                unreachable!("Declaration must belong to an applicable block")
+            },
+        }
+    }
+}
+
+struct RuleExclusion<'a> {
+    property: LonghandId,
+    priority: CascadePriority,
+    block: &'a PropertyDeclarationBlock,
+}
