+def whitespaceExpr {Γ : List Ty} : Expr (.scalar :: Γ) .bool :=
+  (.or (.or (.eqChar (.var .here) (.scalar (Char.ofNat 10))) (.eqChar (.var .here) (.scalar (Char.ofNat 9)))) (.eqChar (.var .here) (.scalar (Char.ofNat 32))))
