 #[unsafe(no_mangle)]
+pub extern "C" fn Servo_KeyframeEndpoint_ResolveIsolatedForTesting(
+    endpoint: &style::keyframe_endpoint::KeyframeEndpoint,
+    element: &RawGeckoElement,
+    pseudo_type: PseudoStyleType,
+    providers: &ComputedValues,
+    raw_data: &PerDocumentStyleData,
+    pending_name: &nsACString,
+    pending_font_size: bool,
+    demanded_name: &mut nsACString,
+    status: &mut style::keyframe_endpoint::EndpointDemandStatus,
+    references_attributes: &mut bool,
+    parent_unchanged: &mut bool,
+    owned_struct_isolated: &mut bool,
+    vacated_rejected: &mut bool,
+) -> Strong<AnimationValue> {
+    use style::keyframe_endpoint::{EndpointDemand, EndpointDemandStatus};
+    *references_attributes = false;
+    *parent_unchanged = false;
+    *owned_struct_isolated = false;
+    *vacated_rejected = false;
+    let mut pending = std::collections::HashSet::new();
+    let Ok(pending_text) = std::str::from_utf8(pending_name) else {
+        *status = EndpointDemandStatus::Unsupported;
+        return Strong::null();
+    };
+    if !pending_text.is_empty() {
+        let Ok(name) = style::custom_properties::parse_name(pending_text) else {
+            *status = EndpointDemandStatus::Unsupported;
+            return Strong::null();
+        };
+        pending.insert(Atom::from(name));
+    }
+    demanded_name.assign("");
+    let mut pending_prioritary = style::properties::PrioritaryPropertyIdSet::default();
+    if pending_font_size {
+        pending_prioritary.insert(style::properties::PrioritaryPropertyId::FontSize);
+    }
+
+    let data = raw_data.borrow();
+    let element = GeckoElement(element);
+    let pseudo = PseudoElement::from_pseudo_type(pseudo_type, None);
+    let parent_element = if pseudo.is_none() {
+        element.inheritance_parent()
+    } else {
+        Some(element)
+    };
+    let parent_data = parent_element.as_ref().and_then(|e| e.borrow_data());
+    let parent_style = parent_data.as_ref().map(|d| &**d.styles.primary());
+    let container_size_query =
+        ContainerSizeQuery::for_element(element, parent_style, pseudo.is_some());
+    let mut conditions = Default::default();
+    let mut tree_counting_caches = TreeCountingCaches::default();
+    let mut context = create_context_for_animation(
+        &data,
+        providers,
+        parent_style,
+        false,
+        &mut conditions,
+        container_size_query,
+        &element,
+        &mut tree_counting_caches,
+    );
+    context.builder.substitution_functions =
+        style::custom_properties::ComputedSubstitutionFunctions::new(
+            Some(providers.custom_properties().clone()),
+            None,
+        );
+    context.builder.mutate_font();
+    let before_properties = context.builder.custom_properties().clone();
+    let before_flags = context.builder.flags();
+    let before_font_size = context
+        .builder
+        .get_font()
+        .slow_clone_font_size()
+        .computed_size;
+    let before_cache = format!("{:?}", context.rule_cache_conditions.borrow());
+    {
+        let mut local_conditions = Default::default();
+        let mut local_caches = TreeCountingCaches::default();
+        if let Some(attempt) = context.fork_for_keyframe(&mut local_conditions, &mut local_caches) {
+            *owned_struct_isolated =
+                !std::ptr::eq(attempt.builder.get_font(), context.builder.get_font());
+        }
+    }
+    let font = context.builder.take_font();
+    *vacated_rejected = matches!(
+        endpoint.resolve_from_cascade(&data.stylist, &context, &pending, &pending_prioritary),
+        Err(EndpointDemand::ContextPreparation)
+    );
+    context.builder.put_font(font);
+    let result =
+        endpoint.resolve_from_cascade(&data.stylist, &context, &pending, &pending_prioritary);
+    *parent_unchanged = before_properties == *context.builder.custom_properties()
+        && before_flags == context.builder.flags()
+        && before_font_size
+            == context
+                .builder
+                .get_font()
+                .slow_clone_font_size()
+                .computed_size
+        && before_cache == format!("{:?}", context.rule_cache_conditions.borrow())
+        && context.builder.substitution_functions.attributes.is_empty()
+        && context.builder.attribute_references.is_none();
+    match result {
+        Ok((value, effects)) => {
+            *references_attributes = effects.references_attributes();
+            *status = EndpointDemandStatus::Resolved;
+            Arc::new(value).into()
+        },
+        Err(error) => {
+            *status = match error {
+                EndpointDemand::Provider(name) => {
+                    demanded_name.assign(&name.to_string());
+                    EndpointDemandStatus::Provider
+                },
+                EndpointDemand::Prioritary(id) => {
+                    demanded_name.assign(id.to_longhand().name());
+                    EndpointDemandStatus::Prioritary
+                },
+                EndpointDemand::ContextPreparation => EndpointDemandStatus::ContextPreparation,
+                EndpointDemand::Unsupported(_) => EndpointDemandStatus::Unsupported,
+            };
+            Strong::null()
+        },
+    }
+}
