[
  {
    "name": "effect-anchors",
    "command": [
      "webspec-index",
      "anchors",
      "*effect*value*",
      "--spec",
      "WEB-ANIMATIONS-1",
      "-l",
      "50"
    ],
    "exit": 0
  },
  {
    "name": "effect-interface",
    "command": [
      "webspec-index",
      "query",
      "WEB-ANIMATIONS-1#the-animationeffect-interface",
      "--format",
      "markdown",
      "--links",
      "full"
    ],
    "exit": 0
  },
  {
    "name": "trace-transformed-overall",
    "command": [
      "webspec-index",
      "trace",
      "WEB-ANIMATIONS-1#transformed-progress",
      "WEB-ANIMATIONS-1#overall-progress",
      "--max-depth",
      "9",
      "-l",
      "40",
      "--format",
      "markdown"
    ],
    "exit": 0
  }
]
