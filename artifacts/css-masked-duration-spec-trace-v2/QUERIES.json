[
  {
    "name": "idl",
    "command": [
      "webspec-index",
      "idl",
      "Window.getComputedStyle()",
      "--format",
      "markdown"
    ],
    "exit": 1
  },
  {
    "name": "pending",
    "command": [
      "webspec-index",
      "query",
      "https://drafts.csswg.org/css-animations-2/#requirements-on-pending-style-changes",
      "--format",
      "markdown",
      "--links",
      "full"
    ],
    "exit": 1
  },
  {
    "name": "duration",
    "command": [
      "webspec-index",
      "query",
      "https://drafts.csswg.org/css-animations-2/#animation-duration",
      "--format",
      "markdown",
      "--links",
      "full"
    ],
    "exit": 1
  },
  {
    "name": "updates",
    "command": [
      "webspec-index",
      "query",
      "https://drafts.csswg.org/css-animations-2/#animations",
      "--format",
      "markdown",
      "--links",
      "full"
    ],
    "exit": 1
  },
  {
    "name": "liveness",
    "command": [
      "webspec-index",
      "query",
      "https://drafts.csswg.org/web-animations-1/#model-liveness",
      "--format",
      "markdown",
      "--links",
      "full"
    ],
    "exit": 1
  },
  {
    "name": "computed",
    "command": [
      "webspec-index",
      "query",
      "https://drafts.csswg.org/cssom/#dom-window-getcomputedstyle",
      "--format",
      "markdown",
      "--links",
      "full"
    ],
    "exit": 1
  }
]
