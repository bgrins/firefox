[
  {
    "name": "compute-properties",
    "command": [
      "webspec-index",
      "query",
      "https://drafts.csswg.org/web-animations-1/#computing-property-values",
      "--effects",
      "off",
      "--format",
      "markdown",
      "--links",
      "full"
    ],
    "exit": 0
  },
  {
    "name": "computed-section",
    "command": [
      "webspec-index",
      "query",
      "https://drafts.csswg.org/css-cascade-5/#computed",
      "--effects",
      "off",
      "--format",
      "markdown",
      "--links",
      "full"
    ],
    "exit": 0
  },
  {
    "name": "non-animatable",
    "command": [
      "webspec-index",
      "query",
      "https://drafts.csswg.org/web-animations-1/#not-animatable",
      "--effects",
      "off",
      "--format",
      "markdown",
      "--links",
      "full"
    ],
    "exit": 0
  },
  {
    "name": "duration-to-iteration-9",
    "command": [
      "webspec-index",
      "trace",
      "CSS-ANIMATIONS-2#animation-duration",
      "WEB-ANIMATIONS-1#iteration-duration",
      "--max-depth",
      "9",
      "-l",
      "10",
      "--format",
      "markdown"
    ],
    "exit": 0
  },
  {
    "name": "duration-to-iteration-12",
    "command": [
      "webspec-index",
      "trace",
      "CSS-ANIMATIONS-2#animation-duration",
      "WEB-ANIMATIONS-1#iteration-duration",
      "--max-depth",
      "12",
      "-l",
      "10",
      "--format",
      "markdown"
    ],
    "exit": 0
  }
]
