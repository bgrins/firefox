+    DocumentSchema [signature] .nat document (.ret (.nat 7)) := by
+  refine ⟨1, definitions, .mkObj [], useProgram, aliases,
+    .ret (.scope .nat (.nat 7)), ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
+  · exact (exact_keys_spec _ _ outer_keys_unique).mp (by cbv)
+  · cbv
