+def verify_entry(policy):
+    entry = policy['entry_authority']
+    assert entry['kind'] == 'verified-park'
+    for key in ('inputs', 'inputs_manifest', 'application_metadata', 'result', 'terminal'):
+        assert sha(ROOT / entry[key]) == policy['references'][entry[key]]
+    inputs = read(ROOT / entry['inputs'])
+    assert inputs['head'] == policy['head'] and inputs['controls'] == policy['controls']
+    assert inputs['accepted_fixes'] == 149 and inputs['tracked_fixes'] == 150
+    assert inputs['fresh_application_metadata']
+    assert read(ROOT / entry['application_metadata']) == policy['prepared_application_metadata']
+    assert policy['wpt']['harness_revision'] == inputs['head']
+    assert policy['wpt']['phase_revisions']['original'] == policy['prepared_application_metadata']['build_revision']
+    assert all(policy['references'][name] == pin for name, pin in inputs['configuration_pins'].items())
+    assert sha(ROOT / entry['result']) == inputs['park_result_sha256']
+    assert sha(ROOT / entry['terminal']) == inputs['park_terminal_sha256']
+    terminal = read(ROOT / entry['terminal'])
+    assert terminal == entry['terminal_record'] and terminal['exit'] == 0 and terminal['signer_called'] is False
+    assert terminal['result_sha256'] == inputs['park_result_sha256']
+    result = read(ROOT / entry['result'])
+    assert result['head'] == inputs['head'] and result['epoch_sha256'] == inputs['controls']['CURRENT-EPOCH.json']
+    assert result['released_staging'] and result['roadmap_preimage_restored'] and result['research_files_preserved']
+    assert result['signer_called'] is False and result['only_epoch_change'] == 'raw_index_observation.current'
+    assert result['accepted_fixes'] == 149 and result['tracked_fixes'] == 150
+    return inputs
+
+
