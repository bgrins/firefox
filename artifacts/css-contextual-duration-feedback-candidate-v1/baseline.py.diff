+    assert research['native_working_diff_preserved'] is True
+    assert type(research['accepted_fix_increment']) is int and research['accepted_fix_increment'] == 0
+    assert type(research['selected_paths']) is int and research['selected_paths'] > 0
+    assert research['parent'] == native['head'] and research['head'] == policy['head']
+    assert research['head'] != research['parent']
+    assert research['epoch_sha256'] == policy['controls']['CURRENT-EPOCH.json']
 
