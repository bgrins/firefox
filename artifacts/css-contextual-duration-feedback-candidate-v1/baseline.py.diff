+    assert (native['accepted_fix'], native['accepted_fixes'], native['tracked']) == (150,149,150)
+    assert set(research) == {'committed','head','parent','signature_verified','selected_paths','epoch_sha256','accepted_fix_increment','native_working_diff_preserved'}
