--- /dev/null
+++ b/dom/base/test/test_missing_pseudo_animation_recascade.html
@@ -0,0 +1,164 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Transient pseudo cascade with explicit origin maps</title>
+<script src="/tests/SimpleTest/SimpleTest.js"></script>
+<link rel="stylesheet" href="/tests/SimpleTest/test.css">
+<link rel="help" href="https://drafts.csswg.org/css-cascade-5/#cascade-origin">
+<style>
+  .subject { font-size: 20px; }
+  .subject::before { content: none; margin-left: 10px; opacity: 0.25; }
+  .subject::after { content: none; margin-left: 15px; }
+  .important::before { margin-left: 30px !important; }
+  .relative::before { margin-left: 2em; }
+  .logical { direction: rtl; }
+  .logical::before { margin: 0; margin-inline-start: 2em; }
+  .flex { display: flex; }
+  .contents { display: contents; }
+  .generated::before { content: "generated"; }
+</style>
+<script>
+"use strict";
+
+const utils = SpecialPowers.getDOMWindowUtils(window);
+
+async function fixture(body) {
+  const root = document.createElement("div");
+  const subject = document.createElement("div");
+  subject.className = "subject";
+  const animation = document.createElement("div");
+  animation.style.cssText = "margin-left:50px;opacity:0.5;font-size:30px;--gap:50px";
+  const transition = document.createElement("div");
+  transition.style.cssText = "margin-left:70px;opacity:0.8;font-size:40px";
+  root.append(subject, animation, transition);
+  document.body.append(root);
+  const query = (property, animationProperty = "", transitionProperty = "", pseudo = "::before", flags = 0) =>
+    JSON.parse(utils.getMissingPseudoRecascadeForTesting(subject, pseudo,
+      animation, animationProperty, transition, transitionProperty, property, flags));
+  try {
+    await body({ root, subject, animation, transition, query });
+  } finally {
+    root.remove();
+  }
+}
+
+function accepted(result, label) {
+  ok(result.admitted, `${label}: admitted`);
+  ok(result.pseudoMatches, `${label}: exact pseudo identity`);
+  ok(result.originUnchanged, `${label}: origin style not replaced`);
+  ok(result.noPseudoCreated, `${label}: no generated pseudo created`);
+}
+
+add_task(async function cascade_origins() {
+  await fixture(async ({ subject, animation, transition, query }) => {
+    is(getComputedStyle(subject, "::before").marginLeft, "10px", "Setup: authored pseudo base is 10px");
+    is(getComputedStyle(animation).marginLeft, "50px", "Setup: animation donor is 50px");
+    is(getComputedStyle(transition).marginLeft, "70px", "Setup: transition donor is 70px");
+    let result = query("margin-left");
+    accepted(result, "author");
+    is(result.value, "10px", "Normal author value without origin maps");
+    result = query("margin-left", "margin-left");
+    accepted(result, "animation");
+    is(result.value, "50px", "Animation origin beats normal author");
+    subject.classList.add("important");
+    result = query("margin-left", "margin-left");
+    accepted(result, "important");
+    is(result.value, "30px", "Important author beats animation origin");
+    result = query("margin-left", "", "margin-left");
+    accepted(result, "transition only");
+    is(result.value, "70px", "Transition origin beats important author");
+    result = query("margin-left", "margin-left", "margin-left");
+    accepted(result, "overlapping origins");
+    is(result.value, "70px", "Transition origin beats animation and important author");
+  });
+});
+
+add_task(async function disjoint_maps_and_no_publication() {
+  await fixture(async ({ subject, query }) => {
+    const before = getComputedStyle(subject, "::before").marginLeft;
+    let result = query("margin-left", "margin-left", "opacity");
+    accepted(result, "disjoint animation");
+    is(result.value, "50px", "Disjoint animation property survives transition map");
+    result = query("opacity", "margin-left", "opacity");
+    accepted(result, "disjoint transition");
+    is(result.value, "0.8", "Disjoint transition property survives animation map");
+    is(getComputedStyle(subject, "::before").marginLeft, before, "Transient cascade is not published to public style");
+    result = query("margin-left", "margin-left", "margin-left", "::before", 4);
+    accepted(result, "remove origin maps");
+    is(result.value, "10px", "Empty maps remove both origins from a previously recascaded rule path");
+    is(query("margin-left").value, "10px", "Later empty request has no stale origin values");
+  });
+});
+
+add_task(async function inheritance_and_authored_relative_values() {
+  await fixture(async ({ subject, query }) => {
+    subject.classList.add("relative");
+    is(getComputedStyle(subject).fontSize, "20px", "Setup: originating font is 20px");
+    let result = query("margin-left");
+    accepted(result, "origin inheritance");
+    is(result.value, "40px", "Pseudo inherits originating element font");
+    result = query("margin-left", "font-size");
+    accepted(result, "animated font provider");
+    is(result.value, "60px", "Authored em declaration uses cascaded font value");
+    subject.style.fontSize = "25px";
+    result = query("margin-left");
+    accepted(result, "changed origin inheritance");
+    is(result.value, "50px", "Fresh primary style supplies changed inheritance");
+    subject.classList.remove("relative");
+    subject.classList.add("logical");
+    result = query("margin-right", "font-size");
+    accepted(result, "logical authored value");
+    is(result.value, "60px", "RTL logical declaration maps using pseudo writing mode");
+    is(query("margin-left", "font-size").value, "0px", "RTL logical declaration does not overwrite opposite edge");
+  });
+});
+
+add_task(async function custom_property_provider() {
+  const style = document.createElement("style");
+  style.textContent = ".custom::before { margin-left: var(--gap, 12px); }";
+  document.head.append(style);
+  try {
+    await fixture(async ({ subject, animation, query }) => {
+      subject.classList.add("custom");
+      is(getComputedStyle(animation).getPropertyValue("--gap").trim(), "50px", "Setup: custom-property donor is 50px");
+      is(query("margin-left").value, "12px", "Absent custom provider uses authored fallback");
+      const result = query("margin-left", "--gap");
+      accepted(result, "custom provider");
+      is(result.value, "50px", "Authored var declaration uses origin custom-property map");
+    });
+  } finally {
+    style.remove();
+  }
+});
+
+add_task(async function pseudo_layout_parent() {
+  await fixture(async ({ root, subject, query }) => {
+    root.classList.add("flex");
+    let result = query("opacity", "opacity");
+    accepted(result, "ordinary origin layout parent");
+    ok(result.displayIsInline, "Pseudo inside a block origin is not a flex item");
+    subject.classList.add("contents");
+    result = query("opacity", "opacity");
+    accepted(result, "contents origin layout parent");
+    ok(result.displayIsBlock, "Pseudo of display contents origin is blockified as flex item");
+    is(result.value, "0.5", "Contents ancestry preserves animation-origin value");
+  });
+});
+
+add_task(async function supported_and_rejected_identity() {
+  await fixture(async ({ subject, query }) => {
+    let result = query("margin-left", "margin-left", "", "::after");
+    accepted(result, "after identity");
+    is(result.value, "50px", "After pseudo receives its own transient origin rule");
+    result = query("font-size", "font-size", "", "::marker");
+    accepted(result, "marker identity");
+    is(result.value, "30px", "Marker accepts a permitted font property");
+    ok(!query("margin-left", "margin-left", "", "").admitted, "Ordinary element request is rejected");
+    ok(!query("margin-left", "margin-left", "", "::before", 1).admitted, "Mismatched primary style is rejected");
+    ok(!query("margin-left", "margin-left", "", "::before", 2).admitted, "Mismatched base pseudo is rejected");
+    subject.classList.add("generated");
+    result = query("margin-left", "margin-left");
+    is(result.noPseudoCreated, false, "Setup: generated pseudo exists before rejection");
+    ok(!result.admitted, "Generated pseudo request is rejected");
+  });
+});
+</script>
