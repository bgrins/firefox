+  {"id": "css-wide: registered-provider inherit", "css": "--provider:inherit;--n:var(--provider)", "parent": "--n:11;--provider:11", "expected": {"--n": "11", "font-size": "11px"}},
+  {"id": "css-wide: registered-provider unset", "css": "--provider:unset;--n:var(--provider)", "parent": "--n:11;--provider:11", "expected": {"--n": "7", "font-size": "7px"}},
+  {"id": "css-wide: registered-provider inherit extra", "css": "--provider:inherit extra;--n:var(--provider)", "parent": "--n:11;--provider:11", "expected": {"--n": "7", "font-size": "7px"}},
+];
+
+function makeTarget(t, css, parentCSS = "", attributes = {}, fontSize = "calc(var(--n)*1px)") {
+  const parent = document.createElement("div");
+  parent.style.cssText = "font-size:19px;line-height:23px;" + parentCSS;
+  const target = document.createElement("div");
+  target.style.cssText = css + ";font-size:" + fontSize;
+  for (const [name, value] of Object.entries(attributes)) {
+    target.setAttribute(name, value);
+  }
+  parent.append(target);
+  document.body.append(parent);
+  t.add_cleanup(() => parent.remove());
+  return target;
+}
+
+function check(target, expected) {
+  const computed = getComputedStyle(target);
+  for (const [property, value] of Object.entries(expected)) {
+    assert_equals(computed.getPropertyValue(property).trim(), value, property);
+  }
+}
+
+for (const item of cases) {
+  test(t => {
+    const target = makeTarget(t, item.css, item.parent, item.attributes, item.fontSize);
+    check(target, item.expected);
+    if (item.mutation) {
+      for (const [property, value] of Object.entries(item.mutation.set)) {
+        target.style.setProperty(property, value);
+      }
+      check(target, item.mutation.expected);
+    }
+  }, item.id);
+}
+
+for (const order of ["provider-first", "consumer-first"]) {
+  for (const query of ["number-first", "font-first"]) {
+    test(t => {
+      const css = order === "provider-first"
+        ? "--ready:5;--n:var(--ready,1em)"
+        : "--n:var(--ready,1em);--ready:5";
+      const target = makeTarget(t, css);
+      const computed = getComputedStyle(target);
+      if (query === "number-first") {
+        assert_equals(computed.getPropertyValue("--n").trim(), "5");
+        assert_equals(computed.fontSize, "5px");
+      } else {
+        assert_equals(computed.fontSize, "5px");
+        assert_equals(computed.getPropertyValue("--n").trim(), "5");
+      }
+    }, `Provider order: ${order}, ${query}`);
+  }
+}
+
+for (const fallback of ["7", "1em"]) {
+  test(t => {
+    const target = makeTarget(t, `--n:var(--ready,${fallback})`);
+    const missing = fallback === "7" ? "7" : "3";
+    for (const [value, expected] of [[null, missing], ["5", "5"], ["red", "3"], [null, missing]]) {
+      if (value === null) {
+        target.style.removeProperty("--ready");
+      } else {
+        target.style.setProperty("--ready", value);
+      }
+      check(target, {"--n": expected, "font-size": expected + "px"});
+    }
+  }, `Provider mutation with ${fallback} fallback`);
+}
+
+test(t => {
+  const target = makeTarget(t, "--n:attr(data-value type(*),7)");
+  for (const [value, expected] of [[null, "7"], ["5", "5"], ["red", "3"], ["var(--n,9)", "3"], ["5", "5"], [null, "7"]]) {
+    if (value === null) {
+      target.removeAttribute("data-value");
+    } else {
+      target.setAttribute("data-value", value);
+    }
+    check(target, {"--n": expected, "font-size": expected + "px"});
+  }
+}, "Typed attribute mutation clears stale values and cycle state");
+
+for (const mode of ["direct", "selected-fallback", "registered-provider"]) {
+  test(t => {
+    const css = mode === "direct" ? "--n:inherit"
+      : mode === "selected-fallback" ? "--n:var(--missing,inherit)"
+      : "--provider:inherit;--n:var(--provider)";
+    const target = makeTarget(t, css);
+    for (const value of ["11", "13", "11"]) {
+      target.parentElement.style.setProperty("--n", value);
+      target.parentElement.style.setProperty("--provider", value);
+      check(target, {"--n": value, "font-size": value + "px"});
+    }
+  }, `CSS-wide inheritance follows parent mutation: ${mode}`);
+}
+
+function setRootMetrics(t) {
+  const root = document.documentElement;
+  const previous = root.getAttribute("style");
+  t.add_cleanup(() => {
+    if (previous === null) {
+      root.removeAttribute("style");
+    } else {
+      root.setAttribute("style", previous);
+    }
+  });
+  root.style.fontSize = "20px";
+  root.style.lineHeight = "40px";
+  return root;
+}
+
+
+
+test(t => {
+  const root = setRootMetrics(t);
+  const target = makeTarget(t, "--n:calc(1rem / 1px);width:calc(var(--n)*1px)", "", {}, "20px");
+  for (const value of [20, 25]) {
+    root.style.fontSize = value + "px";
+    check(target, {"--n": String(value), "font-size": "20px", "width": value + "px"});
+  }
+}, "Admitted number follows root font-size mutation on a non-root element");
+
+test(t => {
+  const root = setRootMetrics(t);
+  const target = makeTarget(t, "--n:calc(1rlh / 1px);width:calc(var(--n)*1px)", "", {}, "20px");
+  for (const value of [40, 50]) {
+    root.style.lineHeight = value + "px";
+    check(target, {"--n": String(value), "font-size": "20px", "width": value + "px"});
+  }
+}, "Admitted number follows root line-height mutation on a non-root element");
+
+
+
+test(t => {
+  const target = makeTarget(t, "--n:calc(100vw / 1px);width:calc(var(--n)*1px)", "", {}, "20px");
+  const reference = document.createElement("div");
+  reference.style.width = "100vw";
+  target.parentElement.append(reference);
+  const expected = parseFloat(getComputedStyle(reference).width);
+  const computed = getComputedStyle(target);
+  assert_greater_than(expected, 3, "independent viewport calibration exceeds the registered initial value");
+  assert_approx_equals(Number(computed.getPropertyValue("--n")), expected, 0.02, "viewport registered number");
+  assert_approx_equals(parseFloat(computed.width), expected, 0.02, "viewport number consumer");
+  assert_equals(computed.fontSize, "20px");
+}, "Admitted viewport number agrees with an independent ordinary length");
+
+test(t => {
