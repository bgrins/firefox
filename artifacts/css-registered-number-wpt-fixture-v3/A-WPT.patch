+<!doctype html>
+<meta charset="utf-8">
+<title>Registered numeric values discard rejected and unused dependencies</title>
+<link rel="help" href="https://drafts.css-houdini.org/css-properties-values-api-1/#calculation-of-computed-values">
+<link rel="help" href="https://drafts.csswg.org/css-values-5/#property-replacement">
+<link rel="help" href="https://drafts.csswg.org/css-variables-1/#replace-a-var-function">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<style>
+@property --n { syntax: "<number>"; inherits: false; initial-value: 3; }
+@property --provider { syntax: "<number>"; inherits: false; initial-value: 7; }
+</style>
+<body>
+<script>
