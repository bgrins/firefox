+  {"id": "probe: missing-em-fallback", "css": "--n:var(--missing,1em)", "parent": "", "expected": {"--n": "3", "font-size": "3px"}},
+  {"id": "probe: wrong-primary-unused-em", "css": "--wrong:red;--n:var(--wrong,1em)", "parent": "", "expected": {"--n": "3", "font-size": "3px"}},
+  {"id": "probe: direct-invalid-em", "css": "--n:1em", "parent": "", "expected": {"--n": "3", "font-size": "3px"}},
+  {"id": "probe: inherited-ready-unused-em", "css": "--n:var(--ready,1em)", "parent": "--ready:5", "expected": {"--n": "5", "font-size": "5px"}},
+  {"id": "probe: provider-contained-unused-em", "css": "--ready:5;--middle:var(--ready,1em);--n:var(--middle)", "parent": "", "expected": {"--n": "5", "font-size": "5px"}},
+  {"id": "normative: literal-number", "css": "--n:5", "expected": {"--n": "5", "font-size": "5px"}},
+  {"id": "normative: direct-invalid-length", "css": "--n:1em", "expected": {"--n": "3", "font-size": "3px"}},
+  {"id": "normative: valid-primary-unused-length", "css": "--ready:5;--n:var(--ready, 1em)", "expected": {"--n": "5", "font-size": "5px"}},
+  {"id": "normative: used-invalid-length-fallback", "css": "--n:var(--missing, 1em)", "expected": {"--n": "3", "font-size": "3px"}},
