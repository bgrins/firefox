+  {"id": "selected-typed-attribute-only-cycle", "css": "--n:attr(data-value type(*),7)", "attributes": {"data-value": "attr(data-value type(*))"}, "expected": {"--n": "7", "font-size": "7px"}},
+  {"id": "wrong-var-primary-does-not-retry-number-fallback", "css": "--ready:red;--n:var(--ready,7)", "attributes": {}, "expected": {"--n": "3", "font-size": "3px"}},
+  {"id": "wrong-typed-attribute-primary-does-not-retry-number-fallback", "css": "--n:attr(data-value type(*),7)", "attributes": {"data-value": "red"}, "expected": {"--n": "3", "font-size": "3px"}},
+  {"id": "typed-attribute-number-grammar-rejection-uses-fallback", "css": "--n:attr(data-value type(<number>),7)", "attributes": {"data-value": "red"}, "expected": {"--n": "7", "font-size": "7px"}},
+  {"id": "typed-attribute-ready-primary-excludes-length-fallback", "css": "--n:attr(data-value type(*),1em)", "attributes": {"data-value": "5"}, "expected": {"--n": "5", "font-size": "5px"}},
