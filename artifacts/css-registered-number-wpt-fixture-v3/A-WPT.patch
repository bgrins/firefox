+      const actual = {
+        value:computed.getPropertyValue(item.names.value).trim(),
+        number:item.names.number ? computed.getPropertyValue(item.names.number).trim() : null,
+        fontSize:computed.fontSize,
+        width:computed.width
+      };
+      for (const [property, expected] of Object.entries(step.expected)) {
+        assert_equals(actual[property], expected, step.label + ": " + property);
+      }
+    }
+  }, "Registered numeric breadth: " + item.id);
+}
+
+for (const [syntax, separator, suffix] of [["<number>+", " ", "space"], ["<number>#", ", ", "comma"]]) {
+  for (const mode of ["literal-members", "whole-list-rejection"]) {
+    test(t => {
+      const name = `--numeric-list-${suffix}-${mode}`;
+      CSS.registerProperty({name, syntax, inherits:false, initialValue:"3"});
+      const parent = document.createElement("div");
+      parent.style.cssText = "font-size:19px;line-height:23px;width:200px";
+      const target = document.createElement("div");
+      const value = "2" + separator + (mode === "literal-members" ? "5" : "1em");
+      target.style.cssText = `${name}:${value};font-size:20px`;
+      parent.append(target);
+      document.body.append(parent);
+      t.add_cleanup(() => parent.remove());
+      const computed = getComputedStyle(target);
+      const values = computed.getPropertyValue(name).trim().split(/\s*,\s*|\s+/).map(Number);
+      assert_array_equals(values, mode === "literal-members" ? [2, 5] : [3], "complete computed list");
+      assert_equals(computed.fontSize, "20px");
+    }, `Registered numeric list: ${syntax}, ${mode}`);
+  }
+}
+</script>
