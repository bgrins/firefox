+    container.style.width = value + "px";
+    assert_equals(getComputedStyle(reference).width, value + "px", "independent container calibration");
+    check(target, {"--n": String(value), "font-size": "20px", "width": value + "px"});
+  }
+}, "Admitted container number follows an independent container-size mutation");
