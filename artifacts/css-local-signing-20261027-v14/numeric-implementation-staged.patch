+impl Zero for Length {
+    fn zero() -> Self {
+        Self::new(NoCalcLength::zero())
+    }
+
+    fn is_zero(&self) -> bool {
+        // FIXME(emilio): Seems a bit weird to treat calc() unconditionally as
+        // non-zero here?
+        match self.0.unpack() {
+            Unpacked::Inline(_, value) => value == 0.0,
+            Unpacked::Boxed(_) => false,
+        }
+    }
+}
