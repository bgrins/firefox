+/// TODO(Bug 1866236) - Add the <flex> type.
+#[derive(Clone, Copy, PartialEq, Eq)]
+#[repr(u8)]
+pub enum CalcType {
+    /// <length>
+    Length,
+    /// <percentage>
+    Percentage,
+    /// <angle>
+    Angle,
+    /// <time>
+    Time,
+    /// <resolution>
+    Resolution,
+    /// <number>
+    Number,
+}
