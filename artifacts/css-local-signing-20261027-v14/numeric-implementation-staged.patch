+    }
+
+    /// Whether this is a viewport-percentage unit.
+    #[inline]
+    pub fn is_viewport_percentage(self) -> bool {
+        matches!(
+            self,
+            Self::Vw
+                | Self::Svw
+                | Self::Lvw
+                | Self::Dvw
