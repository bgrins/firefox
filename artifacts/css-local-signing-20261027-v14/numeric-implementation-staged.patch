+    /// Convenience parsing function for `<resolution>`.
+    pub fn parse_resolution(
+        context: &ParserContext,
+        input: &mut Parser,
+        function: MathFunction,
+        percentage_context: PercentageContext,
+    ) -> Result<CalcNumeric, ParseError> {
