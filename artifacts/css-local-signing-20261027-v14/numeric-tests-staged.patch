+class InspectableKeyframeEffect final : public KeyframeEffect {
+ public:
+  using KeyframeEffect::KeyframeEffect;
+  const nsTArray<Keyframe>& InputKeyframes() const { return mKeyframes; }
+
+ private:
+  ~InspectableKeyframeEffect() override = default;
+};
