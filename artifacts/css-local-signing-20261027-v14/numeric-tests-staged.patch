diff --git a/artifacts/css-registered-number-wpt-capsule-v1/capture/testing/web-platform/tests/css/css-properties-values-api/non-computed-unit-cycles.html b/artifacts/css-registered-number-wpt-capsule-v1/capture/testing/web-platform/tests/css/css-properties-values-api/non-computed-unit-cycles.html
