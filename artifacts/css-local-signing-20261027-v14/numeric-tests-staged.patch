+macro_rules! get_property_id_from_noncustomcsspropertyid {
+    ($property_id: ident, $ret: expr) => {{
+        match PropertyId::from_noncustomcsspropertyid($property_id) {
+            Some(property_id) => property_id,
+            None => {
+                return $ret;
+            },
+        }
+    }};
+}
