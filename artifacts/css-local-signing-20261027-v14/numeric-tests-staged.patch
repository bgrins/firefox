+macro_rules! get_property_id_from_csspropertyid {
+    ($property_id: ident, $ret: expr) => {{
+        match PropertyId::from_gecko_css_property_id($property_id) {
+            Some(property_id) => property_id,
+            None => {
+                return $ret;
+            },
+        }
+    }};
+}
