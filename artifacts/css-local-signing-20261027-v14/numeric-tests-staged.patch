+
+macro_rules! parse_enabled_property_name {
+    ($prop_name:ident, $found:ident, $default:expr) => {{
+        let prop_name = $prop_name.as_str_unchecked();
+        match PropertyId::parse_enabled_for_all_content(prop_name) {
+            Ok(p) => {
+                *$found = true;
+                p
+            },
+            Err(..) => {
+                *$found = false;
+                return $default;
+            },
+        }
+    }};
+}
