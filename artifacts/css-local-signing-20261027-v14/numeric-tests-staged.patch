+    test_invalid_attr('content', 'attr(data-foo string)', 'abc');
+    test_invalid_attr('animation-name', 'attr(data-foo type(string))', 'abc');
+    test_invalid_attr('animation-name', 'attr(data-foo type(< string>))', 'abc');
+    test_invalid_attr('animation-name', 'attr(data-foo type(<string >))', 'abc');
+
+    test_invalid_attr('animation-name', 'attr(data-foo type(<custom-ident>))', 'initial');
