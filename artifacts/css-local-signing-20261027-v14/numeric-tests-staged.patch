diff --git a/artifacts/css-registered-number-wpt-fixture-v1/candidate/testing/web-platform/tests/css/css-properties-values-api/registered-number-selected-dependencies.html b/artifacts/css-registered-number-wpt-fixture-v1/candidate/testing/web-platform/tests/css/css-properties-values-api/registered-number-selected-dependencies.html
