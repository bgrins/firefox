+  test_attr_no_cycle('--y', 'attr(data-foo type(*), 1px)', 'attr(data-bar type(*), 2px)', '1px');
+  attrElem.removeAttribute('data-bar');
+  attrElem.removeAttribute('data-baz');
+
+  /* Cycle with var() and fallback */
+  attrElem.style.setProperty('--x', 'var(--y)');
+  test_attr_cycle('--y', 'var(--x, 100)', 'var(--y)');
+  attrElem.style.setProperty('--x', null);
+
+  attrElem.setAttribute('data-bar', 'var(--y)');
+  attrElem.style.setProperty('--x', 'attr(data-foo)');
+  test_attr_cycle('--y', 'attr(data-foo type(*))', 'attr(data-bar type(*), 11) var(--x, 3)');
+  attrElem.style.setProperty('--x', null);
+  attrElem.removeAttribute('data-bar');
+
+  /* Cycle in unused fallbacks */
+  test_attr_no_cycle('--y', 'attr(data-foo type(*), var(--y))', '3', '3');
+  test_attr_no_cycle('--y', 'attr(data-foo type(*), attr(data-foo))', '3', '3');
+
+  attrElem.style.setProperty('--x', 'var(--y)');
+  test_attr_no_cycle('--y', 'attr(data-foo type(*), var(--x))', '3', '3');
+  attrElem.style.setProperty('--x', null);
+
+  attrElem.setAttribute('data-bar', 'attr(data-foo type(*))');
+  test_attr_no_cycle('--y', 'attr(data-foo type(*), attr(data-bar type(*)))', '3', '3');
+  attrElem.removeAttribute('data-bar');
+
+  /* Cycle in fallback */
+  test_attr_cycle('--y', 'attr(data-unknown type(*), var(--y))', '3');
+
+  /* No cycle, use raw CSS string without substitution */
+  attrElem.setAttribute('data-bar', 'var(--y)');
+  test_attr_no_cycle('--y', 'attr(data-foo type(<string>))', 'attr(data-bar type(<string>))', '');
+  attrElem.removeAttribute('data-bar');
+
+  attrElem.style.setProperty('--x', 'attr(data-foo)');
+  attrElem.setAttribute('data-bar', 'var(--x)');
+  test_attr_no_cycle('--y', 'attr(data-foo type(*))', 'attr(data-bar, 11) var(--x, 3)', '"var(--x)" "attr(data-bar, 11) var(--x, 3)"');
+  attrElem.removeAttribute('data-bar');
+  attrElem.style.setProperty('--x', null);
+
+  /* Same as above, but with the custom properties swapped, so that the property
+     using the raw (bare) attr() and the one using type() are resolved in the
+     opposite order. The result must not depend on resolution order. */
+  attrElem.style.setProperty('--y', 'attr(data-foo)');
+  attrElem.setAttribute('data-bar', 'var(--y)');
+  test_attr_no_cycle('--x', 'attr(data-foo type(*))', 'attr(data-bar, 11) var(--y, 3)', '"var(--y)" "attr(data-bar, 11) var(--y, 3)"');
+  attrElem.removeAttribute('data-bar');
+  attrElem.style.setProperty('--y', null);
+
+  /* EOF closes the nested raw attribute function. */
+  test_attr_no_cycle('--x', 'attr(data-foo type(*), abc)', 'attr(data-foo', '"attr(data-foo"');
+
+  /* Nested raw attribute reads do not create substitution cycles. */
+  attrElem.setAttribute('data-bar', 'attr(data-foo) attr(data-bar)');
+  test_attr_no_cycle('--x', 'attr(data-foo type(*), abc)', 'attr(data-bar type(*), fallback)', '"attr(data-bar type(*), fallback)" "attr(data-foo) attr(data-bar)"');
+  attrElem.removeAttribute('data-bar');
+
+  /* Transitive cycle through var() */
+  attrElem.setAttribute('data-bar', 'attr(data-foo, 10px)');
+  attrElem.style.setProperty('--x', 'attr(data-bar type(<length>))');
+  test_attr_cycle('width', 'attr(data-foo type(<length>))', 'var(--x)');
+  attrElem.style.setProperty('--x', null);
+  attrElem.removeAttribute('data-bar');
+
+  /* No cycle, --data-foo and data-foo are distinct identifiers */
+  attrElem.setAttribute('data-bar', '3');
+  test_attr_no_cycle('--data-foo', 'attr(data-foo type(*))', 'attr(data-bar number)', '3');
+  attrElem.setAttribute('data-bar', null);
+
+  /* Cycle in non-custom property */
+  CSS.registerProperty({
+    name: '--data-baz',
+    syntax: '<length>',
+    inherits: false,
+    initialValue: '4px',
+  });
+  attrElem.style.setProperty('--data-baz', '3em');
+  test_attr_cycle('font-size', 'attr(data-foo type(*))', 'var(--data-baz)');
+  test_attr_cycle('font-size', 'attr(unknown type(*), var(--data-baz))', '');
+  attrElem.style.setProperty('--data-baz', null);
+
+  /* No cycle in non-custom property */
+  attrElem.style.setProperty('--bar', '3em');
+  test_attr_no_cycle('font-size', 'attr(unknown, var(--bar))', '', '48px');
+  attrElem.style.setProperty('--bar', null);
+
+  attrElem.setAttribute('data-bar', '3');
+  test_attr_no_cycle('font-size', 'attr(data-foo type(*))', 'attr(data-bar em)', '48px');
+  attrElem.setAttribute('data-bar', null);
+
+  /* Cycle in unused fallback for non-custom property */
+  attrElem.style.setProperty('--data-baz', '3em');
+  test_attr_no_cycle('font-size', 'attr(data-foo type(<length>), var(--data-baz))', '5px', '5px');
+  attrElem.style.setProperty('--data-baz', null);
+</script>
diff --git a/artifacts/css-registered-number-wpt-capsule-v2/capture/testing/web-platform/tests/css/css-values/attr-fallback-preparation.html b/artifacts/css-registered-number-wpt-capsule-v2/capture/testing/web-platform/tests/css/css-values/attr-fallback-preparation.html
new file mode 100644
index 0000000000000000000000000000000000000000..72351e8845a6c90285032469f310aeba8eac1392
--- /dev/null
+++ b/artifacts/css-registered-number-wpt-capsule-v2/capture/testing/web-platform/tests/css/css-values/attr-fallback-preparation.html
@@ -0,0 +1,49 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Typed attributes in substitution fallbacks are prepared before use</title>
+<link rel="help" href="https://drafts.csswg.org/css-values-5/#attr-substitution">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<style id="sheet">
+@namespace a "urn:fallback-preload:a";
+#fixture { font-size: 16px; width: 100px; }
+</style>
+<div id="fixture"></div>
+<script>
+const cases = [
+  ["Direct typed attribute control", "width: attr(x type(<length>), 5px)", {"x": "13px"}, "width", "13px"],
+  ["Typed attribute in a missing attribute fallback", "width: attr(missing type(<length>), attr(x type(<length>), 5px))", {"x": "13px"}, "width", "13px"],
+  ["Typed attribute in a missing namespaced attribute fallback", "width: attr(a|missing type(<length>), attr(x type(<length>), 5px))", {"x": "13px"}, "width", "13px"],
+  ["Typed attribute in an unknown namespace fallback", "width: attr(unknown|missing type(<length>), attr(x type(<length>), 5px))", {"x": "13px"}, "width", "13px"],
+  ["Typed attribute in a type-invalid attribute fallback", "width: attr(bad type(<length>), attr(x type(<length>), 5px))", {"x": "13px", "bad": "not-a-length"}, "width", "13px"],
+  ["Typed attribute in two nested fallbacks", "width: attr(missing type(<length>), attr(other type(<length>), attr(x type(<length>), 5px)))", {"x": "13px"}, "width", "13px"],
+  ["Typed attribute in a variable fallback", "width: var(--absent, attr(x type(<length>), 5px))", {"x": "13px"}, "width", "13px"],
+  ["Typed attribute in an environment fallback", "width: env(preload-probe-absent-environment-variable, attr(x type(<length>), 5px))", {"x": "13px"}, "width", "13px"],
+  ["Typed attribute fallback used by font-size", "font-size: attr(missing type(<length>), attr(x type(<length>), 5px))", {"x": "13px"}, "font-size", "13px"],
+  ["Typed attribute in an untyped attribute fallback", "width: attr(missing, attr(x type(<length>), 5px))", {"x": "13px"}, "width", "13px"],
+  ["Custom property graph follows a missing primary fallback", "--result: attr(missing type(<length>), attr(x type(<length>), 5px)); width: var(--result)", {"x": "13px"}, "width", "13px"],
+  ["Numeric unit fallback does not require typed preparation", "width: attr(missing type(<length>), attr(n px, 5px))", {"n": "13"}, "width", "13px"],
+  ["Unused cyclic attribute fallback leaves the primary valid", "width: attr(x type(<length>), attr(cycle type(<length>), 7px))", {"x": "13px", "cycle": "attr(cycle type(<length>))"}, "width", "13px"],
+  ["Unused custom property cycle leaves the primary valid", "--result: attr(x type(<length>), var(--result)); width: var(--result, 5px)", {"x": "13px"}, "width", "13px"],
+  ["Used custom property cycle selects the consumer fallback", "--result: attr(missing type(<length>), var(--result)); width: var(--result, 5px)", {}, "width", "5px"],
+  ["Typed fallback attribute resolves its variable before ordinary-property substitution", "--v: 13px; width: attr(bad type(<length>), attr(chain type(<length>), 5px))", {"bad": "not-a-length", "chain": "var(--v)"}, "width", "13px"]
+];
+for (const [index, [name, declarations, attributes, property, expected]] of cases.entries()) {
+  test(t => {
+    const target = document.createElement("div");
+    target.id = `target-${index}`;
+    for (const [name, value] of Object.entries(attributes)) {
+      target.setAttribute(name, value);
+    }
+    const sheet = document.getElementById("sheet").sheet;
+    const ruleIndex = sheet.insertRule(`#${target.id} { ${declarations} }`, sheet.cssRules.length);
+    document.getElementById("fixture").append(target);
+    t.add_cleanup(() => {
+      target.remove();
+      sheet.deleteRule(ruleIndex);
+    });
+    assert_not_equals(sheet.cssRules[ruleIndex].style.getPropertyValue(property), "", "Declaration parsed");
+    assert_equals(getComputedStyle(target).getPropertyValue(property), expected);
+  }, name);
+}
+</script>
