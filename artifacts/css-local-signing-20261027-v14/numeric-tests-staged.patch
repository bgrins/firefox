+ def require_compiled_transition(epoch, role):
+-    transition = epoch.get("raw_attribute_transition")
+-    if role == "original" and transition is None:
+-        prior = epoch.get("attribute_fallback_transition")
+-        need(isinstance(prior, dict) and prior.get("role") == "candidate" and
+-             prior.get("compiled") is True and prior.get("accepted") is True,
+-             "initial original requires accepted compiled used-fallback candidate")
+-    else:
+-        need(isinstance(transition, dict) and transition.get("role") == role and
+-             transition.get("compiled") is True,
+-             "phase requires matching successful raw-attribute native compilation")
++    transition = epoch.get("registered_number_transition")
++    need(isinstance(transition, dict) and transition.get("role") == role and
++         transition.get("variant") == "committed-head" and transition.get("compiled") is True,
++         "phase requires matching successful committed-head registered-number compilation")
+ 
+ 
