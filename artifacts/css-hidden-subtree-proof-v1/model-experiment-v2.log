Tree.rec.{u} {motive_1 : Tree → Sort u} {motive_2 : List Tree → Sort u}
  (node : (dirty table : Bool) → (children : List Tree) → motive_2 children → motive_1 (Tree.node dirty table children))
  (nil : motive_2 [])
  (cons : (head : Tree) → (tail : List Tree) → motive_1 head → motive_2 tail → motive_2 (head :: tail)) (t : Tree) :
  motive_1 t
