+<!doctype html>
+<meta charset="utf-8">
+<title>SVG length-list animation between inches and quarter millimeters</title>
+<link rel="help" href="https://svgwg.org/specs/animations/#CalcModeAttribute">
+<link rel="help" href="https://drafts.csswg.org/css-values-4/#absolute-lengths">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<body>
+<script>
+const namespace = "http://www.w3.org/2000/svg";
+function element(name, attributes) {
+  const node = document.createElementNS(namespace, name);
+  for (const [key, value] of Object.entries(attributes)) {
+    node.setAttribute(key, value);
+  }
+  return node;
+}
+function animatedText(svg, from, to) {
+  const text = element("text", {x: "0", y: "20"});
+  text.textContent = "x";
+  text.append(element("animate", {
+    attributeName: "x", from, to, begin: "0s", dur: "4s",
+    calcMode: "linear", additive: "replace", fill: "freeze"
+  }));
+  svg.append(text);
+  return text;
+}
+function value(text) {
+  assert_equals(text.x.animVal.numberOfItems, 1, "one animated list item");
+  return text.x.animVal.getItem(0).value;
+}
+async function seek(svg, time) {
+  svg.setCurrentTime(time);
+  await new Promise(requestAnimationFrame);
+  assert_approx_equals(svg.getCurrentTime(), time, 0.0001, "paused sample time");
+}
+for (const ascending of [false, true]) {
+  for (const time of [1, 3]) {
+    promise_test(async t => {
+      const svg = element("svg", {width: "300", height: "100"});
+      const target = animatedText(svg, ascending ? "0q" : "1in", ascending ? "1in" : "0q");
+      const reference = animatedText(svg, ascending ? "0px" : "96px", ascending ? "96px" : "0px");
+      const quarter = element("text", {x: "101.6q"});
+      const inch = element("text", {x: "1in"});
+      svg.append(quarter, inch);
+      document.body.append(svg);
+      t.add_cleanup(() => svg.remove());
+      svg.pauseAnimations();
+      assert_true(svg.animationsPaused(), "paused timeline");
+      await seek(svg, 0);
+      const initial = value(target);
+      const initialReference = value(reference);
+      const rect = svg.getBoundingClientRect();
+      const quarterPixels = quarter.x.baseVal.getItem(0).value;
+      const inchPixels = inch.x.baseVal.getItem(0).value;
+      await seek(svg, time);
+      const first = value(target);
+      const repeat = value(target);
+      const referenceValue = value(reference);
+      await seek(svg, 0);
+      const recovered = value(target);
+      await seek(svg, 4);
+      const endpoint = value(target);
+      const referenceEndpoint = value(reference);
+      const start = ascending ? 0 : 96;
+      const end = ascending ? 96 : 0;
+      const expected = start + (end - start) * time / 4;
+      assert_equals(rect.width, 300, "viewport width");
+      assert_equals(rect.height, 100, "viewport height");
+      assert_approx_equals(quarterPixels, 96, 0.001, "static quarter-millimeter calibration");
+      assert_approx_equals(inchPixels, 96, 0.001, "static inch calibration");
+      assert_approx_equals(initial, start, 0.001, "initial animated value");
+      assert_approx_equals(initialReference, start, 0.001, "initial px reference");
+      assert_approx_equals(referenceValue, expected, 0.001, "px interpolation reference");
+      assert_approx_equals(recovered, start, 0.001, "rewind recovery");
+      assert_approx_equals(endpoint, end, 0.001, "frozen endpoint");
+      assert_approx_equals(referenceEndpoint, end, 0.001, "frozen px endpoint");
+      assert_approx_equals(first, expected, 0.001, "interpolated absolute position");
+      assert_approx_equals(repeat, expected, 0.001, "repeated absolute position");
+    }, `${ascending ? "0q to 1in" : "1in to 0q"}: time ${time}s`);
+  }
+}
+</script>
