+<!doctype html>
+<meta charset="utf-8">
+<title>linear() contextual input positions do not crash parsing</title>
+<link rel="help" href="https://drafts.csswg.org/css-easing-2/">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<script>
+const property = "animation-timing-function";
+for (const value of ["linear(0, 1)", "linear(0 0% 1%, 1)"]) {
+  test(() => {
+    const style = document.createElement("div").style;
+    style.setProperty(property, value);
+    assert_not_equals(style.getPropertyValue(property), "");
+  }, `Literal calibration: ${value}`);
+}
+for (const expression of ["sibling-index() * 1%", "(1em / 1px) * 1%"]) {
+  for (const prefix of ["", "0% "]) {
+    const value = `linear(0 ${prefix}calc(${expression}), 1)`;
+    test(() => {
+      const style = document.createElement("div").style;
+      style.setProperty(property, value);
+      style.removeProperty(property);
+      style.setProperty(property, "linear(0, 1)");
+      const reference = document.createElement("div").style;
+      reference.setProperty(property, "linear(0, 1)");
+      assert_not_equals(reference.getPropertyValue(property), "");
+      assert_equals(style.getPropertyValue(property), reference.getPropertyValue(property));
+    }, `Parsing completes and permits a subsequent declaration: ${value}`);
+  }
+}
+</script>
