+                      epoch_sha256=epoch_sha, native_sources=policy["source_roles"][role],
+                      original_binding=policy["original_binding"],
+                      capsule_directory=capsule_directory, experiment_sha256=experiment_sha,
+                      observation_only=policy["original_binding"] is None,
+                      execution_preserved=execution_preserved)
+    need(not set(assessment).intersection(provenance), "publication must not replace assessed fields")
+    return dict(assessment, **provenance)
 
 
