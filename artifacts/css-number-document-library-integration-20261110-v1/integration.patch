+++ b/CssDerivation/Examples/NumberTree.lean
@@ -0,0 +1,60 @@
+import CssDerivation.Parser.Syntax
+
+namespace CssDerivation.NumberTransfer
+
+open ParserIR
+
+def digitPredicate : Predicate :=
+  .and (.leChar (.scalar '0') (.var .here)) (.leChar (.var .here) (.scalar '9'))
+
+def signPredicate : Predicate :=
+  .or (.eqChar (.var .here) (.scalar '+')) (.eqChar (.var .here) (.scalar '-'))
+
+def dotPredicate : Predicate := .eqChar (.var .here) (.scalar '.')
+
+def exponentPredicate : Predicate :=
+  .or (.eqChar (.var .here) (.scalar 'e')) (.eqChar (.var .here) (.scalar 'E'))
+
+abbrev SignShape := Shape.optional (.base .scalar)
+abbrev ExponentShape := Shape.pair SignShape (.base .chars)
+abbrev NumberShape := Shape.pair SignShape
+  (.pair (.base .chars) (.pair (.optional (.base .chars)) (.optional ExponentShape)))
+
+def signTree : Parser SignShape := .optional (.take signPredicate)
+def digitsTree : Parser (.base .chars) := .scan digitPredicate
+def nonemptyDigitsTree : Parser (.base .chars) := .nonempty digitsTree
+def fractionTree : Parser (.base .chars) := .right (.take dotPredicate) nonemptyDigitsTree
+def exponentTree : Parser ExponentShape :=
+  .right (.take exponentPredicate) (.pair signTree nonemptyDigitsTree)
+
+def numberTree : Parser NumberShape :=
+  .pair signTree (.pair digitsTree (.pair (.optional fractionTree) (.optional exponentTree)))
+
+def magnitudeExpression : FirstOrder.Expr [.chars] .nat :=
+  .foldNat (.var .here) (.nat 0)
+    (.add (.mul (.var (.there .here)) (.nat 10)) (.sub (.code (.var .here)) (.nat 48)))
+
+def magnitude (digits : List Char) : Nat := FirstOrder.eval magnitudeExpression (.cons digits .nil)
+
+def signedMagnitude (sign : Option Char) (value : Nat) : Int :=
+  if sign = some '-' then -(value : Int) else value
+
+structure Exact where
+  significand : Int
+  scale : Int
+  isNumber : Bool
+  sign : Option Char
+  deriving DecidableEq, Repr
+
+def project (parts : NumberShape.Value) : Exact :=
+  let fraction := parts.2.2.1.getD []
+  let exponent := match parts.2.2.2 with
+    | none => 0
+    | some (sign, digits) => signedMagnitude sign (magnitude digits)
+  ⟨signedMagnitude parts.1 (magnitude (parts.2.1 ++ fraction)),
+    exponent - fraction.length, parts.2.2.1.isSome || parts.2.2.2.isSome, parts.1⟩
+
+def execute (state : State) : Option (Exact × State) :=
+  (ParserIR.run numberTree state).map fun (parts, next) => (project parts, next)
+
+end CssDerivation.NumberTransfer
diff --git a/CssDerivation/Parser/Backend.lean b/CssDerivation/Parser/Backend.lean
new file mode 100644
--- /dev/null
+++ b/CssDerivation/Parser/Backend.lean
@@ -0,0 +1,34 @@
+import CssDerivation.Backend
+
+namespace CssParserLowering
+
+open CssDerivation
+
+inductive Program : Type → Type 1 where
+  | legacy {α : Type} : CssDerivation.Program α → Program α
+  | getState : Program State
+  | putState : State → Program Unit
+  | bind {α β : Type} : Program α → (α → Program β) → Program β
+
+def pure (value : α) : Program α := .legacy (.pure value)
+
+def run : Program α → State → α × State
+  | .legacy program, state => CssDerivation.run program state
+  | .getState, state => (state, state)
+  | .putState next, _ => ((), next)
+  | .bind first next, state =>
+    let result := run first state
+    run (next result.1) result.2
+
+def transaction (program : Program (Option α)) : Program (Option α) :=
+  .bind .getState fun before =>
+  .bind program fun result =>
+    match result with
+    | some value => pure (some value)
+    | none => .bind (.putState before) fun _ => pure none
+
+def observed (initial : State) : Option (α × State) → Option α × State
+  | none => (none, initial)
+  | some (value, final) => (some value, final)
+
+end CssParserLowering
diff --git a/CssDerivation/Parser/Lowering.lean b/CssDerivation/Parser/Lowering.lean
new file mode 100644
--- /dev/null
+++ b/CssDerivation/Parser/Lowering.lean
@@ -0,0 +1,36 @@
+import CssDerivation.Parser.Backend
+import CssDerivation.Parser.Syntax
+
+namespace CssParserLowering
+
+open CssDerivation CssDerivation.ParserIR
+
+def lower : Parser shape → Program (Option shape.Value)
+  | .legacy program =>
+    .bind (.legacy (FirstOrder.lower program .nil)) fun value => pure (some value)
+  | .take predicate =>
+    transaction (.bind (.legacy .read) fun value =>
+      match value with
+      | none => pure none
+      | some c => if accepts predicate c then pure (some c) else pure none)
+  | .scan predicate =>
+    .bind .getState fun before =>
+    .bind (.legacy (.scan before.input.length (accepts predicate))) fun chars => pure (some chars)
+  | .nonempty parser =>
+    transaction (.bind (lower parser) fun value =>
+      match value with
+      | some [] => pure none
+      | result => pure result)
+  | .pair left right =>
+    transaction (.bind (lower left) fun first =>
+      match first with
+      | none => pure none
+      | some a => .bind (lower right) fun second => pure (second.map fun b => (a, b)))
+  | .right left right =>
+    transaction (.bind (lower left) fun first =>
+      match first with
+      | none => pure none
+      | some _ => lower right)
+  | .optional parser => .bind (lower parser) fun result => pure (some result)
+
+end CssParserLowering
diff --git a/CssDerivation/Parser/LoweringLaws.lean b/CssDerivation/Parser/LoweringLaws.lean
new file mode 100644
--- /dev/null
+++ b/CssDerivation/Parser/LoweringLaws.lean
@@ -0,0 +1,87 @@
+import CssDerivation.Parser.Lowering
+
+namespace CssParserLowering
+
+open CssDerivation CssDerivation.ParserIR
+
+theorem legacy_preserved (program : CssDerivation.Program α) (state) :
+    run (.legacy program) state = CssDerivation.run program state := rfl
+
+theorem pure_preserved (value : α) (state) : run (pure value) state = (value, state) := rfl
+
+theorem state_read (state) : run .getState state = (state, state) := rfl
+
+theorem state_write (before after) : run (.putState after) before = ((), after) := rfl
+
+theorem transaction_result (program : Program (Option α)) (state) :
+    run (transaction program) state =
+      match run program state with
+      | (none, _) => (none, state)
+      | (some value, final) => (some value, final) := by
+  simp only [transaction, run]
+  cases outcome : run program state with
+  | mk value final => cases value <;> rfl
+
+theorem transaction_failure (program : Program (Option α)) (before after)
+    (failed : run program before = (none, after)) :
+    run (transaction program) before = (none, before) := by
+  rw [transaction_result, failed]
+
+theorem transaction_success (program : Program (Option α)) (before after value)
+    (success : run program before = (some value, after)) :
+    run (transaction program) before = (some value, after) := by
+  rw [transaction_result, success]
+
+theorem maximal_scan (predicate : Predicate) (source) :
+    CssDerivation.scanPrefix (accepts predicate) source.length source = scanWhile predicate source := by
+  rw [scan_matches_length_bound, FirstOrder.scan_lowering]
+  rfl
+
+theorem lowering_correct (parser : Parser shape) (state) :
+    run (lower parser) state = observed state (ParserIR.run parser state) := by
+  induction parser generalizing state with
+  | legacy program =>
+    simp [lower, run, pure, FirstOrder.lowering_correct, CssDerivation.run, ParserIR.run, observed]
+  | take predicate =>
+    rw [lower, transaction_result]
+    cases input : state.input with
+    | nil => simp [run, CssDerivation.run, input, pure, ParserIR.run, observed]
+    | cons c rest =>
+      by_cases accepted : accepts predicate c = true <;>
+        simp [run, CssDerivation.run, input, pure, ParserIR.run, observed, accepted]
+  | scan predicate =>
+    simp [lower, run, CssDerivation.run, pure, ParserIR.run, observed, maximal_scan]
+  | nonempty parser ih =>
+    rw [lower, transaction_result]
+    simp only [run, ih]
+    cases result : ParserIR.run parser state with
+    | none => simp [observed, pure, run, CssDerivation.run, ParserIR.run, result]
+    | some value =>
+      obtain ⟨chars, final⟩ := value
+      cases chars <;> simp [observed, pure, run, CssDerivation.run, ParserIR.run, result]
+  | pair left right leftIH rightIH =>
+    rw [lower, transaction_result]
+    simp only [run, leftIH]
+    cases first : ParserIR.run left state with
+    | none => simp [observed, pure, run, CssDerivation.run, ParserIR.run, first]
+    | some value =>
+      obtain ⟨a, next⟩ := value
+      simp only [observed, run, rightIH]
+      cases second : ParserIR.run right next <;>
+        simp [pure, run, CssDerivation.run, ParserIR.run, first, second]
+  | right left right leftIH rightIH =>
+    rw [lower, transaction_result]
+    simp only [run, leftIH]
+    cases first : ParserIR.run left state with
+    | none => simp [observed, pure, run, CssDerivation.run, ParserIR.run, first]
+    | some value =>
+      obtain ⟨a, next⟩ := value
+      simp only [observed, rightIH]
+      cases second : ParserIR.run right next <;>
+        simp [ParserIR.run, first, second]
+  | optional parser ih =>
+    simp only [lower, run, ih]
+    cases result : ParserIR.run parser state <;>
+      simp [observed, pure, run, CssDerivation.run, ParserIR.run, result]
+
+end CssParserLowering
diff --git a/CssDerivation/Parser/Syntax.lean b/CssDerivation/Parser/Syntax.lean
new file mode 100644
--- /dev/null
+++ b/CssDerivation/Parser/Syntax.lean
@@ -0,0 +1,126 @@
+import CssDerivation.Examples.EscapeCorrespondence
+
+namespace CssDerivation.ParserIR
+
+inductive Shape where
+  | base : FirstOrder.Ty → Shape
+  | pair : Shape → Shape → Shape
+  | optional : Shape → Shape
+
+abbrev Shape.Value : Shape → Type
+  | .base t => t.Value
+  | .pair a b => a.Value × b.Value
+  | .optional a => Option a.Value
+
+abbrev Predicate := FirstOrder.Expr [.scalar] .bool
+
+def accepts (predicate : Predicate) (c : Char) : Bool := FirstOrder.eval predicate (.cons c .nil)
+
+def scanWhile (predicate : Predicate) : List Char → List Char × List Char
+  | [] => ([], [])
+  | c :: rest =>
+      if accepts predicate c then
+        let next := scanWhile predicate rest
+        (c :: next.1, next.2)
+      else ([], c :: rest)
+
+inductive Scanned (predicate : Predicate) : List Char → List Char → List Char → Prop where
+  | empty : Scanned predicate [] [] []
+  | stop (c rest) : accepts predicate c = false → Scanned predicate (c :: rest) [] (c :: rest)
+  | next (c) {source chars rest} : accepts predicate c = true → Scanned predicate source chars rest →
+      Scanned predicate (c :: source) (c :: chars) rest
+
+inductive Parser : Shape → Type where
+  | legacy {t} : FirstOrder.Stmt [] t → Parser (.base t)
+  | take : Predicate → Parser (.base .scalar)
+  | scan : Predicate → Parser (.base .chars)
+  | nonempty : Parser (.base .chars) → Parser (.base .chars)
+  | pair {a b} : Parser a → Parser b → Parser (.pair a b)
+  | right {a b} : Parser a → Parser b → Parser b
+  | optional {a} : Parser a → Parser (.optional a)
+
+def run : Parser t → State → Option (t.Value × State)
+  | .legacy program, state => some (FirstOrder.interpret program .nil state)
+  | .take predicate, state =>
+      match state.input with
+      | [] => none
+      | c :: rest => if accepts predicate c then some (c, { state with input := rest }) else none
+  | .scan predicate, state =>
+      let scanned := scanWhile predicate state.input
+      some (scanned.1, { state with input := scanned.2 })
+  | .nonempty parser, state =>
+      match run parser state with
+      | some ([], _) => none
+      | result => result
+  | .pair left right, state => do
+      let (a, next) ← run left state
+      let (b, final) ← run right next
+      pure ((a, b), final)
+  | .right left right, state => do
+      let (_, next) ← run left state
+      run right next
+  | .optional parser, state =>
+      match run parser state with
+      | none => some (none, state)
+      | some (value, next) => some (some value, next)
+
+theorem Scanned.result {predicate source chars rest} (parsed : Scanned predicate source chars rest) :
+    scanWhile predicate source = (chars, rest) := by
+  induction parsed with
+  | empty => rfl
+  | stop c rest no => simp [scanWhile, no]
+  | next c yes tail ih => simp [scanWhile, yes, ih]
+
+theorem scan_sound (predicate : Predicate) (source : List Char) :
+    Scanned predicate source (scanWhile predicate source).1 (scanWhile predicate source).2 := by
+  induction source with
+  | nil => exact .empty
+  | cons c rest ih =>
+      simp only [scanWhile]
+      split
+      · exact .next c ‹_› ih
+      · exact .stop c rest (by simpa using ‹¬ accepts predicate c = true›)
+
+theorem scan_iff (predicate : Predicate) (source chars rest : List Char) :
+    scanWhile predicate source = (chars, rest) ↔ Scanned predicate source chars rest := by
+  constructor
+  · intro same; simpa [same] using scan_sound predicate source
+  · exact Scanned.result
+
+theorem Scanned.decomposition {predicate source chars rest} (parsed : Scanned predicate source chars rest) :
+    source = chars ++ rest := by
+  induction parsed with
+  | empty => rfl
+  | stop => rfl
+  | next c yes tail ih => simp [ih]
+
+theorem Scanned.boundary {predicate source chars rest} (parsed : Scanned predicate source chars rest) :
+    ∀ c tail, rest = c :: tail → accepts predicate c = false := by
+  induction parsed with
+  | empty => simp
+  | stop c rest no => simpa using no
+  | next c yes tail ih => exact ih
+
+theorem scan_matches_length_bound (predicate : Predicate) (source : List Char) :
+    scanWhile predicate source = FirstOrder.scanData predicate .nil source.length source := by
+  induction source with
+  | nil => rfl
+  | cons c rest ih => simp [scanWhile, FirstOrder.scanData, accepts, ih]
+
+theorem legacy_preserved (program : FirstOrder.Stmt [] t) (state : State) :
+    run (.legacy program) state = some (FirstOrder.interpret program .nil state) := rfl
+
+theorem legacy_lowering (program : FirstOrder.Stmt [] t) (state : State) :
+    run (.legacy program) state = some (CssDerivation.run (FirstOrder.lower program .nil) state) := by
+  rw [FirstOrder.lowering_correct]
+  rfl
+
+theorem optional_rollback (parser : Parser t) (state : State) (failed : run parser state = none) :
+    run (.optional parser) state = some (none, state) := by simp [run, failed]
+
+theorem escape_preserved (source : List Char) :
+    run (.legacy FirstOrder.escapeTree) ⟨source, false⟩ =
+      some ((FirstOrder.execute FirstOrder.escapeTree source).value,
+        ⟨(FirstOrder.execute FirstOrder.escapeTree source).rest, (FirstOrder.execute FirstOrder.escapeTree source).error⟩) := rfl
+
+end CssDerivation.ParserIR
