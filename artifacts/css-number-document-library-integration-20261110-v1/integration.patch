+		charset/page-windows-1251-css-at-charset-bogus-charset-attribute-windows-1250.html
+		charset/page-windows-1251-css-at-charset-bogus.html
+		charset/page-windows-1251-css-at-charset-utf16-ascii-only.html
+		charset/page-windows-1251-css-at-charset-utf16.html
+		charset/page-windows-1251-css-at-charset-utf16be.html
+		charset/page-windows-1251-css-at-charset-windows-1250-in-utf16.html
+		charset/page-windows-1251-css-at-charset-windows-1250-in-utf16be.html
+		charset/page-windows-1251-css-http-bogus-at-charset-windows-1250.html
