diff --git a/CssDerivation/Codec/Parser/Document.lean b/CssDerivation/Codec/Parser/Document.lean
new file mode 100644
--- /dev/null
+++ b/CssDerivation/Codec/Parser/Document.lean
@@ -0,0 +1,33 @@
+import CssDerivation.Codec.Parser.Encoder
+import CssDerivation.Parser.LoweringLaws
+
+namespace CssDerivation.ParserJson
+open Lean FirstOrder TypedCodec JsonSchema ParserIR DocumentSchema
+
+def envelopeKeys : List String := ["schema", "program", "source_map"]
+
+def readDocument (shape : Shape) (j : Json) : Option (Parser shape) := do
+  if !fieldsExactly j envelopeKeys then none else do
+    let version ← field j "schema"
+    if version.getStr?.toOption != some "css-parser-ir-v1" then none else do
+      let sourceMap ← field j "source_map"
+      let _ ← sourceMap.getObj?.toOption
+      let program ← field j "program"
+      decodeParser shape program
+
+def EnvelopeSchema {shape} (j : Json) (p : Parser shape) : Prop :=
+  ∃ version sourceMap source,
+    ExactKeys j envelopeKeys ∧
+    Field j "schema" version ∧ version.getStr? = .ok "css-parser-ir-v1" ∧
+    Field j "source_map" sourceMap ∧ ObjectValue sourceMap ∧
+    Field j "program" source ∧ ParserSchema source p
+
+def encodeDocument {shape} (p : Parser shape) : Json :=
+  Json.mkObj [("schema", .str "css-parser-ir-v1"), ("program", encodeParser p),
+    ("source_map", Json.mkObj [])]
+
+def executeDocument (shape : Shape) (j : Json) (state : State) :
+    Option (Option shape.Value × State) :=
+  (readDocument shape j).map (fun p => CssParserLowering.run (CssParserLowering.lower p) state)
+
+end CssDerivation.ParserJson
diff --git a/CssDerivation/Codec/Parser/DocumentLaws.lean b/CssDerivation/Codec/Parser/DocumentLaws.lean
new file mode 100644
--- /dev/null
+++ b/CssDerivation/Codec/Parser/DocumentLaws.lean
@@ -0,0 +1,68 @@
+import CssDerivation.Codec.Parser.Document
+import CssDerivation.Codec.Parser.EncoderLaws
+
+namespace CssDerivation.ParserJson
+open Lean FirstOrder TypedCodec JsonSchema ParserIR DocumentSchema
+
+theorem string_option_spec (j : Json) (value : String) :
+    j.getStr?.toOption = some value ↔ j.getStr? = .ok value := by
+  cases j.getStr? <;> simp [Except.toOption]
+
+theorem object_option_spec (j : Json) :
+    (∃ value, j.getObj?.toOption = some value) ↔ ObjectValue j := by
+  cases j <;> simp [Json.getObj?, Except.toOption, ObjectValue]
+  exact ⟨_, rfl⟩
+
+theorem envelope_keys_unique : envelopeKeys.Nodup := by decide
+
+theorem document_spec {shape} (j : Json) (p : Parser shape) :
+    readDocument shape j = some p ↔ EnvelopeSchema j p := by
+  constructor
+  · intro accepted
+    by_cases keys : fieldsExactly j envelopeKeys = true
+    · simp only [readDocument, keys, Bool.not_true, Bool.false_eq_true, ite_false,
+        Option.bind_eq_bind, Option.bind_eq_some_iff] at accepted
+      obtain ⟨version, versionField, accepted⟩ := accepted
+      by_cases versionOk : version.getStr?.toOption = some "css-parser-ir-v1"
+      · simp only [versionOk] at accepted
+        change (field j "source_map").bind _ = some p at accepted
+        simp only [Option.bind_eq_some_iff] at accepted
+        obtain ⟨sourceMap, sourceMapField, map, sourceMapRead, source, sourceField, programRead⟩ := accepted
+        exact ⟨version, sourceMap, source, (exact_keys_spec _ _ envelope_keys_unique).mp keys,
+          (field_spec _ _ _).mp versionField, (string_option_spec _ _).mp versionOk,
+          (field_spec _ _ _).mp sourceMapField, (object_option_spec _).mp ⟨map, sourceMapRead⟩,
+          (field_spec _ _ _).mp sourceField, (decodeParser_spec _ _).mp programRead⟩
+      · simp [versionOk] at accepted
+    · simp [readDocument, keys] at accepted
+  · rintro ⟨version, sourceMap, source, keys, versionField, versionOk,
+      sourceMapField, sourceMapObject, sourceField, programSchema⟩
+    obtain ⟨map, mapRead⟩ := (object_option_spec _).mpr sourceMapObject
+    simp [readDocument, (exact_keys_spec _ _ envelope_keys_unique).mpr keys,
+      (field_spec _ _ _).mpr versionField, (string_option_spec _ _).mpr versionOk,
+      (field_spec _ _ _).mpr sourceMapField, mapRead,
+      (field_spec _ _ _).mpr sourceField, (decodeParser_spec _ _).mpr programSchema]
+
+theorem document_json_roundtrip {shape} (p : Parser shape) :
+    readDocument shape (encodeDocument p) = some p := by
+  change decodeParser shape (encodeParser p) = some p
+  exact parser_json_roundtrip p
+
+theorem document_lowering {shape} (j : Json) (p : Parser shape) (state : State)
+    (schema : EnvelopeSchema j p) :
+    executeDocument shape j state = some (CssParserLowering.observed state (ParserIR.run p state)) := by
+  simp [executeDocument, (document_spec _ _).mpr schema, CssParserLowering.lowering_correct]
+
+theorem document_failure_atomic {shape} (j : Json) (p : Parser shape) (state : State)
+    (schema : EnvelopeSchema j p) (failed : ParserIR.run p state = none) :
+    executeDocument shape j state = some (none, state) := by
+  rw [document_lowering j p state schema, failed]
+  rfl
+
+theorem document_success_exact {shape} (j : Json) (p : Parser shape) (before after : State)
+    (value : shape.Value) (schema : EnvelopeSchema j p)
+    (success : ParserIR.run p before = some (value, after)) :
+    executeDocument shape j before = some (some value, after) := by
+  rw [document_lowering j p before schema, success]
+  rfl
+
+end CssDerivation.ParserJson
diff --git a/CssDerivation/Codec/Parser/Encoder.lean b/CssDerivation/Codec/Parser/Encoder.lean
new file mode 100644
--- /dev/null
+++ b/CssDerivation/Codec/Parser/Encoder.lean
@@ -0,0 +1,22 @@
+import CssDerivation.Codec.Parser.Reader
+
+namespace CssDerivation.ParserJson
+open Lean FirstOrder TypedCodec JsonSchema ParserIR
+
+def encodeType : Ty → Json
+  | .nat => .str "nat"
+  | .scalar => .str "scalar"
+  | .bool => .str "bool"
+  | .chars => .str "chars"
+  | .unit => .str "unit"
+
+def encodeParser : {shape : Shape} → Parser shape → Json
+  | _, .legacy (t := t) p => nodeJson "legacy" [encodeType t, encodeStmtJson p]
+  | _, .take predicate => nodeJson "take" [encodeExprJson predicate]
+  | _, .scan predicate => nodeJson "scan" [encodeExprJson predicate]
+  | _, .nonempty p => nodeJson "nonempty" [encodeParser p]
+  | _, .pair a b => nodeJson "pair" [encodeParser a, encodeParser b]
+  | _, .right a b => nodeJson "right" [encodeParser a, encodeParser b]
+  | _, .optional p => nodeJson "optional" [encodeParser p]
+
+end CssDerivation.ParserJson
diff --git a/CssDerivation/Codec/Parser/EncoderLaws.lean b/CssDerivation/Codec/Parser/EncoderLaws.lean
new file mode 100644
--- /dev/null
+++ b/CssDerivation/Codec/Parser/EncoderLaws.lean
@@ -0,0 +1,24 @@
+import CssDerivation.Codec.Parser.Encoder
+import CssDerivation.Codec.Parser.SchemaLaws
+
+namespace CssDerivation.ParserJson
+open Lean FirstOrder TypedCodec JsonSchema ParserIR
+
+theorem encodeType_schema (t : Ty) : TypeSchema (encodeType t) t := by
+  cases t <;> constructor
+
+theorem encodeParser_schema {shape} (p : Parser shape) : ParserSchema (encodeParser p) p := by
+  induction p with
+  | legacy p => exact .node (.rightArgs 2 1 _ _) (.legacy (encodeType_schema _) (encodeStmtJson_schema [] p))
+  | take predicate => exact .node (.rightArgs 2 1 _ _) (.take (encodeExprJson_schema [] predicate))
+  | scan predicate => exact .node (.rightArgs 2 1 _ _) (.scan (encodeExprJson_schema [] predicate))
+  | nonempty p hp => exact .node (.rightArgs 2 1 _ _) (.nonempty hp)
+  | pair a b ha hb => exact .node (.rightArgs 2 1 _ _) (.pair ha hb)
+  | right a b ha hb => exact .node (.rightArgs 2 1 _ _) (.right ha hb)
+  | optional p hp => exact .node (.rightArgs 2 1 _ _) (.optional hp)
+
+theorem parser_json_roundtrip {shape} (p : Parser shape) :
+    decodeParser shape (encodeParser p) = some p :=
+  (decodeParser_spec _ p).mpr (encodeParser_schema p)
+
+end CssDerivation.ParserJson
diff --git a/CssDerivation/Codec/Parser/Reader.lean b/CssDerivation/Codec/Parser/Reader.lean
new file mode 100644
--- /dev/null
+++ b/CssDerivation/Codec/Parser/Reader.lean
@@ -0,0 +1,63 @@
+import CssDerivation.Codec.Parser.Schema
+
+namespace CssDerivation.ParserJson
+open Lean FirstOrder TypedCodec JsonSchema ParserIR
+
+mutual
+  def readParser (j : Json) : Option (Parsed j) :=
+    match j with
+    | .obj ⟨⟨.inner outer "op" (.str op) .leaf (.inner inner "args" (.arr ⟨args⟩) .leaf .leaf)⟩⟩ => do
+      let ⟨shape, p, proof⟩ ← readArguments op args
+      some ⟨shape, p, .node (.rightOp outer inner op args) proof⟩
+    | .obj ⟨⟨.inner outer "args" (.arr ⟨args⟩) .leaf (.inner inner "op" (.str op) .leaf .leaf)⟩⟩ => do
+      let ⟨shape, p, proof⟩ ← readArguments op args
+      some ⟨shape, p, .node (.rightArgs outer inner op args) proof⟩
+    | .obj ⟨⟨.inner outer "op" (.str op) (.inner inner "args" (.arr ⟨args⟩) .leaf .leaf) .leaf⟩⟩ => do
+      let ⟨shape, p, proof⟩ ← readArguments op args
+      some ⟨shape, p, .node (.leftOp outer inner op args) proof⟩
+    | .obj ⟨⟨.inner outer "args" (.arr ⟨args⟩) (.inner inner "op" (.str op) .leaf .leaf) .leaf⟩⟩ => do
+      let ⟨shape, p, proof⟩ ← readArguments op args
+      some ⟨shape, p, .node (.leftArgs outer inner op args) proof⟩
+    | _ => none
+  termination_by sizeOf j
+
+  def readArguments (op : String) (args : List Json) : Option (ParsedArguments op args) :=
+    match op, args with
+    | "legacy", [jt, jp] => do
+      let ⟨t, typeProof⟩ ← readType jt
+      let ⟨p, proof⟩ ← readLegacy t jp
+      some ⟨.base t, .legacy p, .legacy typeProof proof⟩
+    | "take", [j] => do
+      let ⟨predicate, proof⟩ ← readPredicate j
+      some ⟨.base .scalar, .take predicate, .take proof⟩
+    | "scan", [j] => do
+      let ⟨predicate, proof⟩ ← readPredicate j
+      some ⟨.base .chars, .scan predicate, .scan proof⟩
+    | "nonempty", [j] =>
+      match readParser j with
+      | some ⟨.base .chars, p, proof⟩ => some ⟨.base .chars, .nonempty p, .nonempty proof⟩
+      | _ => none
+    | "pair", [ja, jb] => do
+      let ⟨a, pa, proofA⟩ ← readParser ja
+      let ⟨b, pb, proofB⟩ ← readParser jb
+      some ⟨.pair a b, .pair pa pb, .pair proofA proofB⟩
+    | "right", [ja, jb] => do
+      let ⟨a, pa, proofA⟩ ← readParser ja
+      let ⟨b, pb, proofB⟩ ← readParser jb
+      some ⟨b, .right pa pb, .right proofA proofB⟩
+    | "optional", [j] => do
+      let ⟨shape, p, proof⟩ ← readParser j
+      some ⟨.optional shape, .optional p, .optional proof⟩
+    | _, _ => none
+  termination_by sizeOf args
+end
+
+def expectParser (shape : Shape) {j : Json} (parsed : Parsed j) :
+    Option {p : Parser shape // ParserSchema j p} :=
+  match parsed with
+  | ⟨actual, p, proof⟩ => if h : actual = shape then some (h ▸ ⟨p, proof⟩) else none
+
+def decodeParser (shape : Shape) (j : Json) : Option (Parser shape) :=
+  ((readParser j).bind (expectParser shape)).map Subtype.val
+
+end CssDerivation.ParserJson
diff --git a/CssDerivation/Codec/Parser/Schema.lean b/CssDerivation/Codec/Parser/Schema.lean
new file mode 100644
--- /dev/null
+++ b/CssDerivation/Codec/Parser/Schema.lean
@@ -0,0 +1,65 @@
+import CssDerivation.Parser.Syntax
+import CssDerivation.Codec.Document.KeyLaws
+
+namespace CssDerivation.ParserJson
+open Lean FirstOrder TypedCodec JsonSchema ParserIR
+
+deriving instance DecidableEq for Shape
+
+inductive TypeSchema : Json → Ty → Prop where
+  | nat : TypeSchema (.str "nat") .nat
+  | scalar : TypeSchema (.str "scalar") .scalar
+  | bool : TypeSchema (.str "bool") .bool
+  | chars : TypeSchema (.str "chars") .chars
+  | unit : TypeSchema (.str "unit") .unit
+
+mutual
+  inductive ParserSchema : Json → {shape : Shape} → Parser shape → Prop where
+    | node {j op args shape} {p : Parser shape} :
+        Node j op args → ParserArguments op args p → ParserSchema j p
+
+  inductive ParserArguments : String → List Json → {shape : Shape} → Parser shape → Prop where
+    | legacy {jt jp t} {p : Stmt [] t} :
+        TypeSchema jt t → StmtSchema [] jp (encodeStmt p) →
+        ParserArguments "legacy" [jt, jp] (.legacy p)
+    | take {j} {predicate : Predicate} : ExprSchema [] j (encodeExpr predicate) →
+        ParserArguments "take" [j] (.take predicate)
+    | scan {j} {predicate : Predicate} : ExprSchema [] j (encodeExpr predicate) →
+        ParserArguments "scan" [j] (.scan predicate)
+    | nonempty {j} {p : Parser (.base .chars)} : ParserSchema j p →
+        ParserArguments "nonempty" [j] (.nonempty p)
+    | pair {ja jb a b} {pa : Parser a} {pb : Parser b} :
+        ParserSchema ja pa → ParserSchema jb pb → ParserArguments "pair" [ja, jb] (.pair pa pb)
+    | right {ja jb a b} {pa : Parser a} {pb : Parser b} :
+        ParserSchema ja pa → ParserSchema jb pb → ParserArguments "right" [ja, jb] (.right pa pb)
+    | optional {j a} {p : Parser a} : ParserSchema j p →
+        ParserArguments "optional" [j] (.optional p)
+end
+
+abbrev Parsed (j : Json) := Σ shape, {p : Parser shape // ParserSchema j p}
+abbrev ParsedArguments (op : String) (args : List Json) :=
+  Σ shape, {p : Parser shape // ParserArguments op args p}
+
+def readType : (j : Json) → Option {t : Ty // TypeSchema j t}
+  | .str "nat" => some ⟨.nat, .nat⟩
+  | .str "scalar" => some ⟨.scalar, .scalar⟩
+  | .str "bool" => some ⟨.bool, .bool⟩
+  | .str "chars" => some ⟨.chars, .chars⟩
+  | .str "unit" => some ⟨.unit, .unit⟩
+  | _ => none
+
+def certify {α : Type} {P : α → Prop} (result : Option α)
+    (sound : ∀ value, result = some value → P value) : Option {value // P value} :=
+  match result with
+  | none => none
+  | some value => some ⟨value, sound value rfl⟩
+
+def readPredicate (j : Json) : Option {p : Predicate // ExprSchema [] j (encodeExpr p)} :=
+  certify (checkExprJson [] [.scalar] .bool j)
+    (fun p accepted => (alias_free_expression_json_spec j p).mp accepted)
+
+def readLegacy (t : Ty) (j : Json) : Option {p : Stmt [] t // StmtSchema [] j (encodeStmt p)} :=
+  certify (checkStmtJson [] [] t j)
+    (fun p accepted => (alias_free_statement_json_spec j p).mp accepted)
+
+end CssDerivation.ParserJson
diff --git a/CssDerivation/Codec/Parser/SchemaLaws.lean b/CssDerivation/Codec/Parser/SchemaLaws.lean
new file mode 100644
--- /dev/null
+++ b/CssDerivation/Codec/Parser/SchemaLaws.lean
@@ -0,0 +1,74 @@
+import CssDerivation.Codec.Parser.Reader
+
+namespace CssDerivation.ParserJson
+open Lean FirstOrder TypedCodec JsonSchema ParserIR
+
+theorem readType_complete {j t} (schema : TypeSchema j t) :
+    readType j = some ⟨t, schema⟩ := by cases schema <;> rfl
+
+theorem readPredicate_complete {j p} (schema : ExprSchema [] j (encodeExpr p)) :
+    readPredicate j = some ⟨p, schema⟩ := by
+  have accepted := (alias_free_expression_json_spec j p).mpr schema
+  unfold readPredicate certify
+  split <;> simp_all <;> grind
+
+theorem readLegacy_complete {j t} {p : Stmt [] t}
+    (schema : StmtSchema [] j (encodeStmt p)) :
+    readLegacy t j = some ⟨p, schema⟩ := by
+  have accepted := (alias_free_statement_json_spec j p).mpr schema
+  unfold readLegacy certify
+  split <;> simp_all <;> grind
+
+theorem node_arguments_smaller {j op args} (node : Node j op args) :
+    sizeOf args < sizeOf j := by
+  cases node <;> simp [rightObject, leftObject] <;> omega
+
+mutual
+  theorem readParser_complete {j shape} {p : Parser shape} (schema : ParserSchema j p) :
+      readParser j = some ⟨shape, p, schema⟩ := by
+    cases schema with
+    | node node arguments =>
+      cases node <;>
+        simp only [rightObject, leftObject, readParser.eq_def] <;>
+        rw [readArguments_complete arguments] <;> rfl
+  termination_by sizeOf j
+  decreasing_by
+    all_goals simp_wf
+    all_goals apply node_arguments_smaller
+    all_goals assumption
+
+  theorem readArguments_complete {op args shape} {p : Parser shape}
+      (schema : ParserArguments op args p) :
+      readArguments op args = some ⟨shape, p, schema⟩ := by
+    cases schema with
+    | legacy ht hp =>
+      rw [readArguments, readType_complete ht]
+      simp only [Option.bind_eq_bind, Option.bind_some]
+      rw [readLegacy_complete hp]; rfl
+    | take hp => rw [readArguments, readPredicate_complete hp]; rfl
+    | scan hp => rw [readArguments, readPredicate_complete hp]; rfl
+    | nonempty hp => rw [readArguments, readParser_complete hp]
+    | pair ha hb => rw [readArguments, readParser_complete ha, readParser_complete hb]; rfl
+    | right ha hb => rw [readArguments, readParser_complete ha, readParser_complete hb]; rfl
+    | optional hp => rw [readArguments, readParser_complete hp]; rfl
+  termination_by sizeOf args
+  decreasing_by all_goals simp_wf; all_goals simp_all only; all_goals omega
+end
+
+theorem decodeParser_spec {shape} (j : Json) (p : Parser shape) :
+    decodeParser shape j = some p ↔ ParserSchema j p := by
+  constructor
+  · intro accepted
+    cases h : readParser j with
+    | none => simp [decodeParser, h] at accepted
+    | some parsed =>
+      rcases parsed with ⟨actual, q, schema⟩
+      by_cases same : actual = shape
+      · subst actual
+        have eq : q = p := by simpa [decodeParser, h, expectParser] using accepted
+        exact eq ▸ schema
+      · simp [decodeParser, h, expectParser, same] at accepted
+  · intro schema
+    simp [decodeParser, readParser_complete schema, expectParser]
+
+end CssDerivation.ParserJson
