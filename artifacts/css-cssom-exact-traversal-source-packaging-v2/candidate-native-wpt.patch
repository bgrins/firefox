+    const auto y = CheckedInt<int64_t>(aRect.y) + translation->y;
+    const auto right = x + aRect.width;
+    const auto bottom = y + aRect.height;
+    if (x.isValid() && y.isValid() && right.isValid() && bottom.isValid() &&
