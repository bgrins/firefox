de_id":"C_kwDOADc1VdoAKDFkMjc4Y2NkZTkwYzhlZGU4YzFjNDM5YzMyNDY3ZTJmMWIxODQwODQ","commit":{"author":{"name":"Swarup Ukil","email":"sukil@mozilla.com","date":"2026-05-27T09:48:48Z"},"committer":{"name":"moz-wptsync-bot","email":"wptsync@mozilla.com","date":"2026-06-04T22:51:39Z"},"message":"Clean up attr() cycle leftover from Bug 2009001.\n\nSpecifically:\n1. Fix a failing test in attr-cycle.html. Attr-values should only\n   resolve references when prefaced by type() syntax. Else the\n   attr-value is taken as is.\n\n2. Cycle detection currently can't distinguish --data-foo (custom\n   property) from data-foo (attribute), which can flag a false cycle\n   in rare cases. Added a test to attr-cycle.html.\n\n3. CSS-wide keywords aren't meaningful to attr() itself but can pass\n   through directly or via the fallback. Added a test covering this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302511\n\nbugzilla-url: https://bugzilla.mozilla.org/show_bug.cgi?id=1997338\ngecko-commit: 93f005409f29cc3f347a99ce9fa0bd53c7ffe5de\ngecko-commit-git: d3f83bb38dc446c38a9ad37af0bb6c9f511bdfd3\ngecko-reviewers: emilio, firefox-style-system-reviewers","tree":{"sha":"84550dc482956a9aa02663fa0390df839f1f52ef","url":"https://api.github.com/repos/web-platform-tests/wpt/git/trees/84550dc482956a9aa02663fa0390df839f1f52ef"},"url":"https://api.github.com/repos/web-platform-tests/wpt/git/commits/1d278ccde90c8ede8c1c439c32467e2f1b184084","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/web-platform-tests/wpt/commits/1d278ccde90c8ede8c1c439c32467e2f1b184084","html_url":"https://github.com/web-platform-tests/wpt/commit/1d278ccde90c8ede8c1c439c32467e2f1b184084","comments_url":"https://api.github.com/repos/web-platform-tests/wpt/commits/1d278ccde90c8ede8c1c439c32467e2f1b184084/comments","author":{"login":"sukil-moz","id":316258069,"node_id":"U_kgDOEtm3FQ","avatar_url":"ht