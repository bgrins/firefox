+impl<'c, 'decls: 'c>
+    CollectedDeclarations<'c, 'decls, crate::native_provider_completion::PendingProperty>
+{
+    fn into_pending_owner<C>(
+        self,
+        context: C,
+        ready: std::collections::HashMap<Name, Option<ComputedRegisteredValue>>,
+    ) -> Result<IncompleteCascade<'c, 'decls, C>, Name> {
+        use crate::native_provider_completion::{
+            AdmittedCustomProperty, CollectedCustomProperties,
+        };
+        let winners = self
+            .custom
+            .into_iter()
+            .map(|winner| match winner {
+                CollectedCustomProperty::Ordinary(declaration) => (
+                    declaration.name.clone(),
+                    AdmittedCustomProperty::Ordinary(declaration.clone()),
+                ),
+                CollectedCustomProperty::Pending { name, property } => {
+                    (name.clone(), AdmittedCustomProperty::Animated(property))
+                },
+            })
+            .collect();
+        let custom =
+            CollectedCustomProperties::from_admitted(winners).into_owner(context, ready)?;
+        Ok(IncompleteCascade {
+            cascade: self.cascade,
+            declarations: self.declarations,
+            custom,
+        })
     }
 }
 
