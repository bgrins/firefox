+enum CollectedCustomProperty<'a, P> {
+    Ordinary(&'a CustomDeclaration),
+    Pending { name: &'a Name, property: P },
+}
+
+struct CollectedDeclarations<'c, 'decls: 'c, P> {
+    cascade: Cascade<'c>,
+    declarations: Declarations<'decls>,
+    custom: Vec<CollectedCustomProperty<'decls, P>>,
+}
+
+struct ResolvedDeclarations<'c, 'decls: 'c> {
+    cascade: Cascade<'c>,
+    declarations: Declarations<'decls>,
+}
+
+impl<'c, 'decls: 'c, P> CollectedDeclarations<'c, 'decls, P> {
+    fn collect(
+        iter: impl Iterator<
+            Item = (
+                CascadeDeclaration<'decls, P>,
+                CascadePriority,
+                DeclarationSource<'decls>,
+            ),
+        >,
+        mut cascade: Cascade<'c>,
+        context: &mut computed::Context,
+        tracker: &mut AttributeTracker,
+    ) -> Self {
+        cascade.init_custom_properties(context);
+        let mut declarations = Declarations::default();
+        let mut custom = Vec::new();
+        iter_declarations(
+            iter,
+            &mut declarations,
+            Some((&mut cascade, context, &mut custom)),
+            tracker,
+        );
+        Self {
+            cascade,
+            declarations,
+            custom,
+        }
+    }
+}
+
+impl<'c, 'decls: 'c> CollectedDeclarations<'c, 'decls, std::convert::Infallible> {
+    fn resolve_concrete(
+        mut self,
+        context: &mut computed::Context,
+        cache: &mut ShorthandsWithPropertyReferencesCache,
+        tracker: &mut AttributeTracker,
+    ) -> ResolvedDeclarations<'c, 'decls> {
+        for winner in self.custom {
+            match winner {
+                CollectedCustomProperty::Ordinary(declaration) => {
+                    self.cascade
+                        .apply_admitted_custom_property(context, declaration);
+                },
+                CollectedCustomProperty::Pending { property, .. } => match property {},
+            }
+        }
+        // Detect cycles, remove properties participating in them, and resolve custom
+        // properties, applying prioritary properties (font-size, color-scheme, line-height)
+        // interleaved so that a custom property depending on `em`/`lh`/the used color-scheme is
+        // substituted once the prioritary property it needs has been applied.
+        self.cascade.apply_custom_and_prioritary_properties(
+            context,
+            &self.declarations,
+            cache,
+            tracker,
+        );
+        ResolvedDeclarations {
+            cascade: self.cascade,
+            declarations: self.declarations,
+        }
+    }
+}
