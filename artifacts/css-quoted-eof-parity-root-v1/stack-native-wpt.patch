index 000000000000..d3c3d9951b24
--- /dev/null
+++ b/testing/web-platform/tests/css/css-variables/quoted-eof-backslash-parity.html
@@ -0,0 +1,52 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Preserve paired backslashes at quoted EOF</title>
+<link rel="help" href="https://drafts.csswg.org/css-syntax-3/#consume-string-token">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<body>
+<script>
+function quoted(value) {
+  return '"' + value.replaceAll('\\', '\\\\').replaceAll('"', '\\"') + '"';
+}
+
+for (const quote of ['"', "'"]) {
+  for (let count = 0; count <= 4; count++) {
+    for (const terminalQuote of count % 2 ? [false] : [false, true]) {
+      const raw = quote + 'example' + '\\'.repeat(count) + (terminalQuote ? quote : '');
+      const decoded = 'example' + '\\'.repeat(Math.floor(count / 2)) +
+        (terminalQuote && count % 2 ? quote : '');
+      test(t => {
+        const target = document.createElement('div');
+        const reference = document.createElement('div');
+        t.add_cleanup(() => { target.remove(); reference.remove(); });
+        target.style.setProperty('--family', raw);
+        target.style.fontFamily = 'var(--family), serif';
+        reference.style.fontFamily = quoted(decoded) + ', serif';
+        assert_not_equals(target.style.getPropertyValue('--family'), '', 'custom value accepted');
+        assert_not_equals(reference.style.fontFamily, '', 'reference accepted');
+        document.body.append(target, reference);
+        assert_equals(getComputedStyle(target).fontFamily,
+                      getComputedStyle(reference).fontFamily);
+      }, `${quote} with ${count} backslashes and ${terminalQuote ? 'a final quote' : 'EOF'}`);
+    }
+  }
+}
+
+for (const [name, value] of [
+  ['closed fallback', 'var(--absent, "example")'],
+  ['missing quote and parenthesis', 'var(--absent, "example'],
+]) {
+  test(t => {
+    const target = document.createElement('div');
+    const reference = document.createElement('div');
+    t.add_cleanup(() => { target.remove(); reference.remove(); });
+    target.style.fontFamily = value;
+    reference.style.fontFamily = '"example"';
+    assert_not_equals(target.style.fontFamily, '', 'specified value accepted');
+    document.body.append(target, reference);
+    assert_equals(getComputedStyle(target).fontFamily,
+                  getComputedStyle(reference).fontFamily);
+  }, name);
+}
+</script>
