[
  {
    "name": "spec-vars",
    "command": [
      "webspec-index",
      "query",
      "https://drafts.csswg.org/css-variables-1/#using-variables",
      "--format",
      "markdown"
    ],
    "exit": 0
  },
  {
    "name": "spec-taint",
    "command": [
      "webspec-index",
      "query",
      "https://drafts.csswg.org/css-variables-1/#animation-tainted",
      "--format",
      "markdown"
    ],
    "exit": 0
  },
  {
    "name": "spec-values",
    "command": [
      "webspec-index",
      "search",
      "animation-tainted",
      "--spec",
      "CSS-VALUES-5",
      "--limit",
      "5"
    ],
    "exit": 0
  }
]
