+++ b/testing/web-platform/tests/css/css-cascade/revert-layer-important-inline-part.html
@@ -0,0 +1,41 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Important inline layer rollback preserves outer part rules</title>
+<link rel="help" href="https://drafts.csswg.org/css-cascade-5/#revert-layer">
+<link rel="help" href="https://drafts.csswg.org/css-cascade-5/#revert-rule">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<body>
+<script>
+for (const outer of [false, true]) {
+  for (const keyword of ["none", "revert-layer", "revert", "revert-rule"]) {
+    for (const ruleRollback of [false, true]) {
+      test(t => {
+        const host = document.createElement("div");
+        host.id = "rollback-host";
+        const sheet = document.createElement("style");
+        sheet.textContent = outer ? "#rollback-host::part(p) { margin-left:37px; --value:37px }" : "";
+        document.head.append(sheet);
+        const shadow = host.attachShadow({mode:"open"});
+        const local = document.createElement("style");
+        local.textContent = "#target { margin-left:5px; --value:5px }";
+        if (ruleRollback) local.textContent += "#target { margin-left:revert-rule !important; --value:revert-rule !important }";
+        const target = document.createElement("div");
+        target.id = "target";
+        target.setAttribute("part", "p");
+        if (keyword !== "none") {
+          target.style.setProperty("margin-left", keyword, "important");
+          target.style.setProperty("--value", keyword, "important");
+        }
+        shadow.append(local, target);
+        document.body.append(host);
+        t.add_cleanup(() => { host.remove(); sheet.remove(); });
+        const style = getComputedStyle(target);
+        const expected = keyword === "revert" ? "0px" : outer ? "37px" : "5px";
+        assert_equals(style.marginLeft, expected, "Longhand rollback");
+        assert_equals(style.getPropertyValue("--value").trim(), keyword === "revert" ? "" : expected, "Custom property rollback");
+      }, `Outer part rule ${outer}, inline ${keyword}, intervening rule rollback ${ruleRollback}`);
+    }
+  }
+}
+</script>
diff --git a/testing/web-platform/tests/css/css-cascade/revert-layer-preserves-inline-exclusion.html b/testing/web-platform/tests/css/css-cascade/revert-layer-preserves-inline-exclusion.html
new file mode 100644
--- /dev/null
+++ b/testing/web-platform/tests/css/css-cascade/revert-layer-preserves-inline-exclusion.html
@@ -0,0 +1,48 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Layer rollback preserves earlier inline style exclusions</title>
+<link rel="help" href="https://drafts.csswg.org/css-cascade-5/#revert-layer-keyword">
+<link rel="help" href="https://drafts.csswg.org/css-logical-1/#logical-property-group">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<body>
+<script>
+let serial = 0;
+for (const direction of ["ltr", "rtl"]) {
+  for (const outerImportant of [false, true]) {
+    for (const inlineValue of ["revert-layer", "revert", "9px"]) {
+      for (const outerValue of ["revert-layer", "revert-rule", "11px", "none"]) {
+        test(t => {
+          assert_true(CSS.supports("margin-inline-start", inlineValue));
+          const host = document.createElement("div");
+          host.id = `rollback-host-${serial++}`;
+          const physical = direction === "ltr" ? "margin-left" : "margin-right";
+          const sheet = document.createElement("style");
+          if (outerValue !== "none") {
+            sheet.textContent = `#${host.id}::part(p) {
+              ${physical}:${outerValue}${outerImportant ? " !important" : ""}
+            }`;
+          }
+          const shadow = host.attachShadow({mode:"open"});
+          const local = document.createElement("style");
+          local.textContent = `#target { direction:${direction}; ${physical}:37px }`;
+          const target = document.createElement("div");
+          target.id = "target";
+          target.setAttribute("part", "p");
+          target.style.setProperty(physical, "5px");
+          target.style.setProperty("margin-inline-start", inlineValue, "important");
+          shadow.append(local, target);
+          document.body.append(sheet, host);
+          t.add_cleanup(() => { host.remove(); sheet.remove(); });
+          const expected = inlineValue === "revert" ? "0px" :
+            inlineValue === "9px" ? "9px" : outerValue === "11px" ? "11px" : "37px";
+          const computed = getComputedStyle(target);
+          assert_equals(computed.direction, direction);
+          assert_equals(computed.getPropertyValue(physical), expected);
+        }, `${direction}: inline ${inlineValue}, outer ${outerValue}, ` +
+           `${outerImportant ? "important" : "normal"}`);
+      }
+    }
+  }
+}
+</script>
diff --git a/testing/web-platform/tests/css/css-cascade/revert-rule-preserves-earlier-rollback.html b/testing/web-platform/tests/css/css-cascade/revert-rule-preserves-earlier-rollback.html
new file mode 100644
--- /dev/null
+++ b/testing/web-platform/tests/css/css-cascade/revert-rule-preserves-earlier-rollback.html
@@ -0,0 +1,36 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Rule rollback preserves earlier layer rollback exclusions</title>
+<link rel="help" href="https://drafts.csswg.org/css-cascade-5/#revert-layer">
+<link rel="help" href="https://drafts.csswg.org/css-cascade-5/#revert-rule">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<body>
+<script>
+for (const keyword of ["none", "revert-layer", "revert", "revert-rule"]) {
+  for (const ruleRollback of [false, true]) {
+    for (const animated of [false, true]) {
+      test(t => {
+        const sheet = document.createElement("style");
+        sheet.textContent = "#rollback-target { margin-left:5px; --value:5px }";
+        if (ruleRollback) sheet.textContent += "#rollback-target { margin-left:revert-rule !important; --value:revert-rule !important }";
+        if (animated) sheet.textContent += "@keyframes rollback-constant { from,to { margin-left:59px; --value:59px } } #rollback-target { animation:rollback-constant 1s -0.5s linear paused }";
+        document.head.append(sheet);
+        const target = document.createElement("div");
+        target.id = "rollback-target";
+        if (keyword !== "none") {
+          target.style.setProperty("margin-left", keyword, "important");
+          target.style.setProperty("--value", keyword, "important");
+        }
+        document.body.append(target);
+        t.add_cleanup(() => { target.remove(); sheet.remove(); });
+        const style = getComputedStyle(target);
+        assert_equals(style.animationName, animated ? "rollback-constant" : "none", "Animation declaration");
+        const expected = keyword === "revert" ? "0px" : animated && keyword !== "revert-layer" ? "59px" : "5px";
+        assert_equals(style.marginLeft, expected, "Longhand rollback");
+        assert_equals(style.getPropertyValue("--value").trim(), keyword === "revert" ? "" : expected, "Custom property rollback");
+      }, `Inline ${keyword}, intervening rule rollback ${ruleRollback}, animation ${animated}`);
+    }
+  }
+}
+</script>
