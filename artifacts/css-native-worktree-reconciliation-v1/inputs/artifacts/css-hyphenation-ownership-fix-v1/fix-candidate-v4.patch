+        sample.style.hyphenateLimitChars = limit;
+        observations.push({stage: "restricted again", lines: wordLines(sample)});
+        const fresh = fixture(t, limit, partition, hyphens);
+        observations.push({stage: "fresh restricted", lines: wordLines(fresh)});
+        const detail = JSON.stringify(observations);
+        for (const index of [1, 3, 4]) {
+          assert_array_equals(observations[index].lines, [0, 0, 0, 0, 0, 0, 0],
+            observations[index].stage + " must not hyphenate: " + detail);
+        }
+      }, `limit=${limit}; ${partition}; hyphens=${hyphens}`);
+    }
+  }
