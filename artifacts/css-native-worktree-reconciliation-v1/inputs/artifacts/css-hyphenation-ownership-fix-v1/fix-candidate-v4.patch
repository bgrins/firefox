+      span.textContent = text;
+      sample.append(span);
+    }
+  }
+  document.body.append(sample);
+  t.add_cleanup(() => sample.remove());
+  return sample;
+}
+
+promise_test(async t => {
+  assert_equals((await fontReady).length, 1, "Ahem loaded");
+  const sample = fixture(t, "5 2 2", "single", "auto");
+  assert_implements_optional(wordLines(sample).some(top => top !== 0),
+    "The English dictionary hyphenates example at this width");
+}, "English hyphenation dictionary calibration");
+
+for (const limit of ["100", "5 100 2", "5 2 100"]) {
