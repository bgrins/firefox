--- /dev/null
+++ b/testing/web-platform/tests/css/css-values/attr-taint-registration-transition.html
@@ -0,0 +1,113 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Attribute taint survives a custom property registration transition</title>
+<meta name="timeout" content="long">
+<link rel="help" href="https://drafts.csswg.org/css-values-5/#attr-security">
+<link rel="help" href="https://drafts.css-houdini.org/css-properties-values-api-1/#animation-behavior">
+<link rel="help" href="https://drafts.csswg.org/css-transitions-2/#transition-behavior-property">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<body>
+<script>
+const images = [
+  "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='1'%20height='1'%3E%3Cpath%20fill='red'%20d='M0%200h1v1H0z'/%3E%3C/svg%3E",
+  "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='1'%20height='1'%3E%3Cpath%20fill='blue'%20d='M0%200h1v1H0z'/%3E%3C/svg%3E",
+];
+const registration = typed => `@property --source { syntax: "${typed ? "<string>" : "*"}"; inherits: false; ${typed ? 'initial-value: "initial";' : ""} }`;
+
+async function checkTransition(t, { flip, literal, behavior }) {
+  const frame = document.createElement("iframe");
+  t.add_cleanup(() => frame.remove());
+  const loaded = new Promise(resolve => frame.addEventListener("load", resolve, { once: true }));
+  frame.srcdoc = `<!doctype html><meta charset="utf-8">
+    <style id="registration">${registration(!flip)}</style>
+    <style>
+      #target { --source: ${literal ? JSON.stringify(images[0]) : "attr(data-ticket)"};
+        background-image: image-set(var(--source));
+        transition: --source 100s linear; transition-behavior: ${behavior}; }
+      #target.changed { --source: ${JSON.stringify(images[1])}; }
+      #registration-control { --source: 17px; }
+      #literal-a { background-image: image-set(${JSON.stringify(images[0])}); }
+      #literal-b { background-image: image-set(${JSON.stringify(images[1])}); }
+    </style>
+    <div id="target" data-ticket="${images[0]}"></div>
+    <div id="registration-control"></div><div id="literal-a"></div><div id="literal-b"></div>`;
+  document.body.append(frame);
+  await loaded;
+  const win = frame.contentWindow;
+  const doc = frame.contentDocument;
+  const target = doc.getElementById("target");
+  const values = () => {
+    const style = win.getComputedStyle(target);
+    return {
+      source: style.getPropertyValue("--source").trim(),
+      image: style.backgroundImage,
+      registration: win.getComputedStyle(doc.getElementById("registration-control")).getPropertyValue("--source").trim(),
+    };
+  };
+  assert_equals(doc.compatMode, "CSS1Compat");
+  const literalImages = ["literal-a", "literal-b"].map(id => win.getComputedStyle(doc.getElementById(id)).backgroundImage);
+  assert_true(literalImages.every(image => image !== "none"), "Both literal image controls are valid");
+  values();
+  await new Promise(resolve => win.requestAnimationFrame(() => win.requestAnimationFrame(resolve)));
+  const before = values();
+  assert_equals(target.getAnimations().length, 0, "No preexisting animation");
+  assert_equals(before.source, JSON.stringify(images[0]), "Initial custom value is the first string");
+  assert_equals(before.registration, flip ? "17px" : '"initial"', "Initial registration is effective");
+  assert_equals(before.image, literal ? literalImages[0] : "none", "Initial image policy");
+  if (flip) {
+    doc.getElementById("registration").textContent = registration(true);
+  }
+  if (literal) {
+    target.classList.add("changed");
+  } else {
+    target.setAttribute("data-ticket", images[1]);
+  }
+  const afterChange = values();
+  assert_equals(afterChange.registration, '"initial"', "The string registration is effective");
+  const animations = target.getAnimations();
+  if (behavior === "normal") {
+    assert_equals(animations.length, 0, "Normal behavior does not transition string values");
+    assert_equals(afterChange.source, JSON.stringify(images[1]));
+    assert_equals(afterChange.image, "none");
+    return;
+  }
+  assert_equals(animations.length, 1, "An actual transition must exist");
+  const transition = animations[0];
+  assert_true(transition instanceof win.CSSTransition, "The animation is a CSS transition");
+  assert_equals(transition.transitionProperty, "--source");
+  t.add_cleanup(() => transition.cancel());
+  transition.pause();
+  await transition.ready;
+  assert_equals(transition.effect.getComputedTiming().duration, 100000);
+  const samples = [];
+  for (const fraction of [0.25, 0.75]) {
+    transition.currentTime = 100000 * fraction;
+    samples.push({ fraction, ...values(), progress: transition.effect.getComputedTiming().progress,
+      playState: transition.playState, currentTime: transition.currentTime });
+  }
+  transition.cancel();
+  const afterCancel = values();
+  for (const [index, sample] of samples.entries()) {
+    assert_equals(sample.playState, "paused", "The sampled transition remains paused");
+    assert_equals(sample.currentTime, 100000 * sample.fraction);
+    assert_approx_equals(sample.progress, sample.fraction, 0.000001);
+    assert_equals(sample.registration, '"initial"');
+    assert_equals(sample.source, JSON.stringify(images[index]), "Discrete sample selects the expected endpoint");
+  }
+  assert_equals(afterCancel.source, JSON.stringify(images[1]), "Cancellation restores the final value");
+  assert_equals(afterCancel.image, literal ? literalImages[1] : "none", "Final image policy");
+  for (const [index, sample] of samples.entries()) {
+    assert_equals(sample.image, literal ? literalImages[index] : "none", `Image policy at ${sample.fraction} progress`);
+  }
+}
+
+promise_test(t => checkTransition(t, { flip: true, literal: false, behavior: "allow-discrete" }),
+  "Primary attribute taint survives universal-to-string registration during a transition");
+promise_test(t => checkTransition(t, { flip: false, literal: false, behavior: "allow-discrete" }),
+  "Primary attribute taint survives a stable string registration transition");
+promise_test(t => checkTransition(t, { flip: true, literal: true, behavior: "allow-discrete" }),
+  "Clean literals remain usable in images across a registration transition");
+promise_test(t => checkTransition(t, { flip: true, literal: false, behavior: "normal" }),
+  "Normal transition behavior preserves blocking without a discrete transition");
+</script>
