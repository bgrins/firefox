+def preservation(original, candidate, signature):
+    assert original["complete"] and candidate["complete"]
+    comparisons = {}
+    for field, count, keys in [("rows", 45, ("test", "subtest")), ("ends", 4, ("test",))]:
+        before = {tuple(row[key] for key in keys): row for row in original[field]}
+        after = {tuple(row[key] for key in keys): row for row in candidate[field]}
+        assert len(before) == len(original[field]) == count
+        assert len(after) == len(candidate[field]) == count and set(before) == set(after)
+        comparisons[field] = [{"original": signature(before[key]), "candidate": signature(after[key]),
+                               "full_signature_unchanged": signature(before[key]) == signature(after[key])}
+                              for key in sorted(before)]
+    return {"full_original_signature_equality": all(row["full_signature_unchanged"] for rows in comparisons.values() for row in rows),
+            "callbacks": comparisons["rows"], "endings": comparisons["ends"],
+            "native_neutrality_proved": False}
+
+
+def warning_summary(body):
+    text = body.decode("utf-8", errors="replace")
+    lines = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", text).splitlines()
+    matches = [{"line": i + 1, "text": line, "following_context": lines[i + 1:i + 5]}
+               for i, line in enumerate(lines) if re.search(r"\bwarning(?:\[[^\]\r\n]+\])?\s*:", line, re.IGNORECASE)]
+    return {"matching_warning_lines": matches, "matched_line_count": len(matches),
+            "count_is_unique_diagnostic_count": False, "complete_warning_inventory_claimed": False,
+            "decoding_replacement_present": "\ufffd" in text, "human_log_review_required": True,
+            "warning_suppression_added": False}
 
 
