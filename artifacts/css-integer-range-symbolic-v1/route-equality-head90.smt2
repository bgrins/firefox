(set-logic QF_FPBV)
(set-option :timeout 55000)
(set-option :produce-models true)
(declare-fun bits () (_ BitVec 32))
(declare-fun mode () (_ BitVec 2))
(declare-fun candidateZeroChoice () Bool)
(declare-fun contextZeroChoice () Bool)
(define-fun x () (_ FloatingPoint 8 24) ((_ to_fp 8 24) bits))
(define-fun zero () (_ FloatingPoint 8 24) ((_ to_fp 8 24) #x00000000))
(define-fun one () (_ FloatingPoint 8 24) ((_ to_fp 8 24) #x3f800000))
(define-fun maximum () (_ FloatingPoint 8 24) ((_ to_fp 8 24) #x7f7fffff))
(define-fun minimum () (_ FloatingPoint 8 24) (fp.neg maximum))
(define-fun half32 () (_ FloatingPoint 8 24) ((_ to_fp 8 24) #x3f000000))
(define-fun half64 () (_ FloatingPoint 11 53) ((_ to_fp 11 53) #x3fe0000000000000))
(define-fun bound32 () (_ FloatingPoint 8 24) ((_ to_fp 8 24) #x4f000000))
(define-fun bound64 () (_ FloatingPoint 11 53) ((_ to_fp 11 53) #x41e0000000000000))
(define-fun get ((v (_ FloatingPoint 8 24))) (_ FloatingPoint 8 24)
  (let ((normalized (ite (fp.isNaN v) zero v)))
    (ite (fp.gt normalized maximum) maximum
      (ite (fp.lt normalized minimum) minimum normalized))))
(define-fun clamp ((v (_ FloatingPoint 8 24)) (chooseZero Bool)) (_ FloatingPoint 8 24)
  (ite (= mode #b00) v
    (ite (= mode #b01)
      (ite (fp.isZero v) (ite chooseZero zero v) (ite (fp.lt v zero) zero v))
      (ite (= mode #b10) (ite (fp.lt v one) one v)
        (ite (fp.lt v zero) zero (ite (fp.gt v one) one v))))))
(define-fun candidate () (_ FloatingPoint 8 24) (clamp (get x) candidateZeroChoice))
(define-fun context () (_ FloatingPoint 8 24) (get (clamp (get x) contextZeroChoice)))
(define-fun saturate32 ((v (_ FloatingPoint 8 24))) (_ BitVec 32)
  (ite (fp.geq v bound32) #x7fffffff
    (ite (fp.leq v (fp.neg bound32)) #x80000000 ((_ fp.to_sbv 32) RTZ v))))
(define-fun saturate64 ((v (_ FloatingPoint 11 53))) (_ BitVec 32)
  (ite (fp.geq v bound64) #x7fffffff
    (ite (fp.leq v (fp.neg bound64)) #x80000000 ((_ fp.to_sbv 32) RTZ v))))
(define-fun round32 ((v (_ FloatingPoint 8 24))) (_ BitVec 32)
  (saturate32 (fp.roundToIntegral RTN (fp.add RNE v half32))))
(define-fun round64 ((v (_ FloatingPoint 8 24))) (_ BitVec 32)
  (saturate64 (fp.roundToIntegral RTN
    (fp.add RNE ((_ to_fp 11 53) RNE v) half64))))
(define-fun old32 () (_ BitVec 32) (round32 (get x)))
(define-fun new32 () (_ BitVec 32) (round32 context))
(define-fun old64 () (_ BitVec 32) (round64 (get x)))
(define-fun new64 () (_ BitVec 32) (round64 context))
(assert (not (= (round32 candidate) new32)))
(check-sat)
