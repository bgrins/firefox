+<!doctype html>
+<meta charset="utf-8">
+<title>Calculated counter range bounds preserve inclusive membership</title>
+<link rel="help" href="https://drafts.csswg.org/css-counter-styles-3/#counter-style-range">
+<link rel="help" href="https://drafts.csswg.org/css-values-4/#calc-type-checking">
+<link rel="match" href="range-calc-rendering-ref.html">
+<style>
+@counter-style both { system: cyclic; symbols: "A"; range: calc(1) calc(3); }
+.both span::before { content: counter(n, both); }
+@counter-style lower { system: cyclic; symbols: "A"; range: calc(1) 3; }
+.lower span::before { content: counter(n, lower); }
+@counter-style upper { system: cyclic; symbols: "A"; range: 1 calc(3); }
+.upper span::before { content: counter(n, upper); }
+@counter-style unbounded-end { system: cyclic; symbols: "A"; range: calc(1) infinite; }
+.unbounded-end span::before { content: counter(n, unbounded-end); }
+@counter-style unbounded-start { system: cyclic; symbols: "A"; range: infinite calc(3); }
+.unbounded-start span::before { content: counter(n, unbounded-start); }
+@counter-style union { system: cyclic; symbols: "A"; range: calc(1) calc(1), calc(3) calc(3); }
+.union span::before { content: counter(n, union); }
+@counter-style simplified { system: cyclic; symbols: "A"; range: calc(2 - 1) calc(1 + 2); }
+.simplified span::before { content: counter(n, simplified); }
+@counter-style literal { system: cyclic; symbols: "A"; range: 1 3; }
+.literal span::before { content: counter(n, literal); }
+.v0 { counter-reset: n 0; }
+.v1 { counter-reset: n 1; }
+.v2 { counter-reset: n 2; }
+.v3 { counter-reset: n 3; }
+.v4 { counter-reset: n 4; }
+</style>
+<div class="both"><span class="v0"></span><span class="v1"></span><span class="v2"></span><span class="v3"></span><span class="v4"></span></div>
+<div class="lower"><span class="v0"></span><span class="v1"></span><span class="v2"></span><span class="v3"></span><span class="v4"></span></div>
+<div class="upper"><span class="v0"></span><span class="v1"></span><span class="v2"></span><span class="v3"></span><span class="v4"></span></div>
+<div class="unbounded-end"><span class="v0"></span><span class="v1"></span><span class="v2"></span><span class="v3"></span><span class="v4"></span></div>
+<div class="unbounded-start"><span class="v0"></span><span class="v1"></span><span class="v2"></span><span class="v3"></span><span class="v4"></span></div>
+<div class="union"><span class="v0"></span><span class="v1"></span><span class="v2"></span><span class="v3"></span><span class="v4"></span></div>
+<div class="simplified"><span class="v0"></span><span class="v1"></span><span class="v2"></span><span class="v3"></span><span class="v4"></span></div>
+<div class="literal"><span class="v0"></span><span class="v1"></span><span class="v2"></span><span class="v3"></span><span class="v4"></span></div>
