+impl<'a, 'b: 'a, 'c, 'd> ResolutionContext<'a, 'b, 'c, 'd> {
+    fn reset(&mut self) {
+        assert!(self.cascade.resolution.stack.is_empty());
+        self.cascade.resolution.count = 0;
+        self.cascade.resolution.index_map.clear();
+        self.cascade.resolution.non_custom_index_map.clear();
+        self.cascade.resolution.attr_use_index_map.clear();
+        self.cascade.resolution.prepared_priorities.clear();
+        self.cascade.resolution.var_info.clear();
+        self.cascade.resolution.stack.clear();
+    }
