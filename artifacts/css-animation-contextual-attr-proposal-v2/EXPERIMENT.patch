+pub(crate) fn animation_taint_rejects_var(
+    animation_tainted: bool,
+    property_id: Option<PropertyIdRef>,
+    suppress_animation_taint_sink: bool,
+) -> bool {
+    animation_tainted
+        && !suppress_animation_taint_sink
+        && matches!(property_id, Some(PropertyIdRef::NonCustom(id)) if !id.is_animatable())
+}
+
+fn resolve_attribute_input(
+    request: usize,
+    substitution_functions: &ComputedSubstitutionFunctions,
+    stylist: &Stylist,
+    computed_context: &computed::Context,
+    attribute_tracker: &mut AttributeTracker,
+    seen: &mut SubstitutionState,
+) -> Option<ComputedRegisteredValue> {
+    let input = attribute_tracker.attr_resolution.uses[request].input.clone()?;
+    let key = attribute_tracker.attr_resolution.uses[request].key.clone();
+    let substituted = substitute_internal(
+        &input, key.property_id(), substitution_functions, stylist, computed_context,
+        attribute_tracker, seen, None, key.suppress_animation_taint_sink,
+    ).ok()?;
+    if matches!(attribute_tracker.attr_resolution.uses[request].state, AttrUseState::Cyclic) {
+        return None;
+    }
+    let mut value = ComputedRegisteredValue::universal(Arc::new(VariableValue::new_resolved(
+        substituted.css.into_owned(), &key.url_data, substituted.first_token_type,
+        substituted.last_token_type,
+    )));
+    value.attr_tainted = substituted.attr_tainted;
+    value.animation_tainted = substituted.animation_tainted;
+    Some(value)
+}
+
+pub(crate) fn finish_prepared_attribute(
+    request: usize,
+    owner: usize,
+    stylist: &Stylist,
+    computed_context: &computed::Context,
+    attribute_tracker: &mut AttributeTracker,
+) {
+    let previous = attribute_tracker.attr_resolution.prepared_owner;
+    attribute_tracker.attr_resolution.prepared_owner = Some(owner);
+    let result = resolve_attribute_input(
+        request, &computed_context.builder.substitution_functions, stylist,
+        computed_context, attribute_tracker, &mut SubstitutionState::default(),
+    );
+    attribute_tracker.attr_resolution.prepared_owner = previous;
+    attribute_tracker.attr_resolution.leave(request, result);
+}
+
+fn substitute_typed_attribute(
+    raw: &str,
+    reference: &SubstitutionFunctionReference,
+    namespace: &Namespace,
+    url_data: &UrlExtraData,
+    property_id: Option<PropertyIdRef>,
+    substitution_functions: &ComputedSubstitutionFunctions,
+    stylist: &Stylist,
+    computed_context: &computed::Context,
+    attribute_tracker: &mut AttributeTracker,
+    seen: &mut SubstitutionState,
+    suppress_animation_taint_sink: bool,
+) -> Option<Substitution<'static>> {
+    let mut parser = Parser::new(raw);
+    let input = Arc::new(VariableValue::parse(&mut parser, None, url_data).ok()?);
+    let request = if let Some(owner) = attribute_tracker.attr_resolution.prepared_owner {
+        attribute_tracker.attr_resolution.prepared_request(
+            owner, reference as *const SubstitutionFunctionReference as usize,
+            &reference.name, namespace, property_id, suppress_animation_taint_sink, url_data,
+        ).expect("Final attribute occurrence must match dependency preparation")
+    } else {
+        let key = AttrUseKey::new(
+            &reference.name, namespace, property_id, suppress_animation_taint_sink,
+            url_data, attribute_tracker.attr_resolution.uses.len(),
+        );
+        attribute_tracker.attr_resolution.request(key, Some(Arc::clone(&input)))
+    };
+    attribute_tracker.attr_resolution.uses[request].custom_depth = seen.names.len();
+    let result = match attribute_tracker.attr_resolution.enter(request) {
+        AttrEntry::Evaluate => {
+            assert!(attribute_tracker.attr_resolution.prepared_owner.is_none());
+            let result = resolve_attribute_input(
+                request, substitution_functions, stylist, computed_context, attribute_tracker, seen,
+            );
+            attribute_tracker.attr_resolution.leave(request, result.clone());
+            result
+        },
+        AttrEntry::PhysicalCycle(previous) => {
+            seen.mark_names_since(attribute_tracker.attr_resolution.uses[previous].custom_depth);
+            return None;
+        },
+        AttrEntry::Existing => match &attribute_tracker.attr_resolution.uses[request].state {
+            AttrUseState::Ready(value) => Some(value.clone()),
+            AttrUseState::Invalid | AttrUseState::Cyclic => None,
+            AttrUseState::Pending | AttrUseState::Evaluating | AttrUseState::New => {
+                panic!("Attribute result consumed before dependency closure")
+            },
+        },
+    };
+    if matches!(attribute_tracker.attr_resolution.uses[request].state, AttrUseState::Cyclic) {
+        return None;
+    }
+    let result = result?;
+    let value = result.to_variable_value();
+    let mut parser = Parser::new(&value.css);
+    let parsed = reference.attribute_data.parse_typed_value(&mut parser, url_data, property_id).ok()?;
+    let mut converted = parsed.to_variable_value();
+    converted.explicitly_animation_tainted |= result.animation_tainted;
+    Some(Substitution::from_value(converted, true))
+}
