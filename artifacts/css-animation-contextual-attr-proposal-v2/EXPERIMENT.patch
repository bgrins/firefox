+    fn handle_loop(&mut self, name: &VarType, attribute_tracker: &mut AttributeTracker) {
+        match name {
+            VarType::ContextualAttr(request) => {
+                attribute_tracker.attr_resolution.uses[*request].state = AttrUseState::Cyclic;
+            },
+            VarType::Custom(name) => {
+                // This variable is in a loop. Resolve to invalid.
+                handle_invalid_at_computed_value_time(
+                    name,
