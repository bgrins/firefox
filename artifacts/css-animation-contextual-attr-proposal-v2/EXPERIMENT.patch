+pub(crate) struct PreparedCustomSubstitution {
+    substitution: Substitution<'static>,
+    url_data: UrlExtraData,
+}
+
+impl PreparedCustomSubstitution {
+    pub fn selected_value(&self, name: &Name, registration: &PropertyDescriptors) -> Option<VariableValue> {
+        let mut parser = Parser::new(&self.substitution.css);
+        if parser.try_parse(CSSWideKeyword::parse).is_ok() {
+            return None;
+        }
+        if let Some(syntax) = registration.syntax.as_ref() {
+            let taint = if self.substitution.attr_tainted {
+                AttrTaint::new_fully_tainted(self.substitution.css.len())
+            } else {
+                AttrTaint::default()
+            };
+            let mut parser = Parser::new(&self.substitution.css);
+            if SpecifiedRegisteredValue::parse(
+                &mut parser, syntax, &self.url_data, None,
+                AllowComputationallyDependent::Yes, taint, Some(PropertyIdRef::from(name)),
+            ).is_err() {
+                return None;
+            }
+        }
+        Some(VariableValue::new_resolved(
+            self.substitution.css.to_string(), &self.url_data,
+            self.substitution.first_token_type, self.substitution.last_token_type,
+        ))
+    }
+
+    pub fn apply(self, name: &Name, stylist: &Stylist, context: &mut computed::Context) {
+        apply_substituted_value(name, None, &self.url_data, Ok(self.substitution), stylist, context);
+    }
+}
+
+pub(crate) fn prepare_custom_substitution(
+    name: &Name,
+    value: &VariableValue,
+    stylist: &Stylist,
+    context: &computed::Context,
+    attribute_tracker: &mut AttributeTracker,
+) -> Result<PreparedCustomSubstitution, ()> {
+    let mut state = SubstitutionState::default();
+    state.push_name(name, &attribute_tracker.attr_resolution);
+    let substitution = substitute_internal(
+        value, Some(PropertyIdRef::from(name)), &context.builder.substitution_functions,
+        stylist, context, attribute_tracker, &mut state, None, false,
+    )?;
+    if state.cyclic_names.contains(name) {
+        return Err(());
+    }
+    Ok(PreparedCustomSubstitution {
+        substitution: Substitution {
+            css: Cow::Owned(substitution.css.into_owned()),
+            first_token_type: substitution.first_token_type,
+            last_token_type: substitution.last_token_type,
+            attr_tainted: substitution.attr_tainted,
+            animation_tainted: substitution.animation_tainted,
+        },
+        url_data: value.url_data.clone(),
+    })
+}
