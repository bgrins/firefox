+    }
+    if (!timeToUse.IsNull()) {
+      holdTime = CurrentTimeFromTimelineTime(
+          timeToUse.Value(), mStartTime.Value(), PlaybackRateInternal());
+    }
+  }
+  return holdTime;
 }
 
