[
  {
    "name": "timeline-deferral-calls",
    "command": [
      "searchfox-cli",
      "--calls-to",
      "nsAnimationManager::UpdateDeferredTimelineChanges",
      "--depth",
      "1"
    ],
    "exit": 0
  },
  {
    "name": "timeline-prop-pref",
    "command": [
      "searchfox-cli",
      "--path",
      "servo/components/style/properties",
      "-q",
      "scroll-driven-animations.enabled"
    ],
    "exit": 0
  },
  {
    "name": "can-throttle",
    "command": [
      "searchfox-cli",
      "--define",
      "KeyframeEffect::CanThrottle"
    ],
    "exit": 0
  },
  {
    "name": "request-restyle",
    "command": [
      "searchfox-cli",
      "--define",
      "EffectCompositor::RequestRestyle"
    ],
    "exit": 0
  },
  {
    "name": "css-level",
    "command": [
      "searchfox-cli",
      "--path",
      "dom/animation/CSSAnimation.h",
      "-q",
      "CascadeLevel"
    ],
    "exit": 0
  }
]
