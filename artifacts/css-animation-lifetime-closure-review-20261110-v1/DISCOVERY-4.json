[
  {
    "name": "custom-animation",
    "command": [
      "searchfox-cli",
      "--path",
      "servo/components/style/custom_properties.rs",
      "-q",
      "animation"
    ],
    "exit": 0
  },
  {
    "name": "substitution-animation",
    "command": [
      "searchfox-cli",
      "--path",
      "servo/components/style/properties",
      "-q",
      "animation"
    ],
    "exit": 0
  },
  {
    "name": "update-binding",
    "command": [
      "searchfox-cli",
      "--path",
      "layout/style",
      "-q",
      "Gecko_UpdateAnimations"
    ],
    "exit": 0
  },
  {
    "name": "smil-calls",
    "command": [
      "searchfox-cli",
      "--calls-to",
      "mozilla::SMILAnimationController::DoSample",
      "--depth",
      "1"
    ],
    "exit": 0
  },
  {
    "name": "property-filter",
    "command": [
      "searchfox-cli",
      "--define",
      "KeyframeUtils::IsAnimatableProperty"
    ],
    "exit": 0
  }
]
