+     <li class="wpt-test"><a class="wpt-name" href="https://wpt.fyi/results/css/css-values/if-initial-unregistered.html" title="css/css-values/if-initial-unregistered.html">if-initial-unregistered.html</a> <a class="wpt-live" href="http://wpt.live/css/css-values/if-initial-unregistered.html"><small>(live test)</small></a> <a class="wpt-source" href="https://github.com/web-platform-tests/wpt/blob/master/css/css-values/if-initial-unregistered.html"><small>(source)</small></a>
+     <li class="wpt-test"><a class="wpt-name" href="https://wpt.fyi/results/css/css-values/if-invalidation.html" title="css/css-values/if-invalidation.html">if-invalidation.html</a> <a class="wpt-live" href="http://wpt.live/css/css-values/if-invalidation.html"><small>(live test)</small></a> <a class="wpt-source" href="https://github.com/web-platform-tests/wpt/blob/master/css/css-values/if-invalidation.html"><small>(source)</small></a>
