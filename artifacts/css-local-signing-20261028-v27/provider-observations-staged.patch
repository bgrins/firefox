diff --git a/artifacts/css-registered-provider-expanded-observation-runtime-baseline-1/tests/css/css-values/attr-non-type-used-fallback-cycle.html b/artifacts/css-registered-provider-expanded-observation-runtime-baseline-1/tests/css/css-values/attr-non-type-used-fallback-cycle.html
