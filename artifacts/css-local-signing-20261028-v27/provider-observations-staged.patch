diff --git a/artifacts/css-registered-provider-expanded-observation-v1/capture/testing/web-platform/tests/css/css-values/attr-cycle.html b/artifacts/css-registered-provider-expanded-observation-v1/capture/testing/web-platform/tests/css/css-values/attr-cycle.html
