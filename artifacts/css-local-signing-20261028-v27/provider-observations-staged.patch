+     <li class="wpt-test"><a class="wpt-name" href="https://wpt.fyi/results/css/css-values/if-range-with-attr-crash.html" title="css/css-values/if-range-with-attr-crash.html">if-range-with-attr-crash.html</a> <a class="wpt-live" href="http://wpt.live/css/css-values/if-range-with-attr-crash.html"><small>(live test)</small></a> <a class="wpt-source" href="https://github.com/web-platform-tests/wpt/blob/master/css/css-values/if-range-with-attr-crash.html"><small>(source)</small></a>
