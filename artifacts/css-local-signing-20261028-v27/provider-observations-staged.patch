+
+    test_invalid_attr('transition-duration', 'attr(data-foo ms)', '10px');
+    test_invalid_attr('transition-duration', 'attr(data-foo ms)', '10px foo');
+
+    test_invalid_attr('width', 'attr(())', '10px');
+    test_invalid_attr('width', 'attr(data-foo type(< length  >))', '10px');
+    test_invalid_attr('width', 'attr(data-foo type(<length> +))', '10px');
+
+    test_valid_attr("--data-foo", "attr(data-foo type(*))", "attr(data-bar number)", '3')
+    test_valid_attr("--data-foo", "attr(data-foo type(*))", "attr(data-bar %)", '3%')
+</script>
diff --git a/artifacts/css-registered-provider-expanded-observation-runtime-baseline-1/tests/css/css-values/attr-cycle.html b/artifacts/css-registered-provider-expanded-observation-runtime-baseline-1/tests/css/css-values/attr-cycle.html
