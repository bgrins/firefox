+            const val = "3";
+            units.forEach(unit => {
+                const expectedValue = val + unit;
+
+                const dimensionTypeAttrString = 'attr(data-foo type(<' + type + '>))';
+                test_valid_attr(property, dimensionTypeAttrString, expectedValue, expectedValue);
