+      win.CSS.registerProperty({name:other, syntax, inherits:false, initialValue:"vertical-lr"});
+      if (scenario === "cycle with defaulted fallback provider") {
+        win.CSS.registerProperty({name:third, syntax, inherits:false, initialValue:"vertical-lr"});
+      }
