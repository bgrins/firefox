+   <li><a href="#guarded">guarded</a><span>, in § Unnumbered section</span>
+   <li><a href="#funcdef-ident">ident()</a><span>, in § 8.8</span>
+   <li><a href="#typedef-ident-arg">&lt;ident-arg></a><span>, in § 8.8</span>
+   <li><a href="#typedef-ident-args">&lt;ident-args></a><span>, in § 8.8</span>
+   <li><a href="#funcdef-if">if()</a><span>, in § 8.3</span>
