diff --git a/artifacts/css-registered-provider-expanded-observation-runtime-baseline-1/tests/css/css-properties-values-api/registered-numeric-style-range-zoom.html b/artifacts/css-registered-provider-expanded-observation-runtime-baseline-1/tests/css/css-properties-values-api/registered-numeric-style-range-zoom.html
