+                | Self::Lvw
+                | Self::Dvw
+                | Self::Vh
+                | Self::Svh
+                | Self::Lvh
+                | Self::Dvh
+                | Self::Vmin
+                | Self::Svmin
+                | Self::Lvmin
+                | Self::Dvmin
+                | Self::Vmax
+                | Self::Svmax
+                | Self::Lvmax
+                | Self::Dvmax
+                | Self::Vb
+                | Self::Svb
+                | Self::Lvb
+                | Self::Dvb
