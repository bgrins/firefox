+    Parse,
+    PartialEq,
+    SpecifiedValueInfo,
+    ToComputedValue,
+    ToCss,
+    ToResolvedValue,
+    ToShmem,
+    ToTyped,
+)]
+#[repr(u8)]
+pub enum ImageDecoding {
+    /// Use the default heuristics.
+    Auto,
+    /// Force sync-decoding.
+    Sync,
+}
