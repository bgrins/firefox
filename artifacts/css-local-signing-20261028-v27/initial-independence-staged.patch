+            Self::Vb => SortKey::Vb,
+            Self::Svb => SortKey::Svb,
+            Self::Lvb => SortKey::Lvb,
+            Self::Dvb => SortKey::Dvb,
+            Self::Vi => SortKey::Vi,
+            Self::Svi => SortKey::Svi,
+            Self::Lvi => SortKey::Lvi,
+            Self::Dvi => SortKey::Dvi,
+            Self::Cqw => SortKey::Cqw,
+            Self::Cqh => SortKey::Cqh,
+            Self::Cqi => SortKey::Cqi,
