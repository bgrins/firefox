+            initial_values_for_custom_properties_flags: Default::default(),
+            num_rebuilds: 0,
+        }
+    }
+
+    /// Returns the document cascade data.
+    #[inline]
+    pub fn cascade_data(&self) -> &DocumentCascadeData {
+        &self.cascade_data
+    }
+
