/var/folders/6_/h8d9ydg931v94wprdz1fhbnm0000gn/T/sticky-sentinel-v3-0alfl87q/StickyUpdate.lean:423:70: error: unsolved goals
repeatLookup reflow : Bool
primaries : List Nat
w : World
chains overs : Nat → List Nat
hg : ReadyList w.nodes reflow chains overs primaries
hs : BatchSafe reflow chains w.nodes primaries
he :
  StateT.run (machinePrimaryLoop repeatLookup reflow w.nodes.size primaries)
      (StateT.run (updatePrefix reflow primaries) w).snd =
    StateT.run (primaryLoop orderedPosition repeatLookup reflow w.nodes.size primaries)
      (StateT.run (updatePrefix reflow primaries) w).snd
⊢ StateT.run (emit "flush")
      (StateT.run (primaryLoop orderedPosition repeatLookup reflow w.nodes.size primaries)
          (StateT.run (updatePrefix reflow primaries) w).snd).snd =
    have pre := StateT.run (updatePrefix reflow primaries) w;
    have body := StateT.run (primaryLoop orderedPosition repeatLookup reflow pre.fst primaries) pre.snd;
    StateT.run (emit "flush") body.snd
