(set-logic QF_FPBV)
(set-option :timeout 55000)
(set-option :produce-models true)
(declare-fun bits () (_ BitVec 32))
(define-fun x () (_ FloatingPoint 8 24) ((_ to_fp 8 24) bits))
(assert (not (or (fp.isNaN x) (fp.isInfinite x))))
(define-fun half32 () (_ FloatingPoint 8 24) ((_ to_fp 8 24) #x3f000000))
(define-fun one32 () (_ FloatingPoint 8 24) ((_ to_fp 8 24) #x3f800000))
(define-fun bound32 () (_ FloatingPoint 8 24) ((_ to_fp 8 24) #x4f000000))
(define-fun half64 () (_ FloatingPoint 11 53) ((_ to_fp 11 53) #x3fe0000000000000))
(define-fun bound64 () (_ FloatingPoint 11 53) ((_ to_fp 11 53) #x41e0000000000000))
(define-fun saturate32 ((v (_ FloatingPoint 8 24))) (_ BitVec 32)
  (ite (fp.geq v bound32) #x7fffffff
    (ite (fp.leq v (fp.neg bound32)) #x80000000 ((_ fp.to_sbv 32) RTZ v))))
(define-fun saturate64 ((v (_ FloatingPoint 11 53))) (_ BitVec 32)
  (ite (fp.geq v bound64) #x7fffffff
    (ite (fp.leq v (fp.neg bound64)) #x80000000 ((_ fp.to_sbv 32) RTZ v))))
(define-fun nearestEven () (_ FloatingPoint 8 24) (fp.roundToIntegral RNE x))
(define-fun residual () (_ FloatingPoint 8 24) (fp.sub RNE x nearestEven))
(define-fun referenceRounded () (_ FloatingPoint 8 24)
  (ite (fp.eq residual half32) (fp.add RNE nearestEven one32) nearestEven))
(define-fun reference () (_ BitVec 32) (saturate32 referenceRounded))
(define-fun promoted () (_ FloatingPoint 11 53) ((_ to_fp 11 53) RNE x))
(define-fun candidateRounded () (_ FloatingPoint 11 53)
  (fp.roundToIntegral RTN (fp.add RNE promoted half64)))
(define-fun candidate () (_ BitVec 32) (saturate64 candidateRounded))
(define-fun oldRounded () (_ FloatingPoint 8 24)
  (fp.roundToIntegral RTN (fp.add RNE x half32)))
(define-fun old () (_ BitVec 32) (saturate32 oldRounded))
(define-fun tiesEven () (_ BitVec 32) (saturate32 nearestEven))
(define-fun tiesAway () (_ BitVec 32) (saturate32 (fp.roundToIntegral RNA x)))
(define-fun truncate () (_ BitVec 32) (saturate32 (fp.roundToIntegral RTZ x)))
(assert (not (= truncate reference)))
(check-sat)
(get-value (bits x referenceRounded reference truncate))
