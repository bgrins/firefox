+          document.body.append(style, target);
+          t.add_cleanup(() => { style.remove(); target.remove(); });
+          const computed = getComputedStyle(target);
+          assert_equals(computed.direction, direction);
+          assert_equals(computed.getPropertyValue(physical), separateRules ? "5px" : "37px");
+        }, `${direction}, ${important ? "important" : "normal"} substituted ` +
+           `${shorthand ? "shorthand" : "longhand"}, ${separateRules ? "separate rules" : "same rule"}`);
+      }
+    }
+  }
+}
+for (const important of [false, true]) {
+  for (const substituted of [false, true]) {
+    test(t => {
+      assert_true(CSS.supports("font-size", "revert-rule"));
+      const id = `prioritary-rule-${serial++}`;
+      const value = substituted ? "var(--missing-rule-source, revert-rule)" : "revert-rule";
+      const style = document.createElement("style");
+      style.textContent = `
+        @layer base { #${id} { font-size:37px } }
+        #${id} { font-size:5px; --missing-rule-source:initial }
+        #${id} { font-size:${value}${important ? " !important" : ""} }
+      `;
+      const target = document.createElement("div");
+      target.id = id;
+      document.body.append(style, target);
+      t.add_cleanup(() => { style.remove(); target.remove(); });
+      assert_equals(getComputedStyle(target).fontSize, "5px");
+    }, `Prioritary property, ${important ? "important" : "normal"}, ` +
+       `${substituted ? "substituted" : "literal"} rule rollback`);
+  }
