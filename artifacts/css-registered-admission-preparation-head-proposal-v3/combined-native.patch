+fn apply_substituted_css_wide_keyword(
+    name: &Name,
+    kw: CSSWideKeyword,
+    registration: &PropertyDescriptors,
+    stylist: &Stylist,
+    context: &mut computed::Context,
+) {
+    let inherited = context.builder.inherited_style.custom_properties();
+    // TODO: It's unclear what this should do for revert / revert-layer, see
+    // https://github.com/w3c/csswg-drafts/issues/9131. For now treating as unset
+    // seems fine?
+    match (kw, registration.inherits(), context.is_root_element()) {
+        (CSSWideKeyword::Initial, _, _)
+        | (CSSWideKeyword::Revert, false, _)
+        | (CSSWideKeyword::RevertLayer, false, _)
+        | (CSSWideKeyword::RevertRule, false, _)
+        | (CSSWideKeyword::Unset, false, _)
+        | (CSSWideKeyword::Revert, true, true)
+        | (CSSWideKeyword::RevertLayer, true, true)
+        | (CSSWideKeyword::RevertRule, true, true)
+        | (CSSWideKeyword::Unset, true, true)
+        | (CSSWideKeyword::Inherit, _, true) => {
+            remove_and_insert_initial_value(
+                name,
+                registration,
+                stylist.get_custom_property_initial_values(),
+                &mut context.builder.substitution_functions,
+            );
+        },
+        (CSSWideKeyword::Revert, true, false)
+        | (CSSWideKeyword::RevertLayer, true, false)
+        | (CSSWideKeyword::RevertRule, true, false)
+        | (CSSWideKeyword::Inherit, _, false)
+        | (CSSWideKeyword::Unset, true, false) => {
+            if !registration.inherits() {
+                context
+                    .style()
+                    .add_flags(ComputedValueFlags::INHERITS_RESET_STYLE);
+            }
+            match inherited.get(registration, name) {
+                Some(value) => {
+                    context.builder.substitution_functions.insert_var(
+                        registration,
+                        name,
+                        value.clone(),
+                    );
+                },
+                None => {
+                    context
+                        .builder
+                        .substitution_functions
+                        .remove_var(registration, name);
+                },
+            };
+        },
+    }
+}
+
+fn intrinsic_registered_references(registration: &PropertyDescriptors) -> ReferenceFlags {
+    use crate::properties_and_values::syntax::data_type::DependentDataTypes;
+    if registration.syntax.as_ref().is_some_and(|syntax| {
+        syntax
+            .dependent_types()
+            .intersects(DependentDataTypes::COLOR)
+    }) {
+        ReferenceFlags::COLOR_SCHEME
+    } else {
+        ReferenceFlags::empty()
+    }
+}
+
+pub(crate) enum PreparedRegisteredValue {
+    Invalid,
+    CssWide(CSSWideKeyword),
+    Value {
+        specified: SpecifiedRegisteredValue,
+        attr_tainted: bool,
+        references: Option<ReferenceFlags>,
+    },
+}
+
+impl PreparedRegisteredValue {
+    pub(crate) fn references(&self, registration: &PropertyDescriptors) -> Option<ReferenceFlags> {
+        match self {
+            Self::Invalid => Some(intrinsic_registered_references(registration)),
+            Self::CssWide(_) => Some(ReferenceFlags::empty()),
+            Self::Value { references, .. } => *references,
+        }
+    }
+
+    pub(crate) fn apply(self, name: &Name, stylist: &Stylist, context: &mut computed::Context) {
+        let registration = stylist.get_custom_property_registration(name);
+        match self {
+            Self::Invalid => handle_invalid_at_computed_value_time(name, registration, context),
+            Self::CssWide(kw) => {
+                apply_substituted_css_wide_keyword(name, kw, registration, stylist, context);
+            },
+            Self::Value {
+                specified,
+                attr_tainted,
+                ..
+            } => {
+                let mut value = specified.to_computed_value(context);
+                value.attr_tainted |= attr_tainted;
+                context
+                    .builder
+                    .substitution_functions
+                    .insert_var(registration, name, value);
+            },
+        }
+    }
+}
+
+fn prepare_registered_substitution(
+    name: &Name,
+    substitution: Substitution,
+    registration: &PropertyDescriptors,
+    url_data: &UrlExtraData,
+) -> PreparedRegisteredValue {
+    debug_assert!(!registration.is_universal());
+    let mut parser = Parser::new(&substitution.css);
+    if let Ok(kw) = parser.try_parse(CSSWideKeyword::parse) {
+        return PreparedRegisteredValue::CssWide(kw);
+    }
+    let taint = if substitution.attr_tainted {
+        AttrTaint::new_fully_tainted(substitution.css.len())
+    } else {
+        AttrTaint::default()
+    };
+    let mut parser = Parser::new(&substitution.css);
+    let specified = match SpecifiedRegisteredValue::parse(
+        &mut parser,
+        registration.syntax.as_ref().unwrap(),
+        url_data,
+        None,
+        AllowComputationallyDependent::Yes,
+        taint,
+        Some(PropertyIdRef::from(name)),
+    ) {
+        Ok(value) => value,
+        Err(_) => return PreparedRegisteredValue::Invalid,
+    };
+    let intrinsic_references = intrinsic_registered_references(registration);
+    let mut parser = Parser::new(&substitution.css);
+    let references = VariableValue::parse(&mut parser, None, url_data)
+        .ok()
+        .map(|value| value.references.flags | intrinsic_references);
+    PreparedRegisteredValue::Value {
+        specified,
+        attr_tainted: substitution.attr_tainted,
+        references,
+    }
+}
+
+/// Requires all selected providers to have left their graph components.
+pub(crate) fn prepare_registered_value(
+    name: &Name,
+    value: &Arc<VariableValue>,
+    stylist: &Stylist,
+    context: &computed::Context,
+    attribute_tracker: &mut AttributeTracker,
+) -> PreparedRegisteredValue {
+    let substitution = match substitute_internal(
+        value,
+        Some(PropertyIdRef::from(name)),
+        &context.builder.substitution_functions,
+        stylist,
+        context,
+        attribute_tracker,
+        &mut SmallVec::new(),
+        None,
+    ) {
+        Ok(value) => value,
+        Err(()) => return PreparedRegisteredValue::Invalid,
+    };
+    prepare_registered_substitution(
+        name,
+        substitution,
+        stylist.get_custom_property_registration(name),
+        &value.url_data,
+    )
+}
