+            debug_assert_eq!(
+                unsafe {
+                    bindings::Gecko_GetFlattenedTreeParentNode(self.0)
+                        .as_ref()
+                        .map(GeckoNode)
+                },
+                self.parent_node(),
+                "Fast path stopped holding!"
+            );
+            return self.parent_node();
+        }
+
+        // NOTE(emilio): If this call is too expensive, we could manually inline more aggressively.
+        unsafe {
+            bindings::Gecko_GetFlattenedTreeParentNode(self.0)
+                .as_ref()
+                .map(GeckoNode)
+        }
+    }
