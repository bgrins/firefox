+    #[inline]
+    pub fn iter_extra_data_origins(&self) -> ExtraStyleDataIterator<'_> {
+        ExtraStyleDataIterator(self.cascade_data.iter_origins())
+    }
+
+    /// Iterate over the extra data in reverse origin order.
