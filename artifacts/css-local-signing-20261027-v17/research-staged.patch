+    /// This logic is duplicate in Gecko's nsINode::IsInShadowTree().
+    #[inline]
+    fn is_in_shadow_tree(&self) -> bool {
+        use crate::gecko_bindings::structs::NODE_IS_IN_SHADOW_TREE;
+        self.flags() & NODE_IS_IN_SHADOW_TREE != 0
+    }
