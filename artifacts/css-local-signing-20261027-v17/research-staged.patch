+    pub fn iter_extra_data_origins_rev(&self) -> ExtraStyleDataIterator<'_> {
+        ExtraStyleDataIterator(self.cascade_data.iter_origins_rev())
+    }
+
+    /// Returns the number of selectors.
+    pub fn num_selectors(&self) -> usize {
