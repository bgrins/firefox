+bool Gecko_IsSignificantChild(const nsINode* aNode,
+                              bool aWhitespaceIsSignificant) {
+  return nsStyleUtil::ThreadSafeIsSignificantChild(aNode->AsContent(),
+                                                   aWhitespaceIsSignificant);
+}
