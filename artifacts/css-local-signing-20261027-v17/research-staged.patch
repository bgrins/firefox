+    unsafe fn clear_descendant_bits(&self) {
+        unsafe {
+            self.unset_flags(
+                ELEMENT_HAS_DIRTY_DESCENDANTS_FOR_SERVO
+                    | ELEMENT_HAS_ANIMATION_ONLY_DIRTY_DESCENDANTS_FOR_SERVO
+                    | NODE_DESCENDANTS_NEED_FRAMES,
