+        if !self.as_node().is_in_shadow_tree() {
+            return None;
+        }
+        let sr = self.as_node().0.mSubtreeRoot as *const structs::ShadowRoot;
+        Some(GeckoShadowRoot(unsafe { &*sr }))
+    }
