+        input: &mut Parser,
+        allow_quirks: AllowQuirks,
+    ) -> Result<Self, ParseError> {
+        Self::parse_internal(
+            context,
+            input,
+            AllowedNumericType::All,
+            allow_quirks,
+            AllowAnchorPositioningFunctions::No,
+        )
+    }
+
+    /// Parses allowing the unitless length quirk, as well as allowing
