+        match self.0.unpack() {
+            Unpacked::Inline(unit, value) => {
+                NoCalcLength::new(unit, value).to_computed_value(context)
+            },
+            Unpacked::Boxed(calc) => {
+                let result = calc.to_computed_value(context);
+                debug_assert!(
+                    result.to_length().is_some(),
+                    "{:?} didn't resolve to a length: {:?}",
+                    calc,
+                    result,
