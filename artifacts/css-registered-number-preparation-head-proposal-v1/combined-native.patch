+pub(crate) fn is_exact_number_registration(registration: &PropertyDescriptors) -> bool {
+    use crate::properties_and_values::syntax::{ComponentName, data_type::DataType};
+    let Some(syntax) = &registration.syntax else {
+        return false;
+    };
+    let [component] = syntax.components.as_slice() else {
+        return false;
+    };
+    component.multiplier().is_none()
+        && matches!(component.name(), ComponentName::DataType(DataType::Number))
+}
+
+pub(crate) enum PreparedRegisteredNumber {
+    Invalid,
+    CssWide(CSSWideKeyword),
+    Value {
+        specified: SpecifiedRegisteredValue,
+        attr_tainted: bool,
+        references: Option<ReferenceFlags>,
+    },
+}
+
+impl PreparedRegisteredNumber {
+    pub(crate) fn references(&self) -> Option<ReferenceFlags> {
+        match self {
+            Self::Invalid | Self::CssWide(_) => Some(ReferenceFlags::empty()),
+            Self::Value { references, .. } => *references,
+        }
+    }
+
+    pub(crate) fn apply(self, name: &Name, stylist: &Stylist, context: &mut computed::Context) {
+        let registration = stylist.get_custom_property_registration(name);
+        match self {
+            Self::Invalid => handle_invalid_at_computed_value_time(name, registration, context),
+            Self::CssWide(kw) => {
+                apply_substituted_css_wide_keyword(name, kw, registration, stylist, context);
+            },
+            Self::Value {
+                specified,
+                attr_tainted,
+                ..
+            } => {
+                let mut value = specified.to_computed_value(context);
+                value.attr_tainted |= attr_tainted;
+                context
+                    .builder
+                    .substitution_functions
+                    .insert_var(registration, name, value);
+            },
+        }
+    }
+}
+
+fn prepare_number_substitution(
+    name: &Name,
+    substitution: Substitution,
+    registration: &PropertyDescriptors,
+    url_data: &UrlExtraData,
+) -> PreparedRegisteredNumber {
+    debug_assert!(is_exact_number_registration(registration));
+    let mut parser = Parser::new(&substitution.css);
+    if let Ok(kw) = parser.try_parse(CSSWideKeyword::parse) {
+        return PreparedRegisteredNumber::CssWide(kw);
+    }
+    let taint = if substitution.attr_tainted {
+        AttrTaint::new_fully_tainted(substitution.css.len())
+    } else {
+        AttrTaint::default()
+    };
+    let mut parser = Parser::new(&substitution.css);
+    let specified = match SpecifiedRegisteredValue::parse(
+        &mut parser,
+        registration.syntax.as_ref().unwrap(),
+        url_data,
+        None,
+        AllowComputationallyDependent::Yes,
+        taint,
+        Some(PropertyIdRef::from(name)),
+    ) {
+        Ok(value) => value,
+        Err(_) => return PreparedRegisteredNumber::Invalid,
+    };
+    let references = specified.number_context_references();
+    PreparedRegisteredNumber::Value {
+        specified,
+        attr_tainted: substitution.attr_tainted,
+        references,
+    }
+}
+
+/// Requires all selected providers to have left their graph components.
+pub(crate) fn prepare_registered_number(
+    name: &Name,
+    value: &Arc<VariableValue>,
+    stylist: &Stylist,
+    context: &computed::Context,
+    attribute_tracker: &mut AttributeTracker,
+) -> PreparedRegisteredNumber {
+    let substitution = match substitute_internal(
+        value,
+        Some(PropertyIdRef::from(name)),
+        &context.builder.substitution_functions,
+        stylist,
+        context,
+        attribute_tracker,
+        &mut SmallVec::new(),
+        None,
+    ) {
+        Ok(value) => value,
+        Err(()) => return PreparedRegisteredNumber::Invalid,
+    };
+    prepare_number_substitution(
+        name,
+        substitution,
+        stylist.get_custom_property_registration(name),
+        &value.url_data,
+    )
+}
