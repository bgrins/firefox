diff --git a/testing/web-platform/tests/css/css-values/attr-noncustom-dependency-cycles.html b/testing/web-platform/tests/css/css-values/attr-noncustom-dependency-cycles.html
new file mode 100644
--- /dev/null
+++ b/testing/web-platform/tests/css/css-values/attr-noncustom-dependency-cycles.html
@@ -0,0 +1,161 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Attribute dependencies in font-size and line-height cycles</title>
+<link rel="help" href="https://drafts.css-houdini.org/css-properties-values-api-1/#dependency-cycles">
+<link rel="help" href="https://drafts.csswg.org/css-values-5/#attr-substitution">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<body>
+<script>
+CSS.registerProperty({name: "--edge-length", syntax: "<length>", inherits: false,
+                      initialValue: "11px"});
+const cases = [
+  {
+    "name": "An attr-only font-size declaration participates in a registered length cycle",
+    "declarations": "--edge-length:1em;font-size:attr(a type(<length>),5px)",
+    "attributes": {
+      "a": "var(--edge-length)"
+    },
+    "expected": {
+      "--edge-length": "11px",
+      "font-size": "23px",
+      "line-height": "31px",
+      "width": "11px"
+    }
+  },
+  {
+    "name": "A lexical var does not change the font-size attribute cycle",
+    "declarations": "--zero:0px;--edge-length:1em;font-size:calc(var(--zero) + attr(a type(<length>),5px))",
+    "attributes": {
+      "a": "var(--edge-length)"
+    },
+    "expected": {
+      "--edge-length": "11px",
+      "font-size": "23px",
+      "line-height": "31px",
+      "width": "11px"
+    }
+  },
+  {
+    "name": "An attr-only line-height declaration participates in a registered length cycle",
+    "declarations": "--edge-length:1lh;line-height:attr(a type(<length>),5px)",
+    "attributes": {
+      "a": "var(--edge-length)"
+    },
+    "expected": {
+      "--edge-length": "11px",
+      "font-size": "23px",
+      "line-height": "31px",
+      "width": "11px"
+    }
+  },
+  {
+    "name": "A lexical var does not change the line-height attribute cycle",
+    "declarations": "--zero:0px;--edge-length:1lh;line-height:calc(var(--zero) + attr(a type(<length>),5px))",
+    "attributes": {
+      "a": "var(--edge-length)"
+    },
+    "expected": {
+      "--edge-length": "11px",
+      "font-size": "23px",
+      "line-height": "31px",
+      "width": "11px"
+    }
+  },
+  {
+    "name": "An attr-only font-size declaration follows a used attribute fallback",
+    "declarations": "--edge-length:1em;font-size:attr(missing type(<length>),attr(a type(<length>),5px))",
+    "attributes": {
+      "a": "var(--edge-length)"
+    },
+    "expected": {
+      "--edge-length": "11px",
+      "font-size": "23px",
+      "line-height": "31px",
+      "width": "11px"
+    }
+  },
+  {
+    "name": "An unused attribute fallback does not create a font-size cycle",
+    "declarations": "--edge-length:1em;font-size:attr(good type(<length>),attr(a type(<length>),5px))",
+    "attributes": {
+      "good": "13px",
+      "a": "var(--edge-length)"
+    },
+    "expected": {
+      "--edge-length": "13px",
+      "font-size": "13px",
+      "line-height": "31px",
+      "width": "13px"
+    }
+  },
+  {
+    "name": "A literal attribute value does not create a font-size cycle",
+    "declarations": "--edge-length:1em;font-size:attr(a type(<length>),5px)",
+    "attributes": {
+      "a": "13px"
+    },
+    "expected": {
+      "--edge-length": "13px",
+      "font-size": "13px",
+      "line-height": "31px",
+      "width": "13px"
+    }
+  },
+  {
+    "name": "A missing attribute uses the literal font-size fallback",
+    "declarations": "--edge-length:1em;font-size:attr(a type(<length>),5px)",
+    "attributes": {},
+    "expected": {
+      "--edge-length": "5px",
+      "font-size": "5px",
+      "line-height": "31px",
+      "width": "5px"
+    }
+  },
+  {
+    "name": "A custom property without relative units has no font-size back edge",
+    "declarations": "--edge-length:13px;font-size:attr(a type(<length>),5px)",
+    "attributes": {
+      "a": "var(--edge-length)"
+    },
+    "expected": {
+      "--edge-length": "13px",
+      "font-size": "13px",
+      "line-height": "31px",
+      "width": "13px"
+    }
+  },
+  {
+    "name": "A custom property without relative units has no line-height back edge",
+    "declarations": "--edge-length:13px;line-height:attr(a type(<length>),5px)",
+    "attributes": {
+      "a": "var(--edge-length)"
+    },
+    "expected": {
+      "--edge-length": "13px",
+      "font-size": "23px",
+      "line-height": "13px",
+      "width": "13px"
+    }
+  }
+];
+for (const item of cases) {
+  test(t => {
+    const parent = document.createElement("div");
+    parent.style.cssText = "font-size: 23px; line-height: 31px";
+    const target = document.createElement("div");
+    target.style.cssText = "width: var(--edge-length); " + item.declarations;
+    for (const [name, value] of Object.entries(item.attributes)) {
+      target.setAttribute(name, value);
+    }
+    parent.append(target);
+    document.body.append(parent);
+    t.add_cleanup(() => parent.remove());
+    const computed = getComputedStyle(target);
+    for (const [property, expected] of Object.entries(item.expected)) {
+      assert_equals(computed.getPropertyValue(property).trim(), expected, property);
+    }
+  }, item.name);
+}
+</script>
