+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<body>
+<script>
+"use strict";
+let serial = 0;
+const modes = ["CSS ordinary", "CSS registered", "WAAPI ordinary", "WAAPI registered"];
+const expression = name => `attr(${name} type(<number>), 0.125)`;
+
+function node(t, attached = true) {
+  const result = document.createElement("div");
+  result.id = `watch${++serial}`;
+  if (attached) document.body.append(result);
+  t.add_cleanup(() => result.remove());
+  return result;
+}
+
+function opacity(target, pseudo = "") {
+  const value = Number(getComputedStyle(target, pseudo || null).opacity);
+  assert_true(Number.isFinite(value) && value >= 0 && value <= 1,
+              "finite opacity calibration");
+  return value;
+}
+
+function setValue(target, name, value) {
+  if (value === null) target.removeAttribute(name);
+  else target.setAttribute(name, value);
+  assert_equals(target.getAttribute(name), value, "attribute mutation retained");
+}
+
+function frames(property, value) {
+  return [{[property]: value}, {[property]: value}];
+}
