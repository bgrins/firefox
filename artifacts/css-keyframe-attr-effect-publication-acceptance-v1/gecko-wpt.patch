+  animation.pause();
+  animation.currentTime = 500;
+  await animation.ready;
+  t.add_cleanup(() => animation.cancel());
+  assert_equals(animation.playState, "paused", "paused calibration");
+  assert_equals(animation.currentTime, 500, "fixed time calibration");
+  assert_equals(animation.effect.getComputedTiming().progress, 0.5, "midpoint calibration");
+  return animation;
+}
+
+async function prepare(t, mode, {pseudo = "", initial = "0.25", value = expression("data-a")} = {}) {
+  const target = node(t);
+  const ordinary = node(t);
+  const literal = node(t);
+  setValue(target, "data-a", initial);
+  const property = mode.endsWith("registered") ? `--watch-${serial}` : "opacity";
+  if (property !== "opacity") {
+    assert_equals(typeof CSS.registerProperty, "function", "registration available");
+    CSS.registerProperty({name: property, syntax: "<number>", inherits: false, initialValue: "0.875"});
+  }
+  const animationName = `watchAnimation${serial}`;
+  const style = document.createElement("style");
+  style.textContent = `#${target.id}${pseudo} {
+      content: ""; display: block;
+      opacity: ${property === "opacity" ? "0.875" : `var(${property})`};
+    }
+    @keyframes ${animationName} { from { ${property}: ${value}; } to { ${property}: ${value}; } }`;
+  document.head.append(style);
+  t.add_cleanup(() => style.remove());
+  assert_equals(style.sheet.cssRules.length, 2, "style and keyframes retained");
+  const targetRule = style.sheet.cssRules[0];
+  const keyframes = style.sheet.cssRules[1];
+  for (const frame of keyframes.cssRules) {
+    assert_not_equals(frame.style.getPropertyValue(property), "", "keyframe syntax retained");
+  }
+  ordinary.style.opacity = expression("data-a");
+  assert_not_equals(ordinary.style.opacity, "", "ordinary attr syntax retained");
+  const literalAnimation = await pause(t, literal.animate(
+    frames("opacity", "0.375"), {duration: 1000, fill: "both"}));
+  assert_equals(opacity(literal), 0.375, "independent literal effect calibration");
+  let animation;
+  if (mode.startsWith("CSS")) {
+    targetRule.style.animation = `${animationName} 1000ms linear paused both`;
+    const animations = target.getAnimations({subtree: true}).filter(a =>
+      a.effect.target === target && (a.effect.pseudoElement || "") === pseudo);
+    assert_equals(animations.length, 1, "one CSS effect for target and pseudo");
+    animation = animations[0];
+    assert_true(animation instanceof CSSAnimation, "CSS ownership calibration");
+  } else {
+    animation = target.animate(frames(property, value),
+      {duration: 1000, fill: "both", pseudoElement: pseudo || null});
+    assert_false(animation instanceof CSSAnimation, "WAAPI ownership calibration");
+  }
