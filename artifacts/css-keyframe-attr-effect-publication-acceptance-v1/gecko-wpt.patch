+}
+
+function stable(setup) {
+  assert_equals(setup.animation.currentTime, 500, "sample time retained");
+  assert_equals(setup.animation.effect.getComputedTiming().progress, 0.5, "sample remains in effect");
+  const first = opacity(setup.target, setup.pseudo);
+  assert_equals(opacity(setup.target, setup.pseudo), first, "stable repeated read");
+  return first;
+}
+
+function sample(setup, name, value, expected, observations) {
+  setValue(setup.target, name, value);
+  const actual = stable(setup);
+  setValue(setup.ordinary, "data-a", value);
+  assert_equals(opacity(setup.ordinary), expected, "independent ordinary provider after mutation");
+  observations.push({actual, expected});
+}
+
+function finish(setup, observations, expected) {
+  setup.targetRule.style.outlineColor = "red";
+  setup.target.style.outlineColor = "red";
+  assert_equals(stable(setup), expected, "forced normal recomputation calibration");
+  assert_equals(opacity(setup.literal), 0.375, "literal effect remains stable");
+  assert_array_equals(observations.map(x => x.actual), observations.map(x => x.expected),
+                      "attribute-watch first reads");
+}
+
+function replace(setup, value) {
+  const effect = setup.animation.effect;
+  if (setup.mode.startsWith("CSS")) {
+    for (const frame of setup.keyframes.cssRules) frame.style.setProperty(setup.property, value);
+  } else {
+    effect.setKeyframes(frames(setup.property, value));
+  }
+  assert_equals(setup.animation.effect, effect, "replacement retains effect identity");
+}
+
+for (const mode of modes) {
+  promise_test(async t => {
+    const setup = await prepare(t, mode, {initial: null});
+    assert_equals(stable(setup), 0.125, "initial missing attribute fallback calibration");
+    const observations = [];
+    sample(setup, "data-a", "0.75", 0.75, observations);
+    sample(setup, "data-a", null, 0.125, observations);
+    sample(setup, "data-a", "0.5", 0.5, observations);
+    finish(setup, observations, 0.5);
+  }, `${mode}: initially absent attribute is watched`);
+
+  promise_test(async t => {
+    const setup = await prepare(t, mode, {value: "0.25"});
+    assert_equals(stable(setup), 0.25, "initial literal calibration");
+    replace(setup, expression("data-a"));
+    assert_equals(stable(setup), 0.25, "equal-value attr replacement calibration");
+    const observations = [];
+    sample(setup, "data-a", "0.75", 0.75, observations);
+    setValue(setup.target, "data-b", "0.75");
+    replace(setup, expression("data-b"));
+    assert_equals(stable(setup), 0.75, "equal-value name replacement calibration");
+    sample(setup, "data-b", "0.5", 0.5, observations);
+    finish(setup, observations, 0.5);
+  }, `${mode}: equal endpoint values retain new attribute dependencies`);
+
+  promise_test(async t => {
+    const setup = await prepare(t, mode);
+    assert_equals(stable(setup), 0.25, "initial provider calibration");
+    const extra = await pause(t, setup.target.animate(
+      frames(setup.property, expression("data-a")), {duration: 1000, fill: "both"}));
+    assert_equals(stable(setup), 0.25, "both effects computed");
+    extra.cancel();
+    const observations = [];
+    sample(setup, "data-a", "0.75", 0.75, observations);
+    assert_equals(extra.playState, "idle", "other effect cancelled");
+    finish(setup, observations, 0.75);
+  }, `${mode}: cancelling one effect preserves the remaining attribute watch`);
+
+  promise_test(async t => {
+    const setup = await prepare(t, mode, {pseudo: "::before"});
+    assert_equals(stable(setup), 0.25, "initial pseudo provider calibration");
+    const observations = [];
+    sample(setup, "data-a", "0.75", 0.75, observations);
+    sample(setup, "data-a", null, 0.125, observations);
+    finish(setup, observations, 0.125);
+  }, `${mode}: before pseudo reads changed originating attributes`);
+}
+
+for (const mode of ["WAAPI ordinary", "WAAPI registered"]) {
+  promise_test(async t => {
+    const setup = await prepare(t, mode);
+    assert_equals(stable(setup), 0.25, "source effect computed");
+    const source = setup.animation;
+    const copy = new KeyframeEffect(source.effect);
+    setup.animation = new Animation(copy, document.timeline);
+    setup.animation.play();
+    await pause(t, setup.animation);
+    source.cancel();
+    assert_equals(stable(setup), 0.25, "copied effect calibration");
+    const observations = [];
+    sample(setup, "data-a", "0.75", 0.75, observations);
+    finish(setup, observations, 0.75);
+  }, `${mode}: copied effects retain attribute dependencies`);
+
+  for (const attached of [true, false]) {
+    promise_test(async t => {
+      const setup = await prepare(t, mode);
+      assert_equals(stable(setup), 0.25, "original target provider calibration");
+      const previousTarget = setup.target;
+      const target = node(t, attached);
+      target.style.opacity = setup.property === "opacity" ? "0.875" : `var(${setup.property})`;
+      setValue(target, "data-a", "0.5");
+      if (attached) assert_equals(opacity(target), 0.875, "new target has underlying style");
+      const effect = setup.animation.effect;
+      effect.target = target;
+      setup.target = target;
+      assert_equals(effect.target, target, "retargeting retained");
+      const observations = [];
+      if (attached) {
+        assert_equals(stable(setup), 0.5, "initial retarget provider calibration");
+        sample(setup, "data-a", "0.625", 0.625, observations);
+      } else {
+        setValue(target, "data-a", "0.625");
+        document.body.append(target);
+        assert_equals(stable(setup), 0.625, "new target provider calibration");
+      }
+      assert_equals(opacity(previousTarget), 0.875, "old target has no effect");
+      sample(setup, "data-a", "0.75", 0.75, observations);
+      finish(setup, observations, 0.75);
+    }, `${mode}: ${attached ? "styled" : "initially unstyled"} retarget retains attribute dependencies`);
+  }
+}
+</script>
diff --git a/testing/web-platform/tests/css/css-animations/keyframe-attribute-generated-pseudos.html b/testing/web-platform/tests/css/css-animations/keyframe-attribute-generated-pseudos.html
new file mode 100644
--- /dev/null
+++ b/testing/web-platform/tests/css/css-animations/keyframe-attribute-generated-pseudos.html
@@ -0,0 +1,170 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Attribute dependencies in after and marker keyframe effects</title>
+<link rel="help" href="https://drafts.csswg.org/css-lists-3/#marker-properties">
+<link rel="help" href="https://drafts.csswg.org/web-animations-1/#calculating-computed-keyframes">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<body>
+<script>
+"use strict";
+let serial = 0;
+const kinds = [
+  {pseudo: "::after", css: "opacity", js: "opacity", attribute: "data-number",
+   expression: "attr(data-number type(<number>), 0.125)", underlying: "0.875", literal: "0.375",
+   initial: "0.25", expected: 0.25, literalExpected: 0.375,
+   stages: [["0.75", 0.75], [null, 0.125], ["0.5", 0.5]]},
+  {pseudo: "::marker", css: "font-size", js: "fontSize", attribute: "data-size",
+   expression: "attr(data-size px, 12px)", underlying: "8px", literal: "28px",
+   initial: "20", expected: 20, literalExpected: 28,
+   stages: [["40", 40], [null, 12], ["30", 30]]},
+];
+
+function node(t, kind) {
+  const wrapper = document.createElement(kind.pseudo === "::marker" ? "ul" : "div");
+  wrapper.style.cssText = "margin:0; padding:0; border:0";
+  const target = document.createElement(kind.pseudo === "::marker" ? "li" : "div");
+  target.id = `pseudoWatch${++serial}`;
+  target.style.cssText = "margin:0; padding:0; border:0; font:16px monospace; list-style-position:inside";
+  const text = document.createElement("span");
+  text.textContent = "body";
+  target.append(text);
+  wrapper.append(target);
+  document.body.append(wrapper);
+  t.add_cleanup(() => wrapper.remove());
+  return target;
+}
+
+function setValue(target, kind, value) {
+  if (value === null) target.removeAttribute(kind.attribute);
+  else target.setAttribute(kind.attribute, value);
+  assert_equals(target.getAttribute(kind.attribute), value, "attribute mutation retained");
+}
+
+function metric(target, kind) {
+  const text = getComputedStyle(target, kind.pseudo)[kind.js];
+  const value = kind.js === "fontSize" ? parseFloat(text) : Number(text);
+  assert_true(Number.isFinite(value), "finite pseudo sample");
+  if (kind.js === "fontSize") {
+    assert_true(text.endsWith("px") && value > 0 && value < 1000, "positive pixel font size");
+  } else {
+    assert_true(value >= 0 && value <= 1, "opacity range calibration");
+  }
+  return value;
+}
+
+function generated(target, kind) {
+  assert_equals(getComputedStyle(target, kind.pseudo).content, '"XX"', "pseudo content calibration");
+  assert_greater_than(target.getBoundingClientRect().height, 0, "rendered target calibration");
+  if (kind.pseudo === "::marker") {
+    assert_equals(getComputedStyle(target).display, "list-item", "rendered list item");
+    assert_equals(getComputedStyle(target).listStylePosition, "inside", "inside marker calibration");
+    const advance = target.firstElementChild.getBoundingClientRect().left - target.getBoundingClientRect().left;
+    assert_greater_than(advance, 0, "rendered marker advances inline content");
+  }
+}
+
+function prepare(t, kind) {
+  const target = node(t, kind);
+  const ordinary = node(t, kind);
+  const literal = node(t, kind);
+  for (const element of [target, ordinary]) setValue(element, kind, kind.initial);
+  const name = `pseudoAttribute${serial}`;
+  const style = document.createElement("style");
+  style.textContent = `#${target.id}${kind.pseudo} {content:"XX"; ${kind.css}:${kind.underlying}}
+    #${ordinary.id}${kind.pseudo} {content:"XX"; ${kind.css}:${kind.expression}}
+    #${literal.id}${kind.pseudo} {content:"XX"; ${kind.css}:${kind.underlying}}
+    @keyframes ${name} {from {${kind.css}:${kind.expression}} to {${kind.css}:${kind.expression}}}
+    @keyframes ${name}Literal {from {${kind.css}:${kind.literal}} to {${kind.css}:${kind.literal}}}`;
+  document.head.append(style);
+  t.add_cleanup(() => style.remove());
+  const rules = style.sheet.cssRules;
+  assert_equals(rules.length, 5, "pseudo and keyframe rules retained");
+  assert_not_equals(rules[1].style.getPropertyValue(kind.css), "", "ordinary attr syntax retained");
+  for (const frame of rules[3].cssRules) {
+    assert_not_equals(frame.style.getPropertyValue(kind.css), "", "keyframe attr syntax retained");
+  }
+  for (const element of [target, ordinary, literal]) generated(element, kind);
+  return {target, ordinary, literal, rule: rules[0], literalRule: rules[2], name};
+}
+
+async function start(t, kind, mode, target, rule, name, value) {
+  let animation;
+  if (mode === "CSS") {
+    rule.style.animation = `${name} 1000ms linear paused both`;
+    const matches = target.getAnimations({subtree:true}).filter(a =>
+      a.effect.target === target && a.effect.pseudoElement === kind.pseudo);
+    assert_equals(matches.length, 1, "one CSS animation on expected pseudo");
+    animation = matches[0];
+    assert_true(animation instanceof CSSAnimation, "CSS ownership calibration");
+  } else {
+    animation = target.animate([{[kind.js]:value}, {[kind.js]:value}],
+      {duration:1000, fill:"both", pseudoElement:kind.pseudo});
+    assert_false(animation instanceof CSSAnimation, "WAAPI ownership calibration");
+  }
+  animation.pause();
+  animation.currentTime = 500;
+  await animation.ready;
+  t.add_cleanup(() => animation.cancel());
+  assert_equals(animation.effect.target, target, "originating target calibration");
+  assert_equals(animation.effect.pseudoElement, kind.pseudo, "pseudo identity calibration");
+  assert_equals(animation.playState, "paused", "paused calibration");
+  assert_equals(animation.effect.getComputedTiming().progress, 0.5, "progress calibration");
+  return animation;
+}
+
+for (const kind of kinds) {
+  for (const mode of ["CSS", "WAAPI"]) {
+    for (const history of ["retained", "fresh"]) {
+      promise_test(async t => {
+        const setup = prepare(t, kind);
+        const literalAnimation = await start(t, kind, mode, setup.literal, setup.literalRule,
+          `${setup.name}Literal`, kind.literal);
+        assert_equals(metric(setup.literal, kind), kind.literalExpected, "literal animation calibration");
+        let animation = await start(t, kind, mode, setup.target, setup.rule, setup.name, kind.expression);
+        const first = animation;
+        assert_equals(metric(setup.target, kind), kind.expected, "initial animated provider calibration");
+        assert_equals(metric(setup.ordinary, kind), kind.expected, "initial ordinary provider calibration");
+        const actuals = [];
+        for (const [value, expected] of kind.stages) {
+          if (history === "fresh") {
+            animation.cancel();
+            setup.rule.style.animation = "none";
+            assert_equals(setup.target.getAnimations({subtree:true}).filter(a =>
+              a.effect.target === setup.target && a.effect.pseudoElement === kind.pseudo).length,
+              0, "fresh history removes old effect");
+            metric(setup.target, kind);
+          }
+          setValue(setup.target, kind, value);
+          if (history === "fresh") {
+            const previous = animation;
+            animation = await start(t, kind, mode, setup.target, setup.rule, setup.name, kind.expression);
+            assert_not_equals(animation, previous, "fresh effect identity");
+          }
+          assert_equals(animation.currentTime, 500, "fixed sample time");
+          assert_equals(animation.effect.getComputedTiming().progress, 0.5, "active sample phase");
+          const actual = metric(setup.target, kind);
+          assert_equals(metric(setup.target, kind), actual, "stable repeated pseudo read");
+          setValue(setup.ordinary, kind, value);
+          assert_equals(metric(setup.ordinary, kind), expected, "ordinary pseudo provider after mutation");
+          assert_equals(metric(setup.literal, kind), kind.literalExpected, "independent literal remains stable");
+          actuals.push(actual);
+          if (history === "retained") assert_equals(animation, first, "effect identity retained");
+        }
+        setup.rule.style.color = "rgb(1, 2, 3)";
+        assert_equals(metric(setup.target, kind), kind.stages.at(-1)[1], "forced normal pseudo recomputation");
+        assert_equals(literalAnimation.currentTime, 500, "literal time retained");
+        assert_array_equals(actuals, kind.stages.map(stage => stage[1]), "generated-pseudo first reads");
+      }, `${mode} ${kind.pseudo}: ${history} attribute history`);
+    }
+  }
+  test(t => {
+    const setup = prepare(t, kind);
+    assert_equals(metric(setup.ordinary, kind), kind.expected, "initial ordinary pseudo provider");
+    for (const [value, expected] of kind.stages) {
+      setValue(setup.ordinary, kind, value);
+      assert_equals(metric(setup.ordinary, kind), expected, "ordinary generated pseudo mutation");
+    }
+  }, `${kind.pseudo}: ordinary attribute control`);
+}
+</script>
diff --git a/testing/web-platform/tests/css/css-animations/keyframe-attribute-unstyled-replacement.html b/testing/web-platform/tests/css/css-animations/keyframe-attribute-unstyled-replacement.html
