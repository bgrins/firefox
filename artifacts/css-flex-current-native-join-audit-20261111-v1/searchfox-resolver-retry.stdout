    3303:       uint32_t numItemsWithLargestWeight = 0;
    3304: 
    3305:       // Since this loop only operates on unfrozen flex items, we can break as
    3306:       // soon as we have seen all of them.
    3307:       uint32_t numUnfrozenItemsToBeSeen = NumItems() - mNumFrozenItems;
    3308:       for (FlexItem& item : Items()) {
    3309:         if (numUnfrozenItemsToBeSeen == 0) {
    3310:           break;
    3311:         }
    3312: 
    3313:         if (!item.IsFrozen()) {
    3314:           numUnfrozenItemsToBeSeen--;
    3315: 
    3316:           const double curWeight = item.GetWeight(isUsingFlexGrow);
    3317:           const double curFlexFactor = item.GetFlexFactor(isUsingFlexGrow);
    3318:           MOZ_ASSERT(curWeight >= 0.0, "weights are non-negative");
    3319:           MOZ_ASSERT(curFlexFactor >= 0.0, "flex factors are non-negative");
