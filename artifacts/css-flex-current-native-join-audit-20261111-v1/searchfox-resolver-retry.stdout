    3253:     FLEX_LOGV("Available free space: %" PRId64 "; flex items should \"%s\"",
    3254:               availableFreeSpace.value, isUsingFlexGrow ? "grow" : "shrink");
    3255: 
    3256:     // The sign of our free space should agree with the type of flexing
    3257:     // (grow/shrink) that we're doing. Any disagreement should've made us use
    3258:     // the other type of flexing, or should've been resolved in
    3259:     // FreezeItemsEarly.
