    3192:     for (FlexItem& item : Items()) {
    3193:       aLineInfo->mItems[itemIndex].mMainBaseSize = item.FlexBaseSize();
    3194:       aLineInfo->mItems[itemIndex].mMainDeltaSize = 0;
    3195:       ++itemIndex;
    3196:     }
    3197:   }
    3198: 
    3199:   // Determine whether we're going to be growing or shrinking items.
