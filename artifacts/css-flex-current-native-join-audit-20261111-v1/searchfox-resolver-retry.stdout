    3218:   }
    3219:   MOZ_ASSERT(!IsEmpty() || aLineInfo,
    3220:              "empty lines should take the early-return above");
    3221: 
    3222:   FLEX_LOG("Resolving flexible lengths for items");
    3223: 
    3224:   // Subtract space occupied by our items' margins/borders/padding/gaps, so
    3225:   // we can just be dealing with the space available for our flex items' content
    3226:   // boxes.
    3227:   const AuCoord64 totalItemMBPAndGaps = mTotalItemMBP + SumOfGaps();
    3228:   const AuCoord64 spaceAvailableForFlexItemsContentBoxes =
    3229:       flexContainerMainSize - totalItemMBPAndGaps;
