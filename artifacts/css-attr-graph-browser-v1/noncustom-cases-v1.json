[
  {
    "name": "An attr-only font-size declaration participates in a registered length cycle",
    "declarations": "--edge-length:1em;font-size:attr(a type(<length>),5px)",
    "attributes": {
      "a": "var(--edge-length)"
    },
    "expected": {
      "--edge-length": "11px",
      "font-size": "23px",
      "line-height": "31px",
      "width": "11px"
    }
  },
  {
    "name": "A lexical var does not change the font-size attribute cycle",
    "declarations": "--zero:0px;--edge-length:1em;font-size:calc(var(--zero) + attr(a type(<length>),5px))",
    "attributes": {
      "a": "var(--edge-length)"
    },
    "expected": {
      "--edge-length": "11px",
      "font-size": "23px",
      "line-height": "31px",
      "width": "11px"
    }
  },
  {
    "name": "An attr-only line-height declaration participates in a registered length cycle",
    "declarations": "--edge-length:1lh;line-height:attr(a type(<length>),5px)",
    "attributes": {
      "a": "var(--edge-length)"
    },
    "expected": {
      "--edge-length": "11px",
      "font-size": "23px",
      "line-height": "31px",
      "width": "11px"
    }
  },
  {
    "name": "A lexical var does not change the line-height attribute cycle",
    "declarations": "--zero:0px;--edge-length:1lh;line-height:calc(var(--zero) + attr(a type(<length>),5px))",
    "attributes": {
      "a": "var(--edge-length)"
    },
    "expected": {
      "--edge-length": "11px",
      "font-size": "23px",
      "line-height": "31px",
      "width": "11px"
    }
  },
  {
    "name": "An attr-only font-size declaration follows a used attribute fallback",
    "declarations": "--edge-length:1em;font-size:attr(missing type(<length>),attr(a type(<length>),5px))",
    "attributes": {
      "a": "var(--edge-length)"
    },
    "expected": {
      "--edge-length": "11px",
      "font-size": "23px",
      "line-height": "31px",
      "width": "11px"
    }
  },
  {
    "name": "An unused attribute fallback does not create a font-size cycle",
    "declarations": "--edge-length:1em;font-size:attr(good type(<length>),attr(a type(<length>),5px))",
    "attributes": {
      "good": "13px",
      "a": "var(--edge-length)"
    },
    "expected": {
      "--edge-length": "13px",
      "font-size": "13px",
      "line-height": "31px",
      "width": "13px"
    }
  },
  {
    "name": "A literal attribute value does not create a font-size cycle",
    "declarations": "--edge-length:1em;font-size:attr(a type(<length>),5px)",
    "attributes": {
      "a": "13px"
    },
    "expected": {
      "--edge-length": "13px",
      "font-size": "13px",
      "line-height": "31px",
      "width": "13px"
    }
  },
  {
    "name": "A missing attribute uses the literal font-size fallback",
    "declarations": "--edge-length:1em;font-size:attr(a type(<length>),5px)",
    "attributes": {},
    "expected": {
      "--edge-length": "5px",
      "font-size": "5px",
      "line-height": "31px",
      "width": "5px"
    }
  },
  {
    "name": "A custom property without relative units has no font-size back edge",
    "declarations": "--edge-length:13px;font-size:attr(a type(<length>),5px)",
    "attributes": {
      "a": "var(--edge-length)"
    },
    "expected": {
      "--edge-length": "13px",
      "font-size": "13px",
      "line-height": "31px",
      "width": "13px"
    }
  },
  {
    "name": "A custom property without relative units has no line-height back edge",
    "declarations": "--edge-length:13px;line-height:attr(a type(<length>),5px)",
    "attributes": {
      "a": "var(--edge-length)"
    },
    "expected": {
      "--edge-length": "13px",
      "font-size": "23px",
      "line-height": "13px",
      "width": "13px"
    }
  }
]
