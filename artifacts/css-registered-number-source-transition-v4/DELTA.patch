+def verify_pending_validation(root, policy, planned_pins, epoch):
+    package = root / policy["packages"]["pending_validation"]["path"]
+    validator = read(package / "POLICY.json")
+    sources = read(package / "SOURCE-PINS.json")
+    roster = read(package / "ROSTER.json")
+    need(roster == read(root / policy["packages"]["pending_tests"]["path"] / "ROSTER.json"),
+         "pending validator matches the sealed overlay roster")
+    need(validator["frozen_head"] == policy["paired_head"], "pending validator frozen HEAD")
+    need(validator["unchanged_native_sources"] == policy["unchanged_native_sources"],
+         "pending validator unchanged collector roles")
+    need(len(sources) == validator["expected_source_pins"] == 20, "pending validator source inventory")
+    need(len(roster["candidate_gtests"]) == len(set(roster["candidate_gtests"])) ==
+         validator["expected_gtests"] == 22, "pending validator exact roster")
+    need(validator["expected_source_pending_calls"] == 34 and not validator["standalone_native_acceptance"],
+         "pending validator scope")
+    for name, pin in sources.items():
+        need(pin == planned_pins.get(name, epoch["pins"].get(name)), "pending validator planned source: " + name)
+    return policy["packages"]["pending_validation"]["manifest_sha256"]
 
