    1467:   if (aExportContext == BaselineExportContext::LineLayout &&
    1468:       aBaselineGroup == BaselineSharingGroup::Last) {
    1469:     if (nsBlockFrame* bf = do_QueryFrame(mScrolledFrame);
    1470:         bf && !bf->IsButtonLike()) {
    1471:       return Some(SynthesizeFallbackBaseline(aWM, aBaselineGroup));
