    1480:   return mScrolledFrame
    1481:       ->GetNaturalBaselineBOffset(aWM, aBaselineGroup, aExportContext)
    1482:       .map([this, aWM, aBaselineGroup](nscoord aBaseline) {
    1483:         const bool first = aBaselineGroup == BaselineSharingGroup::First;
    1484:         const int64_t fromStart =
