+<!doctype html>
+<meta charset="utf-8">
+<title>Hidden table column queries after table size changes</title>
+<link rel="help" href="https://drafts.csswg.org/css-contain-2/#content-visibility">
+<link rel="help" href="https://drafts.csswg.org/cssom-view/#dom-element-getboundingclientrect">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<style>
+body { margin: 0; }
+.host { position: absolute; left: 10px; top: 10px; }
+.outer { width: 100px; height: 64px; }
+.subject { width: 100%; height: 64px; }
+.subject.hidden { content-visibility: hidden; }
+.item { width: 100%; height: 32px; }
+table { table-layout: fixed; width: 100%; height: 32px; border-spacing: 0; border: 0; padding: 0; margin: 0; }
+table.narrow { width: 50%; }
+td { border: 0; padding: 0; height: 32px; }
+</style>
+<body>
+<script>
+"use strict";
+function fixture(selector) {
+  const host = document.createElement("div");
+  host.className = "host";
+  host.innerHTML = `<div class="outer"><div class="subject"><div class="item"><table><colgroup><col><col></colgroup><tbody><tr><td></td><td></td></tr></tbody></table></div></div></div>`;
+  document.body.append(host);
+  return {host, outer: host.querySelector(".outer"), subject: host.querySelector(".subject"), table: host.querySelector("table"), target: host.querySelector(selector)};
+}
+function rect(element) {
+  const r = element.getBoundingClientRect();
+  return [r.x, r.y, r.width, r.height];
+}
+for (const selector of ["col", "colgroup", "table"]) {
+  test(t => {
+    assert_implements(CSS.supports("content-visibility", "hidden"));
+    const target = fixture(selector);
+    const reference = fixture(selector);
+    t.add_cleanup(() => { target.host.remove(); reference.host.remove(); });
+    const rows = [];
+    for (const stage of ["warm", "hide", "change", "restore", "show"]) {
+      if (stage === "hide") target.subject.classList.add("hidden");
+      if (stage === "change" || stage === "restore") {
+        target.table.classList.toggle("narrow", stage === "change");
+        reference.table.classList.toggle("narrow", stage === "change");
+      }
+      if (stage === "show") target.subject.classList.remove("hidden");
+      const outer = rect(target.outer);
+      const first = rect(target.target);
+      const second = rect(target.target);
+      const visible = rect(reference.target);
+      const tableWidth = stage === "change" ? 50 : 100;
+      const width = selector === "col" ? tableWidth / 2 : tableWidth;
+      rows.push({stage, outer, first, second, visible, expected: [10, 10, width, 32]});
+    }
+    for (const row of rows) {
+      assert_array_equals(row.visible, row.expected, `${row.stage}: independent visible calibration`);
+      assert_array_equals(row.outer, [10, 10, 100, 64], `${row.stage}: outer-only flush calibration`);
+    }
+    for (const row of rows) {
+      assert_array_equals(row.first, row.expected, `${row.stage}: first selected query`);
+      assert_array_equals(row.second, row.expected, `${row.stage}: repeat selected query`);
+    }
+  }, `Independent hidden column trigger: table-width, ${selector}`);
+}
+</script>
