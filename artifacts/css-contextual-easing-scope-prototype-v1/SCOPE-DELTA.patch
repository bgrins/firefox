+
+    /// Returns the selected keyframes and their element-relative declaration scope.
+    pub fn lookup_keyframes_with_scope<'a, E>(
+        &'a self,
+        name: &Atom,
+        element: E,
+    ) -> Option<(&'a KeyframesAnimation, CascadeLevel)>
+    where
+        E: TElement + 'a,
+    {
+        let mut result = None;
+        let document_scope = element.each_applicable_non_document_style_rule_data_with_scope(
+            |data, _host, scope| {
+                if result.is_none() {
+                    result = data
+                        .animations
+                        .get(name)
+                        .map(|animation| (animation, scope));
+                }
+            },
+        );
+        if result.is_some() {
+            return result;
+        }
+        if let Some(scope) = document_scope {
+            if let Some(animation) = self.cascade_data.author.animations.get(name) {
+                return Some((animation, scope));
+            }
+        }
+        if let Some(animation) = self.cascade_data.user.animations.get(name) {
+            return Some((animation, CascadeLevel::new(CascadeOrigin::User)));
+        }
+        self.cascade_data
+            .user_agent
+            .cascade_data
+            .animations
+            .get(name)
+            .map(|animation| (animation, CascadeLevel::new(CascadeOrigin::UA)))
     }
 
