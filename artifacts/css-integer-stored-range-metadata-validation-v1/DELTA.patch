+        need(all(row.get(f) == new[key].get(f) for f in
+                 ('status', 'message', 'expected', 'known_intermittent')),
+             'historical outcome changed before metadata correction ' + str(key))
+    return {'rows': len(old), 'historical_outcomes_exact': True}
