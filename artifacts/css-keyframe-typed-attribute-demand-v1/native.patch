+pub(crate) fn first_pending_prioritary(
+    id: PrioritaryPropertyId,
+    pending: &crate::properties::PrioritaryPropertyIdSet,
+) -> Option<PrioritaryPropertyId> {
+    let mut required = *id.dependencies();
+    required.insert(id);
+    loop {
+        let before = required;
+        for dependency in before.iter() {
+            for nested in dependency.dependencies().iter() {
+                required.insert(nested);
+            }
+        }
+        if required == before {
+            break;
+        }
+    }
+    required.iter().find(|id| pending.contains(*id))
 }
 
