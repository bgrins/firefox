+fn parse_attr_number<'i>(input: &mut Parser<'i>) -> Result<&'i str, ()> {
+    input.skip_whitespace();
+    let start = input.position();
+    input.expect_number().map_err(|_| ())?;
+    let number = input.slice_from(start);
+    input.expect_exhausted().map_err(|_| ())?;
+    Ok(number)
+}
