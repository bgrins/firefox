diff --git a/artifacts/css-registered-number-wpt-capsule-v3/capture/testing/web-platform/tests/css/css-values/attr-cycle.html b/artifacts/css-registered-number-wpt-capsule-v3/capture/testing/web-platform/tests/css/css-values/attr-cycle.html
