+    need(len(sys.argv) == (6 if role == "original" else 8), "original/candidate baseline arguments")
+    epoch_path = Path(sys.argv[3])
+    need(epoch_path.is_absolute() and not epoch_path.is_symlink(), "absolute regular epoch")
