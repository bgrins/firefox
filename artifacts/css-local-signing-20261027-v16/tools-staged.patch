+            path.write_bytes(t.encoded(changed))
+            rejected(str(number) + "-" + label, lambda: t.authorized_successors(root, policy, source_pins))
+            path.write_bytes(original)
+        preimage = signing / "ledger-preimages" / "CURRENT-COMMITS.json"
