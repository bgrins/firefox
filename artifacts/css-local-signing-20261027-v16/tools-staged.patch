diff --git a/artifacts/css-registered-number-wpt-capsule-v4/capture/testing/web-platform/tests/css/css-values/attr-namespace-cache.html b/artifacts/css-registered-number-wpt-capsule-v4/capture/testing/web-platform/tests/css/css-values/attr-namespace-cache.html
