+def function(source, name):
+    found = re.search(r"(?m)^.*\bfn " + name + r"[<(]", source)
+    assert found, name
+    opening = source.index("{", found.start())
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[found.start():end]
+
