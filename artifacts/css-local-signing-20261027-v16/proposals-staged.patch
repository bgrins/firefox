+import hashlib
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[1]
+sha = lambda p: hashlib.sha256(p.read_bytes()).hexdigest()
+
