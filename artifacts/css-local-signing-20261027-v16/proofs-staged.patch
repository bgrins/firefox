+            },
+            {
+                "name": "WithVariables",
+                "type": "VariableDeclaration",
+                "doc": "An unparsed declaration.",
+                "copy": False,
+            },
+            {
+                "name": "Custom",
+                "type": "CustomDeclaration",
+                "doc": "A custom property declaration.",
+                "copy": False,
+            },
+        ]
+        for v in self.declaration_extra_variants:
+            self.declaration_variants.append(v)
