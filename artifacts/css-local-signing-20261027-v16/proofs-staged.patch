+<a class="production" data-link-type="function" href="#funcdef-sin" id="ref-for-funcdef-sin④">&lt;<c- nf>sin</c-><c- p>()</c->></a>   = <c- nf>sin</c-><c- p>(</c-> <a class="production" data-link-type="type" href="#typedef-calc-sum" id="ref-for-typedef-calc-sum①③">&lt;calc-sum></a> <c- p>)</c->
+<a class="production" data-link-type="function" href="#funcdef-cos" id="ref-for-funcdef-cos③">&lt;<c- nf>cos</c-><c- p>()</c->></a>   = <c- nf>cos</c-><c- p>(</c-> <a class="production" data-link-type="type" href="#typedef-calc-sum" id="ref-for-typedef-calc-sum①④">&lt;calc-sum></a> <c- p>)</c->
