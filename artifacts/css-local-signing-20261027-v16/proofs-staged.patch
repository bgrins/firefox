+        other_longhands = []
+        for p in self.longhands:
+            if p.name in ["direction", "unicode-bidi"]:
+                continue
+            if not p.enabled_in_content() and not p.experimental(self.engine):
+                continue
+            if "style" not in p.rule_types_allowed_names():
