+/* static */ nsPresContext*
+EffectCompositor::GetPresContext(Element& aElement)
+{
+  nsIPresShell* shell = nsComputedDOMStyle::GetPresShellForContent(&aElement);
+  if (!shell) {
+    return nullptr;
+  }
+  return shell->GetPresContext();
+}
