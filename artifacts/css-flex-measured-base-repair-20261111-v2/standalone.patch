diff --git a/testing/web-platform/tests/css/css-flexbox/flex-shrink-large-content-base.html b/testing/web-platform/tests/css/css-flexbox/flex-shrink-large-content-base.html
new file mode 100644
--- /dev/null
+++ b/testing/web-platform/tests/css/css-flexbox/flex-shrink-large-content-base.html
@@ -0,0 +1,54 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>A large content flex base can shrink to a small target size</title>
+<link rel="help" href="https://drafts.csswg.org/css-flexbox/#resolve-flexible-lengths">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<style>
+  .container {
+    display: flex;
+    flex-direction: var(--direction);
+    writing-mode: var(--writing-mode);
+    inline-size: 100px;
+    block-size: 1000px;
+    position: absolute;
+  }
+  .item {
+    flex: 1 1 auto;
+    min-block-size: 0;
+  }
+  .content {
+    block-size: var(--content-size);
+  }
+</style>
+<div id="log"></div>
+<script>
+  for (const writingMode of ["horizontal-tb", "vertical-lr", "vertical-rl"]) {
+    for (const direction of ["column", "column-reverse"]) {
+      for (const contentSize of [1000, 10000000, 15000000, 17000000]) {
+        test(t => {
+          const container = document.createElement("div");
+          container.className = "container";
+          container.style.setProperty("--direction", direction);
+          container.style.setProperty("--writing-mode", writingMode);
+          container.style.setProperty("--content-size", `${contentSize}px`);
+          const item = document.createElement("div");
+          item.className = "item";
+          for (let i = 0; i < 2; ++i) {
+            const content = document.createElement("div");
+            content.className = "content";
+            item.append(content);
+          }
+          container.append(item);
+          document.body.append(container);
+          t.add_cleanup(() => container.remove());
+          const rect = item.getBoundingClientRect();
+          const size = writingMode === "horizontal-tb" ? rect.height : rect.width;
+          assert_approx_equals(size, 1000, 1, "The item shrinks to the container block size");
+          assert_approx_equals(parseFloat(getComputedStyle(item).blockSize), 1000, 1,
+                               "The resolved block size agrees");
+        }, `${writingMode}, ${direction}, two ${contentSize}px blocks`);
+      }
+    }
+  }
+</script>
diff --git a/testing/web-platform/tests/css/css-flexbox/flex-shrink-wide-target-violation.html b/testing/web-platform/tests/css/css-flexbox/flex-shrink-wide-target-violation.html
new file mode 100644
--- /dev/null
+++ b/testing/web-platform/tests/css/css-flexbox/flex-shrink-wide-target-violation.html
@@ -0,0 +1,69 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Wide shrink targets preserve the sign of the total violation</title>
+<link rel="help" href="https://drafts.csswg.org/css-flexbox/#resolve-flexible-lengths">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<style>
+  .container {
+    display: flex;
+    flex-direction: var(--direction);
+    writing-mode: var(--writing-mode);
+    inline-size: 100px;
+    block-size: 1000px;
+    position: absolute;
+  }
+  .primary {
+    flex: 0 var(--shrink) 1000px;
+    min-block-size: 0;
+  }
+  .secondary {
+    flex: 0 1 auto;
+    min-block-size: 0;
+    max-block-size: 1000px;
+  }
+  .content {
+    block-size: var(--content-size);
+  }
+</style>
+<div id="log"></div>
+<script>
+  for (const writingMode of ["horizontal-tb", "vertical-lr", "vertical-rl"]) {
+    for (const direction of ["column", "column-reverse"]) {
+      for (const contentSize of [1000, 10000000, 15000000, 17000000]) {
+        for (const shrink of [2, 1000000]) {
+          test(t => {
+            const container = document.createElement("div");
+            container.className = "container";
+            container.style.setProperty("--direction", direction);
+            container.style.setProperty("--writing-mode", writingMode);
+            container.style.setProperty("--content-size", `${contentSize}px`);
+            container.style.setProperty("--shrink", shrink);
+            const primary = document.createElement("div");
+            primary.className = "primary";
+            container.append(primary);
+            for (let i = 0; i < 2; ++i) {
+              const secondary = document.createElement("div");
+              secondary.className = "secondary";
+              for (let j = 0; j < 2; ++j) {
+                const content = document.createElement("div");
+                content.className = "content";
+                secondary.append(content);
+              }
+              container.append(secondary);
+            }
+            document.body.append(container);
+            t.add_cleanup(() => container.remove());
+            const sizes = Array.from(container.children, item => {
+              const rect = item.getBoundingClientRect();
+              return writingMode === "horizontal-tb" ? rect.height : rect.width;
+            });
+            assert_approx_equals(sizes[0], 0, 1, "The primary item freezes at its minimum");
+            assert_approx_equals(sizes[1], 500, 1, "The second item shares the remaining space");
+            assert_approx_equals(sizes[2], 500, 1, "The third item shares the remaining space");
+          }, `${writingMode}, ${direction}, ${contentSize}px content, shrink ${shrink}`);
+        }
+      }
+    }
+  }
+</script>
