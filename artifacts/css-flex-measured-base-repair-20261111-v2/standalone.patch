+function testLargeContentBase() {
+  for (const height of [1000, 10000000, 15000000, 17000000]) {
+    for (const margin of [0, 10000000]) {
+      const container = document.createElement("div");
+      container.className = "large-base-container";
+      container.style.setProperty("--test-height", `${height}px`);
+      container.style.setProperty("--test-margin", `${margin}px`);
+      const item = document.createElement("div");
+      item.className = "large-base-item";
+      for (let i = 0; i < 2; ++i) {
+        const content = document.createElement("div");
+        content.className = "large-base-content";
+        item.append(content);
+      }
+      container.append(item);
+      document.body.append(container);
+      const values = container.getAsFlexContainer().getLines()[0].getItems()[0];
+      const label = `Two ${height}px blocks with ${margin}px margin`;
+      isfuzzy(values.mainBaseSize, 2 * height, 1, `${label}: measured flex base`);
+      isfuzzy(values.mainDeltaSize, 1000 - margin - values.mainBaseSize, 1,
+              `${label}: requested shrink delta`);
+      isfuzzy(item.getBoundingClientRect().height, Math.max(0, 1000 - margin), 1,
+              `${label}: final item size`);
+      container.remove();
+    }
+  }
+}
+
 function runTests() {
