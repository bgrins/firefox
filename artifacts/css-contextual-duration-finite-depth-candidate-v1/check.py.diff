+        ('literal later stale', lambda v: v['literal']['afterMembership'].update(opacity=7)),
+        ('literal identity', lambda v: v['literal']['membership'][0].update(animation=False)),
+        ('contextual initial stale', lambda v: v['contextual']['initial'].update(rootFont=32)),
+        ('literal setup stale', lambda v: v['literal']['literalInitial'].update(rootFont=32)),
+    ]:
+        value = synthetic_record('depth-2')['observations']; mutation(value)
+        try:
+            comparison.require_original_calibration(value)
+        except AssertionError:
+            rejected.append(label)
+        else:
+            raise AssertionError(label)
+    print(json.dumps({'literal_and_setup_calibration_checks': 4, 'contextual_stale_first_retained_as_target': True, 'calibration_negatives': rejected}))
 
 
