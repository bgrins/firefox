+def synthetic_record(kind):
+    comparison = load('calibration_record_source', HERE / 'comparison.py')
+    depth = int(kind.removeprefix('depth-'))
+    initial, final = comparison.expected_snapshot(depth, False), comparison.expected_snapshot(depth, True)
+    observations = {mode: {'depth': depth, 'mode': mode, 'literalInitial': copy.deepcopy(initial), 'initial': copy.deepcopy(initial),
+        'samples': [{'phase': phase, 'opacity': final['opacity']} for phase in ('first-leaf-read', 'passive-frame-1', 'passive-frame-2', 'passive-frame-3')],
+        'beforeMembership': copy.deepcopy(final), 'afterMembership': copy.deepcopy(final),
+        'membership': [{'animation': True, 'effect': True} for _ in range(depth + 1)]} for mode in ('literal', 'contextual')}
+    return {'kind': kind, 'run_id': 'synthetic_record_projection', 'observations': observations}
+
+
+def check_calibration(policy):
+    comparison = load('calibration_check', HERE / 'comparison.py')
+    for rule in policy['record_kinds'].values():
+        value = synthetic_record(rule['kind'])['observations']
+        comparison.require_original_calibration(value)
+        value['contextual']['samples'][0]['opacity'] = 7
+        comparison.require_original_calibration(value)
+    rejected = []
+    for label, mutation in [
