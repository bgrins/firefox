+                        visit(base, flags)?;
+                    }
+                },
+                CalcNode::Progress {
+                    value, start, end, ..
+                } => {
+                    visit(value, flags)?;
+                    visit(start, flags)?;
+                    visit(end, flags)?;
+                },
