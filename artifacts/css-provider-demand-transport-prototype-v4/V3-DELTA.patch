+fn parse_registered_value(
+    name: &Name,
+    css: &str,
+    url_data: &UrlExtraData,
+    registration: &PropertyDescriptors,
+    taint: AttrTaint,
+) -> Option<SpecifiedRegisteredValue> {
+    let syntax = registration.syntax.as_ref()?;
+    SpecifiedRegisteredValue::parse(
+        &mut Parser::new(css),
+        syntax,
+        url_data,
+        None,
+        AllowComputationallyDependent::Yes,
+        taint,
+        Some(PropertyIdRef::from(name)),
+    )
+    .ok()
+}
+
+pub(crate) fn try_compute_specified_with_readiness(
+    name: &Name,
+    registration: &PropertyDescriptors,
+    value: &SpecifiedRegisteredValue,
+    context: &computed::Context,
+    readiness: &dyn SubstitutionReadiness,
+) -> Result<ComputedRegisteredValue, SubstitutionDemand> {
+    let mut required =
+        match readiness.value_context_requirements(name, registration, &value, context) {
+            RegisteredContextRequirements::Unknown => {
+                return Err(SubstitutionDemand::InitialContext(name.clone()));
+            },
+            RegisteredContextRequirements::Known(required) => required,
+        };
+    loop {
+        let previous = required;
+        for id in previous.iter() {
+            for dependency in id.dependencies().iter() {
+                required.insert(dependency);
+            }
+        }
+        if previous == required {
+            break;
+        }
+    }
+    if let Some(id) = required.iter().find(|id| !readiness.prioritary_ready(*id)) {
+        return Err(SubstitutionDemand::Prioritary(id));
+    }
+    if !readiness.value_context_ready(name, registration, &value, context) {
+        return Err(SubstitutionDemand::InitialContext(name.clone()));
+    }
+    Ok(value.to_computed_value(context))
+}
