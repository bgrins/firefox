+pub(crate) struct PreparedProvider<'registration> {
+    name: Name,
+    namespace: Option<Namespace>,
+    registration: &'registration PropertyDescriptors,
+    input: PreparedProviderInput<'registration>,
+    attributes: crate::dom::AttributeReferences,
+}
+
+impl PreparedProvider<'_> {
+    pub(crate) fn try_apply(
+        &self,
+        context: &mut computed::Context,
+        attributes: &mut AttributeTracker,
+        readiness: &dyn SubstitutionReadiness,
+    ) -> Result<(), SubstitutionDemand> {
+        let (value, inherits_reset) = match &self.input {
+            PreparedProviderInput::Typed(value, tainted) => {
+                let mut computed = try_compute_specified_with_readiness(
+                    &self.name,
+                    self.registration,
+                    value,
+                    context,
+                    readiness,
+                )?;
+                computed.attr_tainted |= *tainted;
+                (Some(computed), false)
+            },
+            PreparedProviderInput::Default(plan) => {
+                let computed = plan.try_compute(context, readiness)?;
+                (computed.value, computed.inherits_reset_style)
+            },
+            PreparedProviderInput::Resolved(value) => (value.clone(), false),
+        };
+        if inherits_reset {
+            context
+                .style()
+                .add_flags(ComputedValueFlags::INHERITS_RESET_STYLE);
+        }
+        match (&self.namespace, value) {
+            (None, Some(value)) => context.builder.substitution_functions.insert_var(
+                self.registration,
+                &self.name,
+                value,
+            ),
+            (None, None) => context
+                .builder
+                .substitution_functions
+                .remove_var(self.registration, &self.name),
+            (Some(namespace), Some(value)) => context
+                .builder
+                .substitution_functions
+                .insert_attr(&self.name, namespace, value),
+            (Some(namespace), None) => context
+                .builder
+                .substitution_functions
+                .remove_attr(&self.name, namespace),
+        }
+        if let Some(references) = self.attributes.as_ref() {
+            let target = attributes.references.get_or_insert_with(Default::default);
+            for (name, namespaces) in references.iter() {
+                let recorded = target.entry(name.clone()).or_default();
+                for namespace in namespaces {
+                    if !recorded.contains(namespace) {
+                        recorded.push(namespace.clone());
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
+}
