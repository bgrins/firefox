+#[cfg(test)]
+mod compact_borrow_tests {
+    use super::{Arc, ArcUnion, ArcUnionBorrow, ArcUnionBorrowPtr};
+    use std::sync::atomic::{AtomicUsize, Ordering::Relaxed};
+
+    #[test]
+    fn pointer_layout_and_tag_identity() {
+        type Borrow<'a> = ArcUnionBorrowPtr<'a, u8, u8>;
+        assert_eq!(std::mem::size_of::<Borrow>(), std::mem::size_of::<usize>());
+        assert_eq!(
+            std::mem::size_of::<Option<Borrow>>(),
+            std::mem::size_of::<usize>()
+        );
+        assert!(!std::mem::needs_drop::<Borrow>());
+        assert!(std::mem::align_of::<super::ArcInner<u8>>() >= 2);
+        let owner = Arc::new(7u8);
+        let first = Borrow::from_first(owner.borrow_arc());
+        let second = Borrow::from_second(owner.borrow_arc());
+        assert!(!Borrow::ptr_eq(&first, &second));
+        assert!(matches!(first.borrow(), ArcUnionBorrow::First(value) if *value == 7));
+        assert!(matches!(second.borrow(), ArcUnionBorrow::Second(value) if *value == 7));
+        assert_eq!(owner.inner().count.load(Relaxed), 1);
+        let copy = second;
+        let cloned = copy.clone();
+        assert!(Borrow::ptr_eq(&second, &cloned));
+        assert_eq!(owner.inner().count.load(Relaxed), 1);
+        let retained = cloned.to_owned();
+        assert_eq!(owner.inner().count.load(Relaxed), 2);
+        assert!(Borrow::ptr_eq(&second, &Borrow::from_union(&retained)));
+        drop(retained);
+        assert_eq!(owner.inner().count.load(Relaxed), 1);
+    }
+
+    #[test]
+    fn borrowed_views_do_not_drop_and_owned_conversion_retains() {
+        struct Probe(std::sync::Arc<AtomicUsize>);
+        impl Drop for Probe {
+            fn drop(&mut self) {
+                self.0.fetch_add(1, Relaxed);
+            }
+        }
+        for second in [false, true] {
+            let drops = std::sync::Arc::new(AtomicUsize::new(0));
+            let owner = Arc::new(Probe(drops.clone()));
+            let retained;
+            {
+                let borrowed = if second {
+                    ArcUnionBorrowPtr::<Probe, Probe>::from_second(owner.borrow_arc())
+                } else {
+                    ArcUnionBorrowPtr::<Probe, Probe>::from_first(owner.borrow_arc())
+                };
+                let copy = borrowed;
+                assert_eq!(owner.inner().count.load(Relaxed), 1);
+                retained = copy.to_owned();
+                assert!(ArcUnionBorrowPtr::ptr_eq(
+                    &borrowed,
+                    &ArcUnionBorrowPtr::from_union(&retained),
+                ));
+            }
+            assert_eq!(drops.load(Relaxed), 0);
+            drop(owner);
+            assert_eq!(drops.load(Relaxed), 0);
+            drop(retained);
+            assert_eq!(drops.load(Relaxed), 1);
+        }
+    }
+
+    #[test]
+    fn zero_sized_and_high_alignment_payloads() {
+        #[repr(align(128))]
+        struct Aligned(u8);
+        let zero = Arc::new(());
+        let aligned = Arc::new(Aligned(9));
+        let first = ArcUnionBorrowPtr::<(), Aligned>::from_first(zero.borrow_arc());
+        let second = ArcUnionBorrowPtr::<(), Aligned>::from_second(aligned.borrow_arc());
+        assert!(matches!(first.borrow(), ArcUnionBorrow::First(value) if *value == ()));
+        assert!(matches!(second.borrow(), ArcUnionBorrow::Second(value) if value.0 == 9));
+        assert_eq!(zero.inner().count.load(Relaxed), 1);
+        assert_eq!(aligned.inner().count.load(Relaxed), 1);
+        let retained = second.to_owned();
+        drop(aligned);
+        assert!(matches!(retained.borrow(), ArcUnionBorrow::Second(value) if value.0 == 9));
+    }
+
+    #[test]
+    fn static_arc_count_is_unchanged() {
+        static INNER: super::ArcInner<u8> = super::ArcInner {
+            count: AtomicUsize::new(super::STATIC_REFCOUNT),
+            #[cfg(feature = "track_alloc_size")]
+            alloc_size: std::mem::size_of::<super::ArcInner<u8>>(),
+            data: 11,
+        };
+        // This is the same permanent ArcInner storage contract as Arc::new_static.
+        let arc = unsafe { super::ArcBorrow::from_ref(&INNER.data) };
+        let borrowed = ArcUnionBorrowPtr::<u8, u8>::from_second(arc);
+        let retained = borrowed.to_owned();
+        assert!(matches!(retained.borrow(), ArcUnionBorrow::Second(value) if *value == 11));
+        drop(retained);
+        assert_eq!(INNER.count.load(Relaxed), super::STATIC_REFCOUNT);
+    }
+
+    #[test]
+    fn equal_payloads_keep_distinct_allocation_identity() {
+        let first = ArcUnion::<u8, u16>::from_first(Arc::new(1));
+        let other = ArcUnion::<u8, u16>::from_first(Arc::new(1));
+        let a = ArcUnionBorrowPtr::from_union(&first);
+        let b = ArcUnionBorrowPtr::from_union(&other);
+        assert!(!ArcUnionBorrowPtr::ptr_eq(&a, &b));
+        assert!(ArcUnion::ptr_eq(&first, &a.to_owned()));
+    }
+}
