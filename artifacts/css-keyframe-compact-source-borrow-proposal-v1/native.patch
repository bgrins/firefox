+/// A pointer-sized, non-owning borrow of either Arc allocation.
+///
+/// ```compile_fail
+/// use servo_arc::{Arc, ArcUnionBorrowPtr};
+/// let borrowed = {
+///     let owner = Arc::new(1u8);
+///     ArcUnionBorrowPtr::<u8, u16>::from_first(owner.borrow_arc())
+/// };
+/// let _ = borrowed.borrow();
+/// ```
+///
+/// ```compile_fail
+/// use servo_arc::{Arc, ArcUnion, ArcUnionBorrowPtr};
+/// let borrowed = {
+///     let owner = ArcUnion::<u8, u16>::from_second(Arc::new(2));
+///     ArcUnionBorrowPtr::from_union(&owner)
+/// };
+/// let _ = borrowed.borrow();
+/// ```
+///
+/// ```compile_fail
+/// use servo_arc::{Arc, ArcUnionBorrowPtr};
+/// use std::rc::Rc;
+/// let owner = Arc::new(Rc::new(()));
+/// let borrowed = ArcUnionBorrowPtr::<Rc<()>, u8>::from_first(owner.borrow_arc());
+/// std::thread::scope(|scope| {
+///     scope.spawn(move || { let _ = borrowed.borrow(); });
+/// });
+/// ```
+#[repr(transparent)]
+pub struct ArcUnionBorrowPtr<'a, A: 'a, B: 'a> {
+    p: ptr::NonNull<()>,
+    marker: PhantomData<&'a ArcUnion<A, B>>,
+}
+
+// The borrow can only expose the same shared allocations as ArcUnion.
+unsafe impl<A: Sync + Send, B: Sync + Send> Send for ArcUnionBorrowPtr<'_, A, B> {}
+unsafe impl<A: Sync + Send, B: Sync + Send> Sync for ArcUnionBorrowPtr<'_, A, B> {}
+
+impl<A, B> Copy for ArcUnionBorrowPtr<'_, A, B> {}
+
+impl<A, B> Clone for ArcUnionBorrowPtr<'_, A, B> {
+    fn clone(&self) -> Self {
+        *self
+    }
+}
+
+impl<'a, A, B> ArcUnionBorrowPtr<'a, A, B> {
+    #[inline]
+    pub fn from_union(owner: &'a ArcUnion<A, B>) -> Self {
+        Self {
+            p: owner.p,
+            marker: PhantomData,
+        }
+    }
+
+    #[inline]
+    pub fn from_first(value: ArcBorrow<'a, A>) -> Self {
+        // ArcBorrow guarantees allocation provenance; the transient never drops.
+        let arc = unsafe { mem::ManuallyDrop::new(Arc::from_raw(value.get())) };
+        Self {
+            p: arc.p.cast(),
+            marker: PhantomData,
+        }
+    }
+
+    #[inline]
+    pub fn from_second(value: ArcBorrow<'a, B>) -> Self {
+        // ArcInner's atomic counter guarantees a free low bit, even for align-1 B.
+        let arc = unsafe { mem::ManuallyDrop::new(Arc::from_raw(value.get())) };
+        Self {
+            p: arc.p.cast::<()>().map_addr(|address| address | 1),
+            marker: PhantomData,
+        }
+    }
+
+    #[inline]
+    pub fn ptr_eq(this: &Self, other: &Self) -> bool {
+        this.p == other.p
+    }
+
+    #[inline]
+    pub fn borrow(self) -> ArcUnionBorrow<'a, A, B> {
+        if self.p.as_ptr().addr() & 1 == 0 {
+            let allocation = self.p.cast::<ArcInner<A>>();
+            // The private constructors retain an Arc-backed borrow for 'a.
+            ArcUnionBorrow::First(unsafe { ArcBorrow::from_ref(&allocation.as_ref().data) })
+        } else {
+            let allocation = self
+                .p
+                .map_addr(|address| std::num::NonZeroUsize::new(address.get() & !1).unwrap())
+                .cast::<ArcInner<B>>();
+            // Removing only the tag preserves the original allocation provenance.
+            ArcUnionBorrow::Second(unsafe { ArcBorrow::from_ref(&allocation.as_ref().data) })
+        }
+    }
+
+    #[inline]
+    pub fn to_owned(self) -> ArcUnion<A, B> {
+        match self.borrow() {
+            ArcUnionBorrow::First(value) => ArcUnion::from_first(value.clone_arc()),
+            ArcUnionBorrow::Second(value) => ArcUnion::from_second(value.clone_arc()),
+        }
+    }
+}
+
+impl<A: fmt::Debug, B: fmt::Debug> fmt::Debug for ArcUnionBorrowPtr<'_, A, B> {
+    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        fmt::Debug::fmt(&self.borrow(), f)
+    }
+}
