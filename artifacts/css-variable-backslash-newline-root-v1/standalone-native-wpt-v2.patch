diff --git a/testing/web-platform/tests/css/css-variables/trailing-backslash-newline.html b/testing/web-platform/tests/css/css-variables/trailing-backslash-newline.html
new file mode 100644
index 0000000000000000000000000000000000000000..b237cc66f738bc416cb1001a8d62edfc3c064790
--- /dev/null
+++ b/testing/web-platform/tests/css/css-variables/trailing-backslash-newline.html
@@ -0,0 +1,41 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Custom property substitution preserves a backslash delimiter before trailing whitespace</title>
+<link rel="help" href="https://drafts.csswg.org/css-syntax-3/#serialization">
+<link rel="help" href="https://drafts.csswg.org/css-variables-1/#using-variables">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<body>
+<script>
+const cases = [];
+for (const [name, newline] of [["LF", "\n"], ["CR", "\r"], ["FF", "\f"], ["CRLF", "\r\n"]]) {
+  for (const prefix of ["", "x"]) {
+    for (const suffix of ["", " \t", "/**/"]) {
+      cases.push({name: `${name}, prefix ${JSON.stringify(prefix)}, suffix ${JSON.stringify(suffix)}`,
+                  value: prefix + "\\" + newline + suffix, expected: "none", valid: false});
+    }
+  }
+}
+for (const [value, decoded] of [["control", "control"], ["control ", "control"],
+                              ["x\\\\", "x\\"],
+                              ["x\\78", "xx"], ["\"x\"", "x"], ["x/**/", "x"]]) {
+  cases.push({name: `valid control ${JSON.stringify(value)}`,
+              value, expected: CSS.escape(decoded), valid: true});
+}
+for (const c of cases) {
+  test(t => {
+    assert_equals(CSS.supports("animation-name", c.value), c.valid, "Literal syntax");
+    const target = document.createElement("div");
+    target.style.animationName = "var(--probe)";
+    document.body.append(target);
+    t.add_cleanup(() => target.remove());
+    for (const [phase, value, expected] of [
+      ["Initial", "control", "control"], ["Set", c.value, c.expected],
+      ["Restore", "control", "control"], ["Set again", c.value, c.expected],
+    ]) {
+      target.style.setProperty("--probe", value);
+      assert_equals(getComputedStyle(target).animationName, expected, phase);
+    }
+  }, c.name);
+}
+</script>
