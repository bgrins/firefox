0,"blocking":0,"total_blocking":0},"body":"While fuzzing the cssparser fuzz target I encountered a stack overflow leading to a core dump.\nThe overflow occurs when the input contains ~17500 (or more) opening brackets, i.e., `(`, `[`, `{`.\n\nI attached an example input that was generated by the fuzzer.\n\n[64a4f3d80c6f9598cfc40255f7410db68675019d5c2be9eb5555ca5721c29516.txt](https://github.com/user-attachments/files/19908182/64a4f3d80c6f9598cfc40255f7410db68675019d5c2be9eb5555ca5721c29516.txt)\n","reactions":{"url":"https://api.github.com/repos/servo/rust-cssparser/issues/405/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/servo/rust-cssparser/issues/405/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/servo/rust-cssparser/issues/391","repository_url":"https://api.github.com/repos/servo/rust-cssparser","labels_url":"https://api.github.com/repos/servo/rust-cssparser/issues/391/labels{/name}","comments_url":"https://api.github.com/repos/servo/rust-cssparser/issues/391/comments","events_url":"https://api.github.com/repos/servo/rust-cssparser/issues/391/events","html_url":"https://github.com/servo/rust-cssparser/pull/391","id":2336961727,"node_id":"PR_kwDOAKyvFs5xnLQL","number":391,"title":"[unicode-range] Avoid integer overflow (panic in debug builds)","user":{"login":"jfkthame","id":1706499,"node_id":"MDQ6VXNlcjE3MDY0OTk=","avatar_url":"https://avatars.githubusercontent.com/u/1706499?v=4","gravatar_id":"","url":"https://api.github.com/users/jfkthame","html_url":"https://github.com/jfkthame","followers_url":"https://api.github.com/users/jfkthame/followers","following_url":"https://api.github.com/users/jfkthame/following{/other_user}","gists_url":"https://api.github.com/users/jfkthame/gists{/gist_id}","starred_url":"https://api.github.com/users/jfkthame/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jfkthame/subscriptions","organizations_url":"https://api.github.com/users/jfkthame/orgs","repos_url":"https://api.github.com/users/jfkthame/repos","events_url":"https://api.github.com/users/jfkthame/events{/privacy}","received_events_url":"https://api.github.com/users/jfkthame/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2024-06-05T22:57:58Z","updated_at":"2024-11-07T17:29:40Z","closed_at":"2024-11-07T17:29:40Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/servo/rust-cssparser/pulls/391","html_url":"https://github.com/servo/rust-cssparser/pull/391","diff_url":"https://github.com/servo/rust-cssparser/pull/391.diff","patch_url":"https://github.com/servo/rust-cssparser/pull/391.patch","merged_at":"2024-11-07T17:29:40Z"},"body":"If a long string of hex digits are passed to unicode-range, the code tries to parse them into a number before checking whether there are more than the 6 digits allowed by the syntax, and this may lead to integer overflow.\r\n\r\nTo avoid this, check the number of digits and error out earlier if there are too many to possibly be valid.\r\n\r\n(See https://bugzilla.mozilla.org/show_bug.cgi?id=1900403)","reactions":{"url":"https://api.github.com/repos/servo/rust-cssparser/issues/391/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/servo/rust-cssparser/issues/391/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0},{"url":"https://api.github.com/repos/servo/rust-cssparser/issues/350","repository_url":"https://api.github.com/repos/servo/rust-cssparser","labels_url":"https://api.github.com/repos/servo/rust-cssparser/issues/3