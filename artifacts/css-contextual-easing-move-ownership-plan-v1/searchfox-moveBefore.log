    2944:       EnsureValidMoveRequest(aNode, referenceChild, aRv);
    2945:       if (aRv.Failed()) {
    2946:         return;
    2947:       }
    2948:       // Step 7.
    2949:       oldParent = aNode.GetParentNode();
