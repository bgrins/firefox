    2878:                                                    nsINode* aReferenceChild,
    2879:                                                    ErrorResult& aRv) -> void {
    2880:     // Step 1.
    2881:     GetRootNodeOptions options;
    2882:     options.mComposed = true;
    2883:     if (newParent.GetRootNode(options) != aNode.GetRootNode(options)) {
    2884:       aRv.ThrowHierarchyRequestError("Different root node.");
    2885:       return;
    2886:     }
    2887: 
    2888:     // Step 2.
    2889:     if (nsContentUtils::ContentIsHostIncludingDescendantOf(&newParent,
    2890:                                                            &aNode)) {
    2891:       aRv.ThrowHierarchyRequestError("Node is an ancestor of the new parent.");
    2892:       return;
    2893:     }
    2894: 
    2895:     // Step 3.
    2896:     if (aReferenceChild && aReferenceChild->GetParentNode() != &newParent) {
    2897:       aRv.ThrowNotFoundError("Wrong reference child.");
    2898:       return;
    2899:     }
    2900: 
    2901:     // Step 4.
    2902:     if (!aNode.IsElement() && !aNode.IsCharacterData()) {
    2903:       aRv.ThrowHierarchyRequestError("Wrong type of node.");
    2904:       return;
    2905:     }
    2906: 
    2907:     // Step 5.
    2908:     if (aNode.IsText() && newParent.IsDocument()) {
    2909:       aRv.ThrowHierarchyRequestError(
    2910:           "Can't move a text node to be a child of a document.");
    2911:       return;
    2912:     }
    2913: 
    2914:     // Step 6.
    2915:     if (newParent.IsDocument() && aNode.IsElement() &&
    2916:         (newParent.AsDocument()->GetRootElement() ||
    2917:          IsDoctypeOrHasFollowingDoctype(aReferenceChild))) {
    2918:       aRv.ThrowHierarchyRequestError(
    2919:           "Can't move an element to be a child of the document.");
    2920:       return;
    2921:     }
    2922:   };
    2923:   EnsureValidMoveRequest(aNode, referenceChild, aRv);
    2924:   if (MOZ_UNLIKELY(aRv.Failed())) {
    2925:     return;
    2926:   }
    2927: 
    2928:   // Step 7.
    2929:   nsINode* oldParent = aNode.GetParentNode();
