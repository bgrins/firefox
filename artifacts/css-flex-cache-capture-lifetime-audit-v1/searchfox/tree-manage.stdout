     382:     // block axis.
     383:     PresShell()->CancelReflowCallback(this);
     384:     mReflowCallbackPosted = false;
     385:     mOriginalHorzWidth = -1;
     386:   }
     387:   mLastReflowRect = Some(mRect);
     388:   mHorzWidth = horzWidth;
