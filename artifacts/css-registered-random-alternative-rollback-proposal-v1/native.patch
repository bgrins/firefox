+
+    /// Restores random indexes when a speculative parse fails.
+    pub(crate) fn with_random_index_rollback<T, E>(
+        &self,
+        parse: impl FnOnce() -> Result<T, E>,
+    ) -> Result<T, E> {
+        let count = self.random_count.get();
+        let result = parse();
+        if result.is_err() {
+            self.random_count.set(count);
+        }
+        result
     }
 
