+#[derive(Clone, Debug)]
+#[repr(C)]
+pub struct MathClamp {
+    /// The numeric type associated with this clamp.
+    pub numeric_type: NumericType,
+
+    /// The lower bound, value, and upper bound of the clamp expression, in
+    /// that order.
