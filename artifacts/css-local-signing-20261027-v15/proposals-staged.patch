+#[derive(
+    Clone,
+    Debug,
+    Deserialize,
+    MallocSizeOf,
+    PartialEq,
+    Serialize,
+    ToAnimatedZero,
+    ToResolvedValue,
+    ToShmem,
+)]
+pub struct GenericAnchorFunctionFallback<L> {
+    /// Was this node parsed as a calc node?
+    #[animation(constant)]
+    is_calc_node: bool,
+    /// The parsed fallback value. Stored as a calc node to break
+    /// the circular reference.
+    pub node: GenericCalcNode<L>,
+}
