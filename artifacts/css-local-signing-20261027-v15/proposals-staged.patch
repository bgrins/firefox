+#[derive(Clone, Debug)]
+#[repr(C)]
+pub struct MathInvert {
+    /// The numeric type associated with this invert.
+    pub numeric_type: NumericType,
+
+    /// The numeric value being inverted.
+    pub value: Box<NumericValue>,
+}
