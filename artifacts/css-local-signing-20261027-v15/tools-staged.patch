+    assert_equals(computedStyle.getPropertyValue('--registered-4-c'), '');
+    assert_equals(computedStyle.getPropertyValue('--unregistered-4-b'), 'woof');
+    assert_equals(computedStyle.getPropertyValue('--unregistered-4-c'), '');
