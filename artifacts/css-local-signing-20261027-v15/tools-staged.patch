+    before = state.a.verify_current(state.h, ROOT, env, epoch)
+    flags = {n: state.h.git(ROOT / n, env, "ls-files", "-v", "-z") for n in [".", "artifacts/css-spec-lean"]}
+    native_owned, originals, desired = {}, {}, {}
+    for name, expected in prior_pins.items():
