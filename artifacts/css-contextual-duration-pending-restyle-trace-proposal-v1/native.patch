+static const char* DurationFeedbackTraceTarget(Element* aElement) {
+  if (!aElement || !NS_IsMainThread()) {
+    return nullptr;
+  }
+  static const bool enabled = [] {
+    const char* value = std::getenv("MOZ_DURATION_RESTYLE_TRACE");
+    return value && value[0] == '1' && value[1] == '\0';
+  }();
+  if (!enabled) {
+    return nullptr;
+  }
+  nsAutoString id;
+  aElement->GetId(id);
+  if (id.EqualsLiteral("duration-feedback-coupled-passive")) {
+    return "coupled-passive";
+  }
+  if (id.EqualsLiteral("duration-feedback-coupled-seek")) {
+    return "coupled-seek";
+  }
+  if (id.EqualsLiteral("duration-feedback-coupled-outline")) {
+    return "coupled-outline";
+  }
+  if (id.EqualsLiteral("duration-feedback-coupled-override")) {
+    return "coupled-override";
+  }
+  if (id.EqualsLiteral("duration-feedback-coupled-literal")) {
+    return "coupled-literal";
+  }
+  if (id.EqualsLiteral("duration-feedback-zero-start-passive")) {
+    return "zero-start-passive";
+  }
+  if (id.EqualsLiteral("duration-feedback-zero-start-seek")) {
+    return "zero-start-seek";
+  }
+  if (id.EqualsLiteral("duration-feedback-zero-start-outline")) {
+    return "zero-start-outline";
+  }
+  if (id.EqualsLiteral("duration-feedback-zero-start-override")) {
+    return "zero-start-override";
+  }
+  if (id.EqualsLiteral("duration-feedback-zero-start-literal")) {
+    return "zero-start-literal";
+  }
+  return nullptr;
+}
+
+static void DurationFeedbackTrace(
+    const char* aStage, Element* aElement,
+    const PseudoStyleRequest& aPseudoRequest, int aCascade, int aRequest,
+    int aPresent, int aBit, bool aPreTraverse, Element* aRoot = nullptr,
+    unsigned aFlags = 0, const void* aEffect = nullptr,
+    const void* aAnimation = nullptr) {
+  const char* target = DurationFeedbackTraceTarget(aElement);
+  if (!target) {
+    return;
+  }
+  static unsigned sequence = 0;
+  if (sequence >= 4096) {
+    if (sequence == 4096) {
+      ++sequence;
+      std::fprintf(stderr,
+                   "DURATION_RESTYLE_TRACE pid=%lu cap-exhausted limit=4096\n",
+                   static_cast<unsigned long>(base::GetCurrentProcId()));
+    }
+    return;
+  }
+  std::fprintf(
+      stderr,
+      "DURATION_RESTYLE_TRACE pid=%lu seq=%u id=%s element=%p pseudo=%u identifier=%p "
+      "stage=%s cascade=%d request=%d present=%d bit=%d servo=%d pre=%d "
+      "root=%p flags=%u effect=%p animation=%p\n",
+      static_cast<unsigned long>(base::GetCurrentProcId()), ++sequence, target,
+      static_cast<void*>(aElement),
+      static_cast<unsigned>(aPseudoRequest.mType),
+      static_cast<void*>(aPseudoRequest.mIdentifier.get()), aStage, aCascade,
+      aRequest, aPresent, aBit, int(ServoStyleSet::IsInServoTraversal()),
+      int(aPreTraverse), static_cast<void*>(aRoot), aFlags, aEffect, aAnimation);
+}
