 from pathlib import Path
 
 SOURCE = 'servo/components/style/values/generics/calc.rs'
+
+LANDING_TEST = '/css/css-values/round-context-quotient-precision.html'
+LANDING_PATH = 'testing/web-platform/tests' + LANDING_TEST
+OMITTED_SUBTEST = 'both infinite'
+REMOVED_LINE = b'  ["both infinite", "round(up, infinity * sign(1em - 16px), infinity)", 0],\n'
+OLD_BODY_SHA = '961eb87af1dfdb9da434d1e33c30526ad42b56e15b7121bbd8d7f3144d72555c'
+NEW_BODY_SHA = '4ad9d374e71f65433c1f28e9e663f1369e18f99cfafbea855bb5df98d466596d'
+
+
+def remaining_rows(assessment, h):
+    omitted = [e for e in assessment['rows'] if e.get('test') == LANDING_TEST and e.get('subtest') == OMITTED_SUBTEST]
+    h.need(len(omitted) == 1 and omitted[0]['action'] == 'test_status' and omitted[0]['status'] == 'PASS', 'unique omitted historical row must PASS')
+    return [e for e in assessment['rows'] if not (e.get('test') == LANDING_TEST and e.get('subtest') == OMITTED_SUBTEST)]
+
+
+def validate_landing_inputs(root, here, policy, old, h):
+    h.authenticate(root / policy['landing_package'], policy['landing_manifest_sha256'])
+    old_pins = h.read(old / 'SOURCE-PINS.json')
+    capture = old_pins[LANDING_PATH]['capture']
+    before = (old / capture).read_bytes()
+    after = (here / capture).read_bytes()
+    h.need(hashlib.sha256(before).hexdigest() == OLD_BODY_SHA and hashlib.sha256(after).hexdigest() == NEW_BODY_SHA, 'fixed old/new landing bodies')
+    h.need(before.count(REMOVED_LINE) == 1 and before.replace(REMOVED_LINE, b'', 1) == after, 'exact one unrelated assertion removed')
+    origin = policy['landing_package'] + '/candidate/' + LANDING_PATH
+    h.need((root / origin).read_bytes() == after and h.sha(root / policy['landing_package'] / 'candidate' / SOURCE) == policy['source_roles']['candidate'][SOURCE], 'landing package source and WPT')
+    expected_pins = copy.deepcopy(old_pins)
+    expected_pins[LANDING_PATH].update(bytes=len(after), sha256=NEW_BODY_SHA, origin=origin)
+    h.need(h.read(here / 'SOURCE-PINS.json') == expected_pins, 'only landing source record changed')
+    for name, item in expected_pins.items():
+        if item['exists']:
+            h.need(h.sha(here / item['capture']) == item['sha256'], 'captured input: ' + name)
+    expected_experiment = h.read(old / 'EXPERIMENT.json')
+    h.need(expected_experiment['expected_subtest_count'] == 738 and expected_experiment['target_subtests'][LANDING_TEST].count(OMITTED_SUBTEST) == 1, 'historical experiment roster')
+    expected_experiment['target_subtests'][LANDING_TEST].remove(OMITTED_SUBTEST)
+    expected_experiment['expected_subtest_count'] = 737
+    h.need(h.read(here / 'EXPERIMENT.json') == expected_experiment, 'exact final experiment projection')
+    h.need(policy['target_subtests'] == expected_experiment['target_subtests'] and policy['expected_subtest_count'] == 737, 'exact final target roster')
+    expected_manifest = h.read(old / 'SUBSET-MANIFEST.json')
+    leaf = expected_manifest['items']['testharness']['css']['css-values']['round-context-quotient-precision.html']
+    blob_hash = lambda body: hashlib.sha1(b'blob ' + str(len(body)).encode() + b'\0' + body).hexdigest()
+    h.need(leaf == [blob_hash(before), [None, {}]], 'original ordinary testharness manifest')
+    leaf[0] = blob_hash(after)
+    h.need(h.read(here / 'SUBSET-MANIFEST.json') == expected_manifest, 'only landing manifest body hash changed')
+
 
