abs_B2R_lt_emax:
  forall (prec emax : Z) (x : binary_float prec emax),
  (Rabs (B2R prec emax x) < Raux.bpow radix2 emax)%R
Bfrexp_correct:
  forall (prec emax : Z) (prec_gt_0_ : FLX.Prec_gt_0 prec),
  (2 < emax)%Z ->
  forall f : binary_float prec emax,
  is_finite_strict prec emax f = true ->
  let x := B2R prec emax f in
  let z := fst (Bfrexp prec emax prec_gt_0_ f) in
  let e := snd (Bfrexp prec emax prec_gt_0_ f) in
  (/ 2 <= Rabs (B2R prec emax z) < 1)%R /\
  x = (B2R prec emax z * Raux.bpow radix2 e)%R /\
  e = Raux.mag_val radix2 x (Raux.mag radix2 x)
generic_format_B2R:
  forall (prec emax : Z) (x : binary_float prec emax),
  Generic_fmt.generic_format radix2 (SpecFloat.fexp prec emax)
    (B2R prec emax x)


