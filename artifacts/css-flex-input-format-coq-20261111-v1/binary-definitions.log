binary_float
     : Z -> Z -> Set
B2R
     : forall prec emax : Z, binary_float prec emax -> R
is_finite
     : forall prec emax : Z, binary_float prec emax -> bool
generic_format_B2R
     : forall (prec emax : Z) (x : binary_float prec emax),
       Generic_fmt.generic_format radix2 (SpecFloat.fexp prec emax)
         (B2R prec emax x)
valid_binary
