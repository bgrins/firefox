B754_finite
     : forall prec emax : Z,
       bool ->
       forall (m : positive) (e : Z),
       SpecFloat.bounded prec emax m e = true -> binary_float prec emax
B2R =
fun (prec emax : Z) (f : binary_float prec emax) =>
match f with
| B754_finite _ _ s m e _ =>
    Defs.F2R
      {| Defs.Fnum := SpecFloat.cond_Zopp s (Z.pos m); Defs.Fexp := e |}
| _ => 0%R
end
     : forall prec emax : Z, binary_float prec emax -> R

Arguments B2R (prec emax)%Z_scope f
SpecFloat.fexp =
fun prec emax e : Z => Z.max (e - prec) (SpecFloat.emin prec emax)
     : Z -> Z -> Z -> Z

Arguments SpecFloat.fexp (prec emax e)%Z_scope
SpecFloat.emin = fun prec emax : Z => (3 - emax - prec)%Z
     : Z -> Z -> Z

Arguments SpecFloat.emin (prec emax)%Z_scope


