diff --git a/testing/web-platform/tests/css/css-easing/timing-functions-calculated-step-range.html b/testing/web-platform/tests/css/css-easing/timing-functions-calculated-step-range.html
new file mode 100644
index 000000000000..62ffb4eb45dd
--- /dev/null
+++ b/testing/web-platform/tests/css/css-easing/timing-functions-calculated-step-range.html
@@ -0,0 +1,45 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Calculated step counts honor the integer range</title>
+<link rel="help" href="https://drafts.csswg.org/css-easing-2/#step-easing-functions">
+<link rel="help" href="https://drafts.csswg.org/css-values-4/#calc-range">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<body>
+<script>
+for (const property of ["animation-timing-function", "transition-timing-function"]) {
+  for (const [expression, expected] of [
+    ["-10", 1], ["0", 1], ["1", 1], ["0.49", 1],
+    ["1.49", 1], ["1.5", 2], ["2.5", 3], ["2", 2]
+  ]) {
+    test(t => {
+      const target = document.createElement("div");
+      document.body.append(target);
+      t.add_cleanup(() => target.remove());
+      target.style.setProperty(property, `steps(calc(${expression}), start)`);
+      assert_not_equals(target.style.getPropertyValue(property), "", "calculated count is accepted");
+      assert_equals(getComputedStyle(target).getPropertyValue(property),
+                    `steps(${expected}, start)`, "computed count honors its range");
+    }, `${property}: steps(calc(${expression}), start)`);
+  }
+  for (const literal of ["-1", "0", "1.5"]) {
+    test(() => {
+      const target = document.createElement("div");
+      target.style.setProperty(property, "linear");
+      target.style.setProperty(property, `steps(${literal}, start)`);
+      assert_equals(target.style.getPropertyValue(property), "linear");
+    }, `${property}: rejects literal ${literal}`);
+  }
+  test(t => {
+    const target = document.createElement("div");
+    document.body.append(target);
+    t.add_cleanup(() => target.remove());
+    target.style.setProperty(property, "steps(calc(0), start)");
+    assert_not_equals(target.style.getPropertyValue(property), "");
+    target.style.setProperty(property, "steps(4, end)");
+    assert_equals(getComputedStyle(target).getPropertyValue(property), "steps(4)");
+    target.style.removeProperty(property);
+    assert_equals(getComputedStyle(target).getPropertyValue(property), "ease");
+  }, `${property}: replacement and reset`);
+}
+</script>
diff --git a/testing/web-platform/tests/css/css-grid/subgrid/subgrid-repeat-calculated-zero.html b/testing/web-platform/tests/css/css-grid/subgrid/subgrid-repeat-calculated-zero.html
new file mode 100644
index 000000000000..6288d598ab9f
--- /dev/null
+++ b/testing/web-platform/tests/css/css-grid/subgrid/subgrid-repeat-calculated-zero.html
@@ -0,0 +1,35 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Calculated zero subgrid repeat counts are clamped to one</title>
+<link rel="help" href="https://drafts.csswg.org/css-grid-2/#repeat-syntax">
+<link rel="help" href="https://drafts.csswg.org/css-values-4/#calc-range">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<style>
+.parent { display: grid; grid-template-columns: 100px 100px; width: 200px; }
+.child { display: grid; grid-column: 1 / -1; }
+</style>
+<div class="parent"><div id="calculated" class="child"></div></div>
+<div class="parent"><div id="literal" class="child"></div></div>
+<script>
+test(() => {
+  assert_true(CSS.supports("grid-template-columns", "subgrid"));
+  calculated.style.gridTemplateColumns = "subgrid repeat(calc(0), [fixed]) repeat(auto-fill, [fill]) [tail]";
+  literal.style.gridTemplateColumns = "subgrid repeat(1, [fixed]) repeat(auto-fill, [fill]) [tail]";
+  for (const element of [calculated, literal]) {
+    assert_not_equals(element.style.gridTemplateColumns, "", "declaration accepted");
+    assert_equals(element.getBoundingClientRect().width, 200, "bounded two-column span");
+  }
+  const expected = getComputedStyle(literal).gridTemplateColumns;
+  const actual = getComputedStyle(calculated).gridTemplateColumns;
+  const expectedRepeat = getComputedStyle(literal).gridTemplateColumns;
+  const actualRepeat = getComputedStyle(calculated).gridTemplateColumns;
+  assert_equals(expected, "subgrid [fixed] [fill] [tail]", "literal resolved-name calibration");
+  assert_equals(expectedRepeat, expected, "literal resolved names repeat stable");
+  assert_equals(actualRepeat, actual, "calculated resolved names repeat stable");
+  for (const element of [calculated, literal]) {
+    assert_equals(element.getBoundingClientRect().width, 200, "bounded two-column span repeats");
+  }
+  assert_equals(actual, expected, "calculated zero and literal one resolve to the same names");
+}, "bounded subgrid calc(0) versus literal repeat(1)");
+</script>
