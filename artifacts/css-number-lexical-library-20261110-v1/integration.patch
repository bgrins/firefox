+++ b/CssDerivation/Reference/NumberLexical/Caller.lean
@@ -0,0 +1,42 @@
+import CssDerivation.Reference.NumberLexical.IdentifierStart
+import CssDerivation.Reference.NumberLexical.Boundary
+namespace Caller
+open HexPrefix Escape
+
+theorem original_ident_progress (owned : Bool) (xs : List Byte)
+    (h : IdentifierStart.native (xs.map Fin.val) = true) :
+    0 < (Name.run owned xs).count := by
+  cases xs with
+  | nil => simp [IdentifierStart.native] at h
+  | cons b bs =>
+    by_cases ho : Name.ordinary b = true
+    · exact Name.positive_ordinary owned b bs ho
+    · have hf : Name.ordinary b = false := by simpa using ho
+      by_cases hz : b.val = 0
+      · exact Name.positive_nul owned b bs hz
+      · have ha : IdentifierStart.nativeAscii b.val = false := by
+          simp [IdentifierStart.nativeAscii]
+          simp [Name.ordinary,Name.simple,Name.continuation,Name.fourIntro] at hf
+          omega
+        have h45 : b.val ≠ 45 := by
+          intro he
+          simp [Name.ordinary,Name.simple,he] at ho
+        have hb := Name.nonordinary_ascii b hf
+        by_cases h92 : b.val = 92
+        · have hn : Name.newlineAfter bs = false := by
+            cases bs with
+            | nil => rfl
+            | cons c cs =>
+              simpa [IdentifierStart.native,ha,h45,h92,IdentifierStart.newlineAt,
+                IdentifierStart.newline,IdentifierStart.nativeAscii,Name.newlineAfter] using h
+          exact Name.positive_escape owned b bs h92 hn
+        · simp [IdentifierStart.native,ha,h45,h92,hb] at h
+
+theorem original_ident_boundary (owned : Bool) (xs : List Byte)
+    (h : IdentifierStart.native (xs.map Fin.val) = true) :
+    0 < (Name.run owned xs).count ∧ Boundary.marker xs (Name.run owned xs).count :=
+  ⟨original_ident_progress owned xs h, Boundary.name_return_marker owned xs⟩
+
+#print axioms original_ident_progress
+#print axioms original_ident_boundary
+end Caller
diff --git a/CssDerivation/Reference/NumberLexical/Escape.lean b/CssDerivation/Reference/NumberLexical/Escape.lean
new file mode 100644
--- /dev/null
+++ b/CssDerivation/Reference/NumberLexical/Escape.lean
@@ -0,0 +1,132 @@
+import CssDerivation.Reference.NumberLexical.HexPrefix
+namespace Escape
+open HexPrefix
+
+def byte (n : Nat) : Byte := ⟨n % 256, Nat.mod_lt _ (by decide)⟩
+
+def encode (n : Nat) : List Byte :=
+  if n < 128 then [byte n]
+  else if n < 2048 then [byte (192+n/64), byte (128+n%64)]
+  else if n < 65536 then [byte (224+n/4096), byte (128+n/64%64),byte (128+n%64)]
+  else [byte (240+n/262144),byte (128+n/4096%64),byte (128+n/64%64),byte (128+n%64)]
+
+def nativeScalar (n : Nat) : Nat :=
+  if n = 0 then 65533
+  else if n > 1114111 ∨ 55296 ≤ n ∧ n ≤ 57343 then 65533 else n
+
+def referenceScalar (n : Nat) : Nat :=
+  if 1 ≤ n ∧ n ≤ 1114111 ∧ (n < 55296 ∨ 57344 ≤ n) then n else 65533
+
+theorem scalar_mapping (n : Nat) : nativeScalar n = referenceScalar n := by
+  unfold nativeScalar referenceScalar
+  split <;> split <;> try omega
+  all_goals split <;> omega
+
+def width (b : Byte) : Nat :=
+  if b.val < 128 then 1 else if b.val < 224 then 2 else if b.val < 240 then 3 else 4
+
+def nativeWhitespace (xs : List Byte) : Nat :=
+  match xs with
+  | [] => 0
+  | b::bs =>
+    if b.val = 32 ∨ b.val = 9 then 1
+    else if b.val = 10 ∨ b.val = 12 ∨ b.val = 13 then
+      if b.val = 13 ∧ bs.head? = some (byte 10) then 2 else 1
+    else 0
+
+def referenceWhitespace (xs : List Byte) : Nat :=
+  if xs.take 2 = [byte 13,byte 10] then 2
+  else if xs.head?.any (fun b => [9,10,12,13,32].contains b.val) then 1 else 0
+
+theorem whitespace_reference (xs : List Byte) : nativeWhitespace xs = referenceWhitespace xs := by
+  cases xs with
+  | nil => decide
+  | cons b bs =>
+    cases bs with
+    | nil =>
+      simp [nativeWhitespace, referenceWhitespace, byte]
+      split <;> split <;> simp_all <;> omega
+    | cons c cs =>
+      simp [nativeWhitespace, referenceWhitespace, byte, Fin.ext_iff]
+      split <;> split <;> simp_all <;> try omega
+      all_goals split <;> simp_all <;> omega
+
+theorem whitespace_bound (xs : List Byte) : nativeWhitespace xs ≤ xs.length := by
+  cases xs with
+  | nil => simp [nativeWhitespace]
+  | cons b bs =>
+    simp only [nativeWhitespace,List.length_cons]
+    split
+    · omega
+    · split
+      · split
+        · rename_i h
+          cases bs <;> simp_all
+        · omega
+      · omega
+
+structure Result where
+  output : List Byte
+  count : Nat
+  deriving DecidableEq, Repr
+
+def native (xs : List Byte) : Result :=
+  match xs with
+  | [] => ⟨encode 65533,0⟩
+  | b::_ =>
+    match nativeDigit b with
+    | some _ =>
+      let h := HexPrefix.run 6 xs 0
+      ⟨encode (nativeScalar h.value), h.count + nativeWhitespace h.rest⟩
+    | none =>
+      if b.val = 0 then ⟨encode 65533,1⟩
+      else ⟨xs.take (width b), (xs.take (width b)).length⟩
+
+def reference (xs : List Byte) : Result :=
+  match xs with
+  | [] => ⟨encode 65533,0⟩
+  | b::_ =>
+    if (referenceDigit b).isSome then
+      let h := HexPrefix.reference 6 xs 0
+      ⟨encode (referenceScalar h.value), h.count + referenceWhitespace h.rest⟩
+    else if b.val = 0 then ⟨encode 65533,1⟩
+    else ⟨xs.take (width b), (xs.take (width b)).length⟩
+
+theorem native_reference (xs : List Byte) : native xs = reference xs := by
+  cases xs with
+  | nil => rfl
+  | cons b bs =>
+    cases h : nativeDigit b <;>
+      simp [native, reference, ← digit_classification, h, HexPrefix.run_reference,
+        scalar_mapping, whitespace_reference]
+
+theorem consumption_bound (xs : List Byte) : (native xs).count ≤ xs.length := by
+  cases xs with
+  | nil => simp [native]
+  | cons b bs =>
+    simp only [native]
+    split
+    · have h := HexPrefix.consumed_plus_remaining 6 (b::bs) 0
+      have w := whitespace_bound (HexPrefix.run 6 (b::bs) 0).rest
+      simp only; omega
+    · split
+      · simp
+      · simp only [List.length_take,List.length_cons]; omega
+
+theorem residual_bound (xs : List Byte) : (xs.drop (native xs).count).length ≤ xs.length := by
+  simp
+
+example : native [] = ⟨encode 65533,0⟩ := by decide
+example : native [byte 0,byte 65] = ⟨encode 65533,1⟩ := by decide
+example : native [byte 54,byte 49,byte 13,byte 10,byte 66] = ⟨encode 97,4⟩ := by decide
+example : native [byte 48,byte 48,byte 48,byte 48,byte 54,byte 49,byte 66] = ⟨encode 97,6⟩ := by decide
+example : native [byte 100,byte 56,byte 48,byte 48] = ⟨encode 65533,4⟩ := by decide
+example : native [byte 195,byte 169,byte 65] = ⟨[byte 195,byte 169],2⟩ := by decide
+
+#print axioms native_reference
+#print axioms whitespace_reference
+#print axioms scalar_mapping
+#print axioms whitespace_bound
+#print axioms consumption_bound
+#print axioms residual_bound
+end Escape
diff --git a/CssDerivation/Reference/NumberLexical/EscapeBoundary.lean b/CssDerivation/Reference/NumberLexical/EscapeBoundary.lean
new file mode 100644
--- /dev/null
+++ b/CssDerivation/Reference/NumberLexical/EscapeBoundary.lean
@@ -0,0 +1,69 @@
+import CssDerivation.Reference.NumberLexical.Boundary
+namespace EscapeBoundary
+open HexPrefix Escape Boundary
+
+theorem whitespace_ascii (xs : List Byte) :
+    ∀ b ∈ xs.take (nativeWhitespace xs), b.val < 128 := by
+  cases xs with
+  | nil => simp
+  | cons c cs =>
+    simp only [nativeWhitespace]
+    split
+    · simp only [List.take_succ_cons,List.take_zero,List.mem_cons,List.not_mem_nil,or_false]
+      intro b hb
+      subst b
+      omega
+    · split
+      · split
+        · rename_i h
+          cases cs with
+          | nil => simp at h
+          | cons d ds =>
+            simp only [List.head?_cons,Option.some.injEq] at h
+            simp only [List.take_succ_cons,List.take_zero,List.mem_cons,List.not_mem_nil,or_false]
+            intro b hb
+            rcases hb with rfl | rfl
+            · omega
+            · simp [h.2,byte]
+              decide
+        · simp only [List.take_succ_cons,List.take_zero,List.mem_cons,List.not_mem_nil,or_false]
+          intro b hb
+          subst b
+          omega
+      · simp
+
+theorem whitespace_suffix (units : List Boundary.Unit) (xs : List Byte) (h : bytes units = xs) :
+    ∃ rest : List Boundary.Unit, xs.drop (nativeWhitespace xs) = bytes rest := by
+  apply ascii_prefix units (xs.take (nativeWhitespace xs)) _
+  · simpa using h
+  · exact whitespace_ascii xs
+
+theorem native_suffix (units : List Boundary.Unit) :
+    ∃ rest : List Boundary.Unit, (bytes units).drop (Escape.native (bytes units)).count = bytes rest := by
+  cases units with
+  | nil => exact ⟨[], rfl⟩
+  | cons u us =>
+    cases hd : nativeDigit u.first with
+    | some d =>
+      obtain ⟨next,hn⟩ := hex_suffix 6 (u::us) (bytes (u::us)) 0 rfl
+      obtain ⟨last,hl⟩ := whitespace_suffix next (HexPrefix.run 6 (bytes (u::us)) 0).rest hn.symm
+      refine ⟨last, ?_⟩
+      have he := HexPrefix.exact_remainder 6 (bytes (u::us)) 0
+      simp only [bytes,List.flatMap_cons,Unit.bytes,List.cons_append,Escape.native,hd]
+      simp only [bytes,List.flatMap_cons,Unit.bytes,List.cons_append] at he hl
+      rw [← List.drop_drop, ← he]
+      exact hl
+    | none =>
+      by_cases hz : u.first.val = 0
+      · have hr := unit_ascii_singleton u (by omega)
+        exact ⟨us, by simp [bytes,Unit.bytes,Escape.native,hd,hz,hr]⟩
+      · have hw := u.lengthWidth.symm
+        refine ⟨us, ?_⟩
+        simp [bytes,Unit.bytes,Escape.native,hd,hz,List.length_take,hw]
+        rw [Nat.add_comm 1]
+        simp
+
+#print axioms whitespace_ascii
+#print axioms whitespace_suffix
+#print axioms native_suffix
+end EscapeBoundary
diff --git a/CssDerivation/Reference/NumberLexical/HexPrefix.lean b/CssDerivation/Reference/NumberLexical/HexPrefix.lean
new file mode 100644
--- /dev/null
+++ b/CssDerivation/Reference/NumberLexical/HexPrefix.lean
@@ -0,0 +1,145 @@
+import Std
+set_option maxRecDepth 4096
+set_option maxHeartbeats 2000000
+namespace HexPrefix
+abbrev Byte := Fin 256
+
+def nativeDigit (b : Byte) : Option Nat :=
+  if 48 ≤ b.val ∧ b.val ≤ 57 then some (b.val - 48)
+  else if 97 ≤ b.val ∧ b.val ≤ 102 then some (b.val - 97 + 10)
+  else if 65 ≤ b.val ∧ b.val ≤ 70 then some (b.val - 65 + 10)
+  else none
+
+def digitTable : List (Nat × Nat) :=
+  [(48,0),(49,1),(50,2),(51,3),(52,4),(53,5),(54,6),(55,7),(56,8),(57,9),
+   (65,10),(66,11),(67,12),(68,13),(69,14),(70,15),
+   (97,10),(98,11),(99,12),(100,13),(101,14),(102,15)]
+
+def referenceDigit (b : Byte) : Option Nat :=
+  (digitTable.find? fun p => p.1 == b.val).map Prod.snd
+
+theorem digit_classification : ∀ b : Byte, nativeDigit b = referenceDigit b := by decide
+
+theorem digit_bound (b : Byte) (d : Nat) (h : nativeDigit b = some d) : d < 16 := by
+  unfold nativeDigit at h
+  split at h
+  · cases h; omega
+  · split at h
+    · cases h; omega
+    · split at h
+      · cases h; omega
+      · contradiction
+
+structure Result where
+  value : Nat
+  count : Nat
+  rest : List Byte
+  deriving DecidableEq, Repr
+
+def run : Nat → List Byte → Nat → Result
+  | 0, xs, value => ⟨value,0,xs⟩
+  | _+1, [], value => ⟨value,0,[]⟩
+  | n+1, b::xs, value =>
+    match nativeDigit b with
+    | none => ⟨value,0,b::xs⟩
+    | some d =>
+      let r := run n xs (value*16+d)
+      ⟨r.value,r.count+1,r.rest⟩
+
+def selected (fuel : Nat) (xs : List Byte) : List Byte :=
+  (xs.takeWhile fun b => (referenceDigit b).isSome).take fuel
+
+def reference (fuel : Nat) (xs : List Byte) (value : Nat) : Result :=
+  let picked := selected fuel xs
+  ⟨(picked.filterMap referenceDigit).foldl (fun v d => v*16+d) value,
+    picked.length, xs.drop picked.length⟩
+
+theorem selected_none (n : Nat) (b : Byte) (xs : List Byte)
+    (h : referenceDigit b = none) : selected (n+1) (b::xs) = [] := by
+  simp [selected,h]
+
+theorem selected_some (n : Nat) (b : Byte) (xs : List Byte) (d : Nat)
+    (h : referenceDigit b = some d) : selected (n+1) (b::xs) = b :: selected n xs := by
+  simp [selected,h]
+
+theorem run_reference (fuel : Nat) (xs : List Byte) (value : Nat) :
+    run fuel xs value = reference fuel xs value := by
+  induction fuel generalizing xs value with
+  | zero => simp [run,reference,selected]
+  | succ fuel ih =>
+    cases xs with
+    | nil => simp [run,reference,selected]
+    | cons b xs =>
+      cases hd : nativeDigit b with
+      | none =>
+        have hr : referenceDigit b = none := by simpa [digit_classification] using hd
+        simp [run,hd,reference,selected_none _ _ _ hr]
+      | some d =>
+        have hr : referenceDigit b = some d := by simpa [digit_classification] using hd
+        simp [run,hd,ih,reference,selected_some _ _ _ _ hr,hr]
+
+theorem selected_length_le (fuel : Nat) (xs : List Byte) :
+    (selected fuel xs).length ≤ xs.length ∧ (selected fuel xs).length ≤ fuel := by
+  simp only [selected,List.length_take]
+  have h : (List.takeWhile (fun b => (referenceDigit b).isSome) xs).length ≤ xs.length := by
+    induction xs with
+    | nil => simp
+    | cons b bs ih =>
+      cases hc : (referenceDigit b).isSome <;> simp [hc, ih]
+  omega
+
+theorem count_bound (fuel : Nat) (xs : List Byte) (value : Nat) :
+    (run fuel xs value).count ≤ xs.length ∧ (run fuel xs value).count ≤ fuel := by
+  rw [run_reference]
+  exact selected_length_le fuel xs
+
+theorem exact_remainder (fuel : Nat) (xs : List Byte) (value : Nat) :
+    (run fuel xs value).rest = xs.drop (run fuel xs value).count := by
+  simp [run_reference,reference]
+
+theorem consumed_plus_remaining (fuel : Nat) (xs : List Byte) (value : Nat) :
+    (run fuel xs value).count + (run fuel xs value).rest.length = xs.length := by
+  rw [exact_remainder,List.length_drop]
+  have := (count_bound fuel xs value).1
+  omega
+
+theorem value_bound (fuel : Nat) (xs : List Byte) (initial : Nat) :
+    (run fuel xs initial).value < (initial+1) * 16^fuel := by
+  induction fuel generalizing xs initial with
+  | zero => simp [run]
+  | succ fuel ih =>
+    have hp : 1 ≤ 16^(fuel+1) := Nat.one_le_pow _ _ (by decide)
+    have hi : initial+1 ≤ (initial+1)*16^(fuel+1) := by
+      calc initial+1 = (initial+1)*1 := by omega
+           _ ≤ _ := Nat.mul_le_mul_left _ hp
+    cases xs with
+    | nil => simp only [run]; omega
+    | cons b bs =>
+      cases hd : nativeDigit b with
+      | none => simp only [run,hd]; omega
+      | some d =>
+        have hb := digit_bound b d hd
+        have hm : initial*16+d+1 ≤ (initial+1)*16 := by omega
+        simp only [run,hd]
+        calc (run fuel bs (initial*16+d)).value < (initial*16+d+1)*16^fuel := ih _ _
+             _ ≤ ((initial+1)*16)*16^fuel := Nat.mul_le_mul_right _ hm
+             _ = (initial+1)*16^(fuel+1) := by rw [Nat.pow_succ]; ac_rfl
+
+theorem six_digits_u32 (xs : List Byte) : (run 6 xs 0).value < 4294967296 := by
+  have h := value_bound 6 xs 0
+  change (run 6 xs 0).value < 16777216 at h
+  omega
+
+#print axioms value_bound
+#print axioms six_digits_u32
+example : (run 6 [48,48,48,48,54,49,66] 0) = ⟨97,6,[66]⟩ := by decide
+example : (run 6 [49,103] 0) = ⟨1,1,[103]⟩ := by decide
+example : (run 6 [102,102,102,102,102,102] 0).value = 16777215 := by decide
+
+#print axioms digit_classification
+#print axioms digit_bound
+#print axioms run_reference
+#print axioms count_bound
+#print axioms exact_remainder
+#print axioms consumed_plus_remaining
+end HexPrefix
diff --git a/CssDerivation/Reference/NumberLexical/IdentifierStart.lean b/CssDerivation/Reference/NumberLexical/IdentifierStart.lean
new file mode 100644
--- /dev/null
+++ b/CssDerivation/Reference/NumberLexical/IdentifierStart.lean
@@ -0,0 +1,156 @@
+import Std
+
+namespace IdentifierStart
+
+def newline (b : Nat) : Bool := b == 10 || b == 12 || b == 13
+
+def nativeAscii (b : Nat) : Bool :=
+  (97 ≤ b && b ≤ 122) || (65 ≤ b && b ≤ 90) || b == 95 || b == 0
+
+def newlineAt (input : List Nat) (offset : Nat) : Bool :=
+  match input[offset]? with | none => false | some b => newline b
+
+def native (input : List Nat) : Bool :=
+  match input with
+  | [] => false
+  | b :: rest =>
+    if nativeAscii b then true
+    else if b == 45 then
+      match rest with
+      | [] => false
+      | c :: _ => if nativeAscii c || c == 45 then true
+                  else if c == 92 then !newlineAt input 1
+                  else !(c < 128)
+    else if b == 92 then !newlineAt input 1
+    else !(b < 128)
+
+def specStart (b : Nat) : Bool :=
+  decide (b = 0 ∨ b = 95 ∨ 65 ≤ b ∧ b ≤ 90 ∨ 97 ≤ b ∧ b ≤ 122 ∨ 128 ≤ b)
+
+def validEscape (input : List Nat) : Bool :=
+  match input with
+  | 92 :: 10 :: _ | 92 :: 12 :: _ | 92 :: 13 :: _ => false
+  | 92 :: _ => true
+  | _ => false
+
+def reference (input : List Nat) : Bool :=
+  match input with
+  | [] => false
+  | b :: rest =>
+    if b = 45 then
+      match rest with
+      | [] => false
+      | c :: _ => specStart c || c == 45 || validEscape rest
+    else if b = 92 then validEscape input
+    else specStart b
+
+def corrected (input : List Nat) : Bool :=
+  match input with
+  | [] => false
+  | b :: rest =>
+    if nativeAscii b then true
+    else if b == 45 then
+      match rest with
+      | [] => false
+      | c :: _ => if nativeAscii c || c == 45 then true
+                  else if c == 92 then !newlineAt input 2
+                  else !(c < 128)
+    else if b == 92 then !newlineAt input 1
+    else !(b < 128)
+
+theorem ascii_classification (b : Nat) :
+    (nativeAscii b || !(b < 128)) = specStart b := by
+  apply Bool.eq_iff_iff.mpr
+  simp [nativeAscii, specStart]
+  omega
+
+theorem bad_admission_lf (tail : List Nat) :
+    native (45 :: 92 :: 10 :: tail) = true ∧ reference (45 :: 92 :: 10 :: tail) = false := by
+  simp [native, nativeAscii, newlineAt, newline, reference, specStart, validEscape]
+
+theorem bad_admission_cr (tail : List Nat) :
+    native (45 :: 92 :: 13 :: tail) = true ∧ reference (45 :: 92 :: 13 :: tail) = false := by
+  simp [native, nativeAscii, newlineAt, newline, reference, specStart, validEscape]
+
+theorem bad_admission_ff (tail : List Nat) :
+    native (45 :: 92 :: 12 :: tail) = true ∧ reference (45 :: 92 :: 12 :: tail) = false := by
+  simp [native, nativeAscii, newlineAt, newline, reference, specStart, validEscape]
+
+example : corrected [45,92,10] = false := by decide
+example : corrected [45,92,13] = false := by decide
+example : corrected [45,92,12] = false := by decide
+example : native [45,45,92,10] = true ∧ reference [45,45,92,10] = true := by decide
+example : native [92,10] = false ∧ reference [92,10] = false := by decide
+
+
+
+theorem escape_shape (b : Nat) (tail : List Nat) :
+    validEscape (b :: tail) = (b == 92 && !newlineAt tail 0) := by
+  by_cases hb : b = 92
+  · subst b
+    cases tail with
+    | nil => rfl
+    | cons c rest =>
+      by_cases h10 : c = 10 <;> by_cases h12 : c = 12 <;> by_cases h13 : c = 13 <;>
+        simp_all [validEscape, newlineAt, newline]
+  · cases tail <;> simp_all [validEscape, newlineAt]
+
+theorem corrected_reference (input : List Nat) : corrected input = reference input := by
+  cases input with
+  | nil => rfl
+  | cons b tail =>
+    by_cases hb45 : b = 45 <;> by_cases hb92 : b = 92
+    · omega
+    · subst b
+      cases tail with
+      | nil => rfl
+      | cons c rest =>
+        by_cases hc45 : c = 45 <;> by_cases hc92 : c = 92 <;>
+          simp_all [corrected, reference, escape_shape, newlineAt, nativeAscii, specStart]
+        all_goals apply Bool.eq_iff_iff.mpr; simp; omega
+    · subst b
+      simp [corrected, reference, nativeAscii, escape_shape, newlineAt]
+    · simp only [corrected, reference, hb45, hb92, ite_false, beq_iff_eq]
+      simp
+      have h := ascii_classification b
+      cases ha : nativeAscii b <;> simp_all
+
+def affected (input : List Nat) : Bool :=
+  match input with
+  | 45 :: 92 :: c :: _ => newline c
+  | _ => false
+
+theorem exact_change (input : List Nat) :
+    (native input != corrected input) = affected input := by
+  cases input with
+  | nil => rfl
+  | cons b tail =>
+    by_cases hb : b = 45
+    · subst b
+      cases tail with
+      | nil => rfl
+      | cons c rest =>
+        by_cases hc : c = 92
+        · subst c
+          cases rest <;> simp [native, corrected, affected, nativeAscii, newlineAt, newline]
+        · simp [native, corrected, affected, hc, nativeAscii]
+    · simp [native, corrected, affected, hb]
+
+theorem unchanged_outside (input : List Nat) (h : affected input = false) :
+    native input = corrected input := by
+  have e := exact_change input
+  simpa [h] using e
+
+theorem fixed_rejects (tail : List Nat) (c : Nat) (h : newline c = true) :
+    corrected (45 :: 92 :: c :: tail) = false := by
+  simp [corrected, nativeAscii, newlineAt, h]
+
+#print axioms ascii_classification
+#print axioms bad_admission_lf
+#print axioms bad_admission_cr
+#print axioms bad_admission_ff
+#print axioms corrected_reference
+#print axioms exact_change
+#print axioms unchanged_outside
+#print axioms fixed_rejects
+end IdentifierStart
