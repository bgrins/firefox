+++ b/CssDerivation/Reference/NumberLexical/Name.lean
@@ -0,0 +1,166 @@
+import CssDerivation.Reference.NumberLexical.Escape
+namespace Name
+open HexPrefix Escape
+set_option maxRecDepth 4096
+set_option maxHeartbeats 3000000
+
+def simple (b : Byte) : Bool :=
+  (97 ≤ b.val && b.val ≤ 122) || (65 ≤ b.val && b.val ≤ 90) ||
+  (48 ≤ b.val && b.val ≤ 57) || b.val == 95 || b.val == 45 || (192 ≤ b.val && b.val ≤ 239)
+
+def continuation (b : Byte) : Bool := 128 ≤ b.val && b.val ≤ 191
+def fourIntro (b : Byte) : Bool := 240 ≤ b.val && b.val ≤ 255
+def ordinary (b : Byte) : Bool := simple b || continuation b || fourIntro b
+
+def referenceOrdinary (b : Byte) : Bool :=
+  "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-".toList.any (fun c => c.toNat == b.val)
+    || 128 ≤ b.val
+
+theorem ordinary_classification : ∀ b : Byte, ordinary b = referenceOrdinary b := by decide
+
+theorem nonordinary_ascii (b : Byte) (h : ordinary b = false) : b.val < 128 := by
+  have hb := b.isLt
+  simp [ordinary,simple,continuation,fourIntro] at h
+  omega
+
+def newlineAfter (bs : List Byte) : Bool :=
+  match bs with
+  | [] => false
+  | b::_ => b.val == 10 || b.val == 12 || b.val == 13
+
+structure Result where
+  output : List Byte
+  count : Nat
+  rest : List Byte
+  owned : Bool
+  deriving DecidableEq, Repr
+
+def run (owned : Bool) (xs : List Byte) : Result :=
+  match xs with
+  | [] => ⟨[],0,[],owned⟩
+  | b::bs =>
+    if ordinary b then
+      let r := run owned bs
+      ⟨b::r.output,r.count+1,r.rest,r.owned⟩
+    else if b.val = 0 then
+      let r := run true bs
+      ⟨encode 65533 ++ r.output,r.count+1,r.rest,r.owned⟩
+    else if b.val = 92 then
+      if newlineAfter bs then ⟨[],0,b::bs,true⟩
+      else
+        let e := Escape.native bs
+        let r := run true (bs.drop e.count)
+        ⟨e.output ++ r.output,1+e.count+r.count,r.rest,r.owned⟩
+    else ⟨[],0,b::bs,owned⟩
+termination_by xs.length
+decreasing_by all_goals simp_wf <;> omega
+
+theorem ordinary_prefix (owned : Bool) (pre suffix : List Byte)
+    (h : ∀ b ∈ pre, ordinary b = true) :
+    run owned (pre ++ suffix) =
+      let r := run owned suffix
+      ⟨pre ++ r.output, pre.length + r.count, r.rest, r.owned⟩ := by
+  induction pre with
+  | nil => simp
+  | cons b bs ih =>
+    have hb := h b (by simp)
+    have ht : ∀ c ∈ bs, ordinary c = true := by intro c hc; exact h c (by simp [hc])
+    simp [run,hb,ih ht,Nat.add_assoc,Nat.add_comm,Nat.add_left_comm]
+
+theorem simple_ordinary (b : Byte) (h : simple b = true) : ordinary b = true := by
+  simp [ordinary,h]
+
+theorem fast_prefix (owned : Bool) (pre suffix : List Byte)
+    (h : ∀ b ∈ pre, simple b = true) :
+    run owned (pre ++ suffix) =
+      let r := run owned suffix
+      ⟨pre ++ r.output, pre.length + r.count, r.rest, r.owned⟩ :=
+  ordinary_prefix owned pre suffix (fun b hb => simple_ordinary b (h b hb))
+
+theorem native_fast_chunk (owned : Bool) (xs : List Byte) :
+    run owned xs =
+      let pre := xs.takeWhile simple
+      let r := run owned (xs.dropWhile simple)
+      ⟨pre ++ r.output, pre.length+r.count,r.rest,r.owned⟩ := by
+  have h : ∀ b ∈ xs.takeWhile simple, simple b = true := by
+    induction xs with
+    | nil => simp
+    | cons b bs ih =>
+      cases hb : simple b <;> simp_all [hb]
+  have result := fast_prefix owned (xs.takeWhile simple) (xs.dropWhile simple) h
+  simpa using result
+
+def advanceSafe (b : Byte) : Bool :=
+  (b.val < 128 || (b.val &&& 240 != 240 && b.val &&& 192 != 128)) &&
+    b.val != 10 && b.val != 12 && b.val != 13
+
+theorem fast_chunk_advance_domain : ∀ b : Byte, simple b = true → advanceSafe b = true := by decide
+
+theorem consumed_bound (owned : Bool) (xs : List Byte) : (run owned xs).count ≤ xs.length := by
+  induction owned, xs using run.induct with
+  | case1 owned => simp_all [run]
+  | case2 owned b bs h ih => simp_all [run] <;> omega
+  | case3 owned b bs h hz ih => simp_all [run] <;> omega
+  | case4 owned b bs h hz hb hn => simp_all [run]
+  | case5 owned b bs h hz hb hn e ih =>
+      have he := Escape.consumption_bound bs
+      dsimp [e] at ih
+      simp [run, h, hz, hb, hn]
+      simp only [List.length_drop] at ih
+      omega
+  | case6 owned b bs h hz hb => simp_all [run]
+
+theorem exact_remainder (owned : Bool) (xs : List Byte) :
+    (run owned xs).rest = xs.drop (run owned xs).count := by
+  induction owned, xs using run.induct with
+  | case1 owned => simp [run]
+  | case2 owned b bs h ih => simpa [run,h] using ih
+  | case3 owned b bs h hz ih => simpa [run,h,hz] using ih
+  | case4 owned b bs h hz hb hn => simp [run,h,hz,hb,hn]
+  | case5 owned b bs h hz hb hn e ih =>
+      dsimp [e] at ih
+      simp only [run, h, Bool.false_eq_true, ↓reduceIte, hz, hb, hn]
+      rw [show 1 + (Escape.native bs).count + (run true (bs.drop (Escape.native bs).count)).count =
+          ((Escape.native bs).count + (run true (bs.drop (Escape.native bs).count)).count) + 1 by omega]
+      simpa [List.drop_drop] using ih
+  | case6 owned b bs h hz hb => simp [run,h,hz,hb]
+
+theorem positive_ordinary (owned : Bool) (b : Byte) (bs : List Byte)
+    (h : ordinary b = true) : 0 < (run owned (b::bs)).count := by
+  simp [run,h]
+
+theorem positive_nul (owned : Bool) (b : Byte) (bs : List Byte)
+    (h : b.val = 0) : 0 < (run owned (b::bs)).count := by
+  simp [run,ordinary,simple,continuation,fourIntro,h]
+
+theorem positive_escape (owned : Bool) (b : Byte) (bs : List Byte)
+    (h : b.val = 92) (hn : newlineAfter bs = false) : 0 < (run owned (b::bs)).count := by
+  simp [run,ordinary,simple,continuation,fourIntro,h,hn]
+  omega
+
+def boundary (xs : List Byte) : Prop := xs = [] ∨ ∃ b bs, xs = b::bs ∧ b.val < 128
+
+theorem return_boundary (owned : Bool) (xs : List Byte) : boundary (run owned xs).rest := by
+  induction owned, xs using run.induct with
+  | case1 owned => simp [run,boundary]
+  | case2 owned b bs h ih => simpa [run,h] using ih
+  | case3 owned b bs h hz ih => simpa [run,h,hz] using ih
+  | case4 owned b bs h hz hb hn => simp [run,h,hz,hb,hn,boundary]
+  | case5 owned b bs h hz hb hn e ih => simpa [run, h, hz, hb, hn] using ih
+  | case6 owned b bs h hz hb =>
+      have ha : b.val < 128 := nonordinary_ascii b (by simpa using h)
+      simp [run,h,hz,hb,boundary,ha]
+
+#print axioms native_fast_chunk
+#print axioms fast_chunk_advance_domain
+#print axioms positive_ordinary
+#print axioms positive_nul
+#print axioms positive_escape
+#print axioms ordinary_prefix
+#print axioms fast_prefix
+#print axioms exact_remainder
+#print axioms ordinary_classification
+#print axioms nonordinary_ascii
+#print axioms consumed_bound
+#print axioms return_boundary
+end Name
diff --git a/CssDerivation/Reference/NumberLexical/NumericDigits.lean b/CssDerivation/Reference/NumberLexical/NumericDigits.lean
new file mode 100644
--- /dev/null
+++ b/CssDerivation/Reference/NumberLexical/NumericDigits.lean
@@ -0,0 +1,101 @@
+import Std
+set_option maxRecDepth 4096
+set_option maxHeartbeats 2000000
+namespace NumericDigits
+abbrev Byte := Fin 256
+
+def digit (b : Byte) : Bool := 48 ≤ b.val && b.val ≤ 57
+
+def referenceDigit (b : Byte) : Bool :=
+  "0123456789".toList.any (fun c => c.toNat == b.val)
+
+theorem classifier : ∀ b : Byte, digit b = referenceDigit b := by decide
+
+theorem digit_ascii (b : Byte) (h : digit b = true) : b.val < 128 := by
+  simp [digit] at h
+  omega
+
+structure Scan where
+  digits : List Byte
+  rest : List Byte
+  reads : List Nat
+  deriving DecidableEq, Repr
+
+def scan : List Byte → Scan
+  | [] => ⟨[],[],[]⟩
+  | b::bs =>
+    if digit b then
+      let r := scan bs
+      ⟨b::r.digits,r.rest,0::r.reads.map (·+1)⟩
+    else ⟨[],b::bs,[0]⟩
+
+def reference (xs : List Byte) : List Byte × List Byte :=
+  (xs.takeWhile referenceDigit,xs.dropWhile referenceDigit)
+
+theorem scan_reference (xs : List Byte) :
+    ((scan xs).digits,(scan xs).rest) = reference xs := by
+  induction xs with
+  | nil => rfl
+  | cons b bs ih =>
+    cases h : digit b <;> simp [scan,h,reference,← classifier] at *
+    exact ih
+
+theorem cover (xs : List Byte) : (scan xs).digits ++ (scan xs).rest = xs := by
+  have h := scan_reference xs
+  have hd := congrArg Prod.fst h
+  have hr := congrArg Prod.snd h
+  simp only [reference] at hd hr
+  rw [hd,hr]
+  exact List.takeWhile_append_dropWhile
+
+theorem count_bound (xs : List Byte) : (scan xs).digits.length ≤ xs.length := by
+  have h := congrArg List.length (cover xs)
+  simp only [List.length_append] at h
+  omega
+
+theorem exact_suffix (xs : List Byte) : (scan xs).rest = xs.drop (scan xs).digits.length := by
+  have h := cover xs
+  calc (scan xs).rest = ((scan xs).digits ++ (scan xs).rest).drop (scan xs).digits.length := by simp
+       _ = _ := by rw [h]
+
+theorem consumed_digits (xs : List Byte) : ∀ b ∈ (scan xs).digits, digit b = true := by
+  induction xs with
+  | nil => simp [scan]
+  | cons b bs ih => cases hb : digit b <;> simp_all [scan]
+
+theorem maximal (xs : List Byte) : (scan xs).rest = [] ∨
+    ∃ b bs, (scan xs).rest = b::bs ∧ digit b = false := by
+  induction xs with
+  | nil => simp [scan]
+  | cons b bs ih =>
+    cases hb : digit b
+    · exact Or.inr ⟨b,bs,by simp [scan,hb],hb⟩
+    · simpa [scan,hb] using ih
+
+theorem reads_bounded (xs : List Byte) : ∀ i ∈ (scan xs).reads, i < xs.length := by
+  induction xs with
+  | nil => simp [scan]
+  | cons b bs ih =>
+    cases hb : digit b <;> simp only [scan,hb,Bool.false_eq_true,↓reduceIte,List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false,List.length_cons]
+    · intro i hi; subst i; omega
+    · intro i hi
+      rcases hi with rfl | hi
+      · omega
+      · obtain ⟨j,hj,rfl⟩ := List.mem_map.mp hi
+        have := ih j hj
+        omega
+
+theorem nonempty_first_read (b : Byte) (bs : List Byte) : (scan (b::bs)).reads.head? = some 0 := by
+  cases h : digit b <;> simp [scan,h]
+
+#print axioms classifier
+#print axioms digit_ascii
+#print axioms scan_reference
+#print axioms cover
+#print axioms count_bound
+#print axioms exact_suffix
+#print axioms consumed_digits
+#print axioms maximal
+#print axioms reads_bounded
+#print axioms nonempty_first_read
+end NumericDigits
diff --git a/CssDerivation/Reference/NumberLexical/NumericEntry.lean b/CssDerivation/Reference/NumberLexical/NumericEntry.lean
new file mode 100644
--- /dev/null
+++ b/CssDerivation/Reference/NumberLexical/NumericEntry.lean
@@ -0,0 +1,90 @@
+import CssDerivation.Reference.NumberLexical.NumericDigits
+namespace NumericEntry
+open NumericDigits
+
+def signByte (b : Byte) : Bool := b.val == 43 || b.val == 45
+
+def stripSign (xs : List Byte) : List Byte :=
+  match xs with
+  | [] => []
+  | b::bs => if signByte b then bs else xs
+
+def hasSign (xs : List Byte) : Bool := xs.head?.any signByte
+
+def dotDigit (xs : List Byte) : Bool :=
+  match xs with
+  | b::c::_ => b.val == 46 && digit c
+  | _ => false
+
+def nativeStart (xs : List Byte) : Bool :=
+  match xs with
+  | [] => false
+  | b::bs =>
+    if digit b then true
+    else if signByte b then bs.head?.any digit || dotDigit bs
+    else if b.val == 46 then bs.head?.any digit
+    else false
+
+def referenceStart (xs : List Byte) : Bool :=
+  match stripSign xs with
+  | [] => false
+  | b::bs => referenceDigit b || (b.val == 46 && bs.head?.any referenceDigit)
+
+theorem sign_not_digit (b : Byte) (h : signByte b = true) : digit b = false := by
+  simp [signByte] at h
+  simp [digit]
+  omega
+
+theorem dot_not_digit (b : Byte) (h : b.val = 46) : digit b = false := by simp [digit,h]
+
+theorem dot_head_shape (xs : List Byte) :
+    (xs.head?.any digit || dotDigit xs) =
+    (match xs with | [] => false | b::bs => digit b || (b.val == 46 && bs.head?.any digit)) := by
+  cases xs with
+  | nil => rfl
+  | cons b bs => cases bs <;> simp [dotDigit]
+
+theorem entry_reference (xs : List Byte) : nativeStart xs = referenceStart xs := by
+  have hc : referenceDigit = digit := funext (fun b => (classifier b).symm)
+  cases xs with
+  | nil => rfl
+  | cons b bs =>
+    by_cases hs : signByte b = true
+    · have hd := sign_not_digit b hs
+      simp [nativeStart,referenceStart,stripSign,hs,hd,hc, dot_head_shape]
+    · have hs' : signByte b = false := by simpa using hs
+      by_cases hb : b.val = 46 <;> cases hd : digit b <;>
+        simp [nativeStart,referenceStart,stripSign,hs',hc,hb,hd]
+
+theorem entry_nonempty (xs : List Byte) (h : nativeStart xs = true) : xs ≠ [] := by
+  intro hx
+  simp [hx,nativeStart] at h
+
+theorem first_loop_nonempty (xs : List Byte) (h : nativeStart xs = true) : stripSign xs ≠ [] := by
+  rw [entry_reference] at h
+  intro hx
+  simp [referenceStart,hx] at h
+
+theorem signed_cover (xs : List Byte) :
+    (if hasSign xs then xs.take 1 else []) ++ stripSign xs = xs := by
+  cases xs with
+  | nil => rfl
+  | cons b bs => cases hs : signByte b <;> simp [hasSign,stripSign,hs]
+
+theorem entry_first_digit_or_fraction (xs : List Byte) (h : nativeStart xs = true) :
+    (stripSign xs).head?.any digit = true ∨ dotDigit (stripSign xs) = true := by
+  have hc : referenceDigit = digit := funext (fun b => (classifier b).symm)
+  rw [entry_reference] at h
+  have hshape := dot_head_shape (stripSign xs)
+  have hr : ((stripSign xs).head?.any digit || dotDigit (stripSign xs)) = true := by
+    rw [hshape]
+    simpa [referenceStart,hc] using h
+  simpa using hr
+
+#print axioms sign_not_digit
+#print axioms entry_reference
+#print axioms entry_nonempty
+#print axioms first_loop_nonempty
+#print axioms signed_cover
+#print axioms entry_first_digit_or_fraction
+end NumericEntry
diff --git a/CssDerivation/Reference/NumberLexical/NumericLexical.lean b/CssDerivation/Reference/NumberLexical/NumericLexical.lean
new file mode 100644
--- /dev/null
+++ b/CssDerivation/Reference/NumberLexical/NumericLexical.lean
@@ -0,0 +1,145 @@
+import CssDerivation.Reference.NumberLexical.NumericParts
+namespace NumericLexical
+open NumericDigits NumericEntry NumericParts
+
+structure Result where
+  text : List Byte
+  rest : List Byte
+  integralDigits : List Byte
+  fractionalDigits : List Byte
+  exponentDigits : List Byte
+  hasSign : Bool
+  negative : Bool
+  exponentNegative : Bool
+  isInteger : Bool
+  deriving DecidableEq, Repr
+
+def signText (xs : List Byte) : List Byte := if NumericEntry.hasSign xs then xs.take 1 else []
+
+def native (xs : List Byte) : Result :=
+  let integral := scan (stripSign xs)
+  let frac := fraction integral.rest
+  let expo := exponent frac.rest
+  ⟨signText xs ++ integral.digits ++ frac.text ++ expo.text,expo.rest,
+   integral.digits,frac.digits,expo.digits,NumericEntry.hasSign xs,
+   xs.head?.any (fun b => b.val == 45),expo.negative,!frac.used && !expo.used⟩
+
+def reference (xs : List Byte) : Result :=
+  let body := stripSign xs
+  let ints := picked body
+  let frac := refFraction (body.drop ints.length)
+  let expo := refExponent frac.rest
+  ⟨signText xs ++ ints ++ frac.text ++ expo.text,expo.rest,
+   ints,frac.digits,expo.digits,NumericEntry.hasSign xs,
+   xs.head?.any (fun b => b.val == 45),expo.negative,!frac.used && !expo.used⟩
+
+theorem native_reference (xs : List Byte) : native xs = reference xs := by
+  simp [native,reference,NumericDigits.exact_suffix,digits_picked,fraction_reference,exponent_reference]
+
+theorem cover (xs : List Byte) : (native xs).text ++ (native xs).rest = xs := by
+  simp only [native,List.append_assoc]
+  rw [exponent_cover,fraction_cover,NumericDigits.cover]
+  exact signed_cover xs
+
+theorem count_bound (xs : List Byte) : (native xs).text.length ≤ xs.length := by
+  have h := congrArg List.length (cover xs)
+  simp only [List.length_append] at h
+  omega
+
+theorem exact_suffix (xs : List Byte) : (native xs).rest = xs.drop (native xs).text.length := by
+  have h := cover xs
+  calc (native xs).rest = ((native xs).text ++ (native xs).rest).drop (native xs).text.length := by simp
+       _ = _ := by rw [h]
+
+theorem frac_active_nonempty (xs : List Byte) (h : dotDigit xs = true) :
+    (fraction xs).text ≠ [] := by
+  have he := fraction_entry xs h
+  cases xs with
+  | nil => simp at he
+  | cons b bs => simp [fraction,h]
+
+theorem scan_empty_rest (xs : List Byte) (h : (scan xs).digits = []) : (scan xs).rest = xs := by
+  simpa [h] using NumericDigits.cover xs
+
+theorem positive (xs : List Byte) (h : nativeStart xs = true) : 0 < (native xs).text.length := by
+  have he := entry_first_digit_or_fraction xs h
+  by_cases hi : (scan (stripSign xs)).digits = []
+  · have hr := scan_empty_rest _ hi
+    have hd : (stripSign xs).head?.any digit = false := by
+      have hp : picked (stripSign xs) = [] := by simpa [digits_picked] using hi
+      have hn := picked_nonempty (stripSign xs)
+      simp [hp] at hn
+      simpa using hn
+    have hf : dotDigit (stripSign xs) = true := by simpa [hd] using he
+    have ht := frac_active_nonempty _ hf
+    have hl : 0 < (fraction (stripSign xs)).text.length := List.length_pos_iff.mpr ht
+    simp only [native,List.length_append]
+    rw [hr]
+    omega
+  · have hl : 0 < (scan (stripSign xs)).digits.length := List.length_pos_iff.mpr hi
+    simp only [native,List.length_append]
+    omega
+
+theorem fraction_ascii (xs : List Byte) : ∀ b ∈ (fraction xs).text, b.val < 128 := by
+  unfold fraction
+  split
+  · rename_i h
+    cases xs with
+    | nil => simp [dotDigit] at h
+    | cons c cs =>
+      have hc : c.val = 46 := by cases cs <;> simp_all [dotDigit]
+      simp only [List.take_succ_cons,List.take_zero,List.drop_succ_cons,List.drop_zero,List.singleton_append,List.mem_cons]
+      intro b hb
+      rcases hb with rfl | hb
+      · omega
+      · exact digit_ascii b (consumed_digits cs b hb)
+  · simp [emptyPart]
+
+theorem sign_ascii (xs : List Byte) : ∀ b ∈ signText xs, b.val < 128 := by
+  cases xs with
+  | nil => simp [signText]
+  | cons c cs =>
+    by_cases hs : signByte c = true
+    · simp only [signText,NumericEntry.hasSign,List.head?_cons,Option.any_some,hs,↓reduceIte,
+        List.take_succ_cons,List.take_zero,List.mem_singleton]
+      intro b hb
+      subst b
+      simp [signByte] at hs
+      omega
+    · simp [signText,NumericEntry.hasSign,hs]
+
+theorem exponent_ascii (xs : List Byte) : ∀ b ∈ (exponent xs).text, b.val < 128 := by
+  unfold exponent
+  split
+  · rename_i h
+    cases xs with
+    | nil => simp [exponentGuard] at h
+    | cons c cs =>
+      have hc : c.val = 69 ∨ c.val = 101 := by cases cs <;> simp_all [exponentGuard,exponentByte]
+      simp only [List.take_succ_cons,List.take_zero,List.drop_succ_cons,List.drop_zero,List.singleton_append,List.mem_cons,List.mem_append]
+      intro b hb
+      rcases hb with (rfl | hb) | hb
+      · omega
+      · exact sign_ascii cs b hb
+      · exact digit_ascii b (consumed_digits (stripSign cs) b hb)
+  · simp [emptyPart]
+
+theorem consumed_ascii (xs : List Byte) : ∀ b ∈ (native xs).text, b.val < 128 := by
+  simp only [native,List.mem_append]
+  intro b hb
+  rcases hb with ((hb | hb) | hb) | hb
+  · exact sign_ascii xs b hb
+  · exact digit_ascii b (consumed_digits (stripSign xs) b hb)
+  · exact fraction_ascii _ b hb
+  · exact exponent_ascii _ b hb
+
+#print axioms native_reference
+#print axioms cover
+#print axioms count_bound
+#print axioms exact_suffix
+#print axioms positive
+#print axioms fraction_ascii
+#print axioms sign_ascii
+#print axioms exponent_ascii
+#print axioms consumed_ascii
+end NumericLexical
diff --git a/CssDerivation/Reference/NumberLexical/NumericParts.lean b/CssDerivation/Reference/NumberLexical/NumericParts.lean
new file mode 100644
--- /dev/null
+++ b/CssDerivation/Reference/NumberLexical/NumericParts.lean
@@ -0,0 +1,163 @@
+import CssDerivation.Reference.NumberLexical.NumericEntry
+namespace NumericParts
+open NumericDigits NumericEntry
+
+structure Part where
+  text : List Byte
+  digits : List Byte
+  rest : List Byte
+  used : Bool
+  negative : Bool
+  deriving DecidableEq, Repr
+
+def emptyPart (xs : List Byte) : Part := ⟨[],[],xs,false,false⟩
+
+def fraction (xs : List Byte) : Part :=
+  if dotDigit xs then
+    let r := scan (xs.drop 1)
+    ⟨xs.take 1 ++ r.digits,r.digits,r.rest,true,false⟩
+  else emptyPart xs
+
+def exponentByte (b : Byte) : Bool := b.val == 69 || b.val == 101
+
+def exponentGuard (xs : List Byte) : Bool :=
+  match xs with
+  | b::c::cs => exponentByte b &&
+      (digit c || (signByte c && cs.head?.any digit))
+  | _ => false
+
+def exponent (xs : List Byte) : Part :=
+  if exponentGuard xs then
+    let tail := xs.drop 1
+    let sign := if hasSign tail then tail.take 1 else []
+    let r := scan (stripSign tail)
+    ⟨xs.take 1 ++ sign ++ r.digits,r.digits,r.rest,true,tail.head?.any (fun b => b.val == 45)⟩
+  else emptyPart xs
+
+def picked (xs : List Byte) : List Byte := xs.takeWhile referenceDigit
+
+def refFraction (xs : List Byte) : Part :=
+  match xs with
+  | [] => emptyPart xs
+  | b::bs =>
+    let ds := picked bs
+    if b.val = 46 ∧ ds ≠ [] then
+      ⟨b::ds,ds,bs.drop ds.length,true,false⟩
+    else emptyPart xs
+
+def refExponent (xs : List Byte) : Part :=
+  match xs with
+  | [] => emptyPart xs
+  | b::bs =>
+    let core := stripSign bs
+    let ds := picked core
+    if (b.val = 69 ∨ b.val = 101) ∧ ds ≠ [] then
+      let sign := if hasSign bs then bs.take 1 else []
+      ⟨b::(sign ++ ds),ds,core.drop ds.length,true,bs.head?.any (fun b => b.val == 45)⟩
+    else emptyPart xs
+
+theorem digits_picked (xs : List Byte) : (scan xs).digits = picked xs := by
+  exact congrArg Prod.fst (scan_reference xs)
+
+theorem picked_nonempty (xs : List Byte) : picked xs ≠ [] ↔ xs.head?.any digit = true := by
+  cases xs with
+  | nil => simp [picked]
+  | cons b bs => cases hd : digit b <;> simp [picked,← classifier,hd]
+
+theorem fraction_guard (xs : List Byte) :
+    dotDigit xs = (match xs with
+      | [] => false
+      | b::bs => decide (b.val = 46 ∧ picked bs ≠ [])) := by
+  cases xs with
+  | nil => rfl
+  | cons b bs =>
+      cases bs <;> simp [dotDigit,picked_nonempty]
+      apply Bool.eq_iff_iff.mpr
+      simp
+
+theorem exponent_guard (xs : List Byte) :
+    exponentGuard xs = (match xs with
+      | [] => false
+      | b::bs => decide ((b.val = 69 ∨ b.val = 101) ∧ picked (stripSign bs) ≠ [])) := by
+  cases xs with
+  | nil => rfl
+  | cons b bs =>
+    cases bs with
+    | nil => simp [exponentGuard,stripSign,picked]
+    | cons c cs =>
+      cases hs : signByte c
+      · simp [exponentGuard,exponentByte,stripSign,hs,picked_nonempty]
+        apply Bool.eq_iff_iff.mpr
+        simp
+      · have hd := sign_not_digit c hs
+        simp [exponentGuard,exponentByte,stripSign,hs,picked_nonempty,hd]
+        apply Bool.eq_iff_iff.mpr
+        simp
+
+theorem fraction_reference (xs : List Byte) : fraction xs = refFraction xs := by
+  cases xs with
+  | nil => rfl
+  | cons b bs =>
+    simp only [fraction, fraction_guard, refFraction, decide_eq_true_eq]
+    split
+    · simp [digits_picked,NumericDigits.exact_suffix]
+    · rfl
+
+theorem exponent_reference (xs : List Byte) : exponent xs = refExponent xs := by
+  cases xs with
+  | nil => rfl
+  | cons b bs =>
+    simp only [exponent, exponent_guard, refExponent, decide_eq_true_eq]
+    split
+    · simp [digits_picked,NumericDigits.exact_suffix]
+    · rfl
+
+theorem fraction_cover (xs : List Byte) : (fraction xs).text ++ (fraction xs).rest = xs := by
+  unfold fraction
+  split
+  · simp only [List.append_assoc]
+    rw [NumericDigits.cover]
+    exact List.take_append_drop _ _
+  · rfl
+
+theorem exponent_cover (xs : List Byte) : (exponent xs).text ++ (exponent xs).rest = xs := by
+  unfold exponent
+  split
+  · simp only [List.append_assoc]
+    rw [NumericDigits.cover,signed_cover]
+    exact List.take_append_drop _ _
+  · rfl
+
+theorem fraction_entry (xs : List Byte) (h : dotDigit xs = true) :
+    (xs.drop 1).head?.any digit = true ∧ xs.length ≥ 2 := by
+  cases xs with
+  | nil => simp [dotDigit] at h
+  | cons b bs => cases bs <;> simp_all [dotDigit]
+
+theorem exponent_entry (xs : List Byte) (h : exponentGuard xs = true) :
+    (stripSign (xs.drop 1)).head?.any digit = true ∧ xs.length ≥ 2 := by
+  have hg := exponent_guard xs
+  rw [h] at hg
+  cases xs with
+  | nil => simp [exponentGuard] at h
+  | cons b bs =>
+    cases bs with
+    | nil => simp [exponentGuard] at h
+    | cons c cs =>
+      simp only [List.drop_succ_cons,List.drop_zero,List.length_cons]
+      constructor
+      · have hr : (b.val = 69 ∨ b.val = 101) ∧ picked (stripSign (c::cs)) ≠ [] := by simpa using hg.symm
+        exact (picked_nonempty _).mp hr.2
+      · omega
+
+#print axioms digits_picked
+#print axioms picked_nonempty
+#print axioms fraction_guard
+#print axioms exponent_guard
+#print axioms fraction_reference
+#print axioms exponent_reference
+#print axioms fraction_cover
+#print axioms exponent_cover
+#print axioms fraction_entry
+#print axioms exponent_entry
+end NumericParts
diff --git a/CssDerivation/Reference/NumberLexical/NumericToken.lean b/CssDerivation/Reference/NumberLexical/NumericToken.lean
new file mode 100644
--- /dev/null
+++ b/CssDerivation/Reference/NumberLexical/NumericToken.lean
@@ -0,0 +1,115 @@
+import CssDerivation.Reference.NumberLexical.NumericLexical
+import CssDerivation.Reference.NumberLexical.Integration
+import CssDerivation.Reference.NumberLexical.SemanticName
+namespace NumericToken
+open NumericDigits NumericEntry
+
+inductive Kind where
+  | number | percentage | dimension
+  deriving DecidableEq,Repr
+
+structure Result where
+  kind : Kind
+  numeric : NumericLexical.Result
+  unit : List Byte
+  count : Nat
+  rest : List Byte
+  deriving DecidableEq,Repr
+
+def percent (xs : List Byte) : Bool := xs.head?.any (fun b => b.val == 37)
+def ident (xs : List Byte) : Bool := IdentifierStart.corrected (xs.map Fin.val)
+
+def native (xs : List Byte) : Result :=
+  let n := NumericLexical.native xs
+  if percent n.rest then ⟨.percentage,n,[],n.text.length+1,n.rest.drop 1⟩
+  else if ident n.rest then
+    let u := Name.run false n.rest
+    ⟨.dimension,n,u.output,n.text.length+u.count,u.rest⟩
+  else ⟨.number,n,[],n.text.length,n.rest⟩
+
+def reference (xs : List Byte) : Result :=
+  let n := NumericLexical.reference xs
+  if ident n.rest then
+    let u := SemanticName.reference n.rest
+    ⟨.dimension,n,u.output,n.text.length+u.count,u.rest⟩
+  else if percent n.rest then ⟨.percentage,n,[],n.text.length+1,n.rest.drop 1⟩
+  else ⟨.number,n,[],n.text.length,n.rest⟩
+
+theorem percent_excludes_ident (xs : List Byte) (h : percent xs = true) : ident xs = false := by
+  cases xs with
+  | nil => simp [percent] at h
+  | cons b bs =>
+    have hb : b.val = 37 := by simpa [percent] using h
+    simp [ident,IdentifierStart.corrected,IdentifierStart.nativeAscii,hb]
+
+theorem native_reference (xs : List Byte) : native xs = reference xs := by
+  have hn := NumericLexical.native_reference xs
+  have hu := SemanticName.source_semantics false (NumericLexical.native xs).rest
+  have ho := congrArg SemanticName.Result.output hu
+  have hc := congrArg SemanticName.Result.count hu
+  have hr := congrArg SemanticName.Result.rest hu
+  simp only [SemanticName.project] at ho hc hr
+  unfold native reference
+  rw [← hn]
+  cases hp : percent (NumericLexical.native xs).rest
+  · cases hi : ident (NumericLexical.native xs).rest <;> simp [hp,hi,ho,hc,hr]
+  · have hi := percent_excludes_ident _ hp
+    simp [hp,hi]
+
+theorem count_bound (xs : List Byte) : (native xs).count ≤ xs.length := by
+  have cover := congrArg List.length (NumericLexical.cover xs)
+  simp only [List.length_append] at cover
+  unfold native
+  dsimp only
+  split
+  · rename_i h
+    have hr : 0 < (NumericLexical.native xs).rest.length := by
+      cases he : (NumericLexical.native xs).rest with
+      | nil => simp [he,percent] at h
+      | cons b bs => simp
+    simp only
+    omega
+  · split
+    · have hb := Name.consumed_bound false (NumericLexical.native xs).rest
+      simp only
+      omega
+    · simp only
+      omega
+
+theorem exact_suffix (xs : List Byte) : (native xs).rest = xs.drop (native xs).count := by
+  have hn := NumericLexical.exact_suffix xs
+  unfold native
+  dsimp only
+  split
+  · simp only
+    rw [hn,List.drop_drop]
+  · split
+    · simp only
+      rw [Name.exact_remainder,hn,List.drop_drop]
+    · exact hn
+
+theorem positive (xs : List Byte) (h : nativeStart xs = true) : 0 < (native xs).count := by
+  have hn := NumericLexical.positive xs h
+  unfold native
+  dsimp only
+  split
+  · simp only; omega
+  · split <;> simp only <;> omega
+
+theorem dimension_unit (xs : List Byte) (h : (native xs).kind = .dimension) :
+    (native xs).unit = (SemanticName.reference (NumericLexical.native xs).rest).output := by
+  have hu := SemanticName.source_semantics false (NumericLexical.native xs).rest
+  have ho := congrArg SemanticName.Result.output hu
+  simp only [SemanticName.project] at ho
+  unfold native at h ⊢
+  dsimp only at h ⊢
+  split at h <;> simp_all
+  split at h <;> simp_all
+
+#print axioms percent_excludes_ident
+#print axioms native_reference
+#print axioms count_bound
+#print axioms exact_suffix
+#print axioms positive
+#print axioms dimension_unit
+end NumericToken
