+    fn prepare_literal_priority_attributes(
+        context: &mut computed::Context,
+        value: &VariableValue,
+        attribute_tracker: &mut AttributeTracker,
+    ) {
+        for reference in &value.references.refs {
+            if !reference.is_attr_with_type() {
+                continue;
+            }
+            let Some(namespace) = reference.attribute_data.namespace() else {
+                continue;
+            };
+            if context
+                .builder
+                .substitution_functions
+                .contains_attr(&reference.name, namespace)
+            {
+                continue;
+            }
+            let Ok(parsed) = get_attr_value_for_cycle_resolution(
+                &reference.name,
+                &reference.attribute_data,
+                &value.url_data,
+                attribute_tracker,
+            ) else {
+                continue;
+            };
+            if parsed
+                .as_universal()
+                .is_some_and(|value| !value.has_references())
+            {
+                context.builder.substitution_functions.insert_attr(
+                    &reference.name,
+                    namespace,
+                    parsed,
+                );
             }
         }
     }
