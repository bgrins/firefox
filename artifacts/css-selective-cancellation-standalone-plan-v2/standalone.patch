+    const target = doc.getElementById("a");
+    const width = target.animate({ width:[`1${unit}`, `3${unit}`] }, { duration:1000, fill:"both" });
+    const opacity = target.animate({ opacity:[0.2, 0.8] }, { duration:1000, fill:"both" });
