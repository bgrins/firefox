+    doc.documentElement.style[unit === "rem" ? "fontSize" : "lineHeight"] = "47px";
+    const first = parseFloat(win.getComputedStyle(target).width);
+    await settle(win);
+    assert_approx_equals(first, 94, 0.03, "first surviving effect");
+    assert_approx_equals(parseFloat(win.getComputedStyle(target).width), 94, 0.03);
+    assert_equals(win.getComputedStyle(target).opacity, "1", "cancelled effect removed");
