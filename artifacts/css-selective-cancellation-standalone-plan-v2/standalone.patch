+    const first = parseFloat(win.getComputedStyle(target).width);
+    await settle(win);
+    assert_approx_equals(first, 94, 0.03, "first CSS animation root dependency");
+    assert_approx_equals(parseFloat(win.getComputedStyle(target).width), 94, 0.03);
+  }, `CSS animation ${unit} generated keyframes retain root dependency`);
+  promise_test(async t => {
