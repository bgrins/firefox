+<!doctype html>
+<meta charset="utf-8">
+<title>Offset and scroll dimensions preserve integral CSS pixels</title>
+<link rel="help" href="https://drafts.csswg.org/cssom-view/#dom-htmlelement-offsetleft">
+<link rel="help" href="https://drafts.csswg.org/cssom-view/#dom-htmlelement-offsettop">
+<link rel="help" href="https://drafts.csswg.org/cssom-view/#dom-htmlelement-offsetwidth">
+<link rel="help" href="https://drafts.csswg.org/cssom-view/#dom-htmlelement-offsetheight">
