+#[test]
+fn private_target_identity_preserves_variant_and_property() {
+    let metrics = [PrioritaryPropertyId::FontWeight, PrioritaryPropertyId::FontWidth,
+        PrioritaryPropertyId::FontStyle, PrioritaryPropertyId::FontSizeAdjust,
+        PrioritaryPropertyId::Direction, PrioritaryPropertyId::WritingMode,
+        PrioritaryPropertyId::TextOrientation, PrioritaryPropertyId::Appearance,
+        PrioritaryPropertyId::FontSize, PrioritaryPropertyId::LineHeight,
+        PrioritaryPropertyId::ColorScheme];
+    for left in metrics {
+        for right in metrics {
+            assert_eq!(FontTarget::Metric(left).same_as(FontTarget::Metric(right)),
+                left.to_longhand() == right.to_longhand());
+            assert!(!FontTarget::Metric(left).same_as(FontTarget::Synthesis(right.to_longhand())));
+            assert!(!FontTarget::Synthesis(right.to_longhand()).same_as(FontTarget::Metric(left)));
+        }
+    }
+    let synthesis = [LonghandId::FontSynthesisWeight, LonghandId::FontSynthesisStyle,
+        LonghandId::FontSynthesisSmallCaps, LonghandId::FontSynthesisPosition];
+    for left in synthesis {
+        for right in synthesis {
+            assert_eq!(FontTarget::Synthesis(left).same_as(FontTarget::Synthesis(right)), left == right);
+        }
+    }
+}
