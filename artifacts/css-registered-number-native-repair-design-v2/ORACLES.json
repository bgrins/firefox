      },
      "expected": {
        "--n": "3",
        "font-size": "3px"
      },
      "status": "unexecuted_assertion_oracle"
    },
    {
      "id": "noncyclic-numeric-length-division",
      "declarations": {
        "--n": "calc(1em / 1px)",
        "font-size": "20px",
        "width": "calc(var(--n) * 1px)"
      },
      "expected": {
        "--n": "20",
        "font-size": "20px",
        "width": "20px"
      },
      "mutation": {
        "set": {
          "font-size": "30px"
        },
        "expected": {
          "--n": "30",
          "font-size": "30px",
          "width": "30px"
        }
      },
      "status": "unexecuted_assertion_oracle"
    },
    {
      "id": "provider-introduced-numeric-length-division",
      "declarations": {
        "--math": "calc(1em / 1px)",
        "--n": "var(--math)",
        "font-size": "20px",
        "width": "calc(var(--n) * 1px)"
      },
      "expected": {
        "--n": "20",
        "font-size": "20px",
        "width": "20px"
      },
      "mutation": {
        "set": {
          "font-size": "30px"
        },
        "expected": {
          "--n": "30",
          "font-size": "30px",
          "width": "30px"
        }
      },
      "status": "unexecuted_assertion_oracle"
    },
    {
      "id": "unused-valid-numeric-math-fallback",
      "declarations": {
        "--ready": "5",
        "--n": "var(--ready, calc(1em / 1px))"
      },
      "expected": {
        "--n": "5",
        "font-size": "5px"
      },
      "status": "unexecuted_assertion_oracle"
    }
