  "assertion_cases": [
    {
      "id": "literal-number",
      "declarations": {
        "--n": "5"
      },
      "expected": {
        "--n": "5",
        "font-size": "5px"
      },
      "status": "unexecuted_assertion_oracle"
    },
    {
      "id": "direct-invalid-length",
      "declarations": {
        "--n": "1em"
      },
      "expected": {
        "--n": "3",
        "font-size": "3px"
      },
      "status": "unexecuted_assertion_oracle"
    },
    {
      "id": "valid-primary-unused-length",
      "declarations": {
        "--ready": "5",
        "--n": "var(--ready, 1em)"
      },
      "expected": {
        "--n": "5",
        "font-size": "5px"
      },
      "status": "unexecuted_assertion_oracle"
    },
    {
      "id": "used-invalid-length-fallback",
      "declarations": {
        "--n": "var(--missing, 1em)"
      },
      "expected": {
        "--n": "3",
        "font-size": "3px"
      },
      "status": "unexecuted_assertion_oracle"
    },
    {
      "id": "wrong-type-ready-primary",
      "declarations": {
        "--ready": "red",
