      "expected": null,
      "status": "unexecuted_observation_only_spec_integration_gap",
      "record": [
        "computed --n",
        "computed font-size",
        "computed width",
        "both declaration orders",
        "query custom property first versus font-size first"
      ],
      "not_an_oracle": "Do not assert 3px,19px,0px or a retained calc expression as normatively required without resolving the gap."
