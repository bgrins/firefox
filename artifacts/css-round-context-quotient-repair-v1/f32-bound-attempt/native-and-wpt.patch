diff --git a/testing/web-platform/tests/css/css-values/round-context-quotient-precision.html b/testing/web-platform/tests/css/css-values/round-context-quotient-precision.html
new file mode 100644
--- /dev/null
+++ b/testing/web-platform/tests/css/css-values/round-context-quotient-precision.html
@@ -0,0 +1,62 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Context-dependent round() preserves the selected multiple</title>
+<link rel="help" href="https://drafts.csswg.org/css-values-4/#round-func">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<body>
+<script>
+const step = "0.3333333432674407958984375";
+const cases = [
+  ["positive down", "down", 1, 0, step, 2 * Number(step)],
+  ["positive to-zero", "to-zero", 1, 0, step, 2 * Number(step)],
+  ["negative up", "up", -1, 1, step, 1 - 2 * Number(step)],
+  ["negative to-zero", "to-zero", -1, 1, step, 1 - 2 * Number(step)],
+  ["nearest positive control", "nearest", 1, 0, step, 1],
+  ["exact multiple down control", "down", 1, 0, "0.25", 1],
+];
+for (const [name, strategy, sign, offset, interval, expected] of cases) {
+  test(t => {
+    const target = document.createElement("div");
+    const reference = document.createElement("div");
+    const input = document.createElement("div");
+    document.body.append(target, reference, input);
+    t.add_cleanup(() => { target.remove(); reference.remove(); input.remove(); });
+    reference.style.opacity = String(expected);
+    assert_approx_equals(Number(getComputedStyle(reference).opacity), expected, 0.000001,
+                         "literal opacity calibration");
+    reference.style.opacity = "";
+    reference.style.opacity = `calc(${offset} + round(${strategy}, ${sign}, ${interval}))`;
+    assert_not_equals(reference.style.opacity, "", "constant expression accepted");
+    assert_approx_equals(Number(getComputedStyle(reference).opacity), expected, 0.000001,
+                         "constant round reference calibration");
+    target.style.opacity = `calc(${offset} + round(${strategy}, ${sign} * sign(1em - 16px), ${interval}))`;
+    input.style.opacity = "sign(1em - 16px)";
+    assert_not_equals(target.style.opacity, "", "context expression accepted");
+    assert_not_equals(input.style.opacity, "", "input expression accepted");
+    const observations = [];
+    for (const fontSize of [16, 32, 16]) {
+      target.style.fontSize = input.style.fontSize = `${fontSize}px`;
+      observations.push({
+        fontSize,
+        targetFont: getComputedStyle(target).fontSize,
+        inputFont: getComputedStyle(input).fontSize,
+        input: Number(getComputedStyle(input).opacity),
+        first: Number(getComputedStyle(target).opacity),
+        repeat: Number(getComputedStyle(target).opacity),
+      });
+    }
+    for (const row of observations) {
+      assert_equals(row.targetFont, `${row.fontSize}px`, "target font calibration");
+      assert_equals(row.inputFont, `${row.fontSize}px`, "input font calibration");
+      assert_equals(row.input, row.fontSize === 32 ? 1 : 0, "sign input calibration");
+      assert_true(Number.isFinite(row.first) && Number.isFinite(row.repeat), "finite opacity");
+      assert_equals(row.first, row.repeat, "repeat stable");
+    }
+    assert_equals(observations[0].first, offset, "initial zero-input control");
+    assert_equals(observations[2].first, offset, "restored zero-input control");
+    assert_approx_equals(observations[1].first, expected, 0.000001,
+                         "context-dependent rounded opacity");
+  }, name);
+}
+</script>
