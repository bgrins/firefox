      CssNativeHighBit.goodLength n →
        CssNativeHighBit.admissible n cell →
          (CssNativeHighBit.belongs n cell b ↔ ∃ raw, CssNativeHighBit.generate n cell raw = b)
  CssNativeHighBit.Obligations.universal : ∀ (n : Nat),
      CssNativeHighBit.goodLength n →
        ∀ (C : Type) (P : CssNativeHighBit.Backing → C → Prop),
          (∀ (b : CssNativeHighBit.Backing) (c : C), P b c) ↔
            ∀ (cell : CssNativeHighBit.Cell),
              CssNativeHighBit.admissible n cell →
                ∀ (raw : CssNativeHighBit.Backing) (c : C), P (CssNativeHighBit.generate n cell raw) c
  CssNativeHighBit.Obligations.filtered : ∀ (n : Nat),
      CssNativeHighBit.goodLength n →
        ∀ (C : Type) (V : CssNativeHighBit.Backing → Prop) (P : CssNativeHighBit.Backing → C → Prop),
          (∀ (b : CssNativeHighBit.Backing) (c : C), V b → P b c) ↔
            ∀ (cell : CssNativeHighBit.Cell),
              CssNativeHighBit.admissible n cell →
                ∀ (raw : CssNativeHighBit.Backing) (c : C),
                  V (CssNativeHighBit.generate n cell raw) → P (CssNativeHighBit.generate n cell raw) c
  CssNativeHighBit.Obligations.cover_union : ∀ (n : Nat),
      CssNativeHighBit.goodLength n →
        ∀ (C : Type) (E : CssNativeHighBit.Backing → C → Prop),
          (∃ b c, E b c) ↔
            ∃ cell, CssNativeHighBit.admissible n cell ∧ ∃ raw c, E (CssNativeHighBit.generate n cell raw) c
  CssNativeHighBit.Obligations.nonvacuity_and_tails : (∀ (n : Nat) (cell : CssNativeHighBit.Cell),
        CssNativeHighBit.goodLength n →
          CssNativeHighBit.admissible n cell →
            ∀ (C : Type) (c : C),
              ∃ raw,
                CssNativeHighBit.belongs n cell (CssNativeHighBit.generate n cell raw) ∧
                  (CssNativeHighBit.onState n cell (raw, c)).snd = c) ∧
      ∀ (n : Nat) (cell : CssNativeHighBit.Cell),
        CssNativeHighBit.goodLength n →
          n < 5 →
            CssNativeHighBit.admissible n cell →
              ∃ raw₀ raw₁,
                (∀ (i : Fin 5),
                    ↑i < n → CssNativeHighBit.generate n cell raw₀ i = CssNativeHighBit.generate n cell raw₁ i) ∧
                  (∀ (i : Fin 5),
