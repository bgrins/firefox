      (b : CssNativeHighBit.Backing),
      CssNativeHighBit.goodLength n →
        CssNativeHighBit.admissible n cell → CssNativeHighBit.belongs n cell (CssNativeHighBit.generate n cell b)
  CssNativeHighBit.Obligations.fixed_on_class : ∀ (n : Nat) (cell : CssNativeHighBit.Cell)
      (b : CssNativeHighBit.Backing),
      CssNativeHighBit.goodLength n →
        CssNativeHighBit.admissible n cell → CssNativeHighBit.belongs n cell b → CssNativeHighBit.generate n cell b = b
  CssNativeHighBit.Obligations.unique_class : ∀ (n : Nat) (b : CssNativeHighBit.Backing),
      CssNativeHighBit.goodLength n →
        ∃ cell,
          (CssNativeHighBit.admissible n cell ∧ CssNativeHighBit.belongs n cell b) ∧
            ∀ (other : CssNativeHighBit.Cell),
              CssNativeHighBit.admissible n other ∧ CssNativeHighBit.belongs n other b → other = cell
