CssNativeHighBit.Obligations.ascii_refinement : CssNativeHighBit.Obligations →
  ∀ (n : Nat),
    CssNativeHighBit.goodLength n →
      ∀ (C : Type) (V : CssNativeHighBit.Backing → Prop) (P E : CssNativeHighBit.Backing → C → Prop),
        ((∀ (b : CssNativeHighBit.Backing) (c : C), CssNativeHighBit.isAscii n b → P b c) ↔
            ∀ (a : Fin 128) (raw : CssNativeHighBit.Backing) (c : C), P (CssNativeHighBit.asciiChild n a raw) c) ∧
          ((∀ (b : CssNativeHighBit.Backing) (c : C), CssNativeHighBit.isAscii n b → V b → P b c) ↔
              ∀ (a : Fin 128) (raw : CssNativeHighBit.Backing) (c : C),
                V (CssNativeHighBit.asciiChild n a raw) → P (CssNativeHighBit.asciiChild n a raw) c) ∧
            ((∃ b c, CssNativeHighBit.isAscii n b ∧ E b c) ↔ ∃ a raw c, E (CssNativeHighBit.asciiChild n a raw) c)
CssNativeHighBit.Obligations.length_feature_aggregation : CssNativeHighBit.Obligations →
  ∀ (C : Type) (P : Nat → CssNativeHighBit.Feature → CssNativeHighBit.Backing → C → Prop),
    (∀ (n : Nat),
        CssNativeHighBit.goodLength n →
          ∀ (feature : CssNativeHighBit.Feature) (b : CssNativeHighBit.Backing) (c : C), P n feature b c) ↔
      ∀ (n : Nat),
        n ∈ CssNativeHighBit.lengths →
          ∀ (feature : CssNativeHighBit.Feature) (cell : CssNativeHighBit.Cell),
            CssNativeHighBit.admissible n cell →
              ∀ (raw : CssNativeHighBit.Backing) (c : C), P n feature (CssNativeHighBit.generate n cell raw) c
CssNativeHighBit.Controls.omitted_high_class : CssNativeHighBit.Controls →
  CssNativeHighBit.belongs 3 (CssNativeHighBit.Cell.high CssNativeHighBit.firstHighOne) CssNativeHighBit.copyWitness ∧
    ∀ (cell : CssNativeHighBit.Cell),
      CssNativeHighBit.admissible 3 cell →
        cell ≠ CssNativeHighBit.Cell.high CssNativeHighBit.firstHighOne →
          ∀ (raw : CssNativeHighBit.Backing), CssNativeHighBit.generate 3 cell raw ≠ CssNativeHighBit.copyWitness
CssNativeHighBit.Controls.fixed_remaining_high_bytes : CssNativeHighBit.Controls →
  CssNativeHighBit.belongs 3 (CssNativeHighBit.Cell.high CssNativeHighBit.firstHighOne)
      CssNativeHighBit.otherScalarWitness ∧
    ∀ (raw : CssNativeHighBit.Backing), CssNativeHighBit.fixedScalar raw ≠ CssNativeHighBit.otherScalarWitness
CssNativeHighBit.Controls.zeroed_unused_tail : CssNativeHighBit.Controls →
  CssNativeHighBit.belongs 3 (CssNativeHighBit.Cell.high CssNativeHighBit.firstHighOne) CssNativeHighBit.copyWitness ∧
    ∀ (raw : CssNativeHighBit.Backing),
      CssNativeHighBit.zeroUnused 3 (CssNativeHighBit.firstHigh CssNativeHighBit.firstHighOne raw) ≠
        CssNativeHighBit.copyWitness
CssNativeHighBit.Controls.omitted_ascii_complement : CssNativeHighBit.Controls →
  CssNativeHighBit.isAscii 2 CssNativeHighBit.asciiComplementWitness ∧
    ∀ (a : Fin 128),
      ↑a ≠ 0 →
        ∀ (raw : CssNativeHighBit.Backing),
          CssNativeHighBit.asciiChild 2 a raw ≠ CssNativeHighBit.asciiComplementWitness
CssNativeHighBit.Controls.restricted_mode_page : CssNativeHighBit.Controls →
  ¬CssNativeHighBit.restrictedContext CssNativeHighBit.dependentContext ∧
    ¬CssNativeHighBit.restrictedContext CssNativeHighBit.pageContext ∧
      ¬∀ (c : CssNativeHighBit.NativeContext), CssNativeHighBit.restrictedContext c
CssNativeHighBit.Controls.empty_context : CssNativeHighBit.Controls →
  (∀ (b : CssNativeHighBit.Backing) (c : Empty), False) ∧ ¬∃ b c, True
