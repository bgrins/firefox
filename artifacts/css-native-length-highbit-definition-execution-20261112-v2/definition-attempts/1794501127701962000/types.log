  CssNativeHighBit.Obligations.high_value : ∀ (b : UInt8),
      128 ≤ (CssNativeHighBit.high b).toNat ∧ (CssNativeHighBit.high b = b ↔ 128 ≤ b.toNat)
  CssNativeHighBit.Obligations.length_and_tail : ∀ (n : Nat) (cell : CssNativeHighBit.Cell)
      (b : CssNativeHighBit.Backing),
      CssNativeHighBit.goodLength n →
        CssNativeHighBit.admissible n cell →
          (List.ofFn (CssNativeHighBit.generate n cell b)).length = 5 ∧
            ∀ (i : Fin 5), n ≤ ↑i → CssNativeHighBit.generate n cell b i = b i
  CssNativeHighBit.Obligations.high_suffix : ∀ (j : Fin 5) (b : CssNativeHighBit.Backing) (i : Fin 5),
      ↑j < ↑i → CssNativeHighBit.firstHigh j b i = b i
