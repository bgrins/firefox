structure CssNativeHighBit.Controls : Prop
number of parameters: 0
fields:
  CssNativeHighBit.Controls.omitted_high_class : CssNativeHighBit.belongs 3
        (CssNativeHighBit.Cell.high CssNativeHighBit.firstHighOne) CssNativeHighBit.copyWitness ∧
      ∀ (cell : CssNativeHighBit.Cell),
        CssNativeHighBit.admissible 3 cell →
          cell ≠ CssNativeHighBit.Cell.high CssNativeHighBit.firstHighOne →
            ∀ (raw : CssNativeHighBit.Backing), CssNativeHighBit.generate 3 cell raw ≠ CssNativeHighBit.copyWitness
  CssNativeHighBit.Controls.fixed_remaining_high_bytes : CssNativeHighBit.belongs 3
        (CssNativeHighBit.Cell.high CssNativeHighBit.firstHighOne) CssNativeHighBit.otherScalarWitness ∧
      ∀ (raw : CssNativeHighBit.Backing), CssNativeHighBit.fixedScalar raw ≠ CssNativeHighBit.otherScalarWitness
  CssNativeHighBit.Controls.zeroed_unused_tail : CssNativeHighBit.belongs 3
        (CssNativeHighBit.Cell.high CssNativeHighBit.firstHighOne) CssNativeHighBit.copyWitness ∧
      ∀ (raw : CssNativeHighBit.Backing),
        CssNativeHighBit.zeroUnused 3 (CssNativeHighBit.firstHigh CssNativeHighBit.firstHighOne raw) ≠
          CssNativeHighBit.copyWitness
  CssNativeHighBit.Controls.omitted_ascii_complement : CssNativeHighBit.isAscii 2
        CssNativeHighBit.asciiComplementWitness ∧
      ∀ (a : Fin 128),
        ↑a ≠ 0 →
          ∀ (raw : CssNativeHighBit.Backing),
            CssNativeHighBit.asciiChild 2 a raw ≠ CssNativeHighBit.asciiComplementWitness
  CssNativeHighBit.Controls.restricted_mode_page : ¬CssNativeHighBit.restrictedContext
          CssNativeHighBit.dependentContext ∧
      ¬CssNativeHighBit.restrictedContext CssNativeHighBit.pageContext ∧
        ¬∀ (c : CssNativeHighBit.NativeContext), CssNativeHighBit.restrictedContext c
  CssNativeHighBit.Controls.empty_context : (∀ (b : CssNativeHighBit.Backing) (c : Empty), False) ∧ ¬∃ b c, True
constructor:
