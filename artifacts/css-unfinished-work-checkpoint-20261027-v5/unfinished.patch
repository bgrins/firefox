@@ -0,0 +1,104 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Typed attr fallbacks resolve their attribute dependencies</title>
+<link rel="help" href="https://drafts.csswg.org/css-values-5/#attr-substitution">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<style id="sheet">
+#fixture { font-size: 16px; width: 100px; }
+#fixture > div { display: block; padding: 0; border: 0; box-sizing: content-box; }
+</style>
+<div id="fixture"></div>
+<script>
+const cases = [
+  [
+    "Direct typed fallback resolves an attribute containing var()",
+    "--v: 13px; width: attr(bad type(<length>), attr(chain type(<length>), 5px))",
+    {
+      "bad": "not-a-length",
+      "chain": "var(--v)"
+    },
+    {
+      "width": "13px"
+    }
+  ],
+  [
+    "Custom typed fallback uses a preloaded but unresolved attribute",
+    "--v: 13px; --result: attr(bad type(<length>), attr(chain type(<length>), 5px)); width: var(--result); height: attr(chain type(<length>), 7px)",
+    {
+      "bad": "not-a-length",
+      "chain": "var(--v)"
+    },
+    {
+      "width": "13px",
+      "height": "13px"
+    }
+  ],
+  [
+    "Literal preloaded attribute control",
+    "--v: 13px; --result: attr(bad type(<length>), attr(chain type(<length>), 5px)); width: var(--result); height: attr(chain type(<length>), 7px)",
+    {
+      "bad": "not-a-length",
+      "chain": "13px"
+    },
+    {
+      "width": "13px",
+      "height": "13px"
+    }
+  ],
+  [
+    "Missing primary traverses the fallback dependency",
+    "--v: 13px; --result: attr(missing type(<length>), attr(chain type(<length>), 5px)); width: var(--result); height: attr(chain type(<length>), 7px)",
+    {
+      "chain": "var(--v)"
+    },
+    {
+      "width": "13px",
+      "height": "13px"
+    }
+  ],
+  [
+    "Custom typed fallback without an independent preload",
+    "--v: 13px; --result: attr(bad type(<length>), attr(chain type(<length>), 5px)); width: var(--result)",
+    {
+      "bad": "not-a-length",
+      "chain": "var(--v)"
+    },
+    {
+      "width": "13px"
+    }
+  ],
+  [
+    "Unused fallback does not connect the width to a separate cycle",
+    "--loop: attr(chain type(<length>)); width: attr(good type(<length>), attr(chain type(<length>), 7px))",
+    {
+      "good": "13px",
+      "chain": "var(--loop)"
+    },
+    {
+      "width": "13px"
+    }
+  ]
+];
+for (const [index, [name, declarations, attributes, expected]] of cases.entries()) {
+  test(t => {
+    const target = document.createElement("div");
+    target.id = `target-${index}`;
+    for (const [name, value] of Object.entries(attributes)) {
+      target.setAttribute(name, value);
+      assert_equals(target.getAttribute(name), value, "attribute readback");
+    }
+    const sheet = document.getElementById("sheet").sheet;
+    const ruleIndex = sheet.insertRule(`#${target.id} { ${declarations} }`, sheet.cssRules.length);
+    for (const property of Object.keys(expected)) {
+      assert_not_equals(sheet.cssRules[ruleIndex].style.getPropertyValue(property), "", `${property} parsed`);
+    }
+    document.getElementById("fixture").append(target);
+    t.add_cleanup(() => target.remove());
+    const style = getComputedStyle(target);
+    const properties = Object.keys(expected);
+    assert_array_equals(properties.map(property => style.getPropertyValue(property)),
+                        Object.values(expected), properties.join(", "));
+  }, name);
+}
+</script>
diff --git a/testing/web-platform/tests/css/css-values/attr-registered-relative-dependencies.html b/testing/web-platform/tests/css/css-values/attr-registered-relative-dependencies.html
new file mode 100644
index 0000000000000000000000000000000000000000..c490febaab999186e482ad4708770428422f9b01
--- /dev/null
+++ b/testing/web-platform/tests/css/css-values/attr-registered-relative-dependencies.html
@@ -0,0 +1,203 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Attribute and universal-value dependencies through registered lengths</title>
+<link rel="help" href="https://drafts.css-houdini.org/css-properties-values-api-1/#dependency-cycles">
+<link rel="help" href="https://drafts.csswg.org/css-values-5/#attr-substitution">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<body>
+<script>
+CSS.registerProperty({name: "--graph-length", syntax: "<length>", inherits: false,
+                      initialValue: "11px"});
+const cases = [
+  {
+    "name": "A resolved literal attribute has no relative-unit cycle",
+    "declarations": "--graph-length: attr(a type(<length>)); font-size: var(--graph-length)",
+    "attributes": {
+      "a": "13px"
+    },
+    "expected": {
+      "--graph-length": "13px",
+      "font-size": "13px",
+      "width": "13px"
+    },
+    "classification": "control",
+    "predicted_native_width": "13px"
+  },
+  {
+    "name": "A relative unit from a resolved attribute participates in the font cycle",
+    "declarations": "--graph-length: attr(a type(<length>)); font-size: var(--graph-length)",
+    "attributes": {
+      "a": "1em"
+    },
+    "expected": {
+      "--graph-length": "11px",
+      "font-size": "23px",
+      "width": "11px"
+    },
+    "classification": "lost-attribute-unit-flags",
+    "predicted_native_width": "23px"
+  },
+  {
+    "name": "A literal registered relative unit participates in the font cycle",
+    "declarations": "--graph-length: 1em; font-size: var(--graph-length)",
+    "attributes": {},
+    "expected": {
+      "--graph-length": "11px",
+      "font-size": "23px",
+      "width": "11px"
+    },
+    "classification": "control",
+    "predicted_native_width": "11px"
+  },
+  {
+    "name": "A literal universal custom property preserves the relative-unit cycle",
+    "declarations": "--raw: 1em; --graph-length: var(--raw); font-size: var(--graph-length)",
+    "attributes": {},
+    "expected": {
+      "--graph-length": "11px",
+      "font-size": "23px",
+      "width": "11px"
+    },
+    "classification": "control",
+    "predicted_native_width": "11px"
+  },
+  {
+    "name": "A substituted universal custom property preserves the relative-unit cycle",
+    "declarations": "--unit: 1em; --raw: var(--unit); --graph-length: var(--raw); font-size: var(--graph-length)",
+    "attributes": {},
+    "expected": {
+      "--graph-length": "11px",
+      "font-size": "23px",
+      "width": "11px"
+    },
+    "classification": "lost-universal-unit-flags",
+    "predicted_native_width": "23px"
+  },
+  {
+    "name": "A relative attribute without a font back edge computes normally",
+    "declarations": "--graph-length: attr(a type(<length>)); font-size: 17px",
+    "attributes": {
+      "a": "1em"
+    },
+    "expected": {
+      "--graph-length": "17px",
+      "font-size": "17px",
+      "width": "17px"
+    },
+    "classification": "lost-attribute-unit-flags-ordering",
+    "predicted_native_width": "23px"
+  },
+  {
+    "name": "An attribute in font-size exposes its chained custom-property dependency",
+    "declarations": "--graph-length: 1em; font-size: attr(a type(<length>), 5px)",
+    "attributes": {
+      "a": "var(--graph-length)"
+    },
+    "expected": {
+      "--graph-length": "11px",
+      "font-size": "23px",
+      "width": "11px"
+    },
+    "classification": "missing-noncustom-attribute-edge",
+    "predicted_native_width": "5px"
+  },
+  {
+    "name": "A lexical var reference does not change the chained attribute cycle",
+    "declarations": "--zero: 0px; --graph-length: 1em; font-size: calc(var(--zero) + attr(a type(<length>), 5px))",
+    "attributes": {
+      "a": "var(--graph-length)"
+    },
+    "expected": {
+      "--graph-length": "11px",
+      "font-size": "23px",
+      "width": "11px"
+    },
+    "classification": "control",
+    "predicted_native_width": "11px"
+  },
+  {
+    "name": "A chained attribute without a relative-unit back edge computes normally",
+    "declarations": "--graph-length: 13px; font-size: attr(a type(<length>), 5px)",
+    "attributes": {
+      "a": "var(--graph-length)"
+    },
+    "expected": {
+      "--graph-length": "13px",
+      "font-size": "13px",
+      "width": "13px"
+    },
+    "classification": "control",
+    "predicted_native_width": "13px"
+  },
+  {
+    "name": "A successful typed primary ignores a cyclic custom-property fallback",
+    "declarations": "--graph-length: attr(a type(<length>), var(--graph-length)); font-size: var(--graph-length)",
+    "attributes": {
+      "a": "13px"
+    },
+    "expected": {
+      "--graph-length": "13px",
+      "font-size": "13px",
+      "width": "13px"
+    },
+    "classification": "control",
+    "predicted_native_width": "13px"
+  },
+  {
+    "name": "A missing typed primary follows a cyclic custom-property fallback",
+    "declarations": "--graph-length: attr(missing type(<length>), var(--graph-length)); font-size: var(--graph-length)",
+    "attributes": {},
+    "expected": {
+      "--graph-length": "11px",
+      "font-size": "11px",
+      "width": "11px"
+    },
+    "classification": "control",
+    "predicted_native_width": "11px"
+  },
+  {
+    "name": "A used relative-unit fallback participates in the font cycle",
+    "declarations": "--graph-length: attr(missing type(<length>), 1em); font-size: var(--graph-length)",
+    "attributes": {},
+    "expected": {
+      "--graph-length": "11px",
+      "font-size": "23px",
+      "width": "11px"
+    },
+    "classification": "control",
+    "predicted_native_width": "11px"
+  },
+  {
+    "name": "A literal registered relative unit ensures the explicit font size first",
+    "declarations": "--graph-length: 1em; font-size: 17px",
+    "attributes": {},
+    "expected": {
+      "--graph-length": "17px",
+      "font-size": "17px",
+      "width": "17px"
+    },
+    "classification": "control",
+    "predicted_native_width": "17px"
+  }
+];
+for (const item of cases) {
+  test(t => {
+    const parent = document.createElement("div");
+    parent.style.fontSize = "23px";
+    const target = document.createElement("div");
+    target.style.cssText = "width: var(--graph-length); " + item.declarations;
+    for (const [name, value] of Object.entries(item.attributes)) {
+      target.setAttribute(name, value);
+    }
+    parent.append(target);
+    document.body.append(parent);
+    t.add_cleanup(() => parent.remove());
+    assert_equals(getComputedStyle(parent).fontSize, "23px", "parent calibration");
+    const computed = getComputedStyle(target);
+    for (const [property, expected] of Object.entries(item.expected)) {
+      assert_equals(computed.getPropertyValue(property).trim(), expected, property);
+    }
+  }, item.name);
+}
+</script>
diff --git a/testing/web-platform/tests/css/css-variables/quoted-eof-fallback.html b/testing/web-platform/tests/css/css-variables/quoted-eof-fallback.html
new file mode 100644
index 0000000000000000000000000000000000000000..fa0607798479856fef2bb63d2e8534f041d9540b
--- /dev/null
+++ b/testing/web-platform/tests/css/css-variables/quoted-eof-fallback.html
@@ -0,0 +1,27 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Quoted EOF recovery in a variable fallback</title>
+<link rel="help" href="https://drafts.csswg.org/css-syntax-3/#consume-string-token">
+<link rel="help" href="https://drafts.csswg.org/css-variables-1/#resolve-a-variable">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<body>
+<script>
+for (const [name, value] of [
+  ["closed fallback", 'var(--absent, "example")'],
+  ["missing quote and parenthesis", 'var(--absent, "example'],
+  ["escaped EOF in fallback", 'var(--absent, "example\\'],
+]) {
+  test(t => {
+    const target = document.createElement('div');
+    const reference = document.createElement('div');
+    t.add_cleanup(() => { target.remove(); reference.remove(); });
+    target.style.fontFamily = value;
+    reference.style.fontFamily = '"example"';
+    assert_not_equals(target.style.fontFamily, '', 'specified value accepted');
+    document.body.append(target, reference);
+    assert_equals(getComputedStyle(target).fontFamily,
+                  getComputedStyle(reference).fontFamily);
+  }, name);
+}
+</script>
diff --git a/testing/web-platform/tests/css/css-variables/quoted-eof-string-semantics.html b/testing/web-platform/tests/css/css-variables/quoted-eof-string-semantics.html
new file mode 100644
index 0000000000000000000000000000000000000000..df34fa2d679023ff216a6ae938dde4146cd0fd4e
--- /dev/null
+++ b/testing/web-platform/tests/css/css-variables/quoted-eof-string-semantics.html
@@ -0,0 +1,52 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Preserve EOF-recovered strings through custom-property substitution</title>
+<link rel="help" href="https://drafts.csswg.org/css-syntax-3/#consume-string-token">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<body>
+<script>
+function quoted(value) {
+  return '"' + value.replaceAll('\\', '\\\\').replaceAll('"', '\\"') + '"';
+}
+
+for (const quote of ['"', "'"]) {
+  for (let count = 0; count <= 4; count++) {
+    for (const terminalQuote of [false, true]) {
+      const raw = quote + 'example' + '\\'.repeat(count) + (terminalQuote ? quote : '');
+      const decoded = 'example' + '\\'.repeat(Math.floor(count / 2)) +
+        (terminalQuote && count % 2 ? quote : '');
+      test(t => {
+        const target = document.createElement('div');
+        const reference = document.createElement('div');
+        t.add_cleanup(() => { target.remove(); reference.remove(); });
+        target.style.setProperty('--family', raw);
+        target.style.fontFamily = 'var(--family), serif';
+        reference.style.fontFamily = quoted(decoded) + ', serif';
+        assert_not_equals(target.style.getPropertyValue('--family'), '', 'custom value accepted');
+        assert_not_equals(reference.style.fontFamily, '', 'reference accepted');
+        document.body.append(target, reference);
+        assert_equals(getComputedStyle(target).fontFamily,
+                      getComputedStyle(reference).fontFamily);
+      }, `${quote} with ${count} backslashes and ${terminalQuote ? 'a final quote' : 'EOF'}`);
+    }
+  }
+}
+
+for (const [name, value] of [
+  ['closed fallback', 'var(--absent, "example")'],
+  ['missing quote and parenthesis', 'var(--absent, "example'],
+]) {
+  test(t => {
+    const target = document.createElement('div');
+    const reference = document.createElement('div');
+    t.add_cleanup(() => { target.remove(); reference.remove(); });
+    target.style.fontFamily = value;
+    reference.style.fontFamily = '"example"';
+    assert_not_equals(target.style.fontFamily, '', 'specified value accepted');
+    document.body.append(target, reference);
+    assert_equals(getComputedStyle(target).fontFamily,
+                  getComputedStyle(reference).fontFamily);
+  }, name);
+}
+</script>
