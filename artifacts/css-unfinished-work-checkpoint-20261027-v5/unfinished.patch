+    use std::ffi::CString;
+    use std::os::raw::c_char;
+    extern "C" {
+        fn GTest_ExpectFailure(message: *const c_char);
+    }
+    let message = CString::new(message.replace('\0', "\\0")).unwrap();
+    unsafe {
