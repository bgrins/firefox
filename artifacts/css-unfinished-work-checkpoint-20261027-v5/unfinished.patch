@@ -0,0 +1,97 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Composed custom value survives unsupported iteration accumulation</title>
+<link rel="help" href="https://drafts.csswg.org/web-animations-2/">
+<link rel="help" href="https://drafts.css-houdini.org/css-properties-values-api-1/#animation-behavior-of-custom-properties">
+<link rel="help" href="https://drafts.csswg.org/css-values-5/#attr-security">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<style>
+@property --mixed {
+  syntax: "<number> | <length>";
+  inherits: false;
+  initial-value: 1;
+}
+.clean { --mixed: 8; }
+.tainted { --mixed: attr(data-number type(<number>)); }
+.length { --mixed: 20px; }
+.bundle {
+  --bundle: url("data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7") 1 / var(--mixed);
+  border-image: var(--bundle);
+}
+.direct {
+  border-image: url("data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7") 1 / var(--mixed);
+}
+</style>
+<body>
+<script>
+const sourceURL = 'url("data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7")';
+
+function makeTarget(t, provider, observer) {
+  const target = document.createElement("div");
+  target.className = `${provider} ${observer}`;
+  target.dataset.number = "8";
+  document.body.appendChild(target);
+  t.add_cleanup(() => target.remove());
+  return target;
+}
+
+function assertValue(target, expected, tainted, observer, label) {
+  const style = getComputedStyle(target);
+  assert_equals(style.getPropertyValue("--mixed").trim(), expected, `${label}: registered value`);
+  const blocked = tainted && observer === "bundle";
+  assert_equals(style.borderImageSource, blocked ? "none" : sourceURL, `${label}: URL provenance`);
+  assert_equals(style.borderImageWidth, blocked ? "1" : expected, `${label}: width grammar`);
+}
+
+for (const observer of ["bundle", "direct"]) {
+  for (const [provider, value, tainted] of [["clean", "8", false], ["tainted", "8", true], ["length", "20px", false]]) {
+    test(t => {
+      assertValue(makeTarget(t, provider, observer), value, tainted, observer, "Static calibration");
+    }, `Static ${provider} provider, ${observer}`);
+  }
+}
+
+const cases = [
+  {name: "retain composed number after mixed-type iteration", provider: "tainted", startComposite: "add", end: "20px", time: 1250, iteration: 1, progress: .25, expected: "10", tainted: true},
+  {name: "same branch with clean underlying", provider: "clean", startComposite: "add", end: "20px", time: 1250, iteration: 1, progress: .25, expected: "10", tainted: false},
+  {name: "first iteration has no accumulation", provider: "tainted", startComposite: "add", end: "20px", time: 250, iteration: 0, progress: .25, expected: "10", tainted: true},
+  {name: "replacement start ignores underlying", provider: "tainted", startComposite: "replace", end: "20px", time: 1250, iteration: 1, progress: .25, expected: "2", tainted: false},
+  {name: "same-type iteration actually accumulates", provider: "tainted", startComposite: "add", end: "20", time: 1250, iteration: 1, progress: .25, expected: "32.5", tainted: true},
+  {name: "discrete late sample selects clean accumulated length", provider: "tainted", startComposite: "add", end: "20px", time: 1750, iteration: 1, progress: .75, expected: "40px", tainted: false},
+];
+
+for (const observer of ["bundle", "direct"]) {
+  for (const c of cases) {
+    test(t => {
+      const target = makeTarget(t, c.provider, observer);
+      assertValue(target, "8", c.provider === "tainted", observer, "Underlying calibration");
+      const animation = target.animate([
+        {"--mixed": "2", offset: 0, composite: c.startComposite},
+        {"--mixed": c.end, offset: 1, composite: "replace"},
+      ], {
+        duration: 1000,
+        iterations: 3,
+        fill: "both",
+        easing: "linear",
+        composite: "replace",
+        iterationComposite: "accumulate",
+      });
+      t.add_cleanup(() => animation.cancel());
+      animation.pause();
+      animation.currentTime = c.time;
+      assert_true(target.getAnimations().includes(animation), "Effect is present");
+      assert_equals(animation.effect.composite, "replace", "Effect composite");
+      assert_equals(animation.effect.iterationComposite, "accumulate", "Iteration composite");
+      const keyframes = animation.effect.getKeyframes();
+      assert_equals(keyframes.length, 2, "Both keyframes admitted");
+      assert_array_equals(keyframes.map(k => k.composite), [c.startComposite, "replace"], "Per-keyframe composites");
+      assert_array_equals(keyframes.map(k => k["--mixed"]), ["2", c.end], "Unmodified keyframe providers");
+      const timing = animation.effect.getComputedTiming();
+      assert_equals(timing.currentIteration, c.iteration, "Current iteration");
+      assert_equals(timing.progress, c.progress, "Iteration progress");
+      assertValue(target, c.expected, c.tainted, observer, "Composed sample");
+    }, `${c.name}, ${observer}`);
+  }
+}
+</script>
diff --git a/testing/web-platform/tests/css/css-values/attr-cycle-repeated-reference.html b/testing/web-platform/tests/css/css-values/attr-cycle-repeated-reference.html
new file mode 100644
index 0000000000000000000000000000000000000000..4ccf013436c33096b879c8b0f5f48138691f2860
--- /dev/null
+++ b/testing/web-platform/tests/css/css-values/attr-cycle-repeated-reference.html
@@ -0,0 +1,198 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Repeated typed attribute after cycle invalidation</title>
+<link rel="help" href="https://drafts.csswg.org/css-values-5/#attr-substitution">
+<link rel="help" href="https://drafts.csswg.org/css-values-5/#substitute-arbitrary-substitution-function">
+<style id="probe-sheet">
+#fixture { width: 100px; }
+.target { display: block; padding: 0; border: 0; width: 10px; height: 1px; margin: var(--out); }
+#repeat-cycle { --out: attr(x type(*), 13px) attr(x type(*), 37px); }
+#single-cycle { --out: attr(x type(*), 13px); }
+#repeat-constrained-cycle { --out: attr(x type(<length>), 13px) attr(x type(<length>), 37px); }
+#repeat-invalid { --out: attr(x type(*), 13px) attr(x type(*), 37px); }
+#single-invalid { --out: attr(x type(*), 13px); }
+#repeat-literal { --out: attr(x type(*), 13px) attr(x type(*), 37px); }
+#distinct-cycles { --out: attr(x type(*), 13px) attr(y type(*), 37px); }
+#repeat-two-node-cycle { --out: attr(x type(*), 13px) attr(x type(*), 37px); }
+#same-cycle-value-different-names { --out: attr(x type(*), 13px) attr(y type(*), 37px); }
+#independent-declarations { --out: attr(x type(*), 13px); }
+#independent-declarations { --second: attr(x type(*), 37px); margin: var(--out) var(--second); }
+</style>
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<body>
+<div id="fixture"></div>
+<script>
+"use strict";
+function runAttributeReloadProbe() {
+  const definitions = [
+  [
+    "repeat-cycle",
+    "attr(x type(*), 13px) attr(x type(*), 37px)",
+    {
+      "x": "attr(x type(*))"
+    },
+    "13px 37px",
+    "13px",
+    "37px",
+    true
+  ],
+  [
+    "single-cycle",
+    "attr(x type(*), 13px)",
+    {
+      "x": "attr(x type(*))"
+    },
+    "13px",
+    "13px",
+    "13px",
+    false
+  ],
+  [
+    "repeat-constrained-cycle",
+    "attr(x type(<length>), 13px) attr(x type(<length>), 37px)",
+    {
+      "x": "attr(x type(*))"
+    },
+    "13px 37px",
+    "13px",
+    "37px",
+    false
+  ],
+  [
+    "repeat-invalid",
+    "attr(x type(*), 13px) attr(x type(*), 37px)",
+    {
+      "x": "var(--missing)"
+    },
+    "13px 37px",
+    "13px",
+    "37px",
+    true
+  ],
+  [
+    "single-invalid",
+    "attr(x type(*), 13px)",
+    {
+      "x": "var(--missing)"
+    },
+    "13px",
+    "13px",
+    "13px",
+    false
+  ],
+  [
+    "repeat-literal",
+    "attr(x type(*), 13px) attr(x type(*), 37px)",
+    {
+      "x": "19px"
+    },
+    "19px 19px",
+    "19px",
+    "19px",
+    false
+  ],
+  [
+    "distinct-cycles",
+    "attr(x type(*), 13px) attr(y type(*), 37px)",
+    {
+      "x": "attr(x type(*))",
+      "y": "attr(y type(*))"
+    },
+    "13px 37px",
+    "13px",
+    "37px",
+    false
+  ],
+  [
+    "repeat-two-node-cycle",
+    "attr(x type(*), 13px) attr(x type(*), 37px)",
+    {
+      "x": "attr(y type(*))",
+      "y": "attr(x type(*))"
+    },
+    "13px 37px",
+    "13px",
+    "37px",
+    true
+  ],
+  [
+    "same-cycle-value-different-names",
+    "attr(x type(*), 13px) attr(y type(*), 37px)",
+    {
+      "x": "attr(x type(*))",
+      "y": "attr(x type(*))"
+    },
+    "13px 37px",
+    "13px",
+    "37px",
+    true
+  ],
+  [
+    "independent-declarations",
+    "attr(x type(*), 13px)",
+    {
+      "x": "attr(x type(*))"
+    },
+    "13px",
+    "13px",
+    "37px",
+    false
+  ]
+];
+  const fixture = document.getElementById("fixture");
+  const fragment = document.createDocumentFragment();
+  for (const [id, , attributes] of definitions) {
+    const target = document.createElement("div");
+    target.id = id;
+    target.className = "target";
+    for (const [name, value] of Object.entries(attributes)) {
+      target.setAttribute(name, value);
+    }
+    fragment.append(target);
+  }
+  fixture.append(fragment);
+  const sheet = document.getElementById("probe-sheet").sheet;
+  const specified = Object.fromEntries(Array.from(sheet.cssRules)
+    .filter(rule => rule.selectorText?.startsWith("#") && rule.style.getPropertyValue("--out").trim())
+    .map(rule => [rule.selectorText.slice(1), rule.style.getPropertyValue("--out").trim()]));
+  return {
+    support: CSS.supports("margin", "attr(x type(*), 13px)"),
+    fixtureWidth: getComputedStyle(fixture).width,
+    rows: definitions.map(([id, declaration, attributes, custom, top, right, predictedFailure]) => {
+      const target = document.getElementById(id);
+      const computed = getComputedStyle(target);
+      const second = id === "independent-declarations" ? "37px" : "";
+      const actual = {second: computed.getPropertyValue("--second").trim(), custom: computed.getPropertyValue("--out").trim().replace(/\s+/g, " "),
+        top: computed.marginTop, right: computed.marginRight};
+      return {id, expected: {custom, top, right, second}, actual, predictedFailure,
+        pass: actual.second === second && actual.custom === custom && actual.top === top && actual.right === right,
+        declaration, specified: specified[id],
+        attributes: Object.fromEntries(Object.keys(attributes).map(name => [name, target.getAttribute(name)])),
+        missingCustom: computed.getPropertyValue("--missing"), width: computed.width};
+    }),
+  };
+}
+</script>
+<script>
+setup({explicit_done: true});
+window.addEventListener("load", () => {
+  const result = runAttributeReloadProbe();
+  test(() => {
+    assert_true(result.support);
+    assert_equals(result.fixtureWidth, "100px");
+  }, "Syntax support and containing block calibration");
+  for (const row of result.rows) {
+    test(() => {
+      assert_not_equals(row.specified, "");
+      assert_equals(row.width, "10px");
+      assert_equals(row.missingCustom, "");
+      assert_equals(row.actual.custom, row.expected.custom, "custom property tokens");
+      assert_equals(row.actual.second, row.expected.second, "second custom property");
+      assert_equals(row.actual.top, row.expected.top, "margin-top");
+      assert_equals(row.actual.right, row.expected.right, "margin-right");
+    }, row.id);
+  }
+  done();
+});
+</script>
diff --git a/testing/web-platform/tests/css/css-values/attr-fallback-preload.html b/testing/web-platform/tests/css/css-values/attr-fallback-preload.html
