@@ -0,0 +1,36 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Rule rollback preserves earlier layer rollback exclusions</title>
+<link rel="help" href="https://drafts.csswg.org/css-cascade-5/#revert-layer">
+<link rel="help" href="https://drafts.csswg.org/css-cascade-5/#revert-rule">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<body>
+<script>
+for (const keyword of ["none", "revert-layer", "revert", "revert-rule"]) {
+  for (const ruleRollback of [false, true]) {
+    for (const animated of [false, true]) {
+      test(t => {
+        const sheet = document.createElement("style");
+        sheet.textContent = "#rollback-target { margin-left:5px; --value:5px }";
+        if (ruleRollback) sheet.textContent += "#rollback-target { margin-left:revert-rule !important; --value:revert-rule !important }";
+        if (animated) sheet.textContent += "@keyframes rollback-constant { from,to { margin-left:59px; --value:59px } } #rollback-target { animation:rollback-constant 1s -0.5s linear paused }";
+        document.head.append(sheet);
+        const target = document.createElement("div");
+        target.id = "rollback-target";
+        if (keyword !== "none") {
+          target.style.setProperty("margin-left", keyword, "important");
+          target.style.setProperty("--value", keyword, "important");
+        }
+        document.body.append(target);
+        t.add_cleanup(() => { target.remove(); sheet.remove(); });
+        const style = getComputedStyle(target);
+        assert_equals(style.animationName, animated ? "rollback-constant" : "none", "Animation declaration");
+        const expected = keyword === "revert" ? "0px" : animated && keyword !== "revert-layer" ? "59px" : "5px";
+        assert_equals(style.marginLeft, expected, "Longhand rollback");
+        assert_equals(style.getPropertyValue("--value").trim(), keyword === "revert" ? "" : expected, "Custom property rollback");
+      }, `Inline ${keyword}, intervening rule rollback ${ruleRollback}, animation ${animated}`);
+    }
+  }
+}
+</script>
diff --git a/testing/web-platform/tests/css/css-flexbox/collapsed-item-main-axis-alignment-controls.html b/testing/web-platform/tests/css/css-flexbox/collapsed-item-main-axis-alignment-controls.html
new file mode 100644
index 0000000000000000000000000000000000000000..fd77c6c3d5a1e29e977c59e88581b5537b00118f
--- /dev/null
+++ b/testing/web-platform/tests/css/css-flexbox/collapsed-item-main-axis-alignment-controls.html
@@ -0,0 +1,67 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Collapsed item alignment preserves visible zero-size items and auto margins</title>
+<link rel="help" href="https://drafts.csswg.org/css-flexbox-1/#algo-visibility">
+<link rel="help" href="https://drafts.csswg.org/css-flexbox-1/#main-alignment">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<style>
+.container { display: flex; align-items: flex-start; }
+.container, .container > div { margin: 0; padding: 0; border: 0; }
+.container > div { flex: none; }
+.row { inline-size: 100px; block-size: 40px; }
+.row > div { inline-size: 20px; block-size: 10px; }
+.row > .zero { inline-size: 0; }
+.row > .auto { margin-inline: auto; }
+.column { block-size: 100px; inline-size: 40px; }
+.column > div { block-size: 20px; inline-size: 10px; }
+.column > .zero { block-size: 0; }
+.column > .auto { margin-block: auto; }
+.collapsed { visibility: collapse; order: -1; }
+</style>
+<div id="log"></div>
+<script>
+for (const writingMode of ["horizontal-tb", "vertical-rl", "vertical-lr"]) {
+  for (const direction of ["ltr", "rtl"]) {
+    for (const flexDirection of ["row", "row-reverse", "column", "column-reverse"]) {
+      for (const autoMargin of [false, true]) {
+        for (const [justify, ordinaryOffset] of [
+          ["flex-start", 0], ["center", 40], ["space-between", 80],
+          ["space-around", 60], ["space-evenly", 160 / 3],
+        ]) {
+          test(t => {
+            const row = flexDirection.startsWith("row");
+            const vertical = writingMode !== "horizontal-tb";
+            const container = document.createElement("div");
+            container.className = "container " + (row ? "row" : "column");
+            Object.assign(container.style, {writingMode, direction, flexDirection,
+              justifyContent: justify});
+            const zero = document.createElement("div");
+            zero.className = "zero" + (autoMargin ? " auto" : "");
+            const target = document.createElement("div");
+            const collapsed = document.createElement("div");
+            collapsed.className = "collapsed auto";
+            container.append(zero, target, collapsed);
+            document.body.append(container);
+            t.add_cleanup(() => container.remove());
+            const outer = container.getBoundingClientRect();
+            const inner = target.getBoundingClientRect();
+            const horizontalMain = row !== vertical;
+            const reversed = flexDirection.endsWith("reverse") !==
+              (row ? direction === "rtl" : writingMode === "vertical-rl");
+            let offset;
+            if (horizontalMain) {
+              offset = reversed ? outer.right - inner.right : inner.left - outer.left;
+            } else {
+              offset = reversed ? outer.bottom - inner.bottom : inner.top - outer.top;
+            }
+            assert_approx_equals(offset, autoMargin ? 80 : ordinaryOffset, 0.02,
+              "The visible zero-size item participates; the collapsed item does not");
+            assert_equals(horizontalMain ? inner.width : inner.height, 20);
+          }, `${writingMode}; ${direction}; ${flexDirection}; visible auto margins=${autoMargin}; ${justify}`);
+        }
+      }
+    }
+  }
+}
+</script>
diff --git a/testing/web-platform/tests/css/css-flexbox/collapsed-item-main-axis-alignment.html b/testing/web-platform/tests/css/css-flexbox/collapsed-item-main-axis-alignment.html
new file mode 100644
index 0000000000000000000000000000000000000000..85f22361b1b5e3850500f49441368ec87ef0c64d
--- /dev/null
+++ b/testing/web-platform/tests/css/css-flexbox/collapsed-item-main-axis-alignment.html
@@ -0,0 +1,130 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Collapsed flex items do not participate in main-axis alignment</title>
+<link rel="help" href="https://drafts.csswg.org/css-flexbox-1/#algo-visibility">
+<link rel="help" href="https://drafts.csswg.org/css-flexbox-1/#main-alignment">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<style>
+.container { display: flex; align-items: flex-start; }
+.container, .container > div { margin: 0; padding: 0; border: 0; }
+.container > div { flex: none; }
+.row { width: 100px; }
+.column { height: 100px; width: 30px; flex-direction: column; }
+.row > .target { width: 20px; height: 10px; }
+.row > .collapsed { width: 20px; height: 30px; }
+.column > .target { height: 20px; width: 10px; }
+.column > .collapsed { height: 20px; width: 30px; }
+.row > .auto { margin-left: auto; }
+.column > .auto { margin-top: auto; }
+</style>
+<div id="log"></div>
+<script>
+for (const axis of ["row", "column"]) {
+  for (const position of ["before", "after"]) {
+    for (const autoMargin of [false, true]) {
+      for (const removed of [false, true]) {
+        for (const [justify, expected] of [
+          ["flex-start", 0], ["center", 40], ["space-between", 0],
+          ["space-around", 40], ["space-evenly", 40],
+        ]) {
+          test(t => {
+            const container = document.createElement("div");
+            container.className = "container " + axis;
+            container.style.justifyContent = justify;
+            const collapsed = document.createElement("div");
+            collapsed.className = "collapsed" + (autoMargin ? " auto" : "");
+            collapsed.style.visibility = "collapse";
+            if (removed) {
+              collapsed.style.display = "none";
+            }
+            const target = document.createElement("div");
+            target.className = "target";
+            container.append(...(position === "before" ?
+              [collapsed, target] : [target, collapsed]));
+            document.body.append(container);
+            t.add_cleanup(() => container.remove());
+            const outer = container.getBoundingClientRect();
+            const inner = target.getBoundingClientRect();
+            const offset = axis === "row" ? inner.left - outer.left : inner.top - outer.top;
+            const crossSize = axis === "row" ? outer.height : outer.width;
+            assert_equals(crossSize, axis === "column" || !removed ? 30 : 10,
+              "Only a collapsed item's cross-size strut remains");
+            assert_approx_equals(offset, expected, 0.02,
+              "The single visible item determines main-axis alignment");
+          }, `${axis}; ${position}; auto margin=${autoMargin}; display none=${removed}; ${justify}`);
+        }
+      }
+    }
+  }
+}
+
+for (const axis of ["row", "column"]) {
+  for (const position of [0, 1, 2]) {
+    for (const gap of [0, 10]) {
+      for (const justify of ["flex-start", "center", "space-between", "space-around", "space-evenly"]) {
+        test(t => {
+          const container = document.createElement("div");
+          container.className = "container " + axis;
+          container.style.justifyContent = justify;
+          container.style.gap = gap + "px";
+          const targets = [document.createElement("div"), document.createElement("div")];
+          for (const target of targets) {
+            target.className = "target";
+          }
+          const collapsed = document.createElement("div");
+          collapsed.className = "collapsed auto";
+          collapsed.style.visibility = "collapse";
+          const children = [...targets];
+          children.splice(position, 0, collapsed);
+          container.append(...children);
+          document.body.append(container);
+          t.add_cleanup(() => container.remove());
+          const free = 60 - gap;
+          const leading = {"flex-start": 0, "center": free / 2, "space-between": 0,
+            "space-around": free / 4, "space-evenly": free / 3}[justify];
+          const between = {"flex-start": 0, "center": 0, "space-between": free,
+            "space-around": free / 2, "space-evenly": free / 3}[justify];
+          const observations = [];
+          for (const visibility of ["collapse", "hidden", "collapse"]) {
+            collapsed.style.visibility = visibility;
+            const outer = container.getBoundingClientRect();
+            const offsets = targets.map(target => {
+              const inner = target.getBoundingClientRect();
+              return axis === "row" ? inner.left - outer.left : inner.top - outer.top;
+            });
+            observations.push({visibility, offsets});
+          }
+          for (const observation of [observations[0], observations[2]]) {
+            assert_approx_equals(observation.offsets[0], leading, 0.02,
+              "First visible item; " + JSON.stringify(observations));
+            assert_approx_equals(observation.offsets[1], leading + 20 + gap + between, 0.02,
+              "Second visible item; " + JSON.stringify(observations));
+          }
+        }, `${axis}; two visible items; strut index=${position}; gap=${gap}; ${justify}; collapse restoration`);
+      }
+    }
+  }
+}
+
+for (const axis of ["row", "column"]) {
+  for (const justify of ["flex-start", "center", "space-between", "space-around", "space-evenly"]) {
+    test(t => {
+      const container = document.createElement("div");
+      container.className = "container " + axis;
+      container.style.justifyContent = justify;
+      for (let i = 0; i < 2; ++i) {
+        const child = document.createElement("div");
+        child.className = "collapsed auto";
+        child.style.visibility = "collapse";
+        container.append(child);
+      }
+      document.body.append(container);
+      t.add_cleanup(() => container.remove());
+      const bounds = container.getBoundingClientRect();
+      assert_equals(axis === "row" ? bounds.width : bounds.height, 100);
+      assert_equals(axis === "row" ? bounds.height : bounds.width, 30);
+    }, `${axis}; only collapsed items; ${justify}`);
+  }
+}
+</script>
diff --git a/testing/web-platform/tests/css/css-flexbox/flexbox-collapsed-item-exported-baseline.html b/testing/web-platform/tests/css/css-flexbox/flexbox-collapsed-item-exported-baseline.html
new file mode 100644
index 0000000000000000000000000000000000000000..cb514dd6df30e91e3b6889328f159f951eae9cde
--- /dev/null
+++ b/testing/web-platform/tests/css/css-flexbox/flexbox-collapsed-item-exported-baseline.html
@@ -0,0 +1,83 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Collapsed flex items do not supply container baselines</title>
+<link rel="help" href="https://drafts.csswg.org/css-flexbox-1/#algo-visibility">
+<link rel="help" href="https://drafts.csswg.org/css-flexbox-1/#flex-baselines">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<style>
+body { margin: 0; font: 10px/20px monospace; }
+.host { display: flex; align-items: first baseline; }
+.host.last { align-items: last baseline; }
+.box {
+  display: inline-flex;
+  flex-direction: column;
+  justify-content: center;
+  width: 70px;
+  height: 100px;
+  flex: none;
+}
+.reverse .box { flex-direction: column-reverse; }
+.wrap .box { flex-wrap: wrap; height: 10px; }
+.wrap-reverse .box { flex-wrap: wrap-reverse; height: 10px; }
+.item { flex: none; width: 20px; height: 20px; }
+.collapsed { visibility: collapse; }
+.removed { display: none; }
+</style>
+<body>
+<script>
+function makeBox(pattern, reference) {
+  const box = document.createElement("div");
+  box.className = "box";
+  for (const kind of pattern) {
+    if (reference && kind === "c") continue;
+    const item = document.createElement("div");
+    item.className = `item${kind === "c" ? " collapsed" : ""}`;
+    item.textContent = "x";
+    box.append(item);
+  }
+  return box;
+}
+
+for (const wrap of ["nowrap", "wrap", "wrap-reverse"]) {
+  for (const reverse of [false, true]) {
+    for (const last of [false, true]) {
+      for (const [name, pattern] of [
+        ["all collapsed", "c"],
+        ["first collapsed", "cv"],
+        ["last collapsed", "vc"],
+        ["empty control", ""],
+        ["ordinary control", "v"],
+      ]) {
+        test(t => {
+          const host = document.createElement("div");
+          host.className = `host ${wrap}${last ? " last" : ""}${reverse ? " reverse" : ""}`;
+          const target = makeBox(pattern, false);
+          const reference = makeBox(pattern, true);
+          host.append(target, reference);
+          document.body.append(host);
+          t.add_cleanup(() => host.remove());
+          for (const box of [target, reference]) {
+            const rect = box.getBoundingClientRect();
+            assert_equals(rect.width, 70, "Fixed cross size");
+            assert_equals(rect.height, wrap === "nowrap" ? 100 : 10, "Fixed main size");
+          }
+          const difference = () => target.getBoundingClientRect().top -
+            reference.getBoundingClientRect().top;
+          const before = difference();
+          for (const child of target.querySelectorAll(".collapsed")) {
+            assert_equals(getComputedStyle(child).visibility, "collapse");
+            child.classList.add("removed");
+          }
+          assert_equals(difference(), 0, "Removing collapsed children matches the reference");
+          for (const child of target.querySelectorAll(".collapsed")) {
+            child.classList.remove("removed");
+          }
+          assert_equals(difference(), before, "Restoring collapsed children restores layout");
+          assert_equals(before, 0, "Collapsed children do not change the exported baseline");
+        }, `${reverse ? "column-reverse" : "column"}, ${last ? "last" : "first"} baseline, ${name}${wrap === "nowrap" ? "" : `, ${wrap}`}`);
+      }
+    }
+  }
+}
+</script>
diff --git a/testing/web-platform/tests/css/css-flexbox/flexbox-collapsed-item-scroll-overflow.html b/testing/web-platform/tests/css/css-flexbox/flexbox-collapsed-item-scroll-overflow.html
new file mode 100644
index 0000000000000000000000000000000000000000..d29985c2414c3c225b9ea5656259b9d17483c1eb
--- /dev/null
+++ b/testing/web-platform/tests/css/css-flexbox/flexbox-collapsed-item-scroll-overflow.html
@@ -0,0 +1,125 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Collapsed flex items do not contribute scrollable overflow</title>
+<link rel="help" href="https://drafts.csswg.org/css-flexbox-1/#visibility-collapse">
+<link rel="help" href="https://drafts.csswg.org/css-overflow-3/#scrollable">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<style>
+  .box {
+    position: absolute;
+    left: 0;
+    top: 0;
+    display: flex;
+    width: 100px;
+    height: 100px;
+    overflow: auto;
+    scrollbar-width: none;
+  }
+  .item { flex: none; inline-size: 20px; block-size: 240px; }
+  .border { border: 1px solid; }
+  .margin { margin: 1px; }
+  .descendant { inline-size: 40px; block-size: 240px; }
+</style>
+<body>
+<script>
+function makeBox(t, writingMode, direction, flexDirection, variant) {
+  const box = document.createElement("div");
+  box.className = "box";
+  Object.assign(box.style, { writingMode, direction, flexDirection });
+  const item = document.createElement("div");
+  item.className = "item " + variant;
+  if (variant.includes("descendant")) {
+    const descendant = document.createElement("div");
+    descendant.className = "descendant";
+    if (variant === "visible-descendant") descendant.style.visibility = "visible";
+    item.append(descendant);
+  }
+  box.append(item);
+  document.body.append(box);
+  t.add_cleanup(() => box.remove());
+  return { box, item };
+}
+
+function extent(box) {
+  assert_equals(box.clientWidth, 100, "scrollport width");
+  assert_equals(box.clientHeight, 100, "scrollport height");
+  return [box.scrollWidth, box.scrollHeight];
+}
+
+function assertCollapsed(box, message) {
+  assert_array_equals(extent(box), [100, 100], message);
+  box.scrollLeft = box.scrollTop = -1000;
+  assert_equals(box.scrollLeft, 0, "no negative horizontal scroll range");
+  assert_equals(box.scrollTop, 0, "no negative vertical scroll range");
+  box.scrollLeft = box.scrollTop = 1000;
+  assert_equals(box.scrollLeft, 0, "no positive horizontal scroll range");
+  assert_equals(box.scrollTop, 0, "no positive vertical scroll range");
+}
+
+const flexDirections = ["row", "row-reverse", "column", "column-reverse"];
+for (const writingMode of ["horizontal-tb", "vertical-rl", "vertical-lr"]) {
+  for (const direction of ["ltr", "rtl"]) {
+    for (const flexDirection of flexDirections) {
+      for (const variant of ["plain", "border", "margin", "descendant", "visible-descendant"]) {
+        test(t => {
+          const { box, item } = makeBox(t, writingMode, direction, flexDirection, variant);
+          const visible = extent(box);
+          assert_greater_than_equal(visible[writingMode === "horizontal-tb" ? 1 : 0], 240,
+                                    "visible control retains the tall item's overflow");
+          item.style.visibility = "hidden";
+          assert_array_equals(extent(box), visible, "hidden control retains overflow");
+          item.style.visibility = "collapse";
+          assert_equals(getComputedStyle(item).visibility, "collapse", "computed visibility");
+          assertCollapsed(box, "collapsed item and its descendants do not enlarge the scroll area");
+          item.remove();
+          assertCollapsed(box, "removal reference");
+          box.append(item);
+          assertCollapsed(box, "restored collapsed item");
+          item.style.visibility = "visible";
+          assert_array_equals(extent(box), visible, "uncollapsing restores overflow");
+        }, `${writingMode}, ${direction}, ${flexDirection}, ${variant}`);
+      }
+    }
+  }
+}
+
+for (const flexDirection of flexDirections) {
+  for (const position of ["static", "relative", "sticky"]) {
+    test(t => {
+      const { box, item } = makeBox(t, "horizontal-tb", "ltr", flexDirection, "margin");
+      item.style.position = position;
+      if (position !== "static") item.style.top = item.style.left = "20px";
+      assert_greater_than_equal(extent(box)[1], 240, "ordinary positioned overflow control");
+      item.style.visibility = "collapse";
+      assertCollapsed(box, "collapsed positioned margin box does not contribute overflow");
+    }, `${flexDirection}, ${position}, collapsed positioned margin`);
+  }
+}
+
+for (const writingMode of ["horizontal-tb", "vertical-rl", "vertical-lr"]) {
+  for (const flexDirection of flexDirections) {
+    test(t => {
+      const { box, item } = makeBox(t, writingMode, "ltr", flexDirection, "descendant");
+      item.style.blockSize = "40px";
+      item.style.visibility = "collapse";
+      const descendant = item.firstElementChild;
+      descendant.style.inlineSize = descendant.style.blockSize = "1px";
+      assertCollapsed(box, "initial collapsed item fits");
+      descendant.style.transform = "translate(300px, 300px)";
+      assertCollapsed(box, "transform overflow update remains excluded");
+      descendant.style.transform = "translate(-300px, -300px)";
+      assertCollapsed(box, "opposite transform overflow update remains excluded");
+    }, `${writingMode}, ${flexDirection}, transformed collapsed descendant`);
+  }
+}
+
+test(t => {
+  const { box, item } = makeBox(t, "horizontal-tb", "ltr", "row", "plain");
+  Object.assign(item.style, { position: "absolute", left: "0", top: "0" });
+  const visible = extent(box);
+  assert_equals(visible[1], 240, "absolute control overflows");
+  item.style.visibility = "collapse";
+  assert_array_equals(extent(box), visible, "absolute child is not a collapsed flex item");
+}, "Absolutely positioned child remains an overflow contributor");
+</script>
diff --git a/testing/web-platform/tests/css/css-flexbox/flexbox-cross-axis-packing-overflow.html b/testing/web-platform/tests/css/css-flexbox/flexbox-cross-axis-packing-overflow.html
new file mode 100644
index 0000000000000000000000000000000000000000..03a570ed22533d963bed48f718ebb6a2b3b7e2cf
--- /dev/null
+++ b/testing/web-platform/tests/css/css-flexbox/flexbox-cross-axis-packing-overflow.html
@@ -0,0 +1,98 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Safe flex line alignment with large cross sizes and gaps</title>
+<link rel="help" href="https://drafts.csswg.org/css-align-3/#overflow-values">
+<link rel="help" href="https://drafts.csswg.org/css-flexbox/#align-content-property">
+<link rel="help" href="https://drafts.csswg.org/css-values-4/#numeric-types">
+<meta name="assert" content="Safe cross-axis alignment keeps the first flex line at the start when the line sizes and gaps exceed the container size.">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<style>
+  .container {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: flex-start;
+    inline-size: 100px;
+    block-size: 100px;
+  }
+  .item { flex: none; }
+</style>
+<body>
+<script>
+const inputs = [
+  {name: "small lines", count: 3, size: 20, gap: 0},
+  {name: "two large lines", count: 2, size: 12000000, gap: 0},
+  {name: "three large lines", count: 3, size: 12000000, gap: 0},
+  {name: "four large lines", count: 4, size: 12000000, gap: 0},
+  {name: "large gaps", count: 4, size: 20, gap: 12000000},
+  {name: "large lines and gap", count: 2, size: 12000000, gap: 12000000},
+];
+for (const writingMode of ["horizontal-tb", "vertical-lr", "vertical-rl"]) {
+  for (const direction of ["ltr", "rtl"]) {
+    for (const flexDirection of ["row", "row-reverse", "column", "column-reverse"]) {
+      for (const alignment of ["flex-start", "safe flex-end", "safe center"]) {
+        for (const input of inputs) {
+          test(t => {
+            const row = flexDirection.startsWith("row");
+            const container = document.createElement("div");
+            container.className = "container";
+            Object.assign(container.style, {
+              writingMode, direction, flexDirection,
+              alignContent: alignment,
+              [row ? "rowGap" : "columnGap"]: `${input.gap}px`,
+            });
+            for (let i = 0; i < input.count; ++i) {
+              const item = document.createElement("div");
+              item.className = "item";
+              item.style.inlineSize = `${row ? 100 : input.size}px`;
+              item.style.blockSize = `${row ? input.size : 100}px`;
+              container.append(item);
+            }
+            document.body.append(container);
+            t.add_cleanup(() => container.remove());
+            const crossSize = row ? "blockSize" : "inlineSize";
+            const mainSize = row ? "inlineSize" : "blockSize";
+            const gap = row ? "rowGap" : "columnGap";
+            const styles = [...container.children].map(item => getComputedStyle(item));
+            assert_implements_optional(styles.every(style =>
+              Math.abs(parseFloat(style[crossSize]) - input.size) <= 2) &&
+              Math.abs(parseFloat(getComputedStyle(container)[gap]) - input.gap) <= 2,
+              "The input sizes and gaps are within the supported numeric range");
+            for (const style of styles) {
+              assert_equals(parseFloat(style[mainSize]), 100, "Each item fills one line");
+            }
+            assert_equals(getComputedStyle(container).alignContent, alignment,
+              "Requested alignment is supported");
+            const start = rect => {
+              if (row) {
+                return writingMode === "horizontal-tb" ? rect.top :
+                  writingMode === "vertical-rl" ? -rect.right : rect.left;
+              }
+              if (writingMode === "horizontal-tb") {
+                return direction === "ltr" ? rect.left : -rect.right;
+              }
+              return direction === "ltr" ? rect.top : -rect.bottom;
+            };
+            const measure = () => {
+              const rect = container.getBoundingClientRect();
+              assert_equals(rect.width, 100, "Container width");
+              assert_equals(rect.height, 100, "Container height");
+              return start(container.firstElementChild.getBoundingClientRect()) - start(rect);
+            };
+            const actual = measure();
+            container.style.alignContent = "flex-start";
+            assert_approx_equals(measure(), 0, 0.02, "Flex-start control");
+            container.style.alignContent = alignment;
+            assert_approx_equals(measure(), actual, 0.02, "Restoring alignment restores the observation");
+            const free = 100 - input.count * input.size - (input.count - 1) * input.gap;
+            const expected = alignment === "flex-start" ? 0 :
+              Math.max(0, free) / (alignment === "safe center" ? 2 : 1);
+            assert_approx_equals(actual, expected, 0.02,
+              "Safe alignment does not move overflowing lines away from the start");
+          }, `${writingMode}, ${direction}, ${flexDirection}, ${alignment}, ${input.name}`);
+        }
+      }
+    }
+  }
+}
+</script>
diff --git a/testing/web-platform/tests/css/css-flexbox/flexbox-cross-packing-fragmentation-overflow.html b/testing/web-platform/tests/css/css-flexbox/flexbox-cross-packing-fragmentation-overflow.html
new file mode 100644
index 0000000000000000000000000000000000000000..9fcb217162b54b47baa95c4f2815bf9414313422
--- /dev/null
+++ b/testing/web-platform/tests/css/css-flexbox/flexbox-cross-packing-fragmentation-overflow.html
@@ -0,0 +1,86 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Flex cross positions remain relative to the current fragment</title>
+<link rel="help" href="https://drafts.csswg.org/css-flexbox-1/#pagination-algo">
+<link rel="help" href="https://drafts.csswg.org/css-break-3/#breaking-controls">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<style>
+body { margin: 0; }
+.columns {
+  width: 200px;
+  columns: 100px;
+  column-gap: 0;
+  column-fill: auto;
+  height: calc(2 * var(--item-height));
+}
+.content { width: 100px; }
+.flex {
+  display: flex;
+  flex-flow: row wrap;
+  align-content: flex-start;
+  align-items: flex-start;
+}
+.item {
+  width: 100px;
+  height: var(--item-height);
+  flex: none;
+  break-inside: avoid;
+}
+.calibration { position: absolute; top: 0; }
+</style>
+<body>
+<script>
+for (const layout of ["block", "flex"]) {
+  for (const height of [80, 1000000, 4000000, 6000000, 8000000]) {
+    for (const count of [4, 6, 8, 12]) {
+      test(t => {
+        const columns = document.createElement("div");
+        columns.className = "columns";
+        columns.style.setProperty("--item-height", `${height}px`);
+        const calibration = document.createElement("div");
+        calibration.className = "item calibration";
+        calibration.style.setProperty("--item-height", `${height}px`);
+        document.body.append(columns, calibration);
+        t.add_cleanup(() => {
+          columns.remove();
+          calibration.remove();
+        });
+        assert_implements_optional(
+          columns.getBoundingClientRect().height === height * 2 &&
+          calibration.getBoundingClientRect().height === height,
+          "The declared item and column heights are supported");
+        calibration.remove();
+        const content = document.createElement("div");
+        content.className = `content ${layout}`;
+        const items = Array.from({length: count}, () => {
+          const item = document.createElement("div");
+          item.className = "item";
+          content.append(item);
+          return item;
+        });
+        columns.append(content);
+        const measure = () => {
+          const origin = columns.getBoundingClientRect();
+          assert_equals(origin.height, height * 2, "Column height");
+          return items.map((item, index) => {
+            const rect = item.getBoundingClientRect();
+            assert_equals(rect.width, 100, `Item ${index} width`);
+            assert_equals(rect.height, height, `Item ${index} height`);
+            return [rect.x - origin.x, rect.y - origin.y];
+          });
+        };
+        const initial = measure();
+        columns.remove();
+        document.body.append(columns);
+        const restored = measure();
+        for (let index = 0; index < count; ++index) {
+          assert_array_equals(restored[index], initial[index], `Item ${index} restored position`);
+          assert_array_equals(initial[index], [Math.floor(index / 2) * 100, index % 2 * height],
+            `Item ${index} position within its column`);
+        }
+      }, `${layout}, ${count} items of ${height}px in columns of ${height * 2}px`);
+    }
+  }
+}
+</script>
diff --git a/testing/web-platform/tests/css/css-flexbox/flexbox-forced-break-final-fragment-size.html b/testing/web-platform/tests/css/css-flexbox/flexbox-forced-break-final-fragment-size.html
new file mode 100644
index 0000000000000000000000000000000000000000..db485bb9044f07bcb56e27740c64b6e6b50426e0
--- /dev/null
+++ b/testing/web-platform/tests/css/css-flexbox/flexbox-forced-break-final-fragment-size.html
@@ -0,0 +1,126 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Final flex fragment size after forced breaks</title>
+<link rel="help" href="https://drafts.csswg.org/css-flexbox/#pagination">
+<link rel="help" href="https://drafts.csswg.org/css-break/#forced-breaks">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<style>
+  body { margin: 0; }
+  .columns {
+    position: relative;
+    inline-size: 200px;
+    block-size: var(--column-height);
+    columns: 100px;
+    column-gap: 0;
+    column-fill: auto;
+  }
+  .content { display: flex; inline-size: 100px; align-items: flex-start; }
+  .row { flex-flow: row wrap; align-content: flex-start; }
+  .column { flex-direction: column; }
+  .item { flex: none; inline-size: 100px; block-size: 80px; break-inside: avoid; }
+  .item + .item { break-before: always; }
+  .marker { inline-size: 100px; block-size: 20px; break-inside: avoid; }
+  .calibration { columns: auto; }
+  .calibration > div {
+    position: absolute;
+    inline-size: 100px;
+    inset-inline-start: var(--reference-inline);
+  }
+  .calibration .last { block-size: 80px; inset-block-start: 0; }
+  .calibration .after { block-size: 20px; inset-block-start: 80px; }
+</style>
+<body>
+<script>
+for (const writingMode of ["horizontal-tb", "vertical-lr", "vertical-rl"]) {
+for (const textDirection of ["ltr", "rtl"]) {
+for (const direction of ["row", "column"]) {
+  for (const height of [160, 4000000, 8000000, 16000000]) {
+    for (const count of [4, 8, 12]) {
+      test(t => {
+        const columns = document.createElement("div");
+        columns.className = "columns";
+        columns.style.writingMode = writingMode;
+        columns.style.direction = textDirection;
+        columns.style.setProperty("--column-height", `${height}px`);
+        document.body.append(columns);
+        t.add_cleanup(() => columns.remove());
+        const logicalRect = (r, c) => {
+          if (writingMode === "horizontal-tb") {
+            return [textDirection === "rtl" ? c.right - r.right : r.left - c.left,
+                    r.top - c.top, r.width, r.height];
+          }
+          return [textDirection === "rtl" ? c.bottom - r.bottom : r.top - c.top,
+                  writingMode === "vertical-rl" ? c.right - r.right : r.left - c.left,
+                  r.height, r.width];
+        };
+        const emptyRect = columns.getBoundingClientRect();
+        assert_implements_optional(logicalRect(emptyRect, emptyRect)[3] === height,
+                                   "The column height is representable");
+        assert_implements_optional(CSS.supports("break-before", "always"),
+                                   "The forced break value is supported");
+        columns.remove();
+        const reference = columns.cloneNode();
+        reference.classList.add("calibration");
+        reference.style.setProperty("--reference-inline", `${(count - 1) * 100}px`);
+        const referenceLast = document.createElement("div");
+        referenceLast.className = "last";
+        const referenceAfter = document.createElement("div");
+        referenceAfter.className = "after";
+        reference.append(referenceLast, referenceAfter);
+        document.body.append(reference);
+        t.add_cleanup(() => reference.remove());
+        const referenceOrigin = reference.getBoundingClientRect();
+        const expectedLast = logicalRect(referenceLast.getBoundingClientRect(), referenceOrigin);
+        const expectedAfter = logicalRect(referenceAfter.getBoundingClientRect(), referenceOrigin);
+        assert_array_equals(expectedLast, [(count - 1) * 100, 0, 100, 80],
+                            "Independent last-fragment geometry is calibrated");
+        assert_equals(expectedAfter[0], (count - 1) * 100);
+        assert_approx_equals(expectedAfter[1], 80, 1,
+                             "Independent marker position allows large-coordinate rounding");
+        assert_equals(expectedAfter[2], 100);
+        assert_equals(expectedAfter[3], 20);
+        reference.remove();
+        document.body.append(columns);
+        const content = document.createElement("div");
+        content.className = `content ${direction}`;
+        const items = Array.from({length: count}, () => {
+          const item = document.createElement("div");
+          item.className = "item";
+          content.append(item);
+          return item;
+        });
+        const marker = document.createElement("div");
+        marker.className = "marker";
+        columns.append(content, marker);
+        const measure = () => {
+          const origin = columns.getBoundingClientRect();
+          const relativeRect = rect => logicalRect(rect, origin);
+          return {
+            items: items.map(item => relativeRect(item.getBoundingClientRect())),
+            fragments: [...content.getClientRects()].map(relativeRect),
+            marker: relativeRect(marker.getBoundingClientRect()),
+          };
+        };
+        const initial = measure();
+        columns.remove();
+        document.body.append(columns);
+        assert_equals(JSON.stringify(measure()), JSON.stringify(initial),
+                      "Removal and restoration preserve layout");
+        for (let i = 0; i < count; ++i) {
+          assert_array_equals(initial.items[i], [i * 100, 0, 100, 80],
+                              `Item ${i} starts its own column`);
+        }
+        assert_array_equals(initial.marker, expectedAfter,
+                            "The following sibling fits below the last item");
+        assert_equals(initial.fragments.length, count, "One fragment per item");
+        assert_array_equals(initial.fragments[count - 1],
+                            expectedLast,
+                            "The final fragment contains only the last item");
+      }, `${writingMode}, ${textDirection}, ${direction}, ${count} items, ${height}px columns`);
+    }
+  }
+}
+}
+}
+</script>
diff --git a/testing/web-platform/tests/css/css-flexbox/flexbox-natural-baseline-donor.html b/testing/web-platform/tests/css/css-flexbox/flexbox-natural-baseline-donor.html
new file mode 100644
index 0000000000000000000000000000000000000000..a3f861bea929df024dd2642a5e38ec49457f0d09
--- /dev/null
+++ b/testing/web-platform/tests/css/css-flexbox/flexbox-natural-baseline-donor.html
@@ -0,0 +1,105 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Flex containers prefer natural item baselines before synthesizing</title>
+<link rel="help" href="https://drafts.csswg.org/css-flexbox-1/#flex-baselines">
+<link rel="help" href="https://drafts.csswg.org/css-align-3/#baseline-export">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<style>
+body { margin: 0; font: 16px/24px monospace; }
+.host { width: 700px; }
+.host.flex { display: flex; align-items: first baseline; }
+.host.flex.last { align-items: last baseline; }
+.box { display: inline-flex; vertical-align: baseline; baseline-source: first;
+  flex: none; align-items: flex-start; width: 160px; height: 80px; }
+.last .box { baseline-source: last; }
+.reverse .box { flex-direction: row-reverse; }
+.item { flex: none; width: 40px; }
+.text { font: 40px/50px monospace; }
+.small-text { font: 20px/30px monospace; }
+.empty { width: 10px; height: 5px; }
+.tall-empty { height: 15px; }
+.later { order: 1; }
+.removed { display: none; }
+</style>
+<body>
+<script>
+function item(classes, text = "") {
+  const node = document.createElement("div");
+  node.className = `item ${classes}`;
+  node.textContent = text;
+  return node;
+}
+
+function fixture(t, layout, reverse, last, targetItems, referenceItems) {
+  const host = document.createElement("div");
+  host.className = `host ${layout}${reverse ? " reverse" : ""}${last ? " last" : ""}`;
+  const target = document.createElement("div");
+  const reference = document.createElement("div");
+  target.className = reference.className = "box";
+  target.append(...targetItems);
+  reference.append(...referenceItems);
+  host.append(target, reference);
+  document.body.append(host);
+  t.add_cleanup(() => host.remove());
+  return {target, reference};
+}
+
+function difference({target, reference}) {
+  const a = target.getBoundingClientRect();
+  const b = reference.getBoundingClientRect();
+  assert_equals(a.width, 160, "Target width");
+  assert_equals(b.width, 160, "Reference width");
+  assert_equals(a.height, 80, "Target height");
+  assert_equals(b.height, 80, "Reference height");
+  return a.top - b.top;
+}
+
+for (const layout of ["flex", "inline"]) {
+  for (const reverse of [false, true]) {
+    for (const last of [false, true]) {
+      const label = `${layout} parent, ${reverse ? "row-reverse" : "row"}, ${last ? "last" : "first"} baseline`;
+      for (const position of ["before", "after", "absent"]) {
+        test(t => {
+          const text = item("text", "X");
+          const empty = item("empty");
+          const targetItems = position === "before" ? [empty, text] :
+            position === "after" ? [text, empty] : [text];
+          const boxes = fixture(t, layout, reverse, last, targetItems, [item("text", "X")]);
+          const initial = difference(boxes);
+          for (const box of [boxes.target, boxes.reference]) {
+            const rect = box.getBoundingClientRect();
+            const textRect = box.querySelector(".text").getBoundingClientRect();
+            assert_equals(textRect.top - rect.top, 0, "Text block offset");
+            assert_equals(textRect.height, 50, "Text block height");
+          }
+          for (let i = 0; i < 2; ++i) {
+            empty.classList.add("removed");
+            assert_equals(difference(boxes), 0, "Removing the empty item matches the reference");
+            empty.classList.remove("removed");
+            assert_equals(difference(boxes), initial, "Restoring the item restores the observation");
+          }
+          assert_equals(initial, 0, "An empty item does not replace the natural text baseline");
+        }, `${label}, empty item ${position}`);
+      }
+      for (const reordered of [false, true]) {
+        test(t => {
+          const large = item(`text${reordered ? " later" : ""}`, "X");
+          const small = item("small-text", "X");
+          const selected = last !== reordered ? small : large;
+          const boxes = fixture(t, layout, reverse, last, [large, small], [selected.cloneNode(true)]);
+          assert_equals(difference(boxes), 0,
+            "Natural donors follow order-modified document order");
+        }, `${label}, two natural donors, reordered ${reordered}`);
+      }
+      test(t => {
+        const first = item("empty");
+        const second = item("empty tall-empty");
+        const selected = reverse !== last ? second : first;
+        const boxes = fixture(t, layout, reverse, last, [first, second], [selected.cloneNode(true)]);
+        assert_equals(difference(boxes), 0, "Without a natural donor, synthesize from the edge item");
+      }, `${label}, no natural donor`);
+    }
+  }
+}
+</script>
diff --git a/testing/web-platform/tests/css/css-flexbox/flexbox-safe-scroll-origin.html b/testing/web-platform/tests/css/css-flexbox/flexbox-safe-scroll-origin.html
new file mode 100644
index 0000000000000000000000000000000000000000..2551efc023ba5c27e9efd5251a7461bd9a27332d
--- /dev/null
+++ b/testing/web-platform/tests/css/css-flexbox/flexbox-safe-scroll-origin.html
@@ -0,0 +1,105 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Safe flex alignment preserves scroll reachability</title>
+<link rel="help" href="https://drafts.csswg.org/css-align-3/#valdef-overflow-position-safe">
+<link rel="help" href="https://drafts.csswg.org/css-overflow-3/#scroll-origin">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<style>
+  .box {
+    position: absolute;
+    left: 0;
+    top: 0;
+    display: flex;
+    width: 100px;
+    height: 100px;
+    scrollbar-width: none;
+    align-items: flex-start;
+    justify-content: flex-start;
+    align-content: flex-start;
+  }
+  .item { flex: none; }
+</style>
+<body>
+<script>
+const configurations = [];
+const alignments = ["safe center", "safe end", "safe flex-end", "safe flex-start",
+                    "space-between", "space-around", "space-evenly", "flex-start"];
+for (const writingMode of ["horizontal-tb", "vertical-rl", "vertical-lr"]) {
+  for (const direction of ["ltr", "rtl"]) {
+    for (const orientation of ["row", "column"]) {
+      for (const axis of ["main", "cross"]) {
+        const base = { writingMode, direction, orientation, axis, reversed: true, fits: false };
+        for (const overflow of ["auto", "scroll", "hidden"]) {
+          for (const alignment of alignments) {
+            configurations.push({ ...base, overflow, alignment });
+          }
+        }
+        configurations.push({ ...base, overflow: "auto", alignment: "safe center", reversed: false });
+        configurations.push({ ...base, overflow: "auto", alignment: "safe center", fits: true });
+      }
+    }
+  }
+}
+for (const orientation of ["row", "column"]) {
+  for (const axis of ["main", "cross"]) {
+    for (const overflow of ["auto visible", "visible auto", "auto clip", "clip auto"]) {
+      configurations.push({ writingMode: "horizontal-tb", direction: "ltr", orientation,
+        axis, overflow, alignment: "safe center", reversed: true, fits: false });
+    }
+  }
+}
+for (const config of configurations) {
+  const { writingMode, direction, orientation, axis, overflow, alignment, reversed, fits } = config;
+  test(t => {
+    const row = orientation === "row";
+    const vertical = writingMode !== "horizontal-tb";
+    const inlineAxis = axis === "main" ? row : !row;
+    const horizontal = inlineAxis ? !vertical : vertical;
+    const logicalStartFar = inlineAxis ? direction === "rtl" : writingMode === "vertical-rl";
+    const startFar = logicalStartFar !== reversed;
+    const itemSize = fits ? 40 : axis === "main" ? 60 : 80;
+    const overflowSize = Math.max(0, 2 * itemSize - 100);
+    const leading = fits ? (100 - 2 * itemSize) / 2 : 0;
+    const expectedPositions = [0, 1].map(index => startFar ?
+      100 - leading - (index + 1) * itemSize : leading + index * itemSize);
+    const box = document.createElement("div");
+    box.className = "box";
+    Object.assign(box.style, { writingMode, direction, overflow,
+      flexDirection: orientation + (axis === "main" && reversed ? "-reverse" : ""),
+      flexWrap: axis === "cross" ? reversed ? "wrap-reverse" : "wrap" : "nowrap" });
+    const alignmentProperty = axis === "main" ? "justifyContent" : "alignContent";
+    box.style[alignmentProperty] = alignment;
+    const mainSize = axis === "main" ? itemSize : 60;
+    const crossSize = axis === "cross" ? itemSize : 20;
+    for (let index = 0; index < 2; index++) {
+      const item = document.createElement("div");
+      item.className = "item";
+      item.style.inlineSize = `${row ? mainSize : crossSize}px`;
+      item.style.blockSize = `${row ? crossSize : mainSize}px`;
+      box.append(item);
+    }
+    document.body.append(box);
+    t.add_cleanup(() => box.remove());
+    box.scrollLeft = box.scrollTop = 0;
+    assert_equals(box.clientWidth, 100, "scrollport width");
+    assert_equals(box.clientHeight, 100, "scrollport height");
+    assert_equals(getComputedStyle(box)[alignmentProperty], alignment, "computed alignment");
+    const bounds = box.getBoundingClientRect();
+    const positions = [...box.children].map(item => {
+      const rect = item.getBoundingClientRect();
+      assert_equals(horizontal ? rect.width : rect.height, itemSize, "item size on alignment axis");
+      return horizontal ? rect.left - bounds.left : rect.top - bounds.top;
+    });
+    assert_array_equals(positions, expectedPositions, "items align toward the scroll origin");
+    const property = horizontal ? "scrollLeft" : "scrollTop";
+    box[property] = -1000;
+    assert_equals(box[property], startFar && overflowSize ? -overflowSize : 0, "minimum reachable scroll offset");
+    box[property] = 1000;
+    assert_equals(box[property], startFar ? 0 : overflowSize, "maximum reachable scroll offset");
+    assert_equals(horizontal ? box.scrollWidth : box.scrollHeight,
+                  100 + overflowSize, "complete content contributes to scroll extent");
+  }, `${writingMode}, ${direction}, ${orientation}, ${axis}, reversed=${reversed}, ` +
+     `${overflow}, ${alignment}, fits=${fits}`);
+}
+</script>
