+++ b/testing/web-platform/tests/css/css-values/attr-fallback-preload.html
@@ -0,0 +1,239 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Typed attributes in used fallbacks are resolved</title>
+<link rel="help" href="https://drafts.csswg.org/css-values-5/#attr-substitution">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<style id="sheet">
+@namespace a "urn:fallback-probe:a";
+@property --preload-trigger {
+  syntax: "<length>";
+  inherits: false;
+  initial-value: 1px;
+}
+#fixture { font-size: 16px; width: 100px; }
+#fixture > div { display: block; padding: 0; border: 0; box-sizing: content-box; }
+</style>
+<div id="fixture"></div>
+<script>
+const cases = [
+  [
+    "Direct typed attribute",
+    "width: attr(x type(<length>), 5px)",
+    {
+      "x": "13px"
+    },
+    {
+      "width": "13px"
+    }
+  ],
+  [
+    "Missing null-namespace primary",
+    "width: attr(missing type(<length>), attr(x type(<length>), 5px))",
+    {
+      "x": "13px"
+    },
+    {
+      "width": "13px"
+    }
+  ],
+  [
+    "Missing known-namespace primary",
+    "width: attr(a|missing type(<length>), attr(x type(<length>), 5px))",
+    {
+      "x": "13px"
+    },
+    {
+      "width": "13px"
+    }
+  ],
+  [
+    "Unknown namespace primary",
+    "width: attr(unknown|missing type(<length>), attr(x type(<length>), 5px))",
+    {
+      "x": "13px"
+    },
+    {
+      "width": "13px"
+    }
+  ],
+  [
+    "Invalid typed primary",
+    "width: attr(bad type(<length>), attr(x type(<length>), 5px))",
+    {
+      "x": "13px",
+      "bad": "not-a-length"
+    },
+    {
+      "width": "13px"
+    }
+  ],
+  [
+    "Two nested fallbacks",
+    "width: attr(missing type(<length>), attr(other type(<length>), attr(x type(<length>), 5px)))",
+    {
+      "x": "13px"
+    },
+    {
+      "width": "13px"
+    }
+  ],
+  [
+    "Typed attribute in var fallback",
+    "width: var(--absent, attr(x type(<length>), 5px))",
+    {
+      "x": "13px"
+    },
+    {
+      "width": "13px"
+    }
+  ],
+  [
+    "Typed attribute in env fallback",
+    "width: env(preload-probe-absent-environment-variable, attr(x type(<length>), 5px))",
+    {
+      "x": "13px"
+    },
+    {
+      "width": "13px"
+    }
+  ],
+  [
+    "Custom property root",
+    "--result: attr(missing type(<length>), attr(x type(<length>), 5px)); width: var(--result)",
+    {
+      "x": "13px"
+    },
+    {
+      "width": "13px"
+    }
+  ],
+  [
+    "Attribute value graph root",
+    "width: attr(chain type(<length>), 7px)",
+    {
+      "x": "13px",
+      "chain": "attr(missing type(<length>), attr(x type(<length>), 5px))"
+    },
+    {
+      "width": "13px"
+    }
+  ],
+  [
+    "Prioritary property without graph admission",
+    "font-size: attr(missing type(<length>), attr(x type(<length>), 5px))",
+    {
+      "x": "13px"
+    },
+    {
+      "font-size": "13px"
+    }
+  ],
+  [
+    "Prioritary property with graph admission",
+    "--preload-trigger: 1em; font-size: attr(missing type(<length>), var(--absent, attr(x type(<length>), 5px)))",
+    {
+      "x": "13px"
+    },
+    {
+      "font-size": "13px",
+      "--preload-trigger": "13px"
+    }
+  ],
+  [
+    "Independent property preloads fallback attribute",
+    "width: attr(missing type(<length>), attr(x type(<length>), 5px)); height: attr(x type(<length>), 5px)",
+    {
+      "x": "13px"
+    },
+    {
+      "width": "13px",
+      "height": "13px"
+    }
+  ],
+  [
+    "Numeric-unit inner fallback",
+    "width: attr(missing type(<length>), attr(n px, 5px))",
+    {
+      "n": "13"
+    },
+    {
+      "width": "13px"
+    }
+  ],
+  [
+    "Unused cyclic attribute fallback",
+    "width: attr(x type(<length>), attr(cycle type(<length>), 7px))",
+    {
+      "x": "13px",
+      "cycle": "attr(cycle type(<length>))"
+    },
+    {
+      "width": "13px"
+    }
+  ],
+  [
+    "Unused custom-property cycle",
+    "--result: attr(x type(<length>), var(--result)); width: var(--result, 5px)",
+    {
+      "x": "13px"
+    },
+    {
+      "width": "13px"
+    }
+  ],
+  [
+    "Used custom-property cycle",
+    "--result: attr(missing type(<length>), var(--result)); width: var(--result, 5px)",
+    {
+      "x": "13px"
+    },
+    {
+      "width": "5px"
+    }
+  ],
+  [
+    "Unused registered-property cycle",
+    "--preload-trigger: 1em; font-size: attr(x type(<length>), var(--preload-trigger))",
+    {
+      "x": "13px"
+    },
+    {
+      "font-size": "13px",
+      "--preload-trigger": "13px"
+    }
+  ],
+  [
+    "Invalid typed primary in custom property",
+    "--result: attr(bad type(<length>), attr(x type(<length>), 5px)); width: var(--result)",
+    {
+      "x": "13px",
+      "bad": "not-a-length"
+    },
+    {
+      "width": "13px"
+    }
+  ]
+];
+for (const [index, [name, declarations, attributes, expected]] of cases.entries()) {
+  test(t => {
+    const target = document.createElement("div");
+    target.id = `target-${index}`;
+    for (const [name, value] of Object.entries(attributes)) {
+      target.setAttribute(name, value);
+      assert_equals(target.getAttribute(name), value, "attribute readback");
+    }
+    const sheet = document.getElementById("sheet").sheet;
+    const ruleIndex = sheet.insertRule(`#${target.id} { ${declarations} }`, sheet.cssRules.length);
+    for (const property of Object.keys(expected)) {
+      assert_not_equals(sheet.cssRules[ruleIndex].style.getPropertyValue(property), "", `${property} parsed`);
+    }
+    document.getElementById("fixture").append(target);
+    t.add_cleanup(() => target.remove());
+    const style = getComputedStyle(target);
+    const properties = Object.keys(expected);
+    assert_array_equals(properties.map(property => style.getPropertyValue(property)),
+                        Object.values(expected), properties.join(", "));
+  }, name);
+}
+</script>
diff --git a/testing/web-platform/tests/css/css-values/attr-fallback-readiness.html b/testing/web-platform/tests/css/css-values/attr-fallback-readiness.html
