diff --git a/layout/style/test/gtest/rust/metadata_cases.rs b/layout/style/test/gtest/rust/metadata_cases.rs
new file mode 100644
index 0000000000000000000000000000000000000000..91a0c1a6627777a704cbdd6eb5091e8495dc544c
--- /dev/null
+++ b/layout/style/test/gtest/rust/metadata_cases.rs
@@ -0,0 +1,194 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+use crate::deferred_animation_operations::{AnimationOperationArena, SegmentOperands};
+use crate::gecko_bindings::bindings::{CompositeOperation as C, IterationCompositeOperation as I};
+use crate::properties::{
+    animated_properties::AnimationValue as V, CustomDeclarationValue, PropertyDeclaration,
+};
+use style::custom_properties::Name;
+use style::properties_and_values::value::{
+    ComputedValue, ComputedValueComponent, CustomAnimatedValue, ValueInner,
+};
+use style::stylesheets::UrlExtraData;
+
+fn number(name: &Name, value: f32, tainted: bool, url: &UrlExtraData) -> V {
+    let mut value = ComputedValue::new(
+        ValueInner::Component(ComputedValueComponent::Number(value)),
+        url.clone(),
+    );
+    value.attr_tainted = tainted;
+    V::Custom(CustomAnimatedValue::from_computed(name, Some(&value)))
+}
+
+fn check(value: V, name: &Name, expected: &str, tainted: bool, url: &UrlExtraData) {
+    let V::Custom(ref custom) = value else {
+        panic!("not custom")
+    };
+    assert_eq!(custom.is_attr_tainted(), tainted);
+    let PropertyDeclaration::Custom(declaration) = value.uncompute() else {
+        panic!("not custom declaration")
+    };
+    assert_eq!(&declaration.name, name);
+    let CustomDeclarationValue::Parsed(parsed) = declaration.value else {
+        panic!("not typed numeric declaration")
+    };
+    assert_eq!(parsed.attr_tainted, tainted);
+    let tokens = parsed.to_variable_value();
+    assert_eq!(tokens.css, expected);
+    assert_eq!(tokens.url_data.ptr(), url.ptr());
+}
+
+fn interpolation_metadata(left_url: &UrlExtraData, right_url: &UrlExtraData) {
+    assert_ne!(left_url.ptr(), right_url.ptr());
+    let name = Name::from("arena-number");
+    for (left_taint, right_taint) in [(false, false), (false, true), (true, false)] {
+        let mut a = AnimationOperationArena::<()>::new();
+        let from = a.value(number(&name, 2., left_taint, left_url));
+        let to = a.value(number(&name, 6., right_taint, right_url));
+        let operands = SegmentOperands {
+            from: Some(from),
+            to: Some(to),
+            from_composite: C::Replace,
+            to_composite: C::Replace,
+            same_offset: false,
+        };
+        let root = a
+            .compose_segment(operands, None, None, I::Replace, 0, 0.25, 0.25)
+            .unwrap()
+            .unwrap();
+        check(
+            a.resolve(root, |_| -> Result<V, ()> { panic!("no endpoint") })
+                .unwrap(),
+            &name,
+            "3",
+            left_taint || right_taint,
+            left_url,
+        );
+    }
+}
+
+fn iteration_metadata(left_url: &UrlExtraData, right_url: &UrlExtraData) {
+    assert_ne!(left_url.ptr(), right_url.ptr());
+    let name = Name::from("arena-number");
+    let mut a = AnimationOperationArena::<()>::new();
+    let from = a.value(number(&name, 1., false, left_url));
+    let to = a.value(number(&name, 3., false, left_url));
+    let last = a.value(number(&name, 4., true, right_url));
+    let operands = SegmentOperands {
+        from: Some(from),
+        to: Some(to),
+        from_composite: C::Replace,
+        to_composite: C::Replace,
+        same_offset: false,
+    };
+    let root = a
+        .compose_segment(operands, None, Some(last), I::Accumulate, 2, 0.5, 0.5)
+        .unwrap()
+        .unwrap();
+    check(
+        a.resolve(root, |_| -> Result<V, ()> { panic!("no endpoint") })
+            .unwrap(),
+        &name,
+        "10",
+        true,
+        right_url,
+    );
+}
+
+fn fallback_metadata(left_url: &UrlExtraData, right_url: &UrlExtraData) {
+    assert_ne!(left_url.ptr(), right_url.ptr());
+    let name = Name::from("arena-number");
+    let other = Name::from("arena-other");
+    for (progress, expected_name, expected_value, expected_taint, expected_url) in [
+        (0.25, &name, "2", true, left_url),
+        (0.75, &other, "6", false, right_url),
+    ] {
+        let mut a = AnimationOperationArena::<()>::new();
+        let from = a.value(number(&name, 2., true, left_url));
+        let to = a.value(number(&other, 6., false, right_url));
+        let operands = SegmentOperands {
+            from: Some(from),
+            to: Some(to),
+            from_composite: C::Replace,
+            to_composite: C::Replace,
+            same_offset: false,
+        };
+        let root = a
+            .compose_segment(operands, None, None, I::Replace, 0, progress, progress)
+            .unwrap()
+            .unwrap();
+        check(
+            a.resolve(root, |_| -> Result<V, ()> { panic!("no endpoint") })
+                .unwrap(),
+            expected_name,
+            expected_value,
+            expected_taint,
+            expected_url,
+        );
+    }
+}
+
+fn additive_underlying_metadata(left_url: &UrlExtraData, right_url: &UrlExtraData) {
+    assert_ne!(left_url.ptr(), right_url.ptr());
+    let name = Name::from("arena-number");
+    let mut a = AnimationOperationArena::<()>::new();
+    let underlying = a.value(number(&name, 10., true, left_url));
+    let from = a.value(number(&name, 1., false, right_url));
+    let to = a.value(number(&name, 3., false, right_url));
+    let operands = SegmentOperands {
+        from: Some(from),
+        to: Some(to),
+        from_composite: C::Add,
+        to_composite: C::Add,
+        same_offset: false,
+    };
+    let root = a
+        .compose_segment(operands, Some(underlying), None, I::Replace, 0, 0.5, 0.5)
+        .unwrap()
+        .unwrap();
+    check(
+        a.resolve(root, |_| -> Result<V, ()> { panic!("no endpoint") })
+            .unwrap(),
+        &name,
+        "12",
+        true,
+        left_url,
+    );
+}
+
+fn implicit_underlying_metadata(left_url: &UrlExtraData, right_url: &UrlExtraData) {
+    assert_ne!(left_url.ptr(), right_url.ptr());
+    let name = Name::from("arena-number");
+    let mut a = AnimationOperationArena::<()>::new();
+    let underlying = a.value(number(&name, 10., true, left_url));
+    let to = a.value(number(&name, 30., false, right_url));
+    let operands = SegmentOperands {
+        from: None,
+        to: Some(to),
+        from_composite: C::Replace,
+        to_composite: C::Replace,
+        same_offset: false,
+    };
+    let root = a
+        .compose_segment(operands, Some(underlying), None, I::Replace, 0, 0.25, 0.25)
+        .unwrap()
+        .unwrap();
+    check(
+        a.resolve(root, |_| -> Result<V, ()> { panic!("no endpoint") })
+            .unwrap(),
+        &name,
+        "15",
+        true,
+        left_url,
+    );
+}
+
+pub(crate) fn run_all(left_url: &UrlExtraData, right_url: &UrlExtraData) {
+    interpolation_metadata(left_url, right_url);
+    iteration_metadata(left_url, right_url);
+    fallback_metadata(left_url, right_url);
+    additive_underlying_metadata(left_url, right_url);
+    implicit_underlying_metadata(left_url, right_url);
+}
diff --git a/layout/style/test/gtest/rust/owner_cases.rs b/layout/style/test/gtest/rust/owner_cases.rs
new file mode 100644
index 0000000000000000000000000000000000000000..10e89aca3d5afadd206388eb2db382ca9404bc81
--- /dev/null
+++ b/layout/style/test/gtest/rust/owner_cases.rs
@@ -0,0 +1,107 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+use servo_arc::Arc;
+use std::mem::{align_of, size_of};
+use style::animation_rule_sample::{SampledEndpoint, SampledSegment};
+use style::gecko_bindings::bindings::{CompositeOperation, IterationCompositeOperation};
+use style::properties::animated_properties::AnimationValue;
+use style::properties::declaration_block::AnimationRuleSample;
+use style::properties::{LonghandId, OwnedPropertyDeclarationId, PropertyDeclarationBlock};
+use style::rule_tree::{StyleSource, StyleSourceBorrow};
+use style::shared_lock::{Locked, SharedRwLock};
+
+fn sample(lock: &SharedRwLock) -> Option<StyleSource> {
+    let mut sample = AnimationRuleSample::with_capacity(1);
+    let inserted = sample.compose_segment(
+        OwnedPropertyDeclarationId::Longhand(LonghandId::Opacity),
+        SampledSegment {
+            from: Some(SampledEndpoint::Value(AnimationValue::Opacity(0.2))),
+            to: Some(SampledEndpoint::Value(AnimationValue::Opacity(0.6))),
+            from_composite: CompositeOperation::Replace,
+            to_composite: CompositeOperation::Replace,
+            same_offset: false,
+            last: None,
+            iteration_composite: IterationCompositeOperation::Replace,
+            current_iteration: 0,
+        },
+        || None,
+        || (0.5, 0.5),
+    );
+    inserted.then(|| sample.into_rule_source(lock))
+}
+
+#[no_mangle]
+pub extern "C" fn Rust_AnimationRuleSample_OwnerIdentity() {
+    let lock = SharedRwLock::new();
+    let source = sample(&lock);
+    let other = sample(&lock);
+    assert!(source.is_some() && other.is_some());
+    let source = source.unwrap();
+    let other = other.unwrap();
+    let cloned = source.clone();
+    let retained = source.borrow().to_owned();
+    let concrete = StyleSource::from_declarations(source.clone_declarations());
+    assert_eq!(source, cloned);
+    assert_eq!(source, retained);
+    assert_eq!(source.borrow(), retained.borrow());
+    assert_ne!(source, other);
+    assert_ne!(source, concrete);
+    assert_ne!(source.borrow(), concrete.borrow());
+    assert_eq!(concrete, concrete.borrow().to_owned());
+    assert!(source.is_animation_sample());
+    assert!(!concrete.is_animation_sample());
+    assert!(std::ptr::eq(source.get(), concrete.get()));
+    drop(source);
+    drop(cloned);
+    assert_eq!(retained.read(&lock.read()).declarations().len(), 1);
+}
+
+#[no_mangle]
+pub extern "C" fn Rust_AnimationRuleSample_OwnerLifetime() {
+    let lock = SharedRwLock::new();
+    let source = sample(&lock);
+    assert!(source.is_some());
+    let source = source.unwrap();
+    let guard = lock.read();
+    let view = source.declaration_source(&guard);
+    assert!(std::ptr::eq(view.declarations(), source.read(&guard)));
+    assert!(view.animation().is_some());
+    let property = view
+        .animation()
+        .unwrap()
+        .property(&OwnedPropertyDeclarationId::Longhand(LonghandId::Opacity));
+    assert!(property.is_some());
+    let property = property.unwrap();
+    let block = source.clone_declarations();
+    drop(guard);
+    drop(source);
+    let value = property.resolve(|never| -> Result<AnimationValue, ()> { match *never {} });
+    assert!(value.is_ok());
+    assert!(matches!(value.unwrap(), AnimationValue::Opacity(v) if (v - 0.4).abs() < 0.000001));
+    assert_eq!(block.read_with(&lock.read()).declarations().len(), 1);
+}
+
+#[no_mangle]
+pub extern "C" fn Rust_AnimationRuleSample_OwnerLayout() {
+    type Block = Arc<Locked<PropertyDeclarationBlock>>;
+    assert_eq!(size_of::<StyleSource>(), size_of::<Block>());
+    assert_eq!(align_of::<StyleSource>(), align_of::<Block>());
+    assert_eq!(size_of::<Option<StyleSource>>(), size_of::<Option<Block>>());
+    assert_eq!(
+        align_of::<Option<StyleSource>>(),
+        align_of::<Option<Block>>()
+    );
+    assert_eq!(size_of::<StyleSource>(), size_of::<usize>());
+    assert_eq!(size_of::<StyleSourceBorrow<'static>>(), size_of::<usize>());
+    assert_eq!(
+        size_of::<Option<StyleSourceBorrow<'static>>>(),
+        size_of::<usize>()
+    );
+    #[cfg(target_pointer_width = "64")]
+    assert_eq!(
+        size_of::<style::applicable_declarations::ApplicableDeclarationBlock<'static>>(),
+        32
+    );
+}
