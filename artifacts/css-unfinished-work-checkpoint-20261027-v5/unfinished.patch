+        I::Accumulate,
+        2,
+        0.5,
+        false,
+    );
+    compare(
+        "interpolate error left fallback",
+        n(2., true, left),
+        other_n(6., false, right),
+        None,
+        None,
+        C::Replace,
+        C::Replace,
+        I::Replace,
+        0,
+        0.25,
+        false,
+    );
+    compare(
+        "interpolate error right fallback",
+        n(2., true, left),
+        other_n(6., false, right),
+        None,
+        None,
+        C::Replace,
+        C::Replace,
+        I::Replace,
+        0,
+        0.75,
+        false,
+    );
+    compare(
+        "endpoint add error fallback",
+        n(1., false, right),
+        n(3., false, right),
+        other_n(10., true, left),
+        None,
+        C::Add,
+        C::Add,
+        I::Replace,
+        0,
+        0.5,
+        false,
+    );
+    compare(
+        "iteration error fallback",
+        n(1., false, left),
+        n(3., false, left),
+        None,
+        other_n(4., true, right),
+        C::Replace,
+        C::Replace,
+        I::Accumulate,
+        2,
+        0.5,
+        false,
+    );
+    compare(
+        "both add and iteration error fallback",
+        n(1., true, right),
+        n(3., false, right),
+        other_n(10., true, left),
+        other_n(4., true, left),
+        C::Add,
+        C::Add,
+        I::Accumulate,
+        2,
+        0.25,
+        false,
+    );
+    compare(
