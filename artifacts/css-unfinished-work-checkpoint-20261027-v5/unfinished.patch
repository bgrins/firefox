+static RefPtr<URLExtraData> CreateArenaURLData() {
+  RefPtr<nsIURI> uri = NullPrincipal::CreateURI();
+  nsCOMPtr<nsIReferrerInfo> referrerInfo = new ReferrerInfo(nullptr);
+  return MakeRefPtr<URLExtraData>(
