+    let other_n = |value, tainted, url| Some(number(&other, value, tainted, url));
+    compare(
+        "custom interpolate",
+        n(2., false, left),
+        n(6., true, right),
+        None,
+        None,
+        C::Replace,
+        C::Replace,
+        I::Replace,
+        0,
+        0.25,
+        false,
+    );
+    compare(
+        "custom add underlying taint",
