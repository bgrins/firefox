--- /dev/null
+++ b/testing/web-platform/tests/css/css-text/white-space/nowrap-inline-break-policies.html
@@ -0,0 +1,117 @@
+<!DOCTYPE html>
+<meta charset="utf-8">
+<title>Nowrap inline text suppresses breaks across text partitions</title>
+<link rel="help" href="https://drafts.csswg.org/css-text-4/#valdef-text-wrap-mode-nowrap">
+<link rel="stylesheet" href="/fonts/ahem.css">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<style>
+  .sample { font: 20px/30px Ahem; }
+  .narrow { width: 20px; }
+  .intrinsic { width: min-content; }
+  .reference { width: max-content; }
+  .nowrap, .target { white-space: nowrap; }
+  .wrap .target { white-space: normal; }
+  .break-all { word-break: break-all; }
+  .keep-all { word-break: keep-all; }
+  .anywhere { line-break: anywhere; }
+  .capitalize { text-transform: capitalize; }
+</style>
+<div id="fixtures"></div>
+<script>
+const fontReady = document.fonts.load("20px Ahem", "ABC D");
+
+function fixture(t, mode, partition, container, transform, sizing) {
+  const block = document.createElement("div");
+  block.className = `sample ${mode} ${container} ${transform} ${sizing}`;
+  const target = document.createElement("span");
+  target.className = "target";
+  if (partition === "whole") {
+    target.append(document.createTextNode("ABC D"));
+  } else {
+    target.append(document.createTextNode("A"));
+    const rest = document.createTextNode("BC D");
+    if (partition === "adjacent") {
+      target.append(rest);
+    } else {
+      const inner = document.createElement("span");
+      inner.append(rest);
+      target.append(inner);
+    }
+  }
+  block.append(target);
+  document.querySelector("#fixtures").append(block);
+  t.add_cleanup(() => block.remove());
+  return { block, target };
+}
+
+function lineCount(target) {
+  const tops = new Set();
+  const walker = document.createTreeWalker(target, NodeFilter.SHOW_TEXT);
+  for (let node = walker.nextNode(); node; node = walker.nextNode()) {
+    for (let i = 0; i < node.length; ++i) {
+      if (node.data[i] === " ") {
+        continue;
+      }
+      const range = document.createRange();
+      range.setStart(node, i);
+      range.setEnd(node, i + 1);
+      for (const rect of range.getClientRects()) {
+        tops.add(rect.top);
+      }
+    }
+  }
+  return tops.size;
+}
+
+promise_test(async t => {
+  assert_equals((await fontReady).length, 1, "Ahem is loaded");
+  const { block } = fixture(t, "normal", "whole", "nowrap", "", "reference");
+  assert_equals(block.getBoundingClientRect().width, 100);
+}, "Ahem calibration includes all five characters");
+
+for (const mode of ["normal", "break-all", "keep-all", "anywhere"]) {
+  for (const partition of ["whole", "adjacent", "nested"]) {
+    for (const container of ["normal", "nowrap", "wrap"]) {
+      for (const transform of ["", "capitalize"]) {
+        const name = `${mode}, ${partition}, ${container} container, ${transform || "no transform"}`;
+        promise_test(async t => {
+          await fontReady;
+          const { target } = fixture(t, mode, partition, container, transform, "narrow");
+          assert_equals(getComputedStyle(target).whiteSpace,
+                        container === "wrap" ? "normal" : "nowrap");
+          if (container === "wrap") {
+            assert_greater_than(lineCount(target), 1);
+          } else {
+            assert_equals(lineCount(target), 1);
+          }
+        }, `Line wrapping: ${name}`);
+        promise_test(async t => {
+          await fontReady;
+          const { block } = fixture(t, mode, partition, container, transform, "intrinsic");
+          const expected = container !== "wrap" ? 100 :
+                           mode === "normal" || mode === "keep-all" ? 60 : 20;
+          assert_equals(block.getBoundingClientRect().width, expected);
+        }, `Min-content width: ${name}`);
+        if (container === "normal") {
+          promise_test(async t => {
+            await fontReady;
+            const { block, target } = fixture(t, mode, partition, container, transform, "narrow");
+            const prefix = document.createTextNode("X ");
+            block.prepend(prefix);
+            const before = document.createRange();
+            before.setStart(prefix, 0);
+            before.setEnd(prefix, 1);
+            const after = document.createRange();
+            after.setStart(target.firstChild, 0);
+            after.setEnd(target.firstChild, 1);
+            assert_equals(after.getBoundingClientRect().top -
+                          before.getBoundingClientRect().top, 30);
+            assert_equals(lineCount(target), 1);
+          }, `Break before nowrap inline remains allowed: ${name}`);
+        }
+      }
+    }
+  }
+}
+</script>
diff --git a/testing/web-platform/tests/css/css-values/animation-equal-payload-taint.html b/testing/web-platform/tests/css/css-values/animation-equal-payload-taint.html
new file mode 100644
index 0000000000000000000000000000000000000000..7841f9ce856f3d48a34bcb45b66db3f412953394
--- /dev/null
+++ b/testing/web-platform/tests/css/css-values/animation-equal-payload-taint.html
@@ -0,0 +1,71 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Equal animation payload updates preserve attribute taint</title>
+<link rel="help" href="https://drafts.csswg.org/css-values-5/#attr-security">
+<link rel="help" href="https://drafts.csswg.org/web-animations-1/#dom-keyframeeffect-setkeyframes">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<body>
+<script>
+const imageA = "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7";
+const imageB = imageA + "#other";
+let serial = 0;
+function setup(t) {
+  const name = `--animation-taint-${serial++}`;
+  CSS.registerProperty({name, syntax: "<string>", inherits: false, initialValue: '"initial"'});
+  const element = document.createElement("div");
+  const reference = document.createElement("div");
+  document.body.append(element, reference);
+  t.add_cleanup(() => { element.remove(); reference.remove(); });
+  element.style.backgroundImage = `image-set(var(${name}))`;
+  return {name, element, reference};
+}
+function expectedImage(reference, text) {
+  reference.style.backgroundImage = `image-set(${JSON.stringify(text)})`;
+  const value = getComputedStyle(reference).backgroundImage;
+  assert_not_equals(value, "none", "Literal image calibration");
+  return value;
+}
+function frames(name, tainted, text) {
+  const value = tainted ? "attr(data-image)" : JSON.stringify(text);
+  return [{[name]: value}, {[name]: value}];
+}
+function start(t, element, name, tainted, text) {
+  const animation = element.animate(frames(name, tainted, text), {duration: 1000, fill: "both"});
+  t.add_cleanup(() => { animation.cancel(); });
+  animation.pause();
+  animation.currentTime = 500;
+  return animation;
+}
+function observe(element, reference, name, text, tainted, label) {
+  reference.style.setProperty(name, JSON.stringify(text));
+  assert_equals(getComputedStyle(element).getPropertyValue(name),
+                getComputedStyle(reference).getPropertyValue(name), label + " computed payload");
+  assert_equals(getComputedStyle(element).backgroundImage,
+                tainted ? "none" : expectedImage(reference, text), label + " URL taint");
+}
+for (const initialTainted of [false, true]) {
+  for (const samePayload of [true, false]) {
+    test(t => {
+      const {name, element, reference} = setup(t);
+      const finalTainted = !initialTainted;
+      const finalText = samePayload ? imageA : imageB;
+      element.setAttribute("data-image", initialTainted ? imageA : finalText);
+      const animation = start(t, element, name, initialTainted, imageA);
+      observe(element, reference, name, imageA, initialTainted, "Initial effect");
+      animation.effect.setKeyframes(frames(name, finalTainted, finalText));
+      assert_equals(animation.effect.getKeyframes()[0][name],
+                    finalTainted ? "attr(data-image)" : JSON.stringify(finalText),
+                    "New raw keyframes stored");
+      animation.currentTime = 501;
+      observe(element, reference, name, finalText, finalTainted, "Updated effect");
+    }, `setKeyframes ${initialTainted ? "attr to literal" : "literal to attr"}, ${samePayload ? "same" : "different"} payload`);
+  }
+  test(t => {
+    const {name, element, reference} = setup(t);
+    element.setAttribute("data-image", imageA);
+    start(t, element, name, initialTainted, imageA);
+    observe(element, reference, name, imageA, initialTainted, "Fresh effect");
+  }, `Fresh ${initialTainted ? "attr" : "literal"} effect`);
+}
+</script>
diff --git a/testing/web-platform/tests/css/css-values/animation-interpolation-attribute-taint-probe.html b/testing/web-platform/tests/css/css-values/animation-interpolation-attribute-taint-probe.html
new file mode 100644
index 0000000000000000000000000000000000000000..9ac6f493900de223b3bd275536cab97d33be85cc
--- /dev/null
+++ b/testing/web-platform/tests/css/css-values/animation-interpolation-attribute-taint-probe.html
@@ -0,0 +1,87 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Attribute taint in interpolated registered numbers</title>
+<link rel="help" href="https://drafts.csswg.org/css-values-5/#attr-security">
+<link rel="help" href="https://drafts.css-houdini.org/css-properties-values-api-1/#animation-behavior">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<style>
+@property --n {
+  syntax: "<number>";
+  inherits: false;
+  initial-value: 12;
+}
+.parent { --n: attr(data-n type(<number>)); }
+.bundle {
+  --bundle: url("data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7") var(--n);
+  border-image: var(--bundle);
+}
+.direct {
+  border-image: url("data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7") var(--n);
+}
+</style>
+<body>
+<script>
+const sourceURL = 'url("data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7")';
+window.interpolationTaintObservations = [];
+
+function target(t, observer) {
+  const parent = document.createElement("div");
+  parent.className = "parent";
+  parent.dataset.n = "8";
+  const child = parent.appendChild(document.createElement("div"));
+  child.className = observer;
+  document.body.appendChild(parent);
+  t.add_cleanup(() => parent.remove());
+  assert_equals(getComputedStyle(parent).getPropertyValue("--n").trim(), "8", "typed attr provider");
+  return child;
+}
+
+for (const observer of ["bundle", "direct"]) {
+  for (const [value, number, tainted] of [["initial", 12, false], ["inherit", 8, true], ["8", 8, false], ["12", 12, false]]) {
+    test(t => {
+      const child = target(t, observer);
+      child.style.setProperty("--n", value);
+      const style = getComputedStyle(child);
+      assert_equals(Number(style.getPropertyValue("--n")), number, "static numeric provider");
+      assert_equals(style.borderImageSource, observer === "bundle" && tainted ? "none" : sourceURL, "static URL calibration");
+    }, `Static ${value}, ${observer} observer`);
+  }
+}
+
+const cases = [
+  {name: "clean-to-clean", from: "12", to: "8", a: 12, b: 8, taintA: false, taintB: false},
+  {name: "clean-to-tainted", from: "initial", to: "inherit", a: 12, b: 8, taintA: false, taintB: true},
+  {name: "tainted-to-clean", from: "inherit", to: "initial", a: 8, b: 12, taintA: true, taintB: false},
+  {name: "tainted-to-tainted", from: "inherit", to: "inherit", a: 8, b: 8, taintA: true, taintB: true},
+];
+for (const c of cases) {
+  for (const progress of [0, .25, .75, 1]) {
+    const uncertain = progress === 0 && !c.taintA && c.taintB || progress === 1 && c.taintA && !c.taintB;
+    for (const observer of ["bundle", "direct"]) {
+      test(t => {
+        const child = target(t, observer);
+        const animation = child.animate([
+          {"--n": c.from}, {"--n": c.to},
+        ], {duration: 1000, fill: "both", easing: "linear", composite: "replace"});
+        t.add_cleanup(() => animation.cancel());
+        animation.pause();
+        animation.currentTime = progress * 1000;
+        assert_true(child.getAnimations().includes(animation), "effect exists");
+        assert_equals(animation.effect.getComputedTiming().progress, progress, "sample progress");
+        const style = getComputedStyle(child);
+        const number = Number(style.getPropertyValue("--n"));
+        const image = style.borderImageSource;
+        window.interpolationTaintObservations.push({name: c.name, progress, observer, number, image, uncertain});
+        assert_equals(number, (1 - progress) * c.a + progress * c.b, "interpolated numeric value");
+        if (observer === "bundle" && uncertain) {
+          assert_in_array(image, ["none", sourceURL], "diagnostic zero-weight endpoint; no taint polarity assertion");
+        } else {
+          const tainted = c.taintA || c.taintB;
+          assert_equals(image, observer === "bundle" && tainted ? "none" : sourceURL, "sampled URL observer");
+        }
+      }, `${c.name}, progress ${progress}, ${observer}${observer === "bundle" && uncertain ? " (boundary diagnostic)" : ""}`);
+    }
+  }
+}
+</script>
