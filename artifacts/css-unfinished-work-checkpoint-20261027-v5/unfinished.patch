diff --git a/testing/web-platform/tests/css/css-properties-values-api/registered-numeric-relative-units.html b/testing/web-platform/tests/css/css-properties-values-api/registered-numeric-relative-units.html
new file mode 100644
index 0000000000000000000000000000000000000000..c571189285bc998b80e40b2a152f0f6ceaa14d38
--- /dev/null
+++ b/testing/web-platform/tests/css/css-properties-values-api/registered-numeric-relative-units.html
@@ -0,0 +1,73 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Registered numeric values resolve relative units using the element's font</title>
+<link rel="help" href="https://drafts.css-houdini.org/css-properties-values-api-1/#calculation-of-computed-values">
+<link rel="help" href="https://drafts.css-houdini.org/css-properties-values-api-1/#substitution">
+<link rel="help" href="https://drafts.csswg.org/css-values-4/#font-relative-lengths">
+<link rel="help" href="https://drafts.csswg.org/css-values-4/#sign-funcs">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<body>
+<script>
+  function createTarget(t) {
+    const parent = document.createElement("div");
+    parent.style.cssText = "font-size: 30px; line-height: 40px; width: 100px";
+    const target = document.createElement("div");
+    target.style.cssText = "font-size: 10px; line-height: 12px";
+    parent.append(target);
+    document.body.append(parent);
+    t.add_cleanup(() => parent.remove());
+    return target;
+  }
+
+  const types = [
+    ["number", ""],
+    ["integer", ""],
+    ["percentage", "%"],
+    ["angle", "deg"],
+    ["time", "s"],
+    ["resolution", "dppx"],
+  ];
+  for (const [type, unit] of types) {
+    for (const inherits of [false, true]) {
+      for (const input of ["10px", "1em", "1lh"]) {
+        for (const variable of [false, true]) {
+          test(t => {
+            const name = `--${type}-${inherits}-${input}-${variable}`;
+            CSS.registerProperty({ name, syntax: `<${type}>`, inherits, initialValue: `2${unit}` });
+            const target = createTarget(t);
+            target.style.setProperty("--input", input);
+            const operand = variable ? "var(--input)" : input;
+            target.style.setProperty(name, `calc((sign(${operand} - 20px) + 2) * 1${unit})`);
+            target.style.width = `calc((sign(var(${name}) - 2${unit}) + 2) * 10px)`;
+
+            assert_not_equals(target.style.getPropertyValue(name), "", "Declaration is accepted");
+            const style = getComputedStyle(target);
+            assert_equals(style.fontSize, "10px");
+            assert_equals(style.lineHeight, "12px");
+            assert_equals(style.getPropertyValue(name).trim(), `1${unit}`, "Registered computed value");
+            assert_equals(style.width, "10px", "Width using the registered value");
+            assert_equals(target.getBoundingClientRect().width, 10, "Used width");
+          }, `Registered <${type}> using ${input}, ${variable ? "substituted" : "direct"}, inherits: ${inherits}`);
+        }
+      }
+    }
+  }
+
+  for (const inherits of [false, true]) {
+    for (const [input, expected] of [["1em", 10], ["1lh", 12]]) {
+      test(t => {
+        const name = `--length-${inherits}-${input}`;
+        CSS.registerProperty({ name, syntax: "<length>", inherits, initialValue: "0px" });
+        const target = createTarget(t);
+        target.style.setProperty(name, input);
+        target.style.width = `var(${name})`;
+
+        const style = getComputedStyle(target);
+        assert_equals(style.getPropertyValue(name).trim(), `${expected}px`);
+        assert_equals(style.width, `${expected}px`);
+        assert_equals(target.getBoundingClientRect().width, expected);
+      }, `Registered length control using ${input}, inherits: ${inherits}`);
+    }
+  }
+</script>
diff --git a/testing/web-platform/tests/css/css-properties-values-api/registered-token-boundary-probe.html b/testing/web-platform/tests/css/css-properties-values-api/registered-token-boundary-probe.html
new file mode 100644
index 0000000000000000000000000000000000000000..d1eac8ff6df73d3cbc4149cbeaeb21b44d33f413
--- /dev/null
+++ b/testing/web-platform/tests/css/css-properties-values-api/registered-token-boundary-probe.html
@@ -0,0 +1,67 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Registered length-percentage substitution preserves token boundaries</title>
+<link rel="help" href="https://drafts.css-houdini.org/css-properties-values-api-1/#substitution">
+<link rel="help" href="https://drafts.csswg.org/css-variables-1/#using-variables">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<style>
+@property --length {
+  syntax: "<length>";
+  inherits: false;
+  initial-value: 1px;
+}
+@property --lp {
+  syntax: "<length-percentage>";
+  inherits: false;
+  initial-value: 1px;
+}
+@property --lp-list {
+  syntax: "<length-percentage>+";
+  inherits: false;
+  initial-value: 1px;
+}
+.parent { font: 100px monospace; }
+</style>
+<body>
+<script>
+const cases = [
+  {name: "literal comment boundary", font: "20px/**/serif", size: "20px"},
+  {name: "literal whitespace boundary", font: "20px serif", size: "20px"},
+  {name: "unregistered length", property: "--raw", value: "20px", computed: "20px", font: "var(--raw)serif", size: "20px"},
+  {name: "registered length", property: "--length", value: "20px", computed: "20px", font: "var(--length)serif", size: "20px"},
+  {name: "registered length-percentage length", property: "--lp", value: "20px", computed: "20px", font: "var(--lp)serif", size: "20px"},
+  {name: "registered length-percentage reduced calc", property: "--lp", value: "calc(5px + 15px)", computed: "20px", font: "var(--lp)serif", size: "20px"},
+  {name: "registered length-percentage percent", property: "--lp", value: "25%", computed: "25%", font: "var(--lp)serif", size: "25px"},
+  {name: "registered length-percentage singleton list", property: "--lp-list", value: "20px", computed: "20px", font: "var(--lp-list)serif", size: "20px"},
+  {name: "registered length-percentage explicit comment", property: "--lp", value: "20px", computed: "20px", font: "var(--lp)/**/serif", size: "20px"},
+  {name: "registered length-percentage explicit space", property: "--lp", value: "20px", computed: "20px", font: "var(--lp) serif", size: "20px"},
+];
+
+for (const route of ["direct", "custom-property-chain"]) {
+  for (const c of cases) {
+    test(t => {
+      const parent = document.createElement("div");
+      parent.className = "parent";
+      const target = parent.appendChild(document.createElement("div"));
+      document.body.appendChild(parent);
+      t.add_cleanup(() => parent.remove());
+      assert_equals(getComputedStyle(parent).fontSize, "100px", "Parent calibration");
+      if (c.property) {
+        target.style.setProperty(c.property, c.value);
+        assert_equals(getComputedStyle(target).getPropertyValue(c.property).trim(), c.computed, "Computed provider");
+      }
+      if (route === "custom-property-chain") {
+        target.style.setProperty("--font", c.font);
+        target.style.font = "var(--font)";
+      } else {
+        target.style.font = c.font;
+      }
+      assert_not_equals(target.style.font, "", "Font declaration admitted");
+      const style = getComputedStyle(target);
+      assert_equals(style.fontSize, c.size, "Font size after token substitution");
+      assert_equals(style.fontFamily, "serif", "Font family remains a separate identifier");
+    }, `${c.name}, ${route}`);
+  }
+}
+</script>
diff --git a/testing/web-platform/tests/css/css-shadow/part/exportparts-deep-cascade-order.html b/testing/web-platform/tests/css/css-shadow/part/exportparts-deep-cascade-order.html
new file mode 100644
index 0000000000000000000000000000000000000000..9706b6babeb5394cfe3df20f136f5128de56af75
--- /dev/null
+++ b/testing/web-platform/tests/css/css-shadow/part/exportparts-deep-cascade-order.html
@@ -0,0 +1,65 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Exported parts preserve distinct encapsulation contexts in deep trees</title>
+<link rel="help" href="https://drafts.csswg.org/css-cascade-5/#cascade-sort">
+<link rel="help" href="https://drafts.csswg.org/css-cascade-5/#revert-layer">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<div id="fixtures"></div>
+<script>
+function fixture(depth, kind, fillers) {
+  const container = document.createElement("div");
+  document.querySelector("#fixtures").append(container);
+  const roots = [container.attachShadow({mode: "open"})];
+  for (let i = 0; i < depth; ++i) {
+    const host = document.createElement("x-box");
+    host.setAttribute("exportparts", "p");
+    roots.at(-1).append(host);
+    roots.push(host.attachShadow({mode: "open"}));
+  }
+  const target = document.createElement("div");
+  target.setAttribute("part", "p");
+  target.setAttribute("style", "margin-left:1px; --value:1px");
+  target.textContent = "target";
+  roots.at(-1).append(target);
+  const styles = roots.slice(0, -1).map(root => {
+    const style = document.createElement("style");
+    root.append(style);
+    return style;
+  });
+  function setFillers(enabled) {
+    for (let i = 2; i < styles.length; ++i) {
+      styles[i].textContent = enabled ? "x-box::part(unused) { --inert:0 }" : "";
+    }
+  }
+  const important = kind === "important" ? " !important" : "";
+  styles[1].textContent = `x-box::part(p) { margin-left:10px${important}; --value:10px${important} }`;
+  const outer = kind === "rollback" ? "revert-layer" : kind === "origin" ? "revert" : "20px";
+  styles[0].textContent = `x-box::part(p) { margin-left:${outer}${important}; --value:${outer}${important} }`;
+  setFillers(fillers);
+  return {container, target, setFillers};
+}
+for (const depth of [2, 6, 7, 8, 9, 16, 32]) {
+  for (const kind of ["normal", "important", "rollback", "origin"]) {
+    for (const stage of ["initial", "add unrelated rules", "fresh with unrelated rules", "remove unrelated rules"]) {
+      test(t => {
+        const initialFillers = stage === "fresh with unrelated rules" || stage === "remove unrelated rules";
+        const f = fixture(depth, kind, initialFillers);
+        t.add_cleanup(() => f.container.remove());
+        const expected = kind === "normal" ? "20px" : kind === "origin" ? "0px" : "10px";
+        const expectedCustom = kind === "origin" ? "" : expected;
+        if (stage === "add unrelated rules") {
+          assert_equals(getComputedStyle(f.target).marginLeft, expected, "Initial sparse context order");
+          f.setFillers(true);
+        } else if (stage === "remove unrelated rules") {
+          getComputedStyle(f.target).marginLeft;
+          f.setFillers(false);
+        }
+        const style = getComputedStyle(f.target);
+        assert_equals(style.marginLeft, expected, "Longhand context precedence");
+        assert_equals(style.getPropertyValue("--value").trim(), expectedCustom, "Custom property context precedence");
+      }, `${depth} exported contexts, ${kind}, ${stage}`);
+    }
+  }
+}
+</script>
diff --git a/testing/web-platform/tests/css/css-shadow/slot-deep-cascade-order.html b/testing/web-platform/tests/css/css-shadow/slot-deep-cascade-order.html
new file mode 100644
index 0000000000000000000000000000000000000000..c1a080004d2a17b354bfa2cbfc88b2e96c54a358
--- /dev/null
+++ b/testing/web-platform/tests/css/css-shadow/slot-deep-cascade-order.html
@@ -0,0 +1,65 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Forwarded slots preserve distinct encapsulation contexts</title>
+<link rel="help" href="https://drafts.csswg.org/css-cascade-5/#cascade-sort">
+<link rel="help" href="https://drafts.csswg.org/css-cascade-5/#revert-layer">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<div id="fixtures"></div>
+<script>
+function fixture(t, count, kind) {
+  const host = document.createElement("div");
+  document.querySelector("#fixtures").append(host);
+  const target = document.createElement("div");
+  target.id = "target";
+  target.textContent = "target";
+  host.append(target);
+  t.add_cleanup(() => host.remove());
+  let root = host.attachShadow({mode: "open"});
+  const slots = [];
+  for (let i = 0; i < count; ++i) {
+    const slot = document.createElement("slot");
+    slots.push(slot);
+    const style = document.createElement("style");
+    const important = kind === "important" ? " !important" : "";
+    style.textContent = i === 0 ? `::slotted(#target) {margin-left:10px${important};--value:10px${important}}` : "::slotted(#unused) {--inert:0}";
+    root.append(style);
+    if (i === count - 1) {
+      root.append(slot);
+    } else {
+      const nextHost = document.createElement("x-box");
+      root.append(nextHost);
+      nextHost.append(slot);
+      root = nextHost.attachShadow({mode: "open"});
+    }
+  }
+  const style = document.createElement("style");
+  const value = kind === "rollback" ? "revert-layer" : kind === "origin" ? "revert" : "20px";
+  const important = kind === "important" ? " !important" : "";
+  style.textContent = `#target {margin-left:${value}${important};--value:${value}${important}}`;
+  document.head.append(style);
+  t.add_cleanup(() => style.remove());
+  const chain = [];
+  for (let slot = target.assignedSlot; slot; slot = slot.assignedSlot) chain.push(slot);
+  const cs = getComputedStyle(target);
+  const expected = kind === "normal" ? "20px" : kind === "origin" ? "0px" : "10px";
+  const row = {count, kind, actualSlots: chain.length,
+    exactSlotChain: chain.length === slots.length && chain.every((s, i) => s === slots[i]),
+    expected, actual: cs.marginLeft, expectedCustom: kind === "origin" ? "" : expected,
+    actualCustom: cs.getPropertyValue("--value").trim()};
+  style.remove();
+  host.remove();
+  return row;
+}
+for (const count of [1, 5, 6, 7, 8, 9, 16, 32]) {
+  for (const kind of ["normal", "important", "rollback", "origin"]) {
+    test(t => {
+      const row = fixture(t, count, kind);
+      assert_equals(row.actualSlots, count, "Assigned slot chain length");
+      assert_true(row.exactSlotChain, "Assigned slot identities");
+      assert_equals(row.actual, row.expected, "Longhand context precedence");
+      assert_equals(row.actualCustom, row.expectedCustom, "Custom property context precedence");
+    }, `${count} forwarded slots, ${kind}`);
+  }
+}
+</script>
diff --git a/testing/web-platform/tests/css/css-shapes/shape-outside/shape-margin-containing-block-content-box.html b/testing/web-platform/tests/css/css-shapes/shape-outside/shape-margin-containing-block-content-box.html
new file mode 100644
index 0000000000000000000000000000000000000000..23372940b918eb3dcf604f91cb14c1d473894d59
--- /dev/null
+++ b/testing/web-platform/tests/css/css-shapes/shape-outside/shape-margin-containing-block-content-box.html
@@ -0,0 +1,88 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Percentage shape-margin uses the containing block content inline size</title>
+<link rel="help" href="https://drafts.csswg.org/css-shapes-1/#shape-margin-property">
+<link rel="help" href="https://www.w3.org/TR/CSS22/visudet.html#containing-block-details">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<body>
+<script>
+function fixture(t, writingMode, orthogonal, size, padding, border, side, margin) {
+  const vertical = writingMode !== "horizontal-tb";
+  const container = document.createElement("div");
+  container.style.cssText = `position:absolute;top:0;left:0;display:flow-root;
+    writing-mode:${writingMode};box-sizing:content-box;inline-size:${size}px;padding:${padding}px;
+    border:${border}px solid transparent;font-size:0;line-height:20px;
+    text-align:${side};direction:ltr;`;
+  const float = document.createElement("div");
+  const inset = vertical ?
+    (side === "left" ? "0 0 100px 0" : "100px 0 0 0") :
+    (side === "left" ? "0 100px 0 0" : "0 0 0 100px");
+  float.style.cssText = `float:${side};width:${vertical ? 120 : 160}px;
+    height:${vertical ? 160 : 120}px;
+    writing-mode:${orthogonal ? (vertical ? "horizontal-tb" : "vertical-rl") : writingMode};
+    shape-outside:inset(${inset});
+    shape-margin:${margin};`;
+  container.append(float);
+  const markers = [];
+  for (let i = 0; i < 5; ++i) {
+    const marker = document.createElement("span");
+    marker.style.cssText = "display:inline-block;inline-size:1px;block-size:20px;vertical-align:top";
+    container.append(marker, document.createElement("br"));
+    markers.push(marker);
+  }
+  document.body.append(container);
+  t.add_cleanup(() => container.remove());
+  return {
+    container,
+    float,
+    measure(expectedSize) {
+      const rect = container.getBoundingClientRect();
+      const marker = markers[2].getBoundingClientRect();
+      const floatRect = float.getBoundingClientRect();
+      assert_equals(vertical ? rect.height : rect.width,
+        expectedSize + 2 * (padding + border), "container border box inline size");
+      assert_equals(vertical ? floatRect.height : floatRect.width, 160, "float extent along parent inline axis");
+      const bandStart = vertical ?
+        (writingMode === "vertical-rl" ? rect.right - marker.right : marker.left - rect.left) :
+        marker.top - rect.top;
+      assert_equals(bandStart - padding - border, 40, "middle line block position");
+      assert_equals(vertical ? marker.width : marker.height, 20, "middle line block size");
+      if (vertical) {
+        return side === "left" ? marker.top - rect.top - padding - border :
+          rect.bottom - padding - border - marker.bottom;
+      }
+      return side === "left" ? marker.left - rect.left - padding - border :
+        rect.right - padding - border - marker.right;
+    }
+  };
+}
+
+for (const writingMode of ["horizontal-tb", "vertical-rl", "vertical-lr"]) {
+  for (const orthogonal of [false, true]) {
+    for (const size of [200, 400]) {
+      for (const [padding, border] of [[0, 0], [20, 0], [0, 10], [20, 10]]) {
+        for (const side of ["left", "right"]) {
+          for (const percent of [0, 5, 10]) {
+            test(t => {
+              const absolute = fixture(t, writingMode, orthogonal, size, padding, border, side, `${size * percent / 100}px`);
+              const relative = fixture(t, writingMode, orthogonal, size, padding, border, side, `${percent}%`);
+              for (const currentSize of [size, 600 - size, size]) {
+                absolute.container.style.inlineSize = `${currentSize}px`;
+                relative.container.style.inlineSize = `${currentSize}px`;
+                const length = currentSize * percent / 100;
+                absolute.float.style.shapeMargin = `${length}px`;
+                const absoluteEdge = absolute.measure(currentSize);
+                const relativeEdge = relative.measure(currentSize);
+                assert_approx_equals(absoluteEdge, 60 + length, 1 / 60, "absolute margin control");
+                assert_approx_equals(relativeEdge, absoluteEdge, 1 / 60,
+                `percentage and equivalent content-inline-size length at size ${currentSize}`);
+              }
+            }, `${writingMode}, orthogonal float ${orthogonal}, ${side} float, content size ${size}, padding ${padding}, border ${border}, margin ${percent}%`);
+          }
+        }
+      }
+    }
+  }
+}
+</script>
diff --git a/testing/web-platform/tests/css/css-shapes/shape-outside/shape-margin-containing-block-recovery.html b/testing/web-platform/tests/css/css-shapes/shape-outside/shape-margin-containing-block-recovery.html
