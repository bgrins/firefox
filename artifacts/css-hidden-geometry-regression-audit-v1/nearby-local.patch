diff --git a/layout/generic/nsBlockFrame.cpp b/layout/generic/nsBlockFrame.cpp
index 5da4816d2b02..5b1d5bf1595d 100644
--- a/layout/generic/nsBlockFrame.cpp
+++ b/layout/generic/nsBlockFrame.cpp
@@ -8252,10 +8252,14 @@ void nsBlockFrame::RecoverFloats(nsFloatManager& aFloatManager, WritingMode aWM,
   nsIFrame* stop = nullptr;  // Stop before we reach pushed floats that
                              // belong to our next-in-flow
   const nsFrameList* floats = GetFloats();
+  const WritingMode wm = GetWritingMode();
+  const nscoord contentISize =
+      floats ? LogicalSize(wm, GetContentRectRelativeToSelf().Size()).ISize(wm)
+             : 0;
   for (nsIFrame* f = floats ? floats->FirstChild() : nullptr; f && f != stop;
        f = f->GetNextSibling()) {
     LogicalRect region = nsFloatManager::GetRegionFor(aWM, f, aContainerSize);
-    aFloatManager.AddFloat(f, region, aWM, aContainerSize);
+    aFloatManager.AddFloat(f, region, aWM, aContainerSize, contentISize);
     if (!stop && f->GetNextInFlow()) {
       stop = f->GetNextInFlow();
     }
