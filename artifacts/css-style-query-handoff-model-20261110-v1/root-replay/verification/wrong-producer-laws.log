Laws.lean:99:109: error: unsolved goals
count : Nat
tree : Tree count
styled : Fin count → Bool
animationOnly : Bool
producers : List (Producer count)
delivery : Delivery count
⊢ (∃ a,
      a ∈ producers ∧
        collected animationOnly a = true ∧
          ∃ a_1,
            a_1 ∈ tree.children tree.root ∧
              styled a_1 = true ∧
                { child := a_1, hint := project a.childHint, dirty := ancestors tree a.node } = delivery) ↔
    ∃ producer,
      producer ∈ producers ∧
        collected animationOnly producer = true ∧
          ∃ child,
            child ∈ tree.children producer.node ∧
              styled child = true ∧
                { child := child, hint := project producer.childHint, dirty := ancestors tree producer.node } = delivery
