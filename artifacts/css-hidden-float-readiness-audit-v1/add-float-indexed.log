     570:     // For more about pushed floats, see the comment above
     571:     // nsBlockFrame::DrainPushedFloats.
     572:     auto* floatParent = static_cast<nsBlockFrame*>(aFloat->GetParent());
     573:     floatParent->StealFrame(aFloat);
