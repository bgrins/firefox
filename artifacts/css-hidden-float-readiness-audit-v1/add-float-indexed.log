     616:           mLineBSize.isNothing()
     617:               ? GetFloatAvailableSpace(wm, mBCoord)
     618:               : GetFloatAvailableSpaceForBSize(wm, mBCoord, mLineBSize.value(),
     619:                                                nullptr);
     620:       LogicalRect availSpace(wm, floatAvailSpace.mRect.IStart(wm), mBCoord,
     621:                              floatAvailSpace.mRect.ISize(wm),
     622:                              floatAvailSpace.mRect.BSize(wm));
