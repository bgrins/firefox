     608:     if (result == PlaceFloatResult::Placed) {
     609:       placed = true;
     610:       // Pass on updated available space to the current inline reflow engine
     611:       WritingMode wm = mReflowInput.GetWritingMode();
     612:       // If we have mLineBSize, we are reflowing the line again due to
     613:       // LineReflowStatus::RedoMoreFloats. We should use mLineBSize to query the
