     582:   // Because we are in the middle of reflowing a placeholder frame
     583:   // within a line (and possibly nested in an inline frame or two
     584:   // that's a child of our block) we need to restore the space
     585:   // manager's translation to the space that the block resides in
     586:   // before placing the float.
     587:   nscoord oI, oB;
     588:   FloatManager()->GetTranslation(oI, oB);
