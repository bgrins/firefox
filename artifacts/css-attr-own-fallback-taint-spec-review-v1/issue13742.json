{"url":"https://api.github.com/repos/w3c/csswg-drafts/issues/13742","repository_url":"https://api.github.com/repos/w3c/csswg-drafts","labels_url":"https://api.github.com/repos/w3c/csswg-drafts/issues/13742/labels{/name}","comments_url":"https://api.github.com/repos/w3c/csswg-drafts/issues/13742/comments","events_url":"https://api.github.com/repos/w3c/csswg-drafts/issues/13742/events","html_url":"https://github.com/w3c/csswg-drafts/issues/13742","id":4168382722,"node_id":"I_kwDOAI0trM74dHkC","number":13742,"title":"[css-values-5] Are <url>s with attr() tainted values allowed in custom properties?","user":{"login":"anttijk","id":23225331,"node_id":"MDQ6VXNlcjIzMjI1MzMx","avatar_url":"https://avatars.githubusercontent.com/u/23225331?v=4","gravatar_id":"","url":"https://api.github.com/users/anttijk","html_url":"https://github.com/anttijk","followers_url":"https://api.github.com/users/anttijk/followers","following_url":"https://api.github.com/users/anttijk/following{/other_user}","gists_url":"https://api.github.com/users/anttijk/gists{/gist_id}","starred_url":"https://api.github.com/users/anttijk/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/anttijk/subscriptions","organizations_url":"https://api.github.com/users/anttijk/orgs","repos_url":"https://api.github.com/users/anttijk/repos","events_url":"https://api.github.com/users/anttijk/events{/privacy}","received_events_url":"https://api.github.com/users/anttijk/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":971551685,"node_id":"MDU6TGFiZWw5NzE1NTE2ODU=","url":"https://api.github.com/repos/w3c/csswg-drafts/labels/css-values-5","name":"css-values-5","color":"c5def5","default":false,"description":"","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":5,"created_at":"2026-03-30T07:48:09Z","updated_at":"2026-10-20T20:46:24Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_fie