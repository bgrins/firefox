+            var,
+            index,
+            lowlink: index,
+            self_ref: false,
+            registered,
+            selected_dependency_eligible,
+            value_non_custom_refs,
+            value,
+            prepared_custom: None,
+            phase,
+            walk: None,
+            unit_links: SmallVec::new(),
+            unit_cursor: 0,
+            priority_cursor: 0,
+            waiting: None,
+            reference_reply: None,
+        })
+    }
