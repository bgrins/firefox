+pub(crate) struct PreparedRegisteredDefault<'registration> {
+    name: Name,
+    registration: &'registration PropertyDescriptors,
+    is_root: bool,
+    source: RegisteredDefaultSource,
+    inherits_reset_style: bool,
+    pub(crate) requirements: RegisteredContextRequirements,
+}
+
+pub(crate) struct ComputedRegisteredDefault {
+    pub(crate) value: Option<ComputedRegisteredValue>,
+    pub(crate) inherits_reset_style: bool,
+}
+
+pub(crate) fn prepare_registered_default<'registration>(
+    name: &Name,
+    reason: RegisteredDefaultReason,
+    classification: ProviderCycleClassification,
+    registration: &'registration PropertyDescriptors,
+    stylist: &Stylist,
+    context: &computed::Context,
+) -> Result<PreparedRegisteredDefault<'registration>, SubstitutionDemand> {
+    let reason = match classification {
+        ProviderCycleClassification::Pending => {
+            return Err(SubstitutionDemand::Provider(name.clone()));
+        },
+        ProviderCycleClassification::Acyclic => reason,
+        ProviderCycleClassification::InvalidatedParticipant => RegisteredDefaultReason::Invalid,
+    };
+    let inherited = match reason {
+        RegisteredDefaultReason::Invalid => {
+            if registration.is_universal() {
+                return Ok(PreparedRegisteredDefault {
+                    name: name.clone(),
+                    registration,
+                    is_root: context.is_root_element(),
+                    source: RegisteredDefaultSource::Invalid,
+                    inherits_reset_style: false,
+                    requirements: RegisteredContextRequirements::Known(Default::default()),
+                });
+            }
+            registration.inherits() && !context.is_root_element()
+        },
+        RegisteredDefaultReason::CssWide(keyword) => {
+            !context.is_root_element()
+                && keyword != CSSWideKeyword::Initial
+                && (keyword == CSSWideKeyword::Inherit || registration.inherits())
+        },
+    };
+    let source = if inherited {
+        RegisteredDefaultSource::Inherited
+    } else if registration.is_universal() {
+        RegisteredDefaultSource::Copied(
+            stylist
+                .get_custom_property_initial_values()
+                .get(registration, name)
+                .cloned(),
+        )
+    } else if let Some(initial) = registration.initial_value.as_ref() {
+        RegisteredDefaultSource::Initial {
+            css: initial.css.to_string(),
+            url_data: initial.url_data.clone(),
+        }
+    } else {
+        RegisteredDefaultSource::Invalid
+    };
+    let requirements = if matches!(source, RegisteredDefaultSource::Initial { .. }) {
+        RegisteredContextRequirements::Unknown
+    } else {
+        RegisteredContextRequirements::Known(Default::default())
+    };
+    Ok(PreparedRegisteredDefault {
+        name: name.clone(),
+        registration,
+        is_root: context.is_root_element(),
+        source,
+        inherits_reset_style: inherited && !registration.inherits(),
+        requirements,
+    })
+}
+
+impl PreparedRegisteredDefault<'_> {
+    pub(crate) fn initial_input(&self) -> Option<(&str, &UrlExtraData)> {
+        match &self.source {
+            RegisteredDefaultSource::Initial { css, url_data } => Some((css, url_data)),
+            _ => None,
+        }
+    }
+
+    pub(crate) fn try_compute(
+        &self,
+        context: &computed::Context,
+        readiness: &dyn SubstitutionReadiness,
+    ) -> Result<ComputedRegisteredDefault, SubstitutionDemand> {
+        if context.is_root_element() != self.is_root {
+            return Err(SubstitutionDemand::InitialContext(self.name.clone()));
+        }
+        let registration = self.registration;
+        let mut required = match self.requirements {
+            RegisteredContextRequirements::Unknown => {
+                return Err(SubstitutionDemand::InitialContext(self.name.clone()));
+            },
+            RegisteredContextRequirements::Known(required) => required,
+        };
+        loop {
+            let previous = required;
+            for id in previous.iter() {
+                for dependency in id.dependencies().iter() {
+                    required.insert(dependency);
+                }
+            }
+            if previous == required {
+                break;
+            }
+        }
+        if let Some(id) = required.iter().find(|id| !readiness.prioritary_ready(*id)) {
+            return Err(SubstitutionDemand::Prioritary(id));
+        }
+        if matches!(self.source, RegisteredDefaultSource::Initial { .. })
+            && !readiness.initial_context_ready(&self.name, registration, context)
+        {
+            return Err(SubstitutionDemand::InitialContext(self.name.clone()));
+        }
+        let value = match &self.source {
+            RegisteredDefaultSource::Invalid => None,
+            RegisteredDefaultSource::Inherited => context
+                .builder
+                .inherited_style
+                .custom_properties()
+                .get(registration, &self.name)
+                .cloned(),
+            RegisteredDefaultSource::Copied(value) => value.clone(),
+            RegisteredDefaultSource::Initial { css, url_data } => compute_value(
+                css,
+                url_data,
+                registration,
+                context,
+                AttrTaint::default(),
+                Some(PropertyIdRef::from(&self.name)),
+            )
+            .ok(),
+        };
+        Ok(ComputedRegisteredDefault {
+            value,
+            inherits_reset_style: self.inherits_reset_style,
+        })
+    }
+}
