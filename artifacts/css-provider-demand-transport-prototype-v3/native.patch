+pub(crate) enum SubstitutionDemand {
+    Provider(Name),
+    Attribute {
+        name: Name,
+        data: AttributeData,
+        url_data: UrlExtraData,
+    },
+    Prioritary(PrioritaryPropertyId),
+    InitialContext(Name),
+}
+
+pub(crate) enum SubstitutionError {
+    Invalid,
+    Demand(SubstitutionDemand),
+}
+
+impl From<()> for SubstitutionError {
+    fn from(_: ()) -> Self {
+        Self::Invalid
+    }
+}
+
+pub(crate) trait SubstitutionReadiness {
+    fn provider_pending(&self, name: &Name) -> bool;
+    fn attribute_pending(&self, name: &Name, data: &AttributeData) -> bool;
+    fn prioritary_ready(&self, id: PrioritaryPropertyId) -> bool;
+    fn initial_context_ready(
+        &self,
+        _name: &Name,
+        _registration: &PropertyDescriptors,
+        _context: &computed::Context,
+    ) -> bool {
+        false
+    }
+}
+
+#[derive(Clone, Copy, PartialEq)]
+pub(crate) enum PrioritaryApplicationState {
+    Pending,
+    Applying,
+    Ready,
+}
+
+impl PrioritaryApplicationState {
+    pub(crate) fn begin(&mut self) -> bool {
+        if *self != Self::Pending {
+            return false;
+        }
+        *self = Self::Applying;
+        true
+    }
+
+    pub(crate) fn complete(&mut self) {
+        assert!(*self == Self::Applying);
+        *self = Self::Ready;
+    }
+
+    pub(crate) fn suspend(&mut self) {
+        assert!(*self == Self::Applying);
+        *self = Self::Pending;
+    }
+}
+
+pub(crate) enum ProviderCycleClassification {
+    Pending,
+    Acyclic,
+    InvalidatedParticipant,
+}
