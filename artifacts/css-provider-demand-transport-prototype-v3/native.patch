+struct PrioritaryContinuation<'owner, 'style, 'context, 'decl, 'element> {
+    cascade: &'owner mut Cascade<'style>,
+    context: &'owner mut computed::Context<'context>,
+    declarations: &'owner Declarations<'decl>,
+    cache: &'owner mut ShorthandsWithPropertyReferencesCache,
+    attributes: &'owner mut AttributeTracker<'element>,
+    id: PrioritaryPropertyId,
+    complete: bool,
+    owns_suspension: bool,
+}
+
+impl<'owner, 'style, 'context, 'decl, 'element>
+    PrioritaryContinuation<'owner, 'style, 'context, 'decl, 'element>
+{
+    fn new(
+        cascade: &'owner mut Cascade<'style>,
+        context: &'owner mut computed::Context<'context>,
+        declarations: &'owner Declarations<'decl>,
+        cache: &'owner mut ShorthandsWithPropertyReferencesCache,
+        attributes: &'owner mut AttributeTracker<'element>,
+        id: PrioritaryPropertyId,
+    ) -> Result<Self, custom_properties::SubstitutionDemand> {
+        if cascade.applying_prioritary.contains(id) || cascade.suspended_prioritary.contains(id) {
+            return Err(custom_properties::SubstitutionDemand::Prioritary(id));
+        }
+        cascade.suspended_prioritary.insert(id);
+        Ok(Self {
+            cascade,
+            context,
+            declarations,
+            cache,
+            attributes,
+            id,
+            complete: false,
+            owns_suspension: true,
+        })
+    }
+
+    fn resume(
+        &mut self,
+        readiness: Option<&dyn custom_properties::SubstitutionReadiness>,
+    ) -> Result<(), custom_properties::SubstitutionDemand> {
+        if self.complete {
+            return Ok(());
+        }
+        assert!(self.owns_suspension);
+        self.cascade.suspended_prioritary.remove(self.id);
+        self.owns_suspension = false;
+        let result = self.cascade.try_ensure_prioritary_property(
+            self.context,
+            self.declarations,
+            self.cache,
+            self.attributes,
+            self.id,
+            readiness,
+        );
+        if result.is_ok() {
+            self.complete = true;
+        } else {
+            assert!(!self.cascade.suspended_prioritary.contains(self.id));
+            self.cascade.suspended_prioritary.insert(self.id);
+            self.owns_suspension = true;
+        }
+        result
+    }
+
+    fn with_dependency_owner<R>(
+        &mut self,
+        f: impl FnOnce(
+            &mut Cascade,
+            &mut computed::Context,
+            &Declarations,
+            &mut ShorthandsWithPropertyReferencesCache,
+            &mut AttributeTracker,
+        ) -> R,
+    ) -> R {
+        assert!(!self.complete && self.owns_suspension);
+        f(
+            self.cascade,
+            self.context,
+            self.declarations,
+            self.cache,
+            self.attributes,
+        )
+    }
+}
+
+impl Drop for PrioritaryContinuation<'_, '_, '_, '_, '_> {
+    fn drop(&mut self) {
+        if self.owns_suspension {
+            self.cascade.suspended_prioritary.remove(self.id);
+        }
+    }
 }
 
