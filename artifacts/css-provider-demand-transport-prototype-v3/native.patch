+pub(crate) enum RegisteredDefaultReason {
+    Invalid,
+    CssWide(CSSWideKeyword),
+}
+
+enum RegisteredDefaultSource {
+    Invalid,
+    Inherited,
+    Copied(Option<ComputedRegisteredValue>),
+    Initial { css: String, url_data: UrlExtraData },
+}
