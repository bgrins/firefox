+                    context.builder.substitution_functions.insert_var(
+                        registration,
+                        name,
+                        value.clone(),
+                    );
+                },
+                None => {
+                    context
+                        .builder
+                        .substitution_functions
+                        .remove_var(registration, name);
+                },
+            };
+        },
+    }
