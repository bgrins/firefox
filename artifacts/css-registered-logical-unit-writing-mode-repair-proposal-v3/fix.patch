+      assert_equals(value, "horizontal-tb", `Registered admission/defaulting: ${detail}`);
+      assert_equals(writingMode, "horizontal-tb", `No false writing-mode cycle: ${detail}`);
+    }, `Registered writing-mode admission: ${unit}, ${kind}`);
