{
  "manifest_version": 2,
  "name": "Time Server (MCP)",
  "version": "1.0.0",
  "description": "MCP server providing current time functionality for Harbor",
  "browser_specific_settings": {
    "gecko": {
      "id": "time-server-mcp@harbor.mozilla.org"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["harbor"]
}
