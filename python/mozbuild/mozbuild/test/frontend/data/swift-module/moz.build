@template
def Program(name):
    PROGRAM = name


Program("swift-program")

SWIFT_MODULE_NAME = "Swifty"
SWIFT_SOURCES += [
    "a.swift",
    "b.swift",
]
SWIFTFLAGS += ["-import-underlying-module"]
